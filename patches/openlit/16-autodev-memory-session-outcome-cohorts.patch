+jest.mock("@/lib/platform/connectors/memory/crud", () => ({
+	memoryConnectorId: (id: string) => (id.startsWith("memory:") ? id : `memory:${id}`),
+	isMemoryConnectorId: (id: unknown) => typeof id === "string" && id.startsWith("memory:"),
+	listMemoryConnectors: jest.fn(),
+	getMemoryRuntime: jest.fn(),
+}));
+jest.mock("@/lib/platform/connectors/memory/autodev/adapter", () => ({
+	isAutoDevMemoryAdapter: (adapter: unknown) =>
+		!!adapter && typeof adapter === "object" && (adapter as { __autodev?: boolean }).__autodev === true,
+}));
+
+import { GET } from "@/app/api/memory/session-cohorts/route";
+import { getMemoryRuntime, listMemoryConnectors } from "@/lib/platform/connectors/memory/crud";
+import { MEMORY_SESSION_COHORTS_UNSUPPORTED_CONNECTOR } from "@/constants/messages/en";
+
+(globalThis as unknown as { Response: { json: unknown } }).Response = {
+	json: (body: unknown, init?: ResponseInit) => ({
+		status: init?.status ?? 200,
+		json: async () => body,
+	}),
+};
+
+function makeRequest(query: string) {
+	const url = "http://localhost/api/memory/session-cohorts" + (query ? "?" + query : "");
+	return { nextUrl: { searchParams: new URL(url).searchParams } } as any;
+}
+
+const autoDevConnector = { id: "memory:autodev-a", type: "autodev", name: "AutoDev Memory" };
+const claudeConnector = { id: "memory:claude-a", type: "claude", name: "Claude" };
+
+beforeEach(() => {
+	jest.clearAllMocks();
+	(listMemoryConnectors as jest.Mock).mockResolvedValue([autoDevConnector]);
+});
+
+
+test("session cohort route forwards Control API unavailability without an OpenLIT session", async () => {
+	const readSessionOutcomeCohorts = jest.fn().mockResolvedValue({ status: "unavailable", page: null });
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({
+		adapter: { __autodev: true, readSessionOutcomeCohorts },
+		connector: autoDevConnector,
+	});
+	const response = await GET(
+		makeRequest("occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z")
+	);
+	expect(response.status).toBe(200);
+	await expect(response.json()).resolves.toMatchObject({
+		result: { status: "unavailable", page: null },
+	});
+});
+
+test("session cohort route rejects caller-selected identities and overlong windows", async () => {
+	for (const query of [
+		"occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&taskId=caller",
+		"occurredFrom=2024-01-01T00:00:00.000Z&occurredUntil=2026-01-01T00:00:00.000Z",
+		"occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&memoryMode=invalid"
+	]) {
+		const response = await GET(makeRequest(query));
+		expect(response.status).toBe(400);
+	}
+	expect(listMemoryConnectors).not.toHaveBeenCalled();
+});
+
+test("session cohort route invokes only the AutoDev adapter and returns deduplicated counts", async () => {
+	const readSessionOutcomeCohorts = jest.fn().mockResolvedValue({
+		status: "available",
+		page: {
+			schema: "autodev-memory-session-outcome-cohorts-v1",
+			occurredFrom: "2026-09-01T00:00:00.000Z",
+			occurredUntil: "2026-09-02T00:00:00.000Z",
+			cells: [{ memoryMode: "jit", outcomeKind: "success", sessionCount: 2 }],
+			sessionCount: 2,
+			reportedSessionCount: 2,
+			unreportedSessionCount: 0,
+			conflictingOutcomeSessionCount: 1,
+			mixedModeSessionCount: 0
+		}
+	});
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({
+		adapter: { __autodev: true, readSessionOutcomeCohorts },
+		connector: autoDevConnector,
+	});
+	const response = await GET(
+		makeRequest("occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&memoryMode=jit")
+	);
+	expect(response.status).toBe(200);
+	const body = await response.json();
+	expect(body.connector).toEqual(autoDevConnector);
+	expect(body.result.page.sessionCount).toBe(2);
+	expect(readSessionOutcomeCohorts).toHaveBeenCalledWith({
+		occurredFrom: "2026-09-01T00:00:00.000Z",
+		occurredUntil: "2026-09-02T00:00:00.000Z",
+		memoryModes: ["jit"]
+	});
+});
+
+test("session cohort route does not expose session analysis for other connectors", async () => {
+	(listMemoryConnectors as jest.Mock).mockResolvedValue([claudeConnector]);
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({
+		adapter: { __autodev: false },
+		connector: claudeConnector,
+	});
+	const response = await GET(
+		makeRequest("occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&connectorId=claude-a")
+	);
+	expect(response.status).toBe(400);
+	expect(await response.json()).toBe(MEMORY_SESSION_COHORTS_UNSUPPORTED_CONNECTOR);
+});
