--- /dev/null
+++ b/src/client/src/__tests__/lib/platform/manage-dashboard/derived-value.test.ts
@@ -0,0 +1,37 @@
+import { resolveRatioDisplay } from "@/lib/platform/manage-dashboard/derived-value";
+
+describe("resolveRatioDisplay", () => {
+	const ratio = {
+		numerator: "0.cache_read_tokens",
+		denominator: "0.input_tokens",
+		multiplier: 100,
+	};
+
+	it("computes ratios from aggregated sums rather than averaging row rates", () => {
+		expect(
+			resolveRatioDisplay(
+				[{ cache_read_tokens: 91, input_tokens: 102 }],
+				ratio,
+			),
+		).toBeCloseTo((91 / 102) * 100);
+	});
+
+	it("returns unavailable when the denominator or source evidence is absent", () => {
+		expect(
+			resolveRatioDisplay(
+				[{ cache_read_tokens: 0, input_tokens: 0 }],
+				ratio,
+			),
+		).toBeNull();
+		expect(resolveRatioDisplay([], ratio)).toBeNull();
+	});
+
+	it("does not interpret executable or prototype property paths", () => {
+		expect(
+			resolveRatioDisplay(
+				[{ cache_read_tokens: 1, input_tokens: 2 }],
+				{ ...ratio, numerator: "0.constructor" },
+			),
+		).toBeNull();
+	});
+});
