@@ -0,0 +1,369 @@
+import dashboard from "@/clickhouse/seed-data/openlit-dashboard-AutoDev-Usage-layout.json";
+
+type SeedWidget = {
+	title: string;
+	description?: string;
+	properties: Record<string, unknown>;
+	config: {
+		query?: unknown;
+		structuredQuery?: {
+			query?: {
+				filters?: unknown[];
+				aggregations?: unknown[];
+				groupBy?: string[];
+				limit?: number;
+			};
+		};
+	};
+};
+
+const widgets = Object.values(dashboard.widgets) as SeedWidget[];
+
+// Each Usage widget must use a structured query scoped to a single
+// AutoDev-owned service.name. The router widgets (logical/attempt
+// activity) scope to autodev-router; the G10 source-owned MCP server
+// widget scopes to autodev-codex-tools-mcp. No widget may use a
+// different owner and no widget may use raw SQL.
+const ALLOWED_SERVICE_NAMES = new Set([
+	"autodev-router",
+	"autodev-codex-tools-mcp"
+]);
+
+describe("AutoDev Usage dashboard seed", () => {
+	it("declares the shared non-time trace filters and structured widgets", () => {
+		expect(dashboard.title).toBe("Usage");
+		expect(dashboard.variables?.map((variable) => variable.id)).toEqual([
+			"workspace",
+			"provider",
+			"model",
+			"agent",
+			"skill",
+		]);
+		expect(
+			dashboard.variables?.find((variable) => variable.id === "model"),
+	).toMatchObject({
+			label: "Requested model",
+			key: "autodev.requested_model",
+		});
+		for (const widget of widgets) {
+			expect(widget.config.structuredQuery).toBeDefined();
+			expect(widget.config.query).toBeUndefined();
+			const serviceNameFilter = (
+				widget.config.structuredQuery?.query?.filters ?? []
+			).find(
+				(filter) =>
+					filter !== null &&
+					typeof filter === "object" &&
+					"key" in filter &&
+					(filter as { key: unknown }).key === "service.name",
+			) as { value?: unknown } | undefined;
+			expect(serviceNameFilter).toBeDefined();
+			expect(ALLOWED_SERVICE_NAMES.has(serviceNameFilter?.value as string)).toBe(
+				true,
+			);
+		}
+	});
+
+	it("filters cache-rate evidence and calculates the ratio from weighted sums", () => {
+		const widget = widgets.find(
+			(candidate) => candidate.title === "Cache-read rate",
+		);
+		expect(widget).toBeDefined();
+		expect(widget?.properties.ratio).toEqual({
+			numerator: "0.cache_read_tokens",
+			denominator: "0.input_tokens",
+			multiplier: 100,
+		});
+		expect(widget?.properties.optInVariables).toEqual([
+			"workspace",
+			"provider",
+			"model",
+			"agent",
+		]);
+		const query = widget?.config.structuredQuery?.query;
+		expect(query?.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({
+					key: "gen_ai.usage.input_tokens",
+					op: "exists",
+				}),
+				expect.objectContaining({
+					key: "gen_ai.usage.cache_read.input_tokens",
+					op: "exists",
+				}),
+			]),
+		);
+		expect(query?.aggregations).toEqual([
+			{
+				fn: "sum",
+				field: "gen_ai.usage.cache_read.input_tokens",
+				as: "cache_read_tokens",
+			},
+			{
+				fn: "sum",
+				field: "gen_ai.usage.input_tokens",
+				as: "input_tokens",
+			},
+		]);
+	});
+
+	it("keeps logical requests separate from provider-attempt filters", () => {
+		const widget = widgets.find(
+			(candidate) => candidate.title === "Logical routed requests",
+		);
+		expect(widget?.properties.optInVariables).toEqual([
+			"workspace",
+			"model",
+			"agent",
+		]);
+		expect(widget?.description).toMatch(/multiple providers/);
+		expect(widget?.config.structuredQuery?.query?.filters).toEqual([
+			{
+				target: "attribute",
+				scope: "resource",
+				key: "service.name",
+				op: "eq",
+				value: "autodev-router",
+			},
+			{
+				target: "spanName",
+				op: "eq",
+				value: "autodev.routed_request",
+			},
+		]);
+	});
+
+	it("shows logical request activity by role without claiming agent sessions", () => {
+		const widget = widgets.find(
+			(candidate) => candidate.title === "Logical requests by agent/role",
+		);
+		expect(widget?.properties.optInVariables).toEqual([
+			"workspace",
+			"model",
+			"agent",
+		]);
+		expect(widget?.description).toMatch(/not unique agent sessions/);
+		expect(widget?.config.structuredQuery?.query?.groupBy).toEqual([
+			"autodev.agent.role",
+		]);
+	});
+
+	it("scopes the G10 source-owned MCP tool-call widgets to autodev-codex-tools-mcp", () => {
+		// Every G10 widget MUST filter on the shim's resource
+		// service.name AND on the MCP method name span attribute,
+		// because the source-owned observation is uniquely identified
+		// by the combination. Provider and requested-model are
+		// intentionally NOT in optInVariables because the shim does
+		// not emit those fields.
+		const g10Titles = [
+			"MCP tool calls",
+			"P95 tool-call duration",
+			"MCP tool-call errors",
+			"MCP tool calls by tool name",
+		];
+		for (const title of g10Titles) {
+			const widget = widgets.find((candidate) => candidate.title === title);
+			expect(widget).toBeDefined();
+			expect(widget?.config.structuredQuery?.query?.filters).toEqual(
+				expect.arrayContaining([
+					{
+						target: "attribute",
+						scope: "resource",
+						key: "service.name",
+						op: "eq",
+						value: "autodev-codex-tools-mcp",
+					},
+					{
+						target: "attribute",
+						scope: "span",
+						key: "mcp.method.name",
+						op: "eq",
+						value: "tools/call",
+					},
+				]),
+			);
+			expect(widget?.description).toMatch(/Resource scope override/u);
+		}
+	});
+
+	it("opts every G10 widget into workspace + agent at Resource scope only", () => {
+		// The G10 widgets honor the dashboard's workspace and
+		// agent/role variables by overriding their scope to
+		// "resource" at the widget level so the shim's validated
+		// Resource attributes are matched without duplicating
+		// Resource values onto spans. The provider and model
+		// variables remain unselected because the shim does not
+		// emit those attributes; declaring an override for them
+		// would silently filter against empty data.
+		const g10Titles = [
+			"MCP tool calls",
+			"P95 tool-call duration",
+			"MCP tool-call errors",
+			"MCP tool calls by tool name",
+		];
+		for (const title of g10Titles) {
+			const widget = widgets.find((candidate) => candidate.title === title);
+			expect(widget).toBeDefined();
+			expect(widget?.properties.optInVariables).toEqual([
+				"workspace",
+				"agent",
+			]);
+			expect(widget?.properties.variableScopeOverrides).toEqual({
+				workspace: "resource",
+				agent: "resource",
+			});
+			// The override must not invent scopes for variables the
+			// widget does not opt into; that would silently empty
+			// out non-Resource attributes when no value matches.
+			const overrides = (widget?.properties.variableScopeOverrides ??
+				{}) as Record<string, unknown>;
+			expect(Object.keys(overrides).sort()).toEqual([
+				"agent",
+				"workspace",
+			]);
+		}
+	});
+
+	it("counts MCP tool calls and emits the duration/error/status contract", () => {
+		// The G10 widgets must cover the four axes documented in the
+		// task: service.name, mcp.method.name, gen_ai.tool.name, and
+		// span duration/status. Each axis is asserted below so a
+		// future change that drops one is caught by the seed tests.
+		const callCount = widgets.find(
+			(candidate) => candidate.title === "MCP tool calls",
+		);
+		expect(callCount?.config.structuredQuery?.query?.aggregations).toEqual([
+			{
+				fn: "count",
+				as: "calls",
+			},
+		]);
+
+		const latency = widgets.find(
+			(candidate) => candidate.title === "P95 tool-call duration",
+		);
+		expect(latency?.config.structuredQuery?.query?.aggregations).toEqual([
+			{
+				fn: "p95",
+				field: "duration",
+				as: "p95_seconds",
+			},
+		]);
+
+		const errors = widgets.find(
+			(candidate) => candidate.title === "MCP tool-call errors",
+		);
+		expect(errors?.config.structuredQuery?.query?.filters).toEqual(
+			expect.arrayContaining([
+				{
+					target: "status",
+					op: "eq",
+					value: "ERROR",
+				},
+			]),
+		);
+		expect(errors?.config.structuredQuery?.query?.aggregations).toEqual([
+			{
+				fn: "count",
+				as: "errors",
+			},
+		]);
+	});
+
+	it("groups MCP tool calls by gen_ai.tool.name without filtering raw tool content", () => {
+		const grouped = widgets.find(
+			(candidate) => candidate.title === "MCP tool calls by tool name",
+		);
+		expect(grouped?.properties.xAxis).toBe("g0");
+		expect(grouped?.properties.yAxis).toBe("calls");
+		expect(grouped?.config.structuredQuery?.query?.groupBy).toEqual([
+			"gen_ai.tool.name",
+		]);
+		expect(grouped?.config.structuredQuery?.query?.limit).toBe(20);
+		expect(grouped?.config.structuredQuery?.query?.aggregations).toEqual([
+			{
+				fn: "count",
+				as: "calls",
+			},
+		]);
+	});
+
+	it("counts provider errors from failed physical attempt spans", () => {
+		const widget = widgets.find(
+			(candidate) => candidate.title === "Failed attempts by provider",
+		);
+		expect(widget).toBeDefined();
+		expect(widget?.properties.optInVariables).toEqual([
+			"workspace",
+			"provider",
+			"model",
+			"agent",
+		]);
+		const query = widget?.config.structuredQuery?.query;
+		expect(query?.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({ key: "service.name", value: "autodev-router" }),
+				expect.objectContaining({ target: "spanName", value: "gen_ai.client_operation" }),
+				{ target: "status", op: "eq", value: "ERROR" },
+			]),
+		);
+		expect(query?.groupBy).toEqual(["gen_ai.provider.name"]);
+		expect(query?.aggregations).toEqual([{ fn: "count", as: "failures" }]);
+		expect(query?.limit).toBe(20);
+	});
+
+	it("counts only logical requests carrying a source-confirmed compaction signal", () => {
+		const widget = widgets.find((candidate) => candidate.title === "Context compactions");
+		expect(widget).toBeDefined();
+		expect(widget?.properties.optInVariables).toEqual(["workspace", "model", "agent"]);
+		const query = widget?.config.structuredQuery?.query;
+		expect(query?.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({ key: "service.name", value: "autodev-router" }),
+				expect.objectContaining({ target: "spanName", value: "autodev.routed_request" }),
+				{ target: "attribute", scope: "span", key: "autodev.request_kind", op: "eq", value: "compaction" },
+				{ target: "status", op: "eq", value: "OK" },
+			]),
+		);
+		expect(query?.aggregations).toEqual([{ fn: "count", as: "compactions" }]);
+	});
+
+	it("groups skill observations by event and filters by bounded skill name", () => {
+		const widget = widgets.find((candidate) => candidate.title === "Skill events by event");
+		expect(widget).toBeDefined();
+		expect(widget?.properties.optInVariables).toEqual(["workspace", "agent", "skill"]);
+		const query = widget?.config.structuredQuery?.query;
+		expect(query?.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({ key: "service.name", value: "autodev-router" }),
+				expect.objectContaining({ target: "spanName", value: "autodev.skill" }),
+			]),
+		);
+		expect(query?.groupBy).toEqual(["autodev.skill.event"]);
+		expect(query?.aggregations).toEqual([{ fn: "count", as: "events" }]);
+		expect(query?.limit).toBe(10);
+	});
+
+	it("labels OpenLIT pricing attributes as an estimate rather than billed cost", () => {
+		const widget = widgets.find((candidate) => candidate.title === "Estimated GenAI cost");
+		expect(widget).toBeDefined();
+		expect(widget?.description).toMatch(/pricing estimate/i);
+		expect(widget?.description).toMatch(/not a provider billing statement/i);
+		expect(widget?.properties.value).toBe("0.estimated_cost");
+		expect(widget?.properties.prefix).toBe("$");
+		expect(widget?.properties.observationCountPath).toBe("0.costed_attempts");
+		const query = widget?.config.structuredQuery?.query;
+		expect(query?.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({ key: "service.name", value: "autodev-router" }),
+				expect.objectContaining({ target: "spanName", value: "gen_ai.client_operation" }),
+				expect.objectContaining({ key: "gen_ai.usage.cost", op: "exists" }),
+			]),
+		);
+		expect(query?.aggregations).toEqual([
+			{ fn: "sum", field: "gen_ai.usage.cost", as: "estimated_cost" },
+			{ fn: "count", as: "costed_attempts" },
+		]);
+	});
+
+});
