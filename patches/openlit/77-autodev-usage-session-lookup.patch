+/** @jest-environment node */
+
+export {};
+
+const mockResolveTelemetrySourceDescriptor = jest.fn();
+const mockGetTelemetryAdapter = jest.fn();
+const mockListSpans = jest.fn();
+
+jest.mock("@/lib/telemetry-source", () => ({
+	resolveTelemetrySourceDescriptor: (...args: unknown[]) =>
+		mockResolveTelemetrySourceDescriptor(...args),
+	getTelemetryAdapter: (...args: unknown[]) => mockGetTelemetryAdapter(...args),
+}));
+
+const previousUsageToken = process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+process.env.AUTODEV_OPENLIT_USAGE_TOKEN = "session-usage-test-token";
+const { POST } = require("@/app/api/autodev/usage/session/route") as {
+	POST: (request: Request) => Promise<Response>;
+};
+
+const SESSION_ID = "01a0ba14-d54c-78f2-9367-3f80e9a8f75f";
+const TRACE_ID = "0123456789abcdef0123456789abcdef";
+const SPAN_ID = "0123456789abcdef";
+const PARENT_SPAN_ID = "fedcba9876543210";
+
+function span(index = 0) {
+	return {
+		traceId: TRACE_ID,
+		spanId: index === 0 ? SPAN_ID : index.toString(16).padStart(16, "0"),
+		parentSpanId: PARENT_SPAN_ID,
+		name: "autodev.routed_request",
+		serviceName: "autodev-router",
+		timestamp: "2026-10-05T12:00:00.000Z",
+		durationNs: 1_250_000,
+		statusCode: "STATUS_CODE_OK",
+		statusMessage: "private status message",
+		spanAttributes: {
+			"autodev.session.id": SESSION_ID,
+			"gen_ai.operation.name": "chat",
+			"gen_ai.provider.name": "openai",
+			"autodev.requested_model": "gpt-6-luna",
+			"autodev.agent.role": "worker",
+			"autodev.workspace": "owner/repo",
+			"gen_ai.usage.input_tokens": "12",
+			"gen_ai.usage.output_tokens": "3",
+			"gen_ai.usage.cache_read.input_tokens": "2",
+			"gen_ai.usage.cost": "0.00042",
+			"autodev.request_kind": "compaction",
+			"autodev.compaction.provider": "openai",
+			"autodev.hop.route": "claude->openai",
+			"autodev.hop.from": "claude",
+			"autodev.hop.to": "openai",
+			"autodev.hop.reason": "fallback",
+			"gen_ai.prompt": "private prompt content",
+			"tool.arguments": "private tool arguments",
+		},
+		resourceAttributes: { "host.name": "private-host" },
+		events: [{ name: "private event", attributes: { body: "private event body" } }],
+	};
+}
+
+function request(body: unknown, token = "session-usage-test-token"): Request {
+	return new Request("http://openlit.local/api/autodev/usage/session", {
+		method: "POST",
+		headers: {
+			authorization: `Bearer ${token}`,
+			"content-type": "application/json",
+		},
+		body: JSON.stringify(body),
+	});
+}
+
+beforeEach(() => {
+	mockResolveTelemetrySourceDescriptor.mockReset();
+	mockResolveTelemetrySourceDescriptor.mockResolvedValue({ id: "source-1" });
+	mockGetTelemetryAdapter.mockReset();
+	mockGetTelemetryAdapter.mockResolvedValue({ listSpans: mockListSpans });
+	mockListSpans.mockReset();
+	mockListSpans.mockResolvedValue({ rows: [span()], meta: { truncated: false } });
+});
+
+afterAll(() => {
+	if (previousUsageToken === undefined) {
+		delete process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+	} else {
+		process.env.AUTODEV_OPENLIT_USAGE_TOKEN = previousUsageToken;
+	}
+});
+
+describe("fixed AutoDev historical session Usage endpoint", () => {
+	it("requires the dedicated Usage bearer credential", async () => {
+		const response = await POST(
+			request({ sessionId: SESSION_ID, range: "24H" }, "wrong-token"),
+		);
+		expect(response.status).toBe(401);
+		expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+	});
+
+	it("rejects malformed and reserved session identifiers before querying", async () => {
+		for (const sessionId of [
+			"",
+			"contains spaces",
+			"../secret",
+			"_leading-underscore",
+			"x".repeat(129),
+			"unknown",
+			"UNATTRIBUTED",
+			"process-fallback",
+			"process-scope",
+		]) {
+			const response = await POST(request({ sessionId, range: "24H" }));
+			const body = JSON.stringify(await response.json());
+			expect(response.status).toBe(400);
+			if (sessionId) expect(body).not.toContain(sessionId);
+		}
+		expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+	});
+
+	it("queries only the exact router session attribute and returns the fixed redacted v1 summary", async () => {
+		const response = await POST(
+			request({ sessionId: SESSION_ID, range: "7D" }),
+		);
+		const body = await response.json();
+
+		expect(response.status).toBe(200);
+		expect(body).toEqual({
+			schema: "autodev-openlit-session-usage-v1",
+			status: "observed",
+			partial: false,
+			spans: [
+				{
+					spanId: SPAN_ID,
+					traceId: TRACE_ID,
+					parentSpanId: PARENT_SPAN_ID,
+					operationName: "chat",
+					timestamp: "2026-10-05T12:00:00.000Z",
+					durationNs: 1_250_000,
+					statusCode: "OK",
+					provider: "openai",
+					requestedModel: "gpt-6-luna",
+					role: "worker",
+					workspace: "owner/repo",
+					inputTokens: 12,
+					outputTokens: 3,
+					cacheReadInputTokens: 2,
+					costUsd: 0.00042,
+					requestKind: "compaction",
+					compactionProvider: "openai",
+					hopRoute: "claude->openai",
+					hopFrom: "claude",
+					hopTo: "openai",
+					hopReason: "fallback",
+				},
+			],
+		});
+		const serialized = JSON.stringify(body);
+		for (const privateValue of [
+			SESSION_ID,
+			"private prompt content",
+			"private tool arguments",
+			"private status message",
+			"private-host",
+			"private event body",
+		]) {
+			expect(serialized).not.toContain(privateValue);
+		}
+		expect(Object.keys(body.spans[0]).sort()).toEqual([
+			"cacheReadInputTokens",
+			"compactionProvider",
+			"costUsd",
+			"durationNs",
+			"hopFrom",
+			"hopReason",
+			"hopRoute",
+			"hopTo",
+			"inputTokens",
+			"operationName",
+			"outputTokens",
+			"parentSpanId",
+			"provider",
+			"requestKind",
+			"requestedModel",
+			"role",
+			"spanId",
+			"statusCode",
+			"timestamp",
+			"traceId",
+			"workspace",
+		]);
+		expect(mockListSpans).toHaveBeenCalledWith({
+			signal: "traces",
+			timeRange: expect.objectContaining({ start: expect.any(Date), end: expect.any(Date) }),
+			filters: [
+				{
+					target: "attribute",
+					scope: "resource",
+					key: "service.name",
+					op: "eq",
+					value: "autodev-router",
+				},
+				{
+					target: "attribute",
+					scope: "span",
+					key: "autodev.session.id",
+					op: "eq",
+					value: SESSION_ID,
+				},
+			],
+			sort: [{ field: "Timestamp", direction: "desc" }],
+			limit: 200,
+			offset: 0,
+			aiSelector: false,
+		});
+	});
+
+	it("distinguishes an observed empty result from an unavailable query", async () => {
+		mockListSpans.mockResolvedValueOnce({ rows: [], meta: { truncated: false } });
+		const empty = await POST(request({ sessionId: SESSION_ID, range: "24H" }));
+		expect(empty.status).toBe(200);
+		expect(await empty.json()).toEqual({
+			schema: "autodev-openlit-session-usage-v1",
+			status: "observed",
+			partial: false,
+			spans: [],
+		});
+
+		mockListSpans.mockRejectedValueOnce(new Error("private source failure"));
+		const failed = await POST(request({ sessionId: SESSION_ID, range: "24H" }));
+		const failedBody = await failed.json();
+		expect(failed.status).toBe(503);
+		expect(failedBody).toEqual({
+			schema: "autodev-openlit-session-usage-v1",
+			status: "unavailable",
+			partial: false,
+			spans: [],
+		});
+		const failedText = JSON.stringify(failedBody);
+		expect(failedText).not.toContain(SESSION_ID);
+		expect(failedText).not.toContain("private source failure");
+	});
+
+	it("caps results at 200 and marks source and result truncation partial", async () => {
+		mockListSpans.mockResolvedValueOnce({
+			rows: Array.from({ length: 205 }, (_, index) => span(index)),
+			meta: { truncated: false },
+		});
+		const overflow = await POST(request({ sessionId: SESSION_ID, range: "3M" }));
+		const overflowBody = await overflow.json();
+		expect(overflowBody.status).toBe("observed");
+		expect(overflowBody.partial).toBe(true);
+		expect(overflowBody.spans).toHaveLength(200);
+
+		mockListSpans.mockResolvedValueOnce({
+			rows: [span()],
+			meta: { truncated: true },
+		});
+		const sourceTruncated = await POST(
+			request({ sessionId: SESSION_ID, range: "24H" }),
+		);
+		expect((await sourceTruncated.json()).partial).toBe(true);
+	});
+
+	it("rejects an invalid range before querying", async () => {
+		const response = await POST(
+			request({ sessionId: SESSION_ID, range: "all" }),
+		);
+		expect(response.status).toBe(400);
+		expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+	});
+});
