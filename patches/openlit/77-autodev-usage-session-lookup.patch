+import {
+	getTelemetryAdapter,
+	resolveTelemetrySourceDescriptor,
+} from "@/lib/telemetry-source";
+import type {
+	NormalizedSpan,
+	OpenLITQuery,
+} from "@/lib/platform/connectors/datasource/types";
+import {
+	isUsageServiceRequestAuthorized,
+	parseUsageSelection,
+	parseUsageTraceSpanId,
+	isUsageTraceId,
+	usageTimeRange,
+} from "@/lib/autodev/usage-api";
+import { runUsageQuery } from "@/lib/autodev/usage-query-scheduler";
+
+export const runtime = "nodejs";
+
+const SERVICE_TOKEN = process.env.AUTODEV_OPENLIT_USAGE_TOKEN ?? "";
+const SESSION_USAGE_SCHEMA = "autodev-openlit-session-usage-v1" as const;
+const SESSION_SPAN_LIMIT = 200;
+const MAX_REQUEST_BYTES = 16_384;
+const MAX_LABEL_LENGTH = 128;
+const SESSION_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/u;
+const RESERVED_SESSION_IDS = new Set([
+	"unknown",
+	"unattributed",
+	"process-fallback",
+	"process-scope",
+]);
+
+type UsageSpanStatus = "OK" | "ERROR" | "UNSET" | "UNKNOWN";
+
+interface SessionSpanSummary {
+	readonly spanId: string;
+	readonly traceId: string;
+	readonly parentSpanId: string | null;
+	readonly operationName: string;
+	readonly timestamp: string;
+	readonly durationNs: number;
+	readonly statusCode: UsageSpanStatus;
+	readonly provider: string | null;
+	readonly requestedModel: string | null;
+	readonly role: string | null;
+	readonly workspace: string | null;
+	readonly inputTokens: number | null;
+	readonly outputTokens: number | null;
+	readonly cacheReadInputTokens: number | null;
+	readonly costUsd: number | null;
+	readonly requestKind: string | null;
+	readonly compactionProvider: string | null;
+	readonly hopRoute: string | null;
+	readonly hopFrom: string | null;
+	readonly hopTo: string | null;
+	readonly hopReason: string | null;
+}
+
+interface SessionUsageResponse {
+	readonly schema: typeof SESSION_USAGE_SCHEMA;
+	readonly status: "observed" | "unavailable";
+	readonly partial: boolean;
+	readonly spans: readonly SessionSpanSummary[];
+}
+
+function response(
+	status: number,
+	body: SessionUsageResponse | { readonly error: { readonly code: string } },
+): Response {
+	return Response.json(body, {
+		status,
+		headers: { "cache-control": "no-store" },
+	});
+}
+
+function unavailable(): Response {
+	return response(503, {
+		schema: SESSION_USAGE_SCHEMA,
+		status: "unavailable",
+		partial: false,
+		spans: [],
+	});
+}
+
+function parseSessionId(value: unknown): string | null {
+	if (typeof value !== "string" || !SESSION_ID_PATTERN.test(value)) return null;
+	return RESERVED_SESSION_IDS.has(value.toLowerCase()) ? null : value;
+}
+
+function safeLabel(value: unknown): string | null {
+	if (typeof value !== "string") return null;
+	const label = value.trim();
+	if (!label || /[\u0000-\u001f\u007f]/u.test(label)) return null;
+	return label.slice(0, MAX_LABEL_LENGTH);
+}
+
+function safeCount(value: unknown): number | null {
+	if (typeof value !== "string" || !value.trim()) return null;
+	const count = Number(value);
+	return Number.isSafeInteger(count) && count >= 0 ? count : null;
+}
+
+function safeCost(value: unknown): number | null {
+	if (typeof value !== "string" || !value.trim()) return null;
+	const cost = Number(value);
+	return Number.isFinite(cost) && cost >= 0 ? cost : null;
+}
+
+function spanSummary(
+	span: NormalizedSpan,
+	sessionId: string,
+): SessionSpanSummary | null {
+	const timestamp = new Date(span.timestamp);
+	const spanId = parseUsageTraceSpanId(span.spanId);
+	const traceId = isUsageTraceId(span.traceId) ? span.traceId : null;
+	const parentSpanId = span.parentSpanId
+		? parseUsageTraceSpanId(span.parentSpanId)
+		: null;
+	if (
+		span.serviceName !== "autodev-router" ||
+		span.spanAttributes["autodev.session.id"] !== sessionId ||
+		!spanId ||
+		!traceId ||
+		(span.parentSpanId !== "" && !parentSpanId) ||
+		!Number.isSafeInteger(span.durationNs) ||
+		span.durationNs < 0 ||
+		!Number.isFinite(timestamp.getTime())
+	) {
+		return null;
+	}
+	const rawOperation = safeLabel(span.spanAttributes["gen_ai.operation.name"]);
+	const operationName = rawOperation ?? safeLabel(span.name);
+	if (!operationName || typeof span.statusCode !== "string") return null;
+	const sourceStatus = span.statusCode.toUpperCase().replace(/^STATUS_CODE_/u, "");
+	const statusCode: UsageSpanStatus =
+		sourceStatus === "OK" || sourceStatus === "ERROR" || sourceStatus === "UNSET"
+			? sourceStatus
+			: "UNKNOWN";
+	const attributes = span.spanAttributes;
+	return {
+		spanId: spanId.toLowerCase(),
+		traceId: traceId.toLowerCase(),
+		parentSpanId: parentSpanId?.toLowerCase() ?? null,
+		operationName,
+		timestamp: timestamp.toISOString(),
+		durationNs: span.durationNs,
+		statusCode,
+		provider: safeLabel(attributes["gen_ai.provider.name"]),
+		requestedModel: safeLabel(attributes["autodev.requested_model"]),
+		role: safeLabel(attributes["autodev.agent.role"]),
+		workspace: safeLabel(attributes["autodev.workspace"]),
+		inputTokens: safeCount(attributes["gen_ai.usage.input_tokens"]),
+		outputTokens: safeCount(attributes["gen_ai.usage.output_tokens"]),
+		cacheReadInputTokens: safeCount(
+			attributes["gen_ai.usage.cache_read.input_tokens"],
+		),
+		costUsd: safeCost(attributes["gen_ai.usage.cost"]),
+		requestKind: safeLabel(attributes["autodev.request_kind"]),
+		compactionProvider: safeLabel(attributes["autodev.compaction.provider"]),
+		hopRoute: safeLabel(attributes["autodev.hop.route"]),
+		hopFrom: safeLabel(attributes["autodev.hop.from"]),
+		hopTo: safeLabel(attributes["autodev.hop.to"]),
+		hopReason: safeLabel(attributes["autodev.hop.reason"]),
+	};
+}
+
+export async function POST(request: Request): Promise<Response> {
+	if (!SERVICE_TOKEN) return unavailable();
+	if (!isUsageServiceRequestAuthorized(request.headers.get("authorization"), SERVICE_TOKEN)) {
+		return response(401, { error: { code: "autodev_usage_unauthorized" } });
+	}
+
+	const contentLength = Number(request.headers.get("content-length") ?? 0);
+	if (Number.isFinite(contentLength) && contentLength > MAX_REQUEST_BYTES) {
+		return response(413, { error: { code: "autodev_usage_request_too_large" } });
+	}
+	let body: unknown;
+	try {
+		const bodyText = await request.text();
+		if (Buffer.byteLength(bodyText) > MAX_REQUEST_BYTES) {
+			return response(413, { error: { code: "autodev_usage_request_too_large" } });
+		}
+		body = JSON.parse(bodyText);
+	} catch {
+		return response(400, { error: { code: "autodev_usage_request_invalid" } });
+	}
+	if (!isRecord(body) || Object.keys(body).some((key) =>
+		!(["sessionId", "range", "customRange"] as const).includes(key as "sessionId" | "range" | "customRange")
+	)) {
+		return response(400, { error: { code: "autodev_usage_request_invalid" } });
+	}
+	const sessionId = parseSessionId(body.sessionId);
+	const selection = parseUsageSelection({
+		range: body.range,
+		values: {},
+		...(Object.hasOwn(body, "customRange") ? { customRange: body.customRange } : {}),
+	});
+	if (!sessionId || !selection) {
+		return response(400, { error: { code: "autodev_usage_session_request_invalid" } });
+	}
+
+	try {
+		const descriptor = await resolveTelemetrySourceDescriptor({ signal: "traces" });
+		const adapter = await getTelemetryAdapter({ signal: "traces", sourceId: descriptor.id });
+		const query: OpenLITQuery = {
+			signal: "traces",
+			timeRange: usageTimeRange(selection),
+			filters: [
+				{
+					target: "attribute",
+					scope: "resource",
+					key: "service.name",
+					op: "eq",
+					value: "autodev-router",
+				},
+				{
+					target: "attribute",
+					scope: "span",
+					key: "autodev.session.id",
+					op: "eq",
+					value: sessionId,
+				},
+			],
+			sort: [{ field: "Timestamp", direction: "desc" }],
+			limit: SESSION_SPAN_LIMIT,
+			offset: 0,
+			aiSelector: false,
+		};
+		const frame = await runUsageQuery(() => adapter.listSpans(query));
+		if (!Array.isArray(frame.rows)) return unavailable();
+		let partial = Boolean(frame.meta?.truncated) || frame.rows.length >= SESSION_SPAN_LIMIT;
+		const summaries = new Map<string, SessionSpanSummary>();
+		for (const span of frame.rows) {
+			const summary = spanSummary(span, sessionId);
+			if (!summary) {
+				partial = true;
+				continue;
+			}
+			if (summaries.has(summary.spanId)) partial = true;
+			summaries.set(summary.spanId, summary);
+		}
+		const spans = Array.from(summaries.values())
+			.sort((a, b) =>
+				Date.parse(b.timestamp) - Date.parse(a.timestamp) ||
+				a.spanId.localeCompare(b.spanId),
+			)
+			.slice(0, SESSION_SPAN_LIMIT);
+		return response(200, {
+			schema: SESSION_USAGE_SCHEMA,
+			status: "observed",
+			partial: partial || summaries.size > spans.length,
+			spans,
+		});
+	} catch {
+		return unavailable();
+	}
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
