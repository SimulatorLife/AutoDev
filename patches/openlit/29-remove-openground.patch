@@ -0,0 +1,26 @@
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "drop-openground-tables";
+
+/**
+ * Drops the OpenGround comparison-run tables that earlier deployments
+ * created via the now-removed `create-openground-migration`. OpenGround is
+ * gone from the product, so a fresh install must not recreate them and an
+ * existing install should not keep them around.
+ *
+ * `DROP TABLE IF EXISTS` keeps an install that never had them a no-op.
+ */
+export default async function DropOpengroundMigration(databaseConfigId?: string) {
+	const queries = [
+		`DROP TABLE IF EXISTS openlit_openground`,
+		`DROP TABLE IF EXISTS openlit_openground_providers`,
+	];
+
+	const { migrationExist, queriesRun } = await migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+
+	return { migrationExist, queriesRun };
+}
