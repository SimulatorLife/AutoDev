@@ -0,0 +1,70 @@
+/** @jest-environment node */
+
+import { NextRequest } from "next/server";
+
+const mockFetchVariableAllowedValues = jest.fn();
+const mockResolveTelemetrySourceDescriptor = jest.fn();
+const mockGetTelemetryAdapter = jest.fn();
+const mockRunWidgetQuery = jest.fn();
+
+jest.mock("@/lib/platform/dashboard-variables", () => ({
+  fetchVariableAllowedValues: (...args: unknown[]) =>
+    mockFetchVariableAllowedValues(...args)
+}));
+jest.mock("@/lib/telemetry-source", () => ({
+  resolveTelemetrySourceDescriptor: (...args: unknown[]) =>
+    mockResolveTelemetrySourceDescriptor(...args),
+  getTelemetryAdapter: (...args: unknown[]) => mockGetTelemetryAdapter(...args)
+}));
+jest.mock("@/lib/platform/manage-dashboard/widget", () => ({
+  runWidgetQuery: (...args: unknown[]) => mockRunWidgetQuery(...args)
+}));
+
+const previousUsageToken = process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+process.env.AUTODEV_OPENLIT_USAGE_TOKEN = "server-only-usage-test-token";
+const { POST } = require("@/app/api/autodev/usage/route") as {
+  POST: (request: NextRequest) => Promise<Response>;
+};
+
+afterAll(() => {
+  if (previousUsageToken === undefined) {
+    delete process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+  } else {
+    process.env.AUTODEV_OPENLIT_USAGE_TOKEN = previousUsageToken;
+  }
+});
+
+describe("AutoDev Usage endpoint filter lookup", () => {
+  beforeEach(() => {
+    mockFetchVariableAllowedValues.mockReset();
+    mockFetchVariableAllowedValues.mockResolvedValue({
+      supported: true,
+      values: []
+    });
+    mockResolveTelemetrySourceDescriptor.mockReset();
+    mockResolveTelemetrySourceDescriptor.mockResolvedValue({ id: "source-1" });
+    mockGetTelemetryAdapter.mockReset();
+    mockGetTelemetryAdapter.mockResolvedValue({});
+    mockRunWidgetQuery.mockReset();
+    mockRunWidgetQuery.mockResolvedValue({ data: [] });
+  });
+
+  it("fetches filter values across AutoDev logical and MCP spans", async () => {
+    const request = new NextRequest("http://localhost/api/autodev/usage", {
+      method: "POST",
+      headers: {
+        authorization: "Bearer server-only-usage-test-token",
+        "content-type": "application/json"
+      },
+      body: JSON.stringify({ selection: { range: "24H", values: {} } })
+    });
+
+    const response = await POST(request);
+
+    expect(response.status).toBe(200);
+    expect(mockFetchVariableAllowedValues).toHaveBeenCalledTimes(4);
+    for (const [requestOptions] of mockFetchVariableAllowedValues.mock.calls) {
+      expect(requestOptions.aiSelector).toBe(false);
+    }
+  });
+});
