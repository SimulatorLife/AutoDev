+import { _setActorResolverForTesting } from "@/lib/autodev/control-api";
+import { AutoDevMemoryAdapter } from "@/lib/platform/connectors/memory/autodev/adapter";
+import type { MemorySourceDescriptor } from "@/lib/platform/connectors/memory/types";
+
+const originalControlEnv = {
+	url: process.env.AUTODEV_CONTROL_API_URL,
+	token: process.env.AUTODEV_CONTROL_API_TOKEN
+};
+
+const descriptor: MemorySourceDescriptor = {
+	type: "autodev",
+	id: "memory:autodev",
+	name: "AutoDev Memory",
+	settings: { workspaceId: "workspace-a", repositoryId: "owner/repo" }
+};
+
+beforeEach(() => {
+	process.env.AUTODEV_CONTROL_API_URL = "http://127.0.0.1:4101";
+	process.env.AUTODEV_CONTROL_API_TOKEN = "server-only-token";
+	_setActorResolverForTesting(async () => "operator-a");
+});
+
+afterEach(() => {
+	_setActorResolverForTesting(null);
+	if (originalControlEnv.url === undefined)
+		delete process.env.AUTODEV_CONTROL_API_URL;
+	else process.env.AUTODEV_CONTROL_API_URL = originalControlEnv.url;
+	if (originalControlEnv.token === undefined)
+		delete process.env.AUTODEV_CONTROL_API_TOKEN;
+	else process.env.AUTODEV_CONTROL_API_TOKEN = originalControlEnv.token;
+	jest.restoreAllMocks();
+});
+
+test("AutoDev adapter reads scoped memory through the authenticated Control API", async () => {
+	const fetchSpy = jest.spyOn(global, "fetch").mockResolvedValue(
+		new Response(
+			JSON.stringify({
+				schema: "autodev-memory-records-v1",
+				items: [
+					{
+						id: "memory-a",
+						kind: "procedural",
+						claim: "Use the canonical validator.",
+						status: "active",
+						scope: {
+							kind: "repository",
+							workspaceId: "workspace-a",
+							repositoryId: "owner/repo"
+						},
+						provenance: {
+							experienceIds: ["experience-a"],
+							evidence: []
+						},
+						validity: { state: "verified" },
+						createdAt: "2026-10-01T00:00:00.000Z",
+						updatedAt: "2026-10-01T00:00:00.000Z"
+					}
+				],
+				total: 1,
+				limit: 20,
+				offset: 0
+			}),
+			{ status: 200, headers: { "content-type": "application/json" } }
+		)
+	);
+
+	const adapter = new AutoDevMemoryAdapter(descriptor);
+	const results = await adapter.search({
+		query: "canonical validator",
+		limit: 20
+	});
+	expect(results).toHaveLength(1);
+	expect(results[0]).toMatchObject({
+		id: "memory-a",
+		content: "Use the canonical validator.",
+		categories: ["procedural"],
+		lifecycleState: "active",
+		metadata: {
+			autodev: {
+				kind: "procedural",
+				status: "active",
+				scope: { kind: "repository", workspaceId: "workspace-a" }
+			}
+		}
+	});
+	expect(fetchSpy).toHaveBeenCalledTimes(1);
+	const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
+	const parsed = new URL(url);
+	expect(parsed.pathname).toBe("/control/memory/records");
+	expect(parsed.searchParams.get("workspaceId")).toBe("workspace-a");
+	expect(parsed.searchParams.get("repositoryId")).toBe("owner/repo");
+	expect(parsed.searchParams.get("query")).toBe("canonical validator");
+	expect(new Headers(init.headers).get("authorization")).toBe(
+		"Bearer server-only-token"
+	);
+	expect(new Headers(init.headers).get("x-autodev-actor")).toBe("operator-a");
+});
+
+test("AutoDev connector advertises no CRUD mutation capability", async () => {
+	const adapter = new AutoDevMemoryAdapter(descriptor);
+	await expect(adapter.add({ content: "claim" })).rejects.toMatchObject({
+		capability: "add"
+	});
+	await expect(
+		adapter.update("memory-a", { content: "revised" })
+	).rejects.toMatchObject({ capability: "update" });
+	await expect(adapter.delete("memory-a")).rejects.toMatchObject({
+		capability: "delete"
+	});
+});
+
+test("AutoDev connector lists source experiences only when task-history access is explicitly configured", async () => {
+	const fetchSpy = jest
+		.spyOn(global, "fetch")
+		.mockResolvedValueOnce(
+			Response.json({
+				items: [],
+				total: 0,
+				limit: 5,
+				offset: 0
+			})
+		)
+		.mockResolvedValueOnce(
+			Response.json({
+				items: [
+					{
+						id: "experience-a",
+						workspaceId: "workspace-a",
+						repositoryId: "owner/repo",
+						scope: {
+							kind: "task",
+							workspaceId: "workspace-a",
+							taskId: "task-a",
+							runId: "run-a"
+						},
+						taskId: "task-a",
+						runId: "run-a",
+						agentId: "agent-a",
+						agentRole: "orchestrator",
+						startedAt: "2026-10-01T00:00:00.000Z",
+						outcome: "success",
+						memoryMode: "retrieval-only",
+						trajectory: {
+							format: "letta-trajectory-v1",
+							uri: "codex://session/session-a"
+						},
+						evidence: [
+							{
+								kind: "trajectory",
+								uri: "codex://session/session-a"
+							}
+						]
+					}
+				],
+				total: 1,
+				limit: 5,
+				offset: 0
+			})
+		);
+	const adapter = new AutoDevMemoryAdapter({
+		...descriptor,
+		settings: {
+			...descriptor.settings,
+			includeTaskHistory: true,
+			memoryMode: "retrieval-only",
+			outcome: "success"
+		}
+	});
+
+	const result = await adapter.list({ limit: 5 });
+	expect(result).toHaveLength(1);
+	expect(result[0]).toMatchObject({
+		id: "experience:experience-a",
+		categories: ["episodic"],
+		lifecycleState: "historical",
+		metadata: {
+			autodev: {
+				kind: "episodic",
+				experience: {
+					taskId: "task-a",
+					runId: "run-a",
+					memoryMode: "retrieval-only"
+				}
+			}
+		}
+	});
+	const experienceRequest = fetchSpy.mock.calls[1]?.[0];
+	expect(String(experienceRequest)).toContain("/control/memory/experiences?");
+	expect(String(experienceRequest)).toContain("includeTaskHistory=true");
+	expect(String(experienceRequest)).toContain("memoryMode=retrieval-only");
+	expect(String(experienceRequest)).toContain("outcome=success");
+});
