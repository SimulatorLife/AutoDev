+
+## AutoDev Memory
+
+The `autodev` connector is a read-only adapter to the authenticated AutoDev
+Control API. Configure a workspace ID and, when needed, repository/role/task/run/agent
+scope on the connector. The Control API URL and service credential are resolved
+from OpenLIT's server environment; credentials are never stored in connector
+settings or sent to the browser. The adapter exposes list, exact-text search,
+get, and health-check only. Proposals and lifecycle transitions stay in
+AutoDev's operator Control API and MemoryService, and PostgreSQL remains the
+canonical store. Its optional task-history setting requests historical task/agent
+experience envelopes, but only succeeds for an operator actor when
+`AUTODEV_MEMORY_READ_TASK_HISTORY=1` is set in the AutoDev Control API process.
+The Control API still constrains those reads to the selected workspace and
+repository.
diff --git a/src/client/src/lib/platform/connectors/memory/autodev/adapter.ts b/src/client/src/lib/platform/connectors/memory/autodev/adapter.ts
new file mode 100644
index 00000000..156d7ebb
--- /dev/null
+++ b/src/client/src/lib/platform/connectors/memory/autodev/adapter.ts
@@ -0,0 +1,429 @@
+/**
+ * Read-only OpenLIT Memory connector over AutoDev's governed Control API.
+ * AutoDev PostgreSQL remains canonical; this adapter translates the typed
+ * AutoDev records into the retained OpenLIT Memory page's presentation model.
+ */
+
+import { forwardToControlApi } from "@/lib/autodev/control-api";
+import type { ConnectorHealthResult } from "../../types";
+import { BaseMemoryAdapter } from "../base-adapter";
+import type {
+	MemoryCapabilities,
+	MemoryListFilter,
+	MemoryRecord,
+	MemorySearchQuery,
+	MemorySourceDescriptor,
+	MemoryTypeDescriptor
+} from "../types";
+
+interface AutoDevMemoryRecord {
+	id: string;
+	kind: "episodic" | "semantic" | "procedural";
+	claim: string;
+	status: string;
+	scope: Record<string, unknown>;
+	provenance: Record<string, unknown>;
+	validity: Record<string, unknown>;
+	supersedes?: string[];
+	supersededBy?: string[];
+	createdAt: string;
+	updatedAt: string;
+}
+
+interface AutoDevMemoryPage {
+	items: AutoDevMemoryRecord[];
+	total: number;
+}
+
+interface AutoDevExperience {
+	id: string;
+	workspaceId: string;
+	repositoryId?: string;
+	scope: Record<string, unknown>;
+	taskId: string;
+	runId: string;
+	agentId: string;
+	agentRole?: string;
+	startedAt: string;
+	completedAt?: string;
+	outcome: string;
+	memoryMode?: "jit" | "retrieval-only" | "disabled" | "invalid" | "unknown";
+	trajectory: Record<string, unknown>;
+	evidence: unknown[];
+}
+
+interface AutoDevExperiencePage {
+	items: AutoDevExperience[];
+	total: number;
+}
+
+const READ_ONLY_CAPABILITIES: MemoryCapabilities = {
+	add: false,
+	search: true,
+	get: true,
+	list: true,
+	update: false,
+	delete: false,
+	feedback: false
+};
+const MAX_PAGE_SIZE = 100;
+const MEMORY_MODES = new Set(["jit", "retrieval-only", "disabled", "invalid", "unknown"]);
+const EXPERIENCE_OUTCOMES = new Set(["success", "partial", "failure", "cancelled", "unknown"]);
+
+class AutoDevMemoryApiError extends Error {
+	readonly status: number;
+
+	constructor(status: number) {
+		super(`AutoDev Memory Control API returned status ${status}.`);
+		this.name = "AutoDevMemoryApiError";
+		this.status = status;
+	}
+}
+
+function setting(descriptor: MemorySourceDescriptor, key: string): string {
+	const value = descriptor.settings[key];
+	return typeof value === "string" ? value.trim() : "";
+}
+
+function pageLimit(value: number | undefined): number {
+	return typeof value === "number" && Number.isFinite(value)
+		? Math.min(Math.max(Math.floor(value), 1), MAX_PAGE_SIZE)
+		: 50;
+}
+
+function autoDevMemory(value: unknown): AutoDevMemoryRecord | null {
+	if (!value || typeof value !== "object" || Array.isArray(value))
+		return null;
+	const record = value as Record<string, unknown>;
+	if (
+		typeof record.id !== "string" ||
+		typeof record.claim !== "string" ||
+		!record.scope ||
+		typeof record.scope !== "object" ||
+		!record.provenance ||
+		typeof record.provenance !== "object" ||
+		!record.validity ||
+		typeof record.validity !== "object" ||
+		typeof record.createdAt !== "string" ||
+		typeof record.updatedAt !== "string" ||
+		!(["episodic", "semantic", "procedural"] as unknown[]).includes(
+			record.kind
+		) ||
+		typeof record.status !== "string"
+	) {
+		return null;
+	}
+	return record as unknown as AutoDevMemoryRecord;
+}
+
+function autoDevExperience(value: unknown): AutoDevExperience | null {
+	if (!value || typeof value !== "object" || Array.isArray(value))
+		return null;
+	const record = value as Record<string, unknown>;
+	if (
+		typeof record.id !== "string" ||
+		typeof record.workspaceId !== "string" ||
+		typeof record.taskId !== "string" ||
+		typeof record.runId !== "string" ||
+		typeof record.agentId !== "string" ||
+		typeof record.startedAt !== "string" ||
+		typeof record.outcome !== "string" ||
+		!record.scope ||
+		typeof record.scope !== "object" ||
+		!record.trajectory ||
+		typeof record.trajectory !== "object" ||
+		!Array.isArray(record.evidence)
+	) {
+		return null;
+	}
+	return record as unknown as AutoDevExperience;
+}
+
+function presentExperience(experience: AutoDevExperience): MemoryRecord {
+	const role = experience.agentRole?.trim() || "agent";
+	return {
+		id: `experience:${experience.id}`,
+		content: `Captured ${role} trajectory (${experience.outcome}).`,
+		categories: ["episodic"],
+		metadata: {
+			autodev: {
+				kind: "episodic",
+				status: "historical",
+				experience
+			}
+		},
+		agentId: experience.agentId,
+		sessionId: experience.runId,
+		createdAt: experience.startedAt,
+		updatedAt: experience.completedAt || experience.startedAt,
+		lifecycleState: "historical"
+	};
+}
+
+function present(record: AutoDevMemoryRecord): MemoryRecord {
+	const autodev = {
+		kind: record.kind,
+		scope: record.scope,
+		status: record.status,
+		provenance: record.provenance,
+		validity: record.validity,
+		...(record.supersedes ? { supersedes: record.supersedes } : {}),
+		...(record.supersededBy ? { supersededBy: record.supersededBy } : {})
+	};
+	return {
+		id: record.id,
+		content: record.claim,
+		categories: [record.kind],
+		metadata: { autodev },
+		createdAt: record.createdAt,
+		updatedAt: record.updatedAt,
+		lifecycleState: record.status
+	};
+}
+
+export class AutoDevMemoryAdapter extends BaseMemoryAdapter {
+	readonly type = "autodev";
+	private readonly workspaceId: string;
+	private readonly repositoryId: string;
+	private readonly role: string;
+	private readonly taskId: string;
+	private readonly runId: string;
+	private readonly agentId: string;
+	private readonly includeTaskHistory: boolean;
+	private readonly memoryMode: string;
+	private readonly outcome: string;
+
+	constructor(descriptor: MemorySourceDescriptor) {
+		super(descriptor);
+		this.workspaceId = setting(descriptor, "workspaceId");
+		this.repositoryId = setting(descriptor, "repositoryId");
+		this.role = setting(descriptor, "role");
+		this.taskId = setting(descriptor, "taskId");
+		this.runId = setting(descriptor, "runId");
+		this.agentId = setting(descriptor, "agentId");
+		this.includeTaskHistory =
+			descriptor.settings.includeTaskHistory === true;
+		this.memoryMode = setting(descriptor, "memoryMode");
+		this.outcome = setting(descriptor, "outcome");
+		if (this.memoryMode && !MEMORY_MODES.has(this.memoryMode))
+			throw new Error("AutoDev memory mode filter is invalid.");
+		if (this.outcome && !EXPERIENCE_OUTCOMES.has(this.outcome))
+			throw new Error("AutoDev experience outcome filter is invalid.");
+	}
+
+	capabilities(): MemoryCapabilities {
+		return { ...READ_ONLY_CAPABILITIES };
+	}
+
+	async healthCheck(): Promise<ConnectorHealthResult> {
+		if (!this.workspaceId) {
+			return {
+				ok: false,
+				message: "Configure the AutoDev workspace ID."
+			};
+		}
+		try {
+			await this.list({ limit: 1 });
+			return { ok: true, message: "AutoDev Memory is available." };
+		} catch {
+			return {
+				ok: false,
+				message: "AutoDev Memory Control API is unavailable."
+			};
+		}
+	}
+
+	async list(filter: MemoryListFilter): Promise<MemoryRecord[]> {
+		return this.readRecords({ limit: pageLimit(filter.limit) });
+	}
+
+	async search(query: MemorySearchQuery): Promise<MemoryRecord[]> {
+		const text = query.query.trim();
+		if (!text) return this.list({ limit: query.limit });
+		return this.readRecords({ query: text, limit: pageLimit(query.limit) });
+	}
+
+	async get(id: string): Promise<MemoryRecord | null> {
+		if (id.startsWith("experience:")) {
+			const params = this.scopeParams(this.includeTaskHistory);
+			const experienceId = id.slice("experience:".length);
+			const result = await forwardToControlApi<{ experience?: unknown }>({
+				method: "GET",
+				path: `memory/experiences/${encodeURIComponent(experienceId)}?${params.toString()}`
+			});
+			if (!result.ok) {
+				if (result.status === 404) return null;
+				throw new AutoDevMemoryApiError(result.status);
+			}
+			const experience = autoDevExperience(result.body.experience);
+			return experience ? presentExperience(experience) : null;
+		}
+		const params = this.scopeParams();
+		const result = await forwardToControlApi<{
+			memory?: unknown;
+		}>({
+			method: "GET",
+			path: `memory/records/${encodeURIComponent(id)}?${params.toString()}`
+		});
+		if (!result.ok) {
+			if (result.status === 404) return null;
+			throw new AutoDevMemoryApiError(result.status);
+		}
+		const record = autoDevMemory(result.body.memory);
+		return record ? present(record) : null;
+	}
+
+	private scopeParams(includeTaskHistory = false): URLSearchParams {
+		if (!this.workspaceId)
+			throw new Error("AutoDev workspace ID is required.");
+		const params = new URLSearchParams({ workspaceId: this.workspaceId });
+		if (this.repositoryId) params.set("repositoryId", this.repositoryId);
+		if (this.role) params.set("role", this.role);
+		if (Boolean(this.taskId) !== Boolean(this.runId))
+			throw new Error("Configure both AutoDev task and run IDs.");
+		if (this.agentId && !this.taskId)
+			throw new Error("AutoDev agent scope requires task and run IDs.");
+		if (this.taskId && this.runId) {
+			params.set("taskId", this.taskId);
+			params.set("runId", this.runId);
+		}
+		if (this.agentId && this.taskId && this.runId)
+			params.set("agentId", this.agentId);
+		if (includeTaskHistory) params.set("includeTaskHistory", "true");
+		return params;
+	}
+
+	private async readRecords(options: {
+		query?: string;
+		limit: number;
+	}): Promise<MemoryRecord[]> {
+		const params = this.scopeParams();
+		params.set("limit", String(options.limit));
+		if (options.query) params.set("query", options.query);
+		const result = await forwardToControlApi<AutoDevMemoryPage>({
+			method: "GET",
+			path: `memory/records?${params.toString()}`
+		});
+		if (!result.ok) throw new AutoDevMemoryApiError(result.status);
+		if (!Array.isArray(result.body.items))
+			throw new Error("AutoDev Memory response is malformed.");
+		const memories = result.body.items.flatMap((item) => {
+			const record = autoDevMemory(item);
+			return record ? [present(record)] : [];
+		});
+		if (!this.includeTaskHistory) return memories;
+
+		const experienceParams = this.scopeParams(true);
+		experienceParams.set("limit", String(options.limit));
+		if (options.query) experienceParams.set("query", options.query);
+		if (this.memoryMode) experienceParams.set("memoryMode", this.memoryMode);
+		if (this.outcome) experienceParams.set("outcome", this.outcome);
+		const experienceResult =
+			await forwardToControlApi<AutoDevExperiencePage>({
+				method: "GET",
+				path: `memory/experiences?${experienceParams.toString()}`
+			});
+		if (!experienceResult.ok)
+			throw new AutoDevMemoryApiError(experienceResult.status);
+		if (!Array.isArray(experienceResult.body.items))
+			throw new Error("AutoDev experience response is malformed.");
+		const experiences = experienceResult.body.items.flatMap((item) => {
+			const experience = autoDevExperience(item);
+			return experience ? [presentExperience(experience)] : [];
+		});
+		return [...memories, ...experiences]
+			.sort((left, right) =>
+				String(right.createdAt ?? "").localeCompare(
+					String(left.createdAt ?? "")
+				)
+			)
+			.slice(0, options.limit);
+	}
+}
