diff --git a/src/client/src/__tests__/platform/dead-client-modules.test.ts b/src/client/src/__tests__/platform/dead-client-modules.test.ts
new file mode 100644
index 00000000..82baa961
--- /dev/null
+++ b/src/client/src/__tests__/platform/dead-client-modules.test.ts
@@ -0,0 +1,50 @@
+import fs from "fs";
+import path from "path";
+
+describe("dead client modules stay removed", () => {
+	const clientRoot = path.resolve(__dirname, "../../..");
+
+	// These modules lost their last importer when the AutoDev product
+	// subtraction removed the surfaces that used them. They are listed here
+	// so a later patch that reintroduces one has to say so deliberately
+	// rather than leaving an unused module behind.
+	const removedModules = [
+		"src/components/common/code-block.tsx",
+		"src/components/ui/alert.tsx",
+		"src/components/ui/alert-dialog.tsx",
+		"src/lib/autodev/index.ts",
+		"src/utils/hooks/use-database-setup.ts",
+	];
+
+	it("removes the modules nothing imports", () => {
+		for (const relative of removedModules) {
+			expect(fs.existsSync(path.join(clientRoot, relative))).toBe(false);
+		}
+	});
+
+	it("drops the dependency the removed alert dialog owned", () => {
+		const packageJson = JSON.parse(
+			fs.readFileSync(path.join(clientRoot, "package.json"), "utf-8")
+		);
+		expect(packageJson.dependencies).not.toHaveProperty(
+			"@radix-ui/react-alert-dialog"
+		);
+	});
+
+	it("keeps the lockfile free of packages the manifest no longer declares", () => {
+		// npm ci refuses a tree whose manifest and lock disagree, so a
+		// dependency dropped from one and left in the other breaks the
+		// image build rather than merely tidying it.
+		const packageJson = JSON.parse(
+			fs.readFileSync(path.join(clientRoot, "package.json"), "utf-8")
+		);
+		const lock = JSON.parse(
+			fs.readFileSync(path.join(clientRoot, "package-lock.json"), "utf-8")
+		);
+		const locked = Object.keys(lock.packages[""].dependencies || {});
+		const declared = Object.keys(packageJson.dependencies || {});
+		for (const name of locked) {
+			expect(declared).toContain(name);
+		}
+	});
+});
