 		]);
 	});
 
+	it("counts provider hops from the hop attributes the router publishes", () => {
+		// A hop is a fact about one request: the request moved the agent from
+		// one provider to another. The router publishes it on the request's own
+		// span, so the count and the breakdowns read the same source as the
+		// request they belong to.
+		const hops = widgets.find((candidate) => candidate.title === "Provider hops");
+		expect(hops).toBeDefined();
+		expect(hops?.type).toBe("STAT_CARD");
+		expect(hops?.properties).toMatchObject({
+			value: "0.hops",
+			optInVariables: ["workspace", "agent"],
+		});
+		expect(hops?.config.structuredQuery?.query?.filters).toEqual([
+			{
+				target: "attribute",
+				scope: "resource",
+				key: "service.name",
+				op: "eq",
+				value: "autodev-router",
+			},
+			{ target: "spanName", op: "eq", value: "autodev.routed_request" },
+			{
+				target: "attribute",
+				scope: "span",
+				key: "autodev.hop.reason",
+				op: "exists",
+			},
+		]);
+		expect(hops?.config.structuredQuery?.query?.aggregations).toEqual([
+			{ fn: "count", as: "hops" },
+		]);
+		// The logical request span never carries one provider for a route that
+		// may touch several, so the standard provider variable cannot describe
+		// a hop. The hop names its own two providers instead.
+		expect(hops?.properties.optInVariables).not.toContain("provider");
+		expect(hops?.properties.optInVariables).not.toContain("model");
+		expect(hops?.properties.optInVariables).not.toContain("skill");
+	});
+
+	it("breaks provider hops down by the pair, the provider and the reason", () => {
+		const hops = widgets.find((candidate) => candidate.title === "Provider hops");
+		for (const [title, dimension] of [
+			["Provider hops by route", "autodev.hop.route"],
+			["Provider hops by provider", "autodev.hop.to"],
+			["Provider hops by agent role", "autodev.agent.role"],
+			["Provider hops by workspace", "autodev.workspace"],
+			["Provider hops by reason", "autodev.hop.reason"],
+		] as const) {
+			const widget = widgets.find((candidate) => candidate.title === title);
+			const query = widget?.config.structuredQuery?.query;
+			expect(widget?.type).toBe("BAR_CHART");
+			expect(widget?.properties).toMatchObject({
+				xAxis: "g0",
+				yAxis: "hops",
+				resultLimit: 20,
+				optInVariables: ["workspace", "agent"],
+			});
+			expect(query?.filters).toEqual(
+				hops?.config.structuredQuery?.query?.filters,
+			);
+			expect(query?.groupBy).toEqual([dimension]);
+			expect(query?.limit).toBe(20);
+			expect(query?.aggregations).toEqual([{ fn: "count", as: "hops" }]);
+		}
+	});
+
+	it("counts provider hops over time from the same request scope", () => {
+		const hops = widgets.find((candidate) => candidate.title === "Provider hops");
+		const timeSeries = widgets.find(
+			(candidate) => candidate.title === "Provider hops over time",
+		);
+		expect(timeSeries?.type).toBe("LINE_CHART");
+		expect(timeSeries?.properties).toMatchObject({
+			xAxis: "label",
+			yAxis: "count",
+			optInVariables: ["workspace", "agent"],
+		});
+		expect(timeSeries?.config.structuredQuery?.mode).toBe("timeseries");
+		expect(timeSeries?.config.structuredQuery?.query?.filters).toEqual(
+			hops?.config.structuredQuery?.query?.filters,
+		);
+	});
+
 	it("groups skill observations by event and filters by bounded skill name", () => {
 		const widget = widgets.find((candidate) => candidate.title === "Skill events by event");
 		expect(widget).toBeDefined();
