+"use client";
+
+import { useMemo, useState, type FormEvent } from "react";
+import { Button } from "@/components/ui/button";
+import getMessage from "@/constants/messages";
+import { getRequestHeaders } from "@/utils/api";
+
+const USE_KINDS = ["unobservable", "used", "partially_used", "not_used"] as const;
+type UseKind = (typeof USE_KINDS)[number];
+const EMPTY_KIND = "" as const;
+type FormKind = UseKind | typeof EMPTY_KIND;
+
+function formatUseKindLabel(
+	messages: {
+		MEMORY_USE_KIND_USED: string;
+		MEMORY_USE_KIND_PARTIALLY_USED: string;
+		MEMORY_USE_KIND_NOT_USED: string;
+		MEMORY_USE_KIND_UNOBSERVABLE: string;
+	},
+	kind: string
+): string {
+	switch (kind) {
+		case "used":
+			return messages.MEMORY_USE_KIND_USED;
+		case "partially_used":
+			return messages.MEMORY_USE_KIND_PARTIALLY_USED;
+		case "not_used":
+			return messages.MEMORY_USE_KIND_NOT_USED;
+		case "unobservable":
+			return messages.MEMORY_USE_KIND_UNOBSERVABLE;
+		default:
+			// Fall back to the bounded kind string so a malformed server value
+			// still surfaces rather than going silent; localized labels for
+			// the four canonical kinds always win when they are present.
+			return kind.replaceAll("_", " ");
+	}
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+export interface MemoryInjectionUseReportSummary {
+	useKind: string;
+	usedMemoryIds: string[];
+	reportedAt: string;
+	evidence: { kind: string; uri: string }[];
+}
+
+/**
+ * Curator assessment of whether a concrete injected packet was actually
+ * used, independent of task/PR/issue success. The form never lets an
+ * operator type free-text evidence: the only admissible evidence is the
+ * exact trajectory already captured for this experience (matching the
+ * server-side invariant), so it is derived from `trajectoryUri` and
+ * attached automatically. When that trajectory reference is unavailable,
+ * every kind except "unobservable" is disabled with an explicit reason
+ * instead of inventing or accepting a substitute reference. The browser
+ * sends only the event id, chosen use kind, the (forced) used-memory-id
+ * subset, and that one evidence reference; the opaque correlation token,
+ * reporter identity, and authority are resolved only server-side.
+ */
+export default function MemoryInjectionUseReportForm({
+	connectorId,
+	experienceId,
+	injectionEventId,
+	memoryIds,
+	trajectoryUri,
+	onReported
+}: {
+	connectorId: string;
+	experienceId: string;
+	injectionEventId: string;
+	memoryIds: readonly string[];
+	trajectoryUri: string | undefined;
+	onReported: (use: MemoryInjectionUseReportSummary) => void;
+}) {
+	const messages = getMessage();
+	const [useKind, setUseKind] = useState<FormKind>(EMPTY_KIND);
+	const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+
+	const canAssessWithEvidence = typeof trajectoryUri === "string" && trajectoryUri.trim().length > 0;
+	// "Partially used" requires a strict non-empty subset, which is only
+	// possible when the packet carries at least two memory ids.
+	const partiallyUsedAvailable = memoryIds.length >= 2;
+
+	const usedMemoryIds = useMemo(() => {
+		if (useKind === "used") return [...memoryIds];
+		if (useKind === "partially_used") return memoryIds.filter((id) => selectedIds.has(id));
+		return [];
+	}, [useKind, memoryIds, selectedIds]);
+
+	function toggleSelected(id: string) {
+		setSelectedIds((current) => {
+			const next = new Set(current);
+			if (next.has(id)) next.delete(id);
+			else next.add(id);
+			return next;
+		});
+	}
+
+	async function submit(event: FormEvent<HTMLFormElement>) {
+		event.preventDefault();
+		if (saving) return;
+		if (!useKind) {
+			setError(messages.MEMORY_USE_KIND_PLACEHOLDER);
+			return;
+		}
+		if (useKind !== "unobservable" && !canAssessWithEvidence) {
+			setError(messages.MEMORY_INJECTION_USE_REPORT_EVIDENCE_MISSING);
+			return;
+		}
+		if (
+			useKind === "partially_used" &&
+			(usedMemoryIds.length === 0 || usedMemoryIds.length >= memoryIds.length)
+		) {
+			setError(messages.MEMORY_INJECTION_USE_REPORT_PARTIAL_INVALID);
+			return;
+		}
