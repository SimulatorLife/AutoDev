+		const onReported = jest.fn();
+		render(
+			<MemoryInjectionUseReportForm
+				connectorId="memory:autodev-a"
+				experienceId="experience-a"
+				injectionEventId="injection-event-a"
+				memoryIds={["memory-a", "memory-b"]}
+				trajectoryUri="codex://session/task-a"
+				onReported={onReported}
+			/>
