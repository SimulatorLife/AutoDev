+			) {
+				throw new Error(messages.MEMORY_INJECTION_USE_REPORT_FAILED);
+			}
+			const use: MemoryInjectionUseReportSummary = {
+				useKind: body.use.useKind,
+				usedMemoryIds: body.use.usedMemoryIds as string[],
+				reportedAt: body.use.reportedAt,
+				evidence: body.use.evidence.map((reference) => ({
+					kind: (reference as Record<string, string>).kind,
+					uri: (reference as Record<string, string>).uri
+				}))
+			};
+			onReported(use);
+		} catch (caught) {
+			setError(
+				caught instanceof Error
+					? caught.message
+					: messages.MEMORY_INJECTION_USE_REPORT_FAILED
+			);
+		} finally {
+			setSaving(false);
+		}
+	}
+
+	return (
+		<details className="rounded-md border border-stone-200 p-3 dark:border-stone-800">
+			<summary className="cursor-pointer text-xs font-medium text-stone-700 dark:text-stone-200">
+				{messages.MEMORY_INJECTION_USE_REPORT_BUTTON}
+			</summary>
+			<form onSubmit={submit} className="mt-3 space-y-3">
+				<p className="text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_INJECTION_USE_REPORT_NOTE}
+				</p>
