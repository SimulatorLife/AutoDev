+		).toBe(true);
+		fireEvent.change(screen.getByLabelText("Use category"), { target: { value: "used" } });
+		// Without a trajectory reference, used is still disabled in the option list;
+		// the operator sees the explicit "No trajectory reference" message.
+		expect(
+			await screen.findByText(/No trajectory reference is available/i)
+		).toBeInTheDocument();
+		// Pick unobservable — this is allowed and forced to be explicit by the empty
+		// default. Submit fires with no ids and no evidence.
