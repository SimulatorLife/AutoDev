+/**
+ * Focused unit tests for the per-injection use-assessment API route.
+ *
+ * Validates the JSON parsing 400 contract, ID-pattern validation, malformed
+ * payload 400 contract, and successful path via the AutoDev adapter.
+ */
+import assert from "node:assert/strict";
+
+(globalThis as unknown as { Response: { json: unknown } }).Response = {
+	json: (body: unknown, init?: ResponseInit) => ({
+		status: init?.status ?? 200,
+		json: async () => body,
+	}),
+};
+
+jest.mock("@/lib/platform/connectors/memory/crud", () => ({
+	memoryConnectorId: (id: string) => (id.startsWith("memory:") ? id : `memory:${id}`),
+	isMemoryConnectorId: (id: unknown) => typeof id === "string" && id.startsWith("memory:"),
+	listMemoryConnectors: jest.fn(),
+	getMemoryRuntime: jest.fn(),
+}));
+jest.mock("@/lib/platform/connectors/memory/autodev/adapter", () => ({
+	isAutoDevMemoryAdapter: (adapter: unknown) =>
+		!!adapter && typeof adapter === "object" && (adapter as { __autodev?: boolean }).__autodev === true,
+}));
+
+import { POST } from "@/app/api/memory/experiences/[id]/use-assessments/route";
+import { getMemoryRuntime, listMemoryConnectors } from "@/lib/platform/connectors/memory/crud";
+import { MEMORY_INJECTION_USE_REPORT_INVALID } from "@/constants/messages/en";
+
+function request(body: unknown) {
+	return { json: async () => body } as any;
+}
+
+const connector = { id: "memory:autodev-a", type: "autodev", name: "AutoDev Memory" };
+
+describe("POST /api/memory/experiences/[id]/use-assessments", () => {
+	beforeEach(() => {
+		jest.clearAllMocks();
+		(listMemoryConnectors as jest.Mock).mockResolvedValue([connector]);
+	});
+
+	it("returns 400 for malformed JSON without calling the adapter", async () => {
+		const reportInjectionUse = jest.fn();
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, reportInjectionUse },
+			connector,
+		});
+		const response = await POST(request({ /* not a body */ throw: true }), {
+			params: { id: "experience-a" }
+		});
+		assert.equal(response.status, 400);
+		assert.equal(reportInjectionUse.mock.calls.length, 0);
+	});
+
+	it("returns 400 when the experience id fails the ID-pattern check", async () => {
+		const reportInjectionUse = jest.fn();
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, reportInjectionUse },
+			connector,
+		});
+		const response = await POST(
+			request({
+				injectionEventId: "injection-event-a",
+				useKind: "used",
+				usedMemoryIds: ["memory-a"],
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}),
+			{ params: { id: "bad id with spaces" } }
+		);
+		assert.equal(response.status, 400);
+		assert.equal(await response.json(), MEMORY_INJECTION_USE_REPORT_INVALID);
+		assert.equal(reportInjectionUse.mock.calls.length, 0);
+	});
+
+	it("returns 400 when usedMemoryIds include duplicates", async () => {
+		const reportInjectionUse = jest.fn();
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, reportInjectionUse },
+			connector,
+		});
+		const response = await POST(
+			request({
+				injectionEventId: "injection-event-a",
+				useKind: "used",
+				usedMemoryIds: ["memory-a", "memory-a"],
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}),
+			{ params: { id: "experience-a" } }
+		);
+		assert.equal(response.status, 400);
+		assert.equal(await response.json(), MEMORY_INJECTION_USE_REPORT_INVALID);
+		assert.equal(reportInjectionUse.mock.calls.length, 0);
+	});
+
+	it("returns 400 when unobservable carries evidence (server invariant mirror)", async () => {
+		const reportInjectionUse = jest.fn();
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, reportInjectionUse },
+			connector,
+		});
+		const response = await POST(
+			request({
+				injectionEventId: "injection-event-a",
+				useKind: "unobservable",
+				usedMemoryIds: [],
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}),
+			{ params: { id: "experience-a" } }
+		);
+		assert.equal(response.status, 400);
+		assert.equal(await response.json(), MEMORY_INJECTION_USE_REPORT_INVALID);
+		assert.equal(reportInjectionUse.mock.calls.length, 0);
+	});
+
+	it("forwards a valid used assessment and returns the sanitized projection", async () => {
+		const reportInjectionUse = jest.fn().mockResolvedValue({
+			appended: true,
+			use: {
+				useKind: "used",
+				usedMemoryIds: ["memory-a"],
+				reportedAt: "2026-10-01T00:05:00.000Z",
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}
+		});
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, reportInjectionUse },
+			connector,
+		});
+		const response = await POST(
+			request({
+				injectionEventId: "injection-event-a",
+				useKind: "used",
+				usedMemoryIds: ["memory-a"],
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}),
+			{ params: { id: "experience-a" } }
+		);
+		assert.equal(response.status, 200);
+		const body = await response.json();
+		assert.equal(body.schema, "autodev-memory-injection-use-report-ui-v1");
+		assert.equal(body.appended, true);
+		assert.equal(body.use.useKind, "used");
+	});
+
+	it("rejects non-AutoDev connectors with 400 and never touches the report pipeline", async () => {
+		const claude = { id: "memory:claude-a", type: "claude", name: "Claude" };
+		(listMemoryConnectors as jest.Mock).mockResolvedValue([claude]);
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: false },
+			connector: claude,
+		});
+		const response = await POST(
+			request({
+				connectorId: claude.id,
+				injectionEventId: "injection-event-a",
+				useKind: "used",
+				usedMemoryIds: ["memory-a"],
+				evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+			}),
+			{ params: { id: "experience-a" } }
+		);
+		assert.equal(response.status, 400);
+	});
+});
