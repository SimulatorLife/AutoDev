 }
 
+interface MemoryUseCohortCell {
+	memoryMode: string;
+	sessionCardinality: "single" | "multiple";
+	useKind: string | null;
+	exposureCount: number;
+}
+
+interface MemoryUseCohortPage {
+	occurredFrom: string;
+	occurredUntil: string;
+	cells: MemoryUseCohortCell[];
+	exposureCount: number;
+}
