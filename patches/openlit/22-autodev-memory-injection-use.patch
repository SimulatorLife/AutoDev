index 00000000..5fc46248
--- /dev/null
+++ b/src/client/src/app/api/memory/use-cohorts/route.ts
@@ -0,0 +1,140 @@
+import { NextRequest } from "next/server";
+import { errorResponse } from "@/utils/api-response";
+import { withMemoryAccess } from "@/lib/access/memory-route";
+import {
+	getMemoryRuntime,
+	isMemoryConnectorId,
+	listMemoryConnectors,
+	memoryConnectorId
+} from "@/lib/platform/connectors/memory/crud";
+import {
+	isAutoDevMemoryAdapter,
+	type AutoDevUseCohortFilter
+} from "@/lib/platform/connectors/memory/autodev/adapter";
+import {
+	MEMORY_CONNECTOR_NOT_FOUND,
+	MEMORY_USE_COHORTS_LOAD_FAILED,
+	MEMORY_USE_COHORTS_UNSUPPORTED_CONNECTOR,
+	MEMORY_INVALID_FILTER
+} from "@/constants/messages/en";
+
+const FILTER_MAX = 64;
+const FILTER_VALUES_MAX = 10;
+// Mirrors MEMORY_USE_COHORT_ASSIGNED_MODES in @simulatorlife/autodev-core: the
+// filter accepts every assigned mode a session can carry, even though only
+// jit/retrieval-only sessions ever contain an eligible (injected,
+// non-empty-packet) exposure. Selecting "disabled" is valid and simply
+// yields an empty cohort; it is not rejected as an invalid filter.
+const MEMORY_MODE_VALUES = ["jit", "retrieval-only", "disabled"];
+const USE_KIND_VALUES = ["used", "partially_used", "not_used", "unobservable"];
+const ALLOWED_QUERY_KEYS = new Set([
+	"connectorId",
+	"occurredFrom",
+	"occurredUntil",
+	"memoryMode",
+	"useKind"
+]);
+// Mirrors MEMORY_OUTCOME_COHORT_MAX_WINDOW_MS in @simulatorlife/autodev-core; the
+// adapter and the Control API both re-validate this, but checking here
+// gives a clear 400 before any Control API round trip.
+const MAX_COHORT_WINDOW_MS = 365 * 24 * 60 * 60 * 1000;
+
+function parseConnectorId(value: string | null): string | undefined {
+	if (value == null) return undefined;
+	const trimmed = value.trim();
+	if (!trimmed) return undefined;
+	if (trimmed.length > 120 || /[\u0000-\u001f]/.test(trimmed)) {
+		throw new Error(MEMORY_INVALID_FILTER);
+	}
+	const id = memoryConnectorId(trimmed);
+	if (!isMemoryConnectorId(id)) throw new Error(MEMORY_CONNECTOR_NOT_FOUND);
+	return id;
+}
+
+function parseTimestamp(value: string | null, label: string): string {
+	const trimmed = String(value || "").trim();
+	if (!trimmed || !Number.isFinite(Date.parse(trimmed))) {
+		throw new Error(label + " must be a valid ISO 8601 timestamp.");
+	}
+	return trimmed;
+}
+
+function parseEnumValues(values: string[], allowed: string[], label: string): string[] | undefined {
+	if (!values.length) return undefined;
+	if (values.length > FILTER_VALUES_MAX) throw new Error(MEMORY_INVALID_FILTER);
+	const trimmed = values.map((value) => value.trim());
+	if (trimmed.some((value) => !value || value.length > FILTER_MAX || !allowed.includes(value))) {
+		throw new Error(label + " filter is invalid.");
+	}
+	return trimmed;
+}
+
+function parseFilter(params: URLSearchParams): AutoDevUseCohortFilter {
+	let hasUnexpectedKey = false;
+	params.forEach((_value, key) => {
+		if (!ALLOWED_QUERY_KEYS.has(key)) hasUnexpectedKey = true;
+	});
+	if (hasUnexpectedKey) throw new Error(MEMORY_INVALID_FILTER);
+	const occurredFrom = parseTimestamp(params.get("occurredFrom"), "occurredFrom");
+	const occurredUntil = parseTimestamp(params.get("occurredUntil"), "occurredUntil");
+	const fromMs = Date.parse(occurredFrom);
+	const untilMs = Date.parse(occurredUntil);
+	if (untilMs < fromMs) throw new Error("occurredUntil must be on or after occurredFrom.");
+	if (untilMs - fromMs > MAX_COHORT_WINDOW_MS) {
+		throw new Error("The occurred window cannot exceed 365 days.");
+	}
+	return {
+		occurredFrom,
+		occurredUntil,
+		memoryModes: parseEnumValues(params.getAll("memoryMode"), MEMORY_MODE_VALUES, "memoryMode"),
+		useKinds: parseEnumValues(params.getAll("useKind"), USE_KIND_VALUES, "useKind")
+	};
+}
+
+async function resolveAutoDevConnectorId(requested: string | undefined): Promise<string> {
+	const connectors = await listMemoryConnectors();
+	if (requested) {
+		const match = connectors.find((connector) => connector.id === requested);
+		if (!match) throw new Error(MEMORY_CONNECTOR_NOT_FOUND);
+		return match.id;
+	}
+	const autoDevConnector = connectors.find((connector) => connector.type === "autodev");
+	if (!autoDevConnector) throw new Error(MEMORY_CONNECTOR_NOT_FOUND);
+	return autoDevConnector.id;
+}
+
+function statusFor(message: string): number {
+	if (message === MEMORY_CONNECTOR_NOT_FOUND) return 404;
+	return 400;
+}
+
+async function GETHandler(request: NextRequest) {
+	const params = request.nextUrl.searchParams;
+	let connectorId: string | undefined;
+	let filter: AutoDevUseCohortFilter;
+	try {
+		connectorId = parseConnectorId(params.get("connectorId"));
+		filter = parseFilter(params);
+	} catch (error) {
+		return errorResponse(error, MEMORY_INVALID_FILTER, 400);
+	}
+
+	try {
+		const resolvedConnectorId = await resolveAutoDevConnectorId(connectorId);
+		const runtime = await getMemoryRuntime(resolvedConnectorId);
+		if (!isAutoDevMemoryAdapter(runtime.adapter)) {
+			return errorResponse(
+				MEMORY_USE_COHORTS_UNSUPPORTED_CONNECTOR,
+				MEMORY_USE_COHORTS_UNSUPPORTED_CONNECTOR,
+				400
+			);
+		}
+		const result = await runtime.adapter.readInjectionUseCohorts(filter);
+		return Response.json({ connector: runtime.connector, result });
+	} catch (error) {
+		const message = error instanceof Error ? error.message : String(error);
+		return errorResponse(error, MEMORY_USE_COHORTS_LOAD_FAILED, statusFor(message));
+	}
+}
+
+export const GET = withMemoryAccess("read", GETHandler);
