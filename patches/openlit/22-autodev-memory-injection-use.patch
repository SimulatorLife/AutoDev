+		fireEvent.click(screen.getByText("Report injection use"));
+		fireEvent.change(screen.getByLabelText("Use category"), { target: { value: "used" } });
+		fireEvent.click(screen.getByRole("button", { name: "Append use assessment" }));
+
+		await waitFor(() => expect(onReported).toHaveBeenCalledTimes(1));
+		const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
+		expect(url).toContain("/api/memory/experiences/experience-a/use-assessments");
+		const body = JSON.parse(String(init.body)) as Record<string, unknown>;
+		expect(body).toMatchObject({
+			connectorId: "memory:autodev-a",
+			injectionEventId: "injection-event-a",
+			useKind: "used",
+			usedMemoryIds: ["memory-a", "memory-b"],
+			evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+		});
+		expect(body).not.toHaveProperty("correlationToken");
+		expect(body).not.toHaveProperty("reporterId");
+		expect(onReported).toHaveBeenCalledWith({
+			useKind: "used",
+			usedMemoryIds: ["memory-a", "memory-b"],
+			reportedAt: "2026-10-01T00:05:00.000Z",
+			evidence: [{ kind: "trajectory", uri: "codex://session/task-a" }]
+		});
+	});
+
+	it("submits unobservable without ids or evidence", async () => {
+		const fetchSpy = jest.fn().mockResolvedValue(response({
+			schema: "autodev-memory-injection-use-report-ui-v1",
+			appended: true,
+			use: {
+				useKind: "unobservable",
+				usedMemoryIds: [],
+				reportedAt: "2026-10-01T00:05:00.000Z",
+				evidence: []
+			}
+		}));
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		render(
+			<MemoryInjectionUseReportForm
+				connectorId="memory:autodev-a"
+				experienceId="experience-a"
+				injectionEventId="injection-event-a"
+				memoryIds={["memory-a"]}
+				trajectoryUri="codex://session/task-a"
+				onReported={jest.fn()}
+			/>
+		);
+		fireEvent.click(screen.getByText("Report injection use"));
+		// Default is empty; the operator must explicitly choose unobservable.
+		fireEvent.change(screen.getByLabelText("Use category"), { target: { value: "unobservable" } });
+		fireEvent.click(screen.getByRole("button", { name: "Append use assessment" }));
+		await waitFor(() => expect(fetchSpy).toHaveBeenCalledTimes(1));
+		const [, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
+		const body = JSON.parse(String(init.body)) as Record<string, unknown>;
+		expect(body.useKind).toBe("unobservable");
+		expect(body.usedMemoryIds).toEqual([]);
+		expect(body.evidence).toEqual([]);
+	});
+});
