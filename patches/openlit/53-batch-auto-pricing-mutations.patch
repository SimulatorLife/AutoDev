+/**
+ * Persist a bounded set of computed costs in one ClickHouse mutation.
+ *
+ * MergeTree mutations rewrite immutable parts. The auto-pricing backfill must
+ * therefore avoid one ALTER UPDATE per span and limit each mutation to the
+ * affected time partitions.
+ */
+async function writeCostsToTraces(
+	updates: readonly TraceCostUpdate[],
+	databaseConfigId: string
+): Promise<{ err?: string }> {
+	if (updates.length === 0) return {};
+
+	const sanitized = updates.map(({ spanId, timestamp, cost }) => {
+		const date = timestamp.slice(0, 10);
+		if (!/^\d{4}-\d{2}-\d{2}$/u.test(date)) {
+			throw new Error("Trace timestamp did not contain a valid partition date");
+		}
+		return {
+			spanId: Sanitizer.sanitizeValue(spanId),
+			date,
+			cost: cost.toFixed(10),
+		};
+	});
+	const spanIds = sanitized.map(({ spanId }) => `'${spanId}'`).join(", ");
+	const costs = sanitized.map(({ cost }) => `'${cost}'`).join(", ");
+	const dates = Array.from(new Set(sanitized.map(({ date }) => date)))
+		.map((date) => `toDate('${date}')`)
+		.join(", ");
+	const query = `
+		ALTER TABLE ${OTEL_TRACES_TABLE_NAME}
+		UPDATE SpanAttributes = mapUpdate(
+			SpanAttributes,
