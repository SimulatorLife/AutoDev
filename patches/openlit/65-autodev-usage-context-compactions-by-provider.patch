+	it("groups compactions by the provider that served them, not by the route's provider", () => {
+		// A logical route may touch several providers, so the logical-request
+		// span never carries gen_ai.provider.name. A compaction is different: it
+		// is served by exactly one provider, and the router publishes that
+		// provider on the compaction's own span. Grouping by the standard
+		// attribute would read an attribute the span does not have, and would
+		// read it as "the route's provider" if it ever did.
+		const widget = widgets.find(
+			(candidate) => candidate.title === "Context compactions by provider",
+		);
+		expect(widget).toBeDefined();
+		expect(widget?.config.structuredQuery?.query?.groupBy).toEqual([
+			"autodev.compaction.provider",
+		]);
+		expect(widget?.properties.optInVariables).toEqual([
+			"workspace",
+			"model",
+			"agent",
+		]);
+	});
+
