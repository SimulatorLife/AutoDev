@@ -586,4 +586,60 @@ describe("AutoDev Usage dashboard seed", () => {
 		]);
 	});
 
+	it("groups logical requests by requested model and physical attempts by served model without fallback", () => {
+		const requestsByModel = widgets.find(
+			(candidate) => candidate.title === "Logical requests by requested model",
+		);
+		expect(requestsByModel?.type).toBe("BAR_CHART");
+		expect(requestsByModel?.properties).toMatchObject({
+			xAxis: "g0",
+			yAxis: "requests",
+			resultLimit: 20,
+			optInVariables: ["workspace", "model", "agent"],
+		});
+		expect(requestsByModel?.config.structuredQuery?.query).toMatchObject({
+			filters: [
+				{
+					target: "attribute",
+					scope: "resource",
+					key: "service.name",
+					op: "eq",
+					value: "autodev-router",
+				},
+				{ target: "spanName", op: "eq", value: "autodev.routed_request" },
+				{ target: "attribute", scope: "span", key: "autodev.requested_model", op: "exists" },
+			],
+			groupBy: ["autodev.requested_model"],
+			aggregations: [{ fn: "count", as: "requests" }],
+			limit: 20,
+		});
+
+		const attemptsByModel = widgets.find(
+			(candidate) => candidate.title === "Physical attempts by served model",
+		);
+		expect(attemptsByModel?.type).toBe("BAR_CHART");
+		expect(attemptsByModel?.properties).toMatchObject({
+			xAxis: "g0",
+			yAxis: "attempts",
+			resultLimit: 20,
+			optInVariables: ["workspace", "provider", "model", "agent"],
+		});
+		expect(attemptsByModel?.config.structuredQuery?.query).toMatchObject({
+			filters: [
+				{
+					target: "attribute",
+					scope: "resource",
+					key: "service.name",
+					op: "eq",
+					value: "autodev-router",
+				},
+				{ target: "spanName", op: "eq", value: "gen_ai.client_operation" },
+				{ target: "attribute", scope: "span", key: "gen_ai.response.model", op: "exists" },
+			],
+			groupBy: ["gen_ai.response.model"],
+			aggregations: [{ fn: "count", as: "attempts" }],
+			limit: 20,
+		});
+	});
+
 });
