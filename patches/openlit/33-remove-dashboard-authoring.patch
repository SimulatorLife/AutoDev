-function relativeLast24h() {
-	const end = new Date();
-	const start = new Date(end.getTime() - 24 * 60 * 60 * 1000);
-	return {
-		start: start.toISOString(),
-		end: end.toISOString(),
-		type: "relative" as const,
-	};
-}
