+++ b/src/client/src/__tests__/platform/provider-model-administration.test.ts
@@ -0,0 +1,73 @@
+import fs from "fs";
+import path from "path";
+
+describe("provider and model administration stays subtracted", () => {
+	const clientRoot = path.resolve(__dirname, "../../..");
+
+	it("keeps the provider route read-only", () => {
+		// The provider and model catalogs are owned by AutoDev's Control API.
+		// The read survives because the evaluations configuration page lists
+		// providers and their models so a judge can be picked from them. The
+		// writes would have been a second authority over the same rows: no
+		// page, no caller and no SDK used them, so a provider created that
+		// way would have existed in OpenLIT and nowhere else.
+		const route = fs.readFileSync(
+			path.join(clientRoot, "src/app/api/providers/route.ts"),
+			"utf-8"
+		);
+		expect(route).toContain("export const GET = GETHandler;");
+		expect(route).not.toMatch(/export const (?:POST|PUT|DELETE)\b/u);
+		expect(route).not.toMatch(/async function (?:POST|PUT|DELETE)Handler\b/u);
+	});
+
+	it("removes the model administration routes", () => {
+		expect(
+			fs.existsSync(path.join(clientRoot, "src/app/api/providers/models"))
+		).toBe(false);
+	});
+
+	it("removes the model service nothing imported", () => {
+		expect(
+			fs.existsSync(
+				path.join(
+					clientRoot,
+					"src/lib/platform/providers/models-service.ts"
+				)
+			)
+		).toBe(false);
+	});
+
+	it("keeps the read the evaluations configuration page depends on", () => {
+		const evaluationConfiguration = fs.readFileSync(
+			path.join(
+				clientRoot,
+				"src/components/(playground)/evaluations/evaluation-configuration.tsx"
+			),
+			"utf-8"
+		);
+		expect(evaluationConfiguration).toContain('url: "/api/providers"');
+	});
+
+	it("leaves the provider catalog seeded by the migrations", () => {
+		// The reads are only useful if something still populates the tables
+		// they read. The migrations seed both the provider metadata and the
+		// per-provider models, so removing the write routes leaves the
+		// evaluations picker with the catalog it had.
+		const providerMetadataMigration = fs.readFileSync(
+			path.join(
+				clientRoot,
+				"src/clickhouse/migrations/create-provider-metadata-migration.ts"
+			),
+			"utf-8"
+		);
+		const providersMigration = fs.readFileSync(
+			path.join(
+				clientRoot,
+				"src/clickhouse/migrations/create-providers-migration.ts"
+			),
+			"utf-8"
+		);
+		expect(providerMetadataMigration).toContain("DEFAULT_PROVIDERS");
+		expect(providersMigration).toContain("DEFAULT_MODELS_BY_PROVIDER");
+	});
+});
