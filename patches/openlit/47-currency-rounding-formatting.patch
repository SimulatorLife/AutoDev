+    // `cost` is the only `type: "round"` mapping and both consumers — the trace
+    // detail tile and the requests table's cost column — read the value as-is.
+    // Forcing `.toFixed(10)` after lodash's `round` put it back, so the UI
+    // showed `$0.0041000000`.
+    const withCost = (cost: string) =>
+      normalizeTrace({
+        SpanId: 'span-cost',
+        Timestamp: '2024-01-15T10:30:00.000Z',
+        SpanAttributes: { 'gen_ai.usage.cost': cost },
+      } as any);
+
+    expect(withCost('0.0041').cost).toBe('0.0041');
+    expect(withCost('0').cost).toBe('0');
+    expect(withCost('12').cost).toBe('12');
+    // The mapping's precision still applies.
+    expect(withCost('0.004123456789123').cost).toBe('0.0041234568');
+  });
+
