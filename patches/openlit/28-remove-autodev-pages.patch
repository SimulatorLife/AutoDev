-import { withControlApiProxy } from "@/lib/autodev/control-api";
-import { NextRequest } from "next/server";
-
-/**
- * PATCH /autodev/api/providers/{provider}/roles/{role}
- *
- * Forwards a typed role-enablement mutation to the AutoDev Control API.
- * The body must be `{ enabled: boolean }`; anything else is rejected
- * before reaching the network so a malformed client cannot trick the
- * upstream into a 4xx loop.
- *
- * Authorization: the server-configured actor is forwarded as
- * `X-AutoDev-Actor`; the bearer token stays server-side. The AutoDev API
- * matches that actor against its own
- * `AUTODEV_CONTROL_OPERATORS` allowlist and returns 403 if the actor
- * is not authorized.
- */
-export async function PATCH(
-	request: NextRequest,
-	context: { params: Promise<{ provider: string; role: string }> },
-): Promise<Response> {
-	const { provider, role } = await context.params;
-	if (!provider || !role) {
-		return new Response(JSON.stringify({ err: "missing provider or role" }), {
-			status: 400,
-			headers: { "content-type": "application/json" },
-		});
-	}
-
-	// Parse the body once on the OpenLIT side so the upstream always
-	// receives a well-typed `{ enabled: boolean }` payload. Empty body
-	// or wrong shape returns 400 without hitting the network.
-	let raw: unknown;
-	try {
-		raw = await request.json();
-	} catch {
-		return new Response(JSON.stringify({ err: "invalid JSON body" }), {
-			status: 400,
-			headers: { "content-type": "application/json" },
-		});
-	}
-	if (
-		!raw ||
-		typeof raw !== "object" ||
-		typeof (raw as { enabled?: unknown }).enabled !== "boolean"
-	) {
-		return new Response(
-			JSON.stringify({ err: "body must be { enabled: boolean }" }),
-			{ status: 400, headers: { "content-type": "application/json" } },
-		);
-	}
-	const body = { enabled: (raw as { enabled: boolean }).enabled };
-
-	// The provider/role identifiers are URL path segments; we pass them
-	// to the AutoDev API as-is. The upstream owns the allowlist and the
-	// audit trail, so the proxy does no further validation here.
-	const safeProvider = encodeURIComponent(provider);
-	const safeRole = encodeURIComponent(role);
-	return withControlApiProxy(
-		request,
-		"PATCH",
-		`providers/${safeProvider}/roles/${safeRole}`,
-		body,
-	);
-}
