+	it("reads provider phase percentiles only from attempts that report them", () => {
+		// A bridge reports where an attempt's time went (waiting for the
+		// provider, then on it), and the router records each phase as an
+		// attribute of the attempt span. An attempt that reports nothing must
+		// not count as a zero-second phase, so each card requires its attribute.
+		for (const [title, key, alias] of [
+			["P95 provider queue wait", "autodev.provider.queue.duration", "p95_queue_seconds"],
+			["P95 provider on-site time", "autodev.provider.site.duration", "p95_site_seconds"],
+		] as const) {
+			const widget = widgets.find((candidate) => candidate.title === title);
+			expect(widget?.type).toBe("STAT_CARD");
+			expect(widget?.properties).toMatchObject({
+				value: `0.${alias}`,
+				suffix: "s",
+				optInVariables: ["workspace", "provider", "model", "agent"],
+			});
+			expect(widget?.config.structuredQuery?.query?.filters).toEqual([
+				{
+					target: "attribute",
+					scope: "resource",
+					key: "service.name",
+					op: "eq",
+					value: "autodev-router",
+				},
+				{ target: "spanName", op: "eq", value: "gen_ai.client_operation" },
+				{ target: "attribute", scope: "span", key, op: "exists" },
+			]);
+			expect(widget?.config.structuredQuery?.query?.aggregations).toEqual([
+				{ fn: "p95", field: `span:${key}`, as: alias },
+			]);
+		}
+	});
+
