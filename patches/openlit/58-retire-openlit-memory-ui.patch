-function humanizeAttributeKey(key: string): string {
-	const spaced = key.replace(/_/g, " ").replace(/\s+/g, " ").trim();
-	if (!spaced) return key;
-	return spaced.charAt(0).toUpperCase() + spaced.slice(1);
-}
