-function metadataForDetails(memory: MemoryListItem): Record<string, unknown> | undefined {
-	const metadata = memory.metadata;
-	if (!metadata || !memory.id.startsWith("experience:") || !isPlainObject(metadata.autodev)) {
-		return metadata;
-	}
-	const autodev = metadata.autodev;
-	if (!isPlainObject(autodev.injectionOutcomes) && !isPlainObject(autodev.sessionOutcome)) return metadata;
-	const visibleAutoDev = { ...autodev };
-	delete visibleAutoDev.injectionOutcomes;
-	delete visibleAutoDev.sessionOutcome;
-	return { ...metadata, autodev: visibleAutoDev };
-}
