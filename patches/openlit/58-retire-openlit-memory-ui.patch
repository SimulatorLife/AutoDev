-function alignedWriteScope(
-	scope: MemoryWriteScope | undefined,
-	filters: MemoryFilterOptions
-): MemoryFilterScope {
-	const userId = scope?.userId?.trim() || "";
-	const sessionId = scope?.sessionId?.trim() || "";
