@@ -0,0 +1,13 @@
+-- Sharing a database config with another user is not an AutoDev product
+-- concept: there is a single operator, so there is nobody to share it with.
+-- The invited-user queue and the per-user edit/delete/share grants only ever
+-- existed to constrain a second user, and the share dialog that wrote them is
+-- gone.
+--
+-- `databaseconfiguser` itself stays: it is the user<->config link that also
+-- records which config is current. Only the three grant columns go.
+DROP TABLE IF EXISTS "DatabaseConfigInvitedUser";
+
+ALTER TABLE "databaseconfiguser" DROP COLUMN "canShare";
+ALTER TABLE "databaseconfiguser" DROP COLUMN "canEdit";
+ALTER TABLE "databaseconfiguser" DROP COLUMN "canDelete";
