@@ -0,0 +1,156 @@
+/** @jest-environment node */
+
+const mockResolveTelemetrySourceDescriptor = jest.fn();
+const mockGetTelemetryAdapter = jest.fn();
+const mockGetSpan = jest.fn();
+const mockGetTraceSpans = jest.fn();
+
+jest.mock("@/lib/telemetry-source", () => ({
+  resolveTelemetrySourceDescriptor: (...args: unknown[]) =>
+    mockResolveTelemetrySourceDescriptor(...args),
+  getTelemetryAdapter: (...args: unknown[]) => mockGetTelemetryAdapter(...args)
+}));
+
+const previousUsageToken = process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+process.env.AUTODEV_OPENLIT_USAGE_TOKEN = "trace-route-test-token";
+const { GET } = require("@/app/api/autodev/usage/span/[spanId]/route") as {
+  GET: (request: Request, context: { params: { spanId: string } }) => Promise<Response>;
+};
+
+const TRACE_ID = "0123456789abcdef0123456789abcdef";
+const SELECTED_SPAN_ID = "0123456789abcdef";
+
+function span(spanId: string, parentSpanId = "") {
+  return {
+    traceId: TRACE_ID,
+    spanId,
+    parentSpanId,
+    name: "gen_ai.client_operation",
+    serviceName: "autodev-router",
+    timestamp: "2026-10-05T12:00:00.000Z",
+    durationNs: 1_250_000,
+    statusCode: "Ok",
+    statusMessage: "private status message",
+    spanAttributes: { "gen_ai.prompt": "private prompt content" },
+    resourceAttributes: { "host.name": "private-host" }
+  };
+}
+
+function request(spanId: string, token = "trace-route-test-token"): Request {
+  return new Request(`http://openlit.local/api/autodev/usage/span/${spanId}`, {
+    headers: { authorization: `Bearer ${token}` }
+  });
+}
+
+function context(spanId: string) {
+  return { params: { spanId } };
+}
+
+beforeEach(() => {
+  mockResolveTelemetrySourceDescriptor.mockReset();
+  mockResolveTelemetrySourceDescriptor.mockResolvedValue({ id: "source-1" });
+  mockGetTelemetryAdapter.mockReset();
+  mockGetTelemetryAdapter.mockResolvedValue({
+    getSpan: mockGetSpan,
+    getTraceSpans: mockGetTraceSpans
+  });
+  mockGetSpan.mockReset();
+  mockGetSpan.mockResolvedValue(span(SELECTED_SPAN_ID));
+  mockGetTraceSpans.mockReset();
+  mockGetTraceSpans.mockResolvedValue([span(SELECTED_SPAN_ID)]);
+});
+
+afterAll(() => {
+  if (previousUsageToken === undefined) {
+    delete process.env.AUTODEV_OPENLIT_USAGE_TOKEN;
+  } else {
+    process.env.AUTODEV_OPENLIT_USAGE_TOKEN = previousUsageToken;
+  }
+});
+
+describe("AutoDev Usage trace detail endpoint", () => {
+  it("returns a bounded privacy-filtered span summary", async () => {
+    const response = await GET(request(SELECTED_SPAN_ID), context(SELECTED_SPAN_ID));
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body).toMatchObject({
+      schema: "autodev-openlit-trace-detail-v1",
+      traceId: TRACE_ID,
+      selectedSpanId: SELECTED_SPAN_ID,
+      partial: false,
+      spans: [
+        {
+          spanId: SELECTED_SPAN_ID,
+          parentSpanId: null,
+          spanName: "gen_ai.client_operation",
+          serviceName: "autodev-router",
+          timestamp: "2026-10-05T12:00:00.000Z",
+          durationNs: 1_250_000,
+          statusCode: "OK"
+        }
+      ]
+    });
+    expect(JSON.stringify(body)).not.toContain("private prompt content");
+    expect(JSON.stringify(body)).not.toContain("private status message");
+    expect(JSON.stringify(body)).not.toContain("private-host");
+    expect(mockGetTelemetryAdapter).toHaveBeenCalledWith({
+      signal: "traces",
+      sourceId: "source-1"
+    });
+  });
+
+  it("requires the dedicated Usage bearer credential", async () => {
+    const response = await GET(
+      request(SELECTED_SPAN_ID, "wrong-token"),
+      context(SELECTED_SPAN_ID)
+    );
+    expect(response.status).toBe(401);
+    expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+  });
+
+  it("rejects invalid span IDs before querying the telemetry adapter", async () => {
+    const response = await GET(request("not-a-span-id"), context("not-a-span-id"));
+    expect(response.status).toBe(400);
+    expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+  });
+
+  it("returns a typed not-found response when the source has no matching span", async () => {
+    mockGetSpan.mockResolvedValue(null);
+    const response = await GET(request(SELECTED_SPAN_ID), context(SELECTED_SPAN_ID));
+    const body = await response.json();
+    expect(response.status).toBe(404);
+    expect(body.error.code).toBe("autodev_usage_trace_not_found");
+    expect(mockGetTraceSpans).not.toHaveBeenCalled();
+  });
+
+  it("caps large trace responses and keeps the selected span in the sample", async () => {
+    const spans = Array.from({ length: 205 }, (_, index) =>
+      span((index + 1).toString(16).padStart(16, "0"))
+    );
+    const selected = spans.at(-1)!;
+    mockGetSpan.mockResolvedValue(selected);
+    mockGetTraceSpans.mockResolvedValue(spans);
+
+    const response = await GET(
+      request(selected.spanId),
+      context(selected.spanId)
+    );
+    const body = await response.json();
+    expect(response.status).toBe(200);
+    expect(body.partial).toBe(true);
+    expect(body.spans).toHaveLength(200);
+    expect(body.spans.map((entry: { spanId: string }) => entry.spanId)).toContain(
+      selected.spanId
+    );
+  });
+
+  it("returns a generic unavailable response when the source fails", async () => {
+    mockGetTelemetryAdapter.mockRejectedValue(new Error("private connection detail"));
+    const response = await GET(request(SELECTED_SPAN_ID), context(SELECTED_SPAN_ID));
+    const body = await response.json();
+    expect(response.status).toBe(503);
+    expect(body.error.code).toBe("autodev_usage_trace_unavailable");
+    expect(JSON.stringify(body)).not.toContain("private connection detail");
+  });
+});
