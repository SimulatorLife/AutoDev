@@ -161,3 +161,25 @@ function isUsageTimeRange(value: unknown): value is UsageTimeRange {
 function isUsageVariableId(value: string): value is UsageVariableId {
 	return USAGE_VARIABLE_IDS.some((id) => id === value);
 }
+const USAGE_TRACE_SPAN_ID_PATTERN = /^[0-9a-f]{16}$/iu;
+const USAGE_TRACE_ID_PATTERN = /^[0-9a-f]{32}$/iu;
+
+/** Return only a valid, non-zero OpenTelemetry SpanId for fixed trace lookups. */
+export function parseUsageTraceSpanId(value: unknown): string | null {
+	if (
+		typeof value !== "string" ||
+		!USAGE_TRACE_SPAN_ID_PATTERN.test(value) ||
+		/^0{16}$/u.test(value)
+	) {
+		return null;
+	}
+	return value;
+}
+
+export function isUsageTraceId(value: unknown): value is string {
+	return (
+		typeof value === "string" &&
+		USAGE_TRACE_ID_PATTERN.test(value) &&
+		!/^0{32}$/u.test(value)
+	);
+}
