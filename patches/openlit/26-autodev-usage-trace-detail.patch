diff --git a/src/client/src/app/api/autodev/usage/span/[spanId]/route.ts b/src/client/src/app/api/autodev/usage/span/[spanId]/route.ts
new file mode 100644
index 00000000..b175d225
--- /dev/null
+++ b/src/client/src/app/api/autodev/usage/span/[spanId]/route.ts
@@ -0,0 +1,153 @@
+import {
+	getTelemetryAdapter,
+	resolveTelemetrySourceDescriptor,
+} from "@/lib/telemetry-source";
+import type { NormalizedSpan } from "@/lib/platform/connectors/datasource/types";
+import {
+	isUsageServiceRequestAuthorized,
+	isUsageTraceId,
+	parseUsageTraceSpanId,
+} from "@/lib/autodev/usage-api";
+
+export const runtime = "nodejs";
+
+const SERVICE_TOKEN = process.env.AUTODEV_OPENLIT_USAGE_TOKEN ?? "";
+const TRACE_DETAIL_SCHEMA = "autodev-openlit-trace-detail-v1" as const;
+const MAX_RESPONSE_SPANS = 200;
+const SOURCE_TRACE_SPAN_LIMIT = 5_000;
+const MAX_LABEL_LENGTH = 256;
+
+type UsageTraceStatus = "OK" | "ERROR" | "UNSET" | "UNKNOWN";
+interface UsageTraceSpan {
+	readonly spanId: string;
+	readonly parentSpanId: string | null;
+	readonly spanName: string;
+	readonly serviceName: string;
+	readonly timestamp: string;
+	readonly durationNs: number;
+	readonly statusCode: UsageTraceStatus;
+}
+
+function errorResponse(
+	status: number,
+	code: string,
+	message: string,
+): Response {
+	return Response.json(
+		{ error: { code, message } },
+		{ status, headers: { "cache-control": "no-store" } },
+	);
+}
+
+function safeLabel(value: unknown): string | null {
+	if (typeof value !== "string") return null;
+	return value.slice(0, MAX_LABEL_LENGTH);
+}
+
+function toSafeSpan(span: NormalizedSpan): UsageTraceSpan | null {
+	const timestamp = new Date(span.timestamp);
+	if (
+		!parseUsageTraceSpanId(span.spanId) ||
+		(span.parentSpanId !== "" && !parseUsageTraceSpanId(span.parentSpanId)) ||
+		!isUsageTraceId(span.traceId) ||
+		!Number.isSafeInteger(span.durationNs) ||
+		span.durationNs < 0 ||
+		!Number.isFinite(timestamp.getTime())
+	) {
+		return null;
+	}
+	const spanName = safeLabel(span.name);
+	const serviceName = safeLabel(span.serviceName);
+	if (spanName === null || serviceName === null) return null;
+	if (typeof span.statusCode !== "string") return null;
+	const sourceStatus = span.statusCode.toUpperCase().replace(/^STATUS_CODE_/u, "");
+	const statusCode: UsageTraceStatus =
+		sourceStatus === "OK" || sourceStatus === "ERROR" || sourceStatus === "UNSET"
+			? sourceStatus
+			: "UNKNOWN";
+	return {
+		spanId: span.spanId.toLowerCase(),
+		parentSpanId: span.parentSpanId ? span.parentSpanId.toLowerCase() : null,
+		spanName,
+		serviceName,
+		timestamp: timestamp.toISOString(),
+		durationNs: span.durationNs,
+		statusCode,
+	};
+}
+
+function compareSpanTime(a: UsageTraceSpan, b: UsageTraceSpan): number {
+	return Date.parse(a.timestamp) - Date.parse(b.timestamp);
+}
+
+export async function GET(
+	request: Request,
+	context: { readonly params: { readonly spanId?: string } },
+): Promise<Response> {
+	if (!SERVICE_TOKEN) {
+		return errorResponse(503, "autodev_usage_not_configured", "Usage service is not configured.");
+	}
+	if (!isUsageServiceRequestAuthorized(request.headers.get("authorization"), SERVICE_TOKEN)) {
+		return errorResponse(401, "autodev_usage_unauthorized", "Unauthorized.");
+	}
+
+	const spanId = parseUsageTraceSpanId(context.params.spanId);
+	if (!spanId) {
+		return errorResponse(400, "autodev_usage_trace_span_id_invalid", "A valid OpenTelemetry SpanId is required.");
+	}
+
+	try {
+		const descriptor = await resolveTelemetrySourceDescriptor({ signal: "traces" });
+		const adapter = await getTelemetryAdapter({ signal: "traces", sourceId: descriptor.id });
+		const selected = await adapter.getSpan(spanId);
+		if (!selected) {
+			return errorResponse(404, "autodev_usage_trace_not_found", "The referenced span was not found.");
+		}
+		if (!isUsageTraceId(selected.traceId)) {
+			return errorResponse(502, "autodev_usage_trace_invalid", "The telemetry source returned an invalid trace reference.");
+		}
+
+		const sourceSpans = await adapter.getTraceSpans(selected.traceId);
+		const summaries = new Map<string, UsageTraceSpan>();
+		let partial = sourceSpans.length >= SOURCE_TRACE_SPAN_LIMIT;
+		for (const span of sourceSpans) {
+			if (span.traceId !== selected.traceId) {
+				partial = true;
+				continue;
+			}
+			const safeSpan = toSafeSpan(span);
+			if (!safeSpan) {
+				partial = true;
+				continue;
+			}
+			summaries.set(safeSpan.spanId.toLowerCase(), safeSpan);
+		}
+
+		const selectedSpan = toSafeSpan(selected);
+		if (!selectedSpan) {
+			return errorResponse(502, "autodev_usage_trace_invalid", "The telemetry source returned an invalid selected span.");
+		}
+		if (!summaries.has(selectedSpan.spanId.toLowerCase())) partial = true;
+		summaries.set(selectedSpan.spanId.toLowerCase(), selectedSpan);
+		const ordered = Array.from(summaries.values()).sort(compareSpanTime);
+		partial ||= ordered.length > MAX_RESPONSE_SPANS;
+		let spans = ordered.slice(0, MAX_RESPONSE_SPANS);
+		if (!spans.some((span) => span.spanId.toLowerCase() === selectedSpan.spanId.toLowerCase())) {
+			spans = [...spans.slice(0, MAX_RESPONSE_SPANS - 1), selectedSpan].sort(compareSpanTime);
+			partial = true;
+		}
+
+		return Response.json(
+			{
+				schema: TRACE_DETAIL_SCHEMA,
+				traceId: selected.traceId.toLowerCase(),
+				selectedSpanId: selectedSpan.spanId,
+				spans,
+				partial,
+			},
+			{ headers: { "cache-control": "no-store" } },
+		);
+	} catch {
+		return errorResponse(503, "autodev_usage_trace_unavailable", "Trace details are unavailable.");
+	}
+}
