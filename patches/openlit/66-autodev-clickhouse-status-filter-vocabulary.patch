+/**
+ * The stored spelling of each span status.
+ *
+ * ClickHouse keeps the OTel span status in an enum of its own, whose names
+ * are title-cased (`Ok`, `Error`, `Unset`). The query contract speaks the
+ * OTel vocabulary (`OK`, `ERROR`, `UNSET`), and some callers use the
+ * `STATUS_CODE_` prefix the OTLP JSON encoding uses. Comparing those
+ * spellings literally makes a status filter select nothing, and a filter
+ * that selects nothing reads as a measured zero rather than as a filter that
+ * never fired. Map each spelling onto the stored one here, where the storage
+ * representation is known.
+ */
+const CLICKHOUSE_STATUS_NAMES: Readonly<Record<string, string>> = {
+	ok: "Ok",
+	error: "Error",
+	unset: "Unset",
+};
+
+function clickhouseStatusName(value: string): string {
+	const key = value.trim().toLowerCase().replace(/^status_code_/u, "");
+	return CLICKHOUSE_STATUS_NAMES[key] ?? value;
+}
