-
 # Bake Prisma CLI/Schema engines for the Alpine builder and the Debian
 # bookworm runtime (OpenSSL 3). schema.prisma `binaryTargets` only covers the
 # Query Engine; CLI engines are resolved at install time for the builder
@@ -19,8 +17,28 @@ COPY ./client/ .
 # / `prisma generate`) downloads from binaries.prisma.sh and fails air-gapped.
 ENV PRISMA_CLI_BINARY_TARGETS=linux-musl-openssl-3.0.x,linux-musl-arm64-openssl-3.0.x,debian-openssl-3.0.x,linux-arm64-openssl-3.0.x
 
-# Install dependencies, generate Prisma client & Build the Next.js application
-RUN npm install && npx prisma generate && npm run build
+# Install dependencies from the lockfile alone so source-only changes reuse
+# this layer without re-running npm or re-downloading Prisma engines.
+COPY ./client/package.json ./client/package-lock.json ./
+RUN --mount=type=cache,id=openlit-npm,target=/root/.npm \
+    --mount=type=cache,id=openlit-prisma,target=/root/.cache/prisma \
+    npm ci --prefer-offline --no-audit --no-fund
+
+# Generate Prisma client in its own cached layer keyed only by schema changes.
+COPY ./client/prisma ./prisma
+RUN --mount=type=cache,id=openlit-prisma,target=/root/.cache/prisma \
+    npx prisma generate
+
+
+# Next.js build stage - reuses cached deps + Prisma and persists .next/cache
+FROM deps AS builder
+
+# Copy the rest of the application code
+COPY ./client/ .
+
+# Build the Next.js application with persistent cache
+RUN --mount=type=cache,id=openlit-next-cache,target=/app/client/.next/cache \
+    NEXT_TELEMETRY_DISABLED=1 npm run build
 
 
