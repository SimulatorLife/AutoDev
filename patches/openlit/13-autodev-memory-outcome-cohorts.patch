+		const result = await adapter.readOutcomeCohorts({
+			occurredFrom: "2026-09-01T00:00:00.000Z",
+			occurredUntil: "2026-09-02T00:00:00.000Z"
+		});
+		expect(result).toEqual({ status: "unavailable", page: null });
+	}
+});
