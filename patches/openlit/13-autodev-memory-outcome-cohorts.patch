+import { fireEvent, render, screen } from "@testing-library/react";
+import MemoryCohortView from "@/components/(playground)/memory/memory-cohort-view";
+
+jest.mock("@/utils/api", () => ({
+	getRequestHeaders: (headers?: Record<string, string>) => headers || {},
+}));
+
+class ResizeObserverMock {
+	observe() {}
+	unobserve() {}
+	disconnect() {}
+}
+Object.defineProperty(global, "ResizeObserver", {
+	writable: true,
+	value: ResizeObserverMock,
+});
+
+describe("MemoryCohortView", () => {
+	beforeEach(() => {
+		jest.clearAllMocks();
+	});
+
+	it("renders nothing for a non-AutoDev connector", () => {
+		global.fetch = jest.fn() as unknown as typeof fetch;
+		const { container } = render(
+			<MemoryCohortView connectorId="memory:claude-a" connectorType="claude" />
+		);
+		expect(container).toBeEmptyDOMElement();
+		expect(global.fetch).not.toHaveBeenCalled();
+	});
+
+	it("shows the explicit disabled state and sends an inclusive UTC date window", async () => {
+		const fetchSpy = jest.fn().mockResolvedValue({
+			ok: true,
+			json: async () => ({
+				connector: { id: "memory:autodev-a", type: "autodev" },
+				result: { status: "disabled", page: null },
+			}),
+		});
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		render(<MemoryCohortView connectorId="memory:autodev-a" connectorType="autodev" />);
+		expect(await screen.findByRole("status")).toHaveTextContent(
+			"workspace, repository, and task-history/operator access"
+		);
+		const requestUrl = new URL(String(fetchSpy.mock.calls[0]?.[0]), "http://localhost");
+		expect(requestUrl.searchParams.get("occurredFrom")).toMatch(/T00:00:00\.000Z$/u);
+		expect(requestUrl.searchParams.get("occurredUntil")).toMatch(/T23:59:59\.999Z$/u);
+	});
+
+	it("handles cleared date inputs without making an invalid request", async () => {
+		const fetchSpy = jest.fn().mockResolvedValue({
+			ok: true,
+			json: async () => ({
+				connector: { id: "memory:autodev-a", type: "autodev" },
+				result: { status: "disabled", page: null },
+			}),
+		});
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		render(<MemoryCohortView connectorId="memory:autodev-a" connectorType="autodev" />);
+		await screen.findByRole("status");
+		fireEvent.change(screen.getByLabelText("From"), { target: { value: "" } });
+		expect(await screen.findByText(/Select valid start and end dates/i)).toBeInTheDocument();
+		expect(fetchSpy).toHaveBeenCalledTimes(1);
+	});
+
+	it("handles cleared date inputs without making an invalid request", async () => {
+		const fetchSpy = jest.fn().mockResolvedValue({
+			ok: true,
+			json: async () => ({
+				connector: { id: "memory:autodev-a", type: "autodev" },
+				result: { status: "disabled", page: null },
+			}),
+		});
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		render(<MemoryCohortView connectorId="memory:autodev-a" connectorType="autodev" />);
+		await screen.findByRole("status");
+		fireEvent.change(screen.getByLabelText("From"), { target: { value: "" } });
+		expect(await screen.findByText(/Select valid start and end dates/i)).toBeInTheDocument();
+		expect(fetchSpy).toHaveBeenCalledTimes(1);
+	});
+
+	it("keeps an unreported (null reportKind/outcomeKind) cell visible and states outcomes are reporter-supplied", async () => {
+		global.fetch = jest.fn().mockResolvedValue({
+			ok: true,
+			json: async () => ({
+				connector: { id: "memory:autodev-a", type: "autodev" },
+				result: {
+					status: "available",
+					page: {
+						occurredFrom: "2026-09-01T00:00:00.000Z",
+						occurredUntil: "2026-09-02T00:00:00.000Z",
+						cells: [
+							{
+								memoryMode: "jit",
+								injectionResult: "injected",
+								reportKind: null,
+								outcomeKind: null,
+								exposureCount: 9,
+								reportCount: 0,
+							},
+							{
+								memoryMode: "jit",
+								injectionResult: "injected",
+								reportKind: "pull_request",
+								outcomeKind: "success",
+								exposureCount: 2,
+								reportCount: 2,
+							},
+						],
+						exposureCount: 11,
+						reportCount: 2,
+					},
+				},
+			}),
+		}) as unknown as typeof fetch;
+
+		render(<MemoryCohortView connectorId="memory:autodev-a" connectorType="autodev" />);
+
+		expect(await screen.findAllByText("Unreported")).toHaveLength(2);
+		expect(screen.getByText("11")).toBeInTheDocument();
+		expect(screen.getByText("2", { selector: "p" })).toBeInTheDocument();
+		expect(
+			screen.getByText(/outcomes are reporter-supplied/i)
+		).toBeInTheDocument();
+		expect(
+			screen.getByText(/reportCount is always less than or equal to exposureCount/i)
+		).toBeInTheDocument();
+		// The disclaimer explicitly states these counts are NOT any of the
+		// following, so the phrases legitimately appear once, inside the
+		// disclaimer sentence -- never as a table/column label or a computed
+		// value (e.g. a percentage).
+		expect(screen.getByText(/not a task success rate/i)).toBeInTheDocument();
+		expect(screen.getByText(/a model-use metric/i)).toBeInTheDocument();
+		expect(screen.getByText(/pr verification/i)).toBeInTheDocument();
+		expect(screen.getByText(/causal effect on any outcome/i)).toBeInTheDocument();
+		expect(screen.queryByText(/%/)).not.toBeInTheDocument();
+		const headers = screen.getAllByRole("columnheader").map((node) => node.textContent);
+		expect(headers).toEqual([
+			"Memory mode",
+			"Injection result",
+			"Report kind",
+			"Outcome kind",
+			"Exposure count",
+			"Report count",
+		]);
+	});
+});
