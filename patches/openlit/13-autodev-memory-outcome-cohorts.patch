@@ -0,0 +1,337 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { RefreshCw } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import {
+	Select,
+	SelectContent,
+	SelectItem,
+	SelectTrigger,
+	SelectValue,
+} from "@/components/ui/select";
+import {
+	Table,
+	TableBody,
+	TableCell,
+	TableHead,
+	TableHeader,
+	TableRow,
+} from "@/components/ui/table";
+import { Skeleton } from "@/components/ui/skeleton";
+import getMessage from "@/constants/messages";
+import { getRequestHeaders } from "@/utils/api";
+
+export interface MemoryCohortCell {
+	memoryMode: string;
+	injectionResult: string;
+	reportKind: string | null;
+	outcomeKind: string | null;
+	exposureCount: number;
+	reportCount: number;
+}
+
+export interface MemoryCohortPage {
+	occurredFrom: string;
+	occurredUntil: string;
+	cells: MemoryCohortCell[];
+	exposureCount: number;
+	reportCount: number;
+}
+
+export interface MemoryCohortResult {
+	status: "available" | "empty" | "unavailable" | "disabled";
+	page: MemoryCohortPage | null;
+}
+
+const MEMORY_MODE_OPTIONS = ["jit", "retrieval-only", "disabled", "invalid", "unknown"];
+const INJECTION_RESULT_OPTIONS = ["injected", "empty", "skipped"];
+const REPORT_KIND_OPTIONS = ["task", "pull_request", "issue", "other"];
+const OUTCOME_KIND_OPTIONS = ["success", "partial", "failure", "cancelled", "unknown"];
+const DEFAULT_WINDOW_DAYS = 30;
+const MAX_COHORT_WINDOW_MS = 365 * 24 * 60 * 60 * 1000;
+const ALL_VALUE = "__all__";
+
+function isoDate(date: Date): string {
+	return date.toISOString().slice(0, 10);
+}
+
+function defaultWindow(): { occurredFrom: string; occurredUntil: string } {
+	const until = new Date();
+	const from = new Date(until.getTime() - DEFAULT_WINDOW_DAYS * 24 * 60 * 60 * 1000);
+	return { occurredFrom: isoDate(from), occurredUntil: isoDate(until) };
+}
+
+export default function MemoryCohortView({
+	connectorId,
+	connectorType,
+}: {
+	connectorId: string;
+	connectorType: string;
+}) {
+	const messages = getMessage();
+	const initialWindow = useMemo(defaultWindow, []);
+	const [occurredFrom, setOccurredFrom] = useState(initialWindow.occurredFrom);
+	const [occurredUntil, setOccurredUntil] = useState(initialWindow.occurredUntil);
+	const [memoryMode, setMemoryMode] = useState(ALL_VALUE);
+	const [injectionResult, setInjectionResult] = useState(ALL_VALUE);
+	const [reportKind, setReportKind] = useState(ALL_VALUE);
+	const [outcomeKind, setOutcomeKind] = useState(ALL_VALUE);
+	const [loading, setLoading] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	const [result, setResult] = useState<MemoryCohortResult | null>(null);
+
+	const requestSequence = useRef(0);
+	const load = useCallback(() => {
+		const requestId = ++requestSequence.current;
+		setResult(null);
+		setError(null);
+		if (connectorType !== "autodev" || !connectorId) {
+			setLoading(false);
+			return;
+		}
+		const fromMs = Date.parse(`${occurredFrom}T00:00:00.000Z`);
+		const untilMs = Date.parse(`${occurredUntil}T23:59:59.999Z`);
+		if (
+			!occurredFrom ||
+			!occurredUntil ||
+			!Number.isFinite(fromMs) ||
+			!Number.isFinite(untilMs) ||
+			untilMs < fromMs ||
+			untilMs - fromMs > MAX_COHORT_WINDOW_MS
+		) {
+			setLoading(false);
+			setError(messages.MEMORY_COHORTS_INVALID_WINDOW);
+			return;
+		}
+		setLoading(true);
+		const params = new URLSearchParams({
+			connectorId,
+			occurredFrom: new Date(fromMs).toISOString(),
+			occurredUntil: new Date(untilMs).toISOString(),
+		});
+		// Explicit group-dimension filters are opt-in. Leaving reportKind and
+		// outcomeKind unselected (the default) deliberately keeps unreported
+		// exposure cells in the response -- they are not errors to be hidden.
+		if (memoryMode !== ALL_VALUE) params.set("memoryMode", memoryMode);
+		if (injectionResult !== ALL_VALUE) params.set("injectionResult", injectionResult);
+		if (reportKind !== ALL_VALUE) params.set("reportKind", reportKind);
+		if (outcomeKind !== ALL_VALUE) params.set("outcomeKind", outcomeKind);
+		fetch("/api/memory/cohorts?" + params.toString(), { headers: getRequestHeaders() })
+			.then(async (response) => {
+				const body = await response.json().catch(() => null);
+				if (!response.ok) {
+					throw new Error(
+						(body && typeof body === "object" && typeof body.err === "string" && body.err) ||
+						messages.MEMORY_COHORTS_LOAD_FAILED
+					);
+				}
+				return body as { result: MemoryCohortResult };
+			})
+			.then((payload) => {
+				if (requestId === requestSequence.current) setResult(payload.result);
+			})
+			.catch((caught: unknown) => {
+				if (requestId === requestSequence.current) {
+					setError(caught instanceof Error ? caught.message : messages.MEMORY_COHORTS_LOAD_FAILED);
+				}
+			})
+			.finally(() => {
+				if (requestId === requestSequence.current) setLoading(false);
+			});
+	}, [
+		connectorId,
+		connectorType,
+		injectionResult,
+		memoryMode,
+		messages.MEMORY_COHORTS_INVALID_WINDOW,
+		messages.MEMORY_COHORTS_LOAD_FAILED,
+		occurredFrom,
+		occurredUntil,
+		outcomeKind,
+		reportKind,
+	]);
+
+	useEffect(() => {
+		load();
+		return () => {
+			requestSequence.current += 1;
+		};
+	}, [load]);
+
+	if (connectorType !== "autodev") return null;
+
+	const page = result?.page ?? null;
+	const cells = page?.cells ?? [];
+
+	return (
+		<div className="flex h-full min-h-0 flex-col gap-3 overflow-auto p-1">
+			<div>
+				<h2 className="text-sm font-semibold text-stone-900 dark:text-stone-100">
+					{messages.MEMORY_COHORTS_TITLE}
+				</h2>
+				<p className="mt-1 text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_COHORTS_SCOPE_NOTE}
+				</p>
+			</div>
+			<div className="flex flex-wrap items-end gap-2">
+				<label className="flex flex-col gap-1 text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_COHORTS_FROM_LABEL}
+					<input
+						type="date"
+						value={occurredFrom}
+						max={occurredUntil}
+						onChange={(event) => setOccurredFrom(event.target.value)}
+						className="h-8 rounded-md border border-stone-200 bg-white px-2 text-xs dark:border-stone-800 dark:bg-stone-950"
+					/>
+				</label>
+				<label className="flex flex-col gap-1 text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_COHORTS_UNTIL_LABEL}
+					<input
+						type="date"
+						value={occurredUntil}
+						min={occurredFrom}
+						onChange={(event) => setOccurredUntil(event.target.value)}
+						className="h-8 rounded-md border border-stone-200 bg-white px-2 text-xs dark:border-stone-800 dark:bg-stone-950"
+					/>
+				</label>
+				<CohortFilterSelect
+					label={messages.MEMORY_COHORTS_MEMORY_MODE}
+					value={memoryMode}
+					options={MEMORY_MODE_OPTIONS}
+					allLabel={messages.MEMORY_COHORTS_ALL_FILTER_VALUE}
+					onChange={setMemoryMode}
+				/>
+				<CohortFilterSelect
+					label={messages.MEMORY_COHORTS_INJECTION_RESULT}
+					value={injectionResult}
+					options={INJECTION_RESULT_OPTIONS}
+					allLabel={messages.MEMORY_COHORTS_ALL_FILTER_VALUE}
+					onChange={setInjectionResult}
+				/>
+				<CohortFilterSelect
+					label={messages.MEMORY_COHORTS_REPORT_KIND}
+					value={reportKind}
+					options={REPORT_KIND_OPTIONS}
+					allLabel={messages.MEMORY_COHORTS_ALL_FILTER_VALUE}
+					onChange={setReportKind}
+				/>
+				<CohortFilterSelect
+					label={messages.MEMORY_COHORTS_OUTCOME_KIND}
+					value={outcomeKind}
+					options={OUTCOME_KIND_OPTIONS}
+					allLabel={messages.MEMORY_COHORTS_ALL_FILTER_VALUE}
+					onChange={setOutcomeKind}
+				/>
+				<Button
+					size="sm"
+					variant="outline"
+					className="h-8 gap-1.5"
+					onClick={load}
+					disabled={loading}
+				>
+					<RefreshCw className={"size-3.5 " + (loading ? "animate-spin" : "")} />
+					{messages.MEMORY_COHORTS_REFRESH}
+				</Button>
+			</div>
+			{loading && !result ? (
+				<div className="space-y-2">
+					<Skeleton className="h-8 w-full rounded-md" />
+					<Skeleton className="h-24 w-full rounded-md" />
+				</div>
+			) : error ? (
+				<p role="status" className="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-900 dark:border-red-900/70 dark:bg-red-950/30 dark:text-red-100">
+					{error}
+				</p>
+			) : result?.status === "disabled" ? (
+				<p role="status" className="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-900/70 dark:bg-amber-950/30 dark:text-amber-100">
+					{messages.MEMORY_COHORTS_DISABLED}
+				</p>
+			) : result?.status === "unavailable" ? (
+				<p role="status" className="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-900/70 dark:bg-amber-950/30 dark:text-amber-100">
+					{messages.MEMORY_COHORTS_UNAVAILABLE}
+				</p>
+			) : result?.status === "empty" || cells.length === 0 ? (
+				<p role="status" className="rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-xs text-stone-600 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-300">
+					{messages.MEMORY_COHORTS_EMPTY}
+				</p>
+			) : (
+				<div className="space-y-3">
+					<div className="grid grid-cols-2 gap-2 sm:grid-cols-2">
+						<CohortTotalCard
+							label={messages.MEMORY_COHORTS_TOTAL_EXPOSURES}
+							value={page?.exposureCount ?? 0}
+						/>
+						<CohortTotalCard
+							label={messages.MEMORY_COHORTS_TOTAL_REPORTS}
+							value={page?.reportCount ?? 0}
+						/>
+					</div>
+					<Table>
+						<TableHeader>
+							<TableRow>
+								<TableHead>{messages.MEMORY_COHORTS_MEMORY_MODE}</TableHead>
+								<TableHead>{messages.MEMORY_COHORTS_INJECTION_RESULT}</TableHead>
+								<TableHead>{messages.MEMORY_COHORTS_REPORT_KIND}</TableHead>
+								<TableHead>{messages.MEMORY_COHORTS_OUTCOME_KIND}</TableHead>
+								<TableHead className="text-right">{messages.MEMORY_COHORTS_EXPOSURE_COUNT}</TableHead>
+								<TableHead className="text-right">{messages.MEMORY_COHORTS_REPORT_COUNT}</TableHead>
+							</TableRow>
+						</TableHeader>
+						<TableBody>
+							{cells.map((cell, index) => (
+								<TableRow key={index}>
+									<TableCell>{cell.memoryMode}</TableCell>
+									<TableCell>{cell.injectionResult}</TableCell>
+									<TableCell>{cell.reportKind ?? messages.MEMORY_COHORTS_UNREPORTED}</TableCell>
+									<TableCell>{cell.outcomeKind ?? messages.MEMORY_COHORTS_UNREPORTED}</TableCell>
+									<TableCell className="text-right tabular-nums">{cell.exposureCount}</TableCell>
+									<TableCell className="text-right tabular-nums">{cell.reportCount}</TableCell>
+								</TableRow>
+							))}
+						</TableBody>
+					</Table>
+				</div>
+			)}
+		</div>
+	);
+}
+
+function CohortFilterSelect({
+	label,
+	value,
+	options,
+	allLabel,
+	onChange,
+}: {
+	label: string;
+	value: string;
+	options: string[];
+	allLabel: string;
+	onChange: (value: string) => void;
+}) {
+	return (
+		<Select value={value} onValueChange={onChange}>
+			<SelectTrigger className="h-8 w-[160px]" aria-label={label}>
+				<SelectValue placeholder={label} />
+			</SelectTrigger>
+			<SelectContent>
+				<SelectItem value={ALL_VALUE}>{allLabel}</SelectItem>
+				{options.map((option) => (
+					<SelectItem key={option} value={option}>
+						{option}
+					</SelectItem>
+				))}
+			</SelectContent>
+		</Select>
+	);
+}
+
+function CohortTotalCard({ label, value }: { label: string; value: number }) {
+	return (
+		<div className="rounded-md border border-stone-200 bg-white px-3 py-2 dark:border-stone-800 dark:bg-stone-950">
+			<p className="text-[11px] uppercase tracking-wide text-stone-500 dark:text-stone-400">{label}</p>
+			<p className="mt-1 text-lg font-semibold tabular-nums text-stone-950 dark:text-stone-50">{value}</p>
+		</div>
+	);
+}
