+jest.mock("@/lib/session", () => ({ getCurrentUser: jest.fn() }));
+jest.mock("@/lib/platform/connectors/memory/crud", () => ({
+	memoryConnectorId: (id: string) => (id.startsWith("memory:") ? id : `memory:${id}`),
+	isMemoryConnectorId: (id: unknown) => typeof id === "string" && id.startsWith("memory:"),
+	listMemoryConnectors: jest.fn(),
+	getMemoryRuntime: jest.fn(),
+}));
+jest.mock("@/lib/platform/connectors/memory/autodev/adapter", () => ({
+	isAutoDevMemoryAdapter: (adapter: unknown) =>
+		!!adapter && typeof adapter === "object" && (adapter as { __autodev?: boolean }).__autodev === true,
+}));
+
+import { GET } from "@/app/api/memory/cohorts/route";
+import { getCurrentUser } from "@/lib/session";
+import { getMemoryRuntime, listMemoryConnectors } from "@/lib/platform/connectors/memory/crud";
+import { MEMORY_COHORTS_UNSUPPORTED_CONNECTOR } from "@/constants/messages/en";
+
+(globalThis as unknown as { Response: { json: unknown } }).Response = {
+	json: (body: unknown, init?: ResponseInit) => ({
+		status: init?.status ?? 200,
+		json: async () => body,
+	}),
+};
+
+function makeRequest(query: string) {
+	const url = "http://localhost/api/memory/cohorts" + (query ? "?" + query : "");
+	return { nextUrl: { searchParams: new URL(url).searchParams } } as any;
+}
+
+const autoDevConnector = { id: "memory:autodev-a", type: "autodev", name: "AutoDev Memory" };
+const claudeConnector = { id: "memory:claude-a", type: "claude", name: "Claude" };
+
+describe("GET /api/memory/cohorts", () => {
+	beforeEach(() => {
+		jest.clearAllMocks();
+		(getCurrentUser as jest.Mock).mockResolvedValue({ id: "operator-a" });
+	});
+
+	it("requires authentication", async () => {
+		(getCurrentUser as jest.Mock).mockResolvedValue(null);
+		const response = await GET(
+			makeRequest("occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z")
+		);
+		expect(response.status).toBe(401);
+		expect(listMemoryConnectors).not.toHaveBeenCalled();
+	});
+
+	it("rejects a missing or invalid occurred timestamp", async () => {
+		const response = await GET(makeRequest("occurredUntil=2026-09-02T00:00:00.000Z"));
+		expect(response.status).toBe(400);
+		const body = await response.json();
+		expect(String(body)).toMatch(/occurredFrom/);
+	});
+
+	it("rejects a window exceeding 365 days", async () => {
+		const response = await GET(
+			makeRequest("occurredFrom=2024-01-01T00:00:00.000Z&occurredUntil=2026-01-01T00:00:00.000Z")
+		);
+		expect(response.status).toBe(400);
+		const body = await response.json();
+		expect(String(body)).toMatch(/365 days/);
+	});
+
+	it("rejects an invalid enum filter value", async () => {
+		const response = await GET(
+			makeRequest(
+				"occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&memoryMode=not-a-mode"
+			)
+		);
+		expect(response.status).toBe(400);
+	});
+
+	it("rejects task/run/agent identity and unknown query selectors", async () => {
+		for (const key of ["taskId", "runId", "agentId", "unknown"]) {
+			const response = await GET(
+				makeRequest(
+					"occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z&" + key + "=caller-value"
+				)
+			);
+			expect(response.status).toBe(400);
+		}
+		expect(listMemoryConnectors).not.toHaveBeenCalled();
+	});
+
+
+	it("404s when no AutoDev connector exists and none was requested", async () => {
+		(listMemoryConnectors as jest.Mock).mockResolvedValue([claudeConnector]);
+		const response = await GET(
+			makeRequest("occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z")
+		);
+		expect(response.status).toBe(404);
+	});
+
+	it("rejects a requested connector that is not the AutoDev adapter", async () => {
+		(listMemoryConnectors as jest.Mock).mockResolvedValue([claudeConnector]);
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: false },
+			connector: claudeConnector,
+		});
+		const response = await GET(
+			makeRequest(
+				"connectorId=claude-a&occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z"
+			)
+		);
+		expect(response.status).toBe(400);
+		const body = await response.json();
+		expect(body).toBe(MEMORY_COHORTS_UNSUPPORTED_CONNECTOR);
+	});
+
+	it("returns the cohort result for a valid request, excluding role/task/run/agent scope", async () => {
+		const readOutcomeCohorts = jest.fn().mockResolvedValue({
+			status: "available",
+			page: {
+				occurredFrom: "2026-09-01T00:00:00.000Z",
+				occurredUntil: "2026-09-02T00:00:00.000Z",
+				cells: [
+					{
+						memoryMode: "jit",
+						injectionResult: "injected",
+						reportKind: null,
+						outcomeKind: null,
+						exposureCount: 5,
+						reportCount: 0,
+					},
+				],
+				exposureCount: 5,
+				reportCount: 0,
+			},
+		});
+		(listMemoryConnectors as jest.Mock).mockResolvedValue([autoDevConnector]);
+		(getMemoryRuntime as jest.Mock).mockResolvedValue({
+			adapter: { __autodev: true, readOutcomeCohorts },
+			connector: autoDevConnector,
+		});
+
+		const response = await GET(
+			makeRequest(
+				"occurredFrom=2026-09-01T00:00:00.000Z&occurredUntil=2026-09-02T00:00:00.000Z"
+			)
+		);
+		expect(response.status).toBe(200);
+		const body = await response.json();
+		expect(body.connector).toEqual(autoDevConnector);
+		expect(body.result.status).toBe("available");
+		expect(body.result.page.cells[0].reportKind).toBeNull();
+		expect(readOutcomeCohorts).toHaveBeenCalledWith({
+			occurredFrom: "2026-09-01T00:00:00.000Z",
+			occurredUntil: "2026-09-02T00:00:00.000Z",
+			memoryModes: undefined,
+			injectionResults: undefined,
+			reportKinds: undefined,
+			outcomeKinds: undefined,
+		});
+	});
+});
