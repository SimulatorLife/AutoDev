diff --git a/src/client/src/clickhouse/migrations/drop-prompt-migration.ts b/src/client/src/clickhouse/migrations/drop-prompt-migration.ts
new file mode 100644
index 00000000..3a43b246
--- /dev/null
+++ b/src/client/src/clickhouse/migrations/drop-prompt-migration.ts
@@ -0,0 +1,35 @@
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "drop-prompt-tables";
+
+/**
+ * Drops the tables that the Prompt Hub product owned.
+ *
+ * The Prompt Hub's pages, API and components are gone, so nothing reads or
+ * writes these tables any more. A fresh install must not create them, and an
+ * existing install should not keep them: the tables were the product's
+ * storage, and storage with no owner is a place a stale row can still be
+ * read from by something that believes it is looking at prompts.
+ *
+ * The table names are spelled out here rather than imported, because the
+ * module that named them was part of the removed product. The drop
+ * migration is the one place that still has to say what the tables were
+ * called, and it has to survive the removal that took the names with it.
+ *
+ * `DROP TABLE IF EXISTS` keeps an install that never had them a no-op.
+ */
+export default async function DropPromptMigration(databaseConfigId?: string) {
+	const queries = [
+		`DROP TABLE IF EXISTS openlit_prompt_version_downloads`,
+		`DROP TABLE IF EXISTS openlit_prompt_versions`,
+		`DROP TABLE IF EXISTS openlit_prompts`,
+	];
+
+	const { migrationExist, queriesRun } = await migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+
+	return { migrationExist, queriesRun };
+}
