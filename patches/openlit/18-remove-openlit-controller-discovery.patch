-			if (
-				desired.desired_status === DESIRED_RUNNING &&
-				actual === "stopped"
-			) {
-				actions.push({
-					actionType: KNOWN_ACTIONS.START_WORKLOAD,
-					serviceKey: svc.workload_key,
-					payload: desired.config || "{}",
-				});
-			}
-			if (
-				desired.desired_status === DESIRED_STOPPED &&
-				actual !== "stopped"
-			) {
