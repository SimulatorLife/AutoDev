--- /dev/null
+++ b/src/client/src/__tests__/platform/controller-removal.test.ts
@@ -0,0 +1,83 @@
+import fs from "fs";
+import path from "path";
+
+describe("controller removal and direct OTel receiver verification", () => {
+	const repoRoot = path.resolve(__dirname, "../../../../..");
+	const clientRoot = path.resolve(__dirname, "../../..");
+
+	it("removes opamp-server directory and controller server-side assets", () => {
+		const opampDir = path.join(repoRoot, "src/opamp-server");
+		expect(fs.existsSync(opampDir)).toBe(false);
+
+		const fleetHubApp = path.join(clientRoot, "src/app/(playground)/fleet-hub");
+		expect(fs.existsSync(fleetHubApp)).toBe(false);
+
+		const controllerApi = path.join(clientRoot, "src/app/api/controller");
+		expect(fs.existsSync(controllerApi)).toBe(false);
+
+		const fleetHubApi = path.join(clientRoot, "src/app/api/fleet-hub");
+		expect(fs.existsSync(fleetHubApi)).toBe(false);
+
+		const controllerLib = path.join(clientRoot, "src/lib/platform/controller");
+		expect(fs.existsSync(controllerLib)).toBe(false);
+
+		const fleetHubLib = path.join(clientRoot, "src/lib/platform/fleet-hub");
+		expect(fs.existsSync(fleetHubLib)).toBe(false);
+	});
+
+	it("removes controller frontend store slices and controller types", () => {
+		const storeSlice = path.join(
+			clientRoot,
+			"src/store/agents-instrumentation.ts"
+		);
+		expect(fs.existsSync(storeSlice)).toBe(false);
+
+		const selectorSlice = path.join(
+			clientRoot,
+			"src/selectors/agents-instrumentation.ts"
+		);
+		expect(fs.existsSync(selectorSlice)).toBe(false);
+
+		const controllerTypes = path.join(clientRoot, "src/types/controller.ts");
+		expect(fs.existsSync(controllerTypes)).toBe(false);
+	});
+
+	it("does not register controller tables in ClickHouse migrations", () => {
+		const migrationsDir = path.join(clientRoot, "src/clickhouse/migrations");
+		const migrationFiles = fs.readdirSync(migrationsDir);
+		expect(
+			migrationFiles.some((f) => f.toLowerCase().includes("controller"))
+		).toBe(false);
+
+		const indexTs = fs.readFileSync(
+			path.join(migrationsDir, "index.ts"),
+			"utf-8"
+		);
+		expect(indexTs).not.toContain("CreateControllerMigration");
+		expect(indexTs).not.toContain("openlit_controller");
+	});
+
+	it("starts otelcontribcol directly with signal handling in entrypoint.sh", () => {
+		const entrypointPath = path.join(clientRoot, "scripts/entrypoint.sh");
+		expect(fs.existsSync(entrypointPath)).toBe(true);
+		const content = fs.readFileSync(entrypointPath, "utf-8");
+
+		expect(content).not.toContain("opamp-server");
+		expect(content).not.toContain("opamp-supervisor");
+		expect(content).toContain("otelcontribcol");
+		expect(content).toMatch(/trap\s+.*SIGTERM/);
+		expect(content).toMatch(/trap\s+.*SIGINT/);
+		expect(content).toContain("shutdown_collector");
