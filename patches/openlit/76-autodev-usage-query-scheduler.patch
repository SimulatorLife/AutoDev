diff --git a/src/client/src/lib/autodev/usage-query-scheduler.ts b/src/client/src/lib/autodev/usage-query-scheduler.ts
new file mode 100644
--- /dev/null
+++ b/src/client/src/lib/autodev/usage-query-scheduler.ts
@@ -0,0 +1,41 @@
+/**
+ * Process-wide FIFO scheduler for the fixed Usage API's ClickHouse reads.
+ * Keeping queued work here (rather than fanning out pool acquisitions) makes
+ * concurrent Usage requests share one conservative query concurrency budget.
+ */
+export const USAGE_QUERY_CONCURRENCY = 8;
+
+type QueryTask<T> = () => Promise<T>;
+type QueuedQuery = {
+	run: () => Promise<void>;
+};
+
+const queue: QueuedQuery[] = [];
+let active = 0;
+
+/** Run one Usage query in FIFO order, never starting more than eight at once. */
+export function runUsageQuery<T>(task: QueryTask<T>): Promise<T> {
+	return new Promise<T>((resolve, reject) => {
+		queue.push({
+			run: async () => {
+				try {
+					resolve(await task());
+				} catch (error) {
+					reject(error);
+				}
+			},
+		});
+		drain();
+	});
+}
+
+function drain(): void {
+	while (active < USAGE_QUERY_CONCURRENCY && queue.length > 0) {
+		const query = queue.shift()!;
+		active++;
+		void query.run().finally(() => {
+			active--;
+			drain();
+		});
+	}
+}
diff --git a/src/client/src/__tests__/lib/autodev/usage-query-scheduler.test.ts b/src/client/src/__tests__/lib/autodev/usage-query-scheduler.test.ts
new file mode 100644
--- /dev/null
+++ b/src/client/src/__tests__/lib/autodev/usage-query-scheduler.test.ts
@@ -0,0 +1,38 @@
+import {
+	runUsageQuery,
+	USAGE_QUERY_CONCURRENCY,
+} from "@/lib/autodev/usage-query-scheduler";
+
+describe("fixed Usage query scheduler", () => {
+	it("bounds overlapping Usage batches and starts queued reads in FIFO order", async () => {
+		let active = 0;
+		let peak = 0;
+		const starts: number[] = [];
+		let releaseFirstWave!: () => void;
+		const firstWave = new Promise<void>((resolve) => {
+			releaseFirstWave = resolve;
+		});
+		const tasks = Array.from({ length: 24 }, (_, index) => () =>
+			runUsageQuery(async () => {
+				starts.push(index);
+				active++;
+				peak = Math.max(peak, active);
+				if (index === USAGE_QUERY_CONCURRENCY - 1) releaseFirstWave();
+				if (index >= USAGE_QUERY_CONCURRENCY) await firstWave;
+				await Promise.resolve();
+				active--;
+				return index;
+			}),
+		);
+
+		const [firstBatch, overlappingBatch] = await Promise.all([
+			Promise.all(tasks.slice(0, 12).map((task) => task())),
+			Promise.all(tasks.slice(12).map((task) => task())),
+		]);
+
+		expect([...firstBatch, ...overlappingBatch]).toHaveLength(24);
+		expect(peak).toBeLessThanOrEqual(USAGE_QUERY_CONCURRENCY);
+		expect(peak).toBe(USAGE_QUERY_CONCURRENCY);
+		expect(starts).toEqual(Array.from({ length: 24 }, (_, index) => index));
+	});
+});
