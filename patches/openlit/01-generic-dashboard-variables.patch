diff --git a/src/client/src/lib/platform/dashboard-variables/translate.ts b/src/client/src/lib/platform/dashboard-variables/translate.ts
new file mode 100644
index 0000000..0ae3738
--- /dev/null
+++ b/src/client/src/lib/platform/dashboard-variables/translate.ts
@@ -0,0 +1,310 @@
+import type {
+	AttributeScope,
+	NormalizedFilter,
+	Signal,
+} from "@/lib/platform/connectors/datasource/types";
+
+/**
+ * Generic non-time dashboard variable: a typed, schema-driven binding
+ * between a dashboard UI control and a single telemetry attribute key on a
+ * single signal.
+ *
+ * The variable system is schema-driven: the instrumentation/resource schema
+ * owns the attribute key. Application-specific field names are not hardwired
+ * into this reusable binding layer.
+ *
+ * Variables are declared on a board, reference an attribute via
+ * `(scope, key)` (e.g. `("resource", "workspace.id")`,
+ * `("span", "gen_ai.system")`), and are bound into the typed
+ * `OpenLITQuery.filters` list at run time without touching SQL strings.
+ */
+export interface DashboardVariableSpec {
+	/** Unique identifier within the board; used as URL key and widget opt-in. */
+	id: string;
+	/** Display label shown next to the dropdown. */
+	label: string;
+	/** Telemetry signal this variable targets. */
+	signal: Signal;
+	/** Attribute scope (resource, span, log, metric). */
+	scope: AttributeScope;
+	/**
+	 * Attribute key used for the filter predicate. Must be a valid OTel
+	 * attribute identifier (e.g. `service.name`, `gen_ai.system`,
+	 * `workspace.id`).
+	 */
+	key: string;
+	/** Allow multi-select in the dropdown UI. */
+	multi: boolean;
+	/** Support an "All" sentinel (empty selection => no filter added). */
+	supportsAll: boolean;
+	/** Default values selected when the board first loads. */
+	defaultValues?: string[];
+	/**
+	 * Explicit telemetry source binding override; when omitted, the
+	 * project's per-signal binding is used (same fallback as widgets).
+	 */
+	sourceId?: string | null;
+	/**
+	 * Static enumeration of allowed values. When omitted, the UI fetches
+	 * `distinctValues(key, query)` from the bound source.
+	 */
+	allowedValues?: string[];
+}
+
+/**
+ * Widget opt-in: list of dashboard variable ids the widget depends on.
+ * Widgets that do not declare a variable ignore its selection entirely. A
+ * widget that declares a variable receives its translated filters when the
+ * variable has a non-empty selection.
+ */
+export type DashboardVariableOptIn = string[];
+
+export interface DashboardVariableState {
+	/** id -> selected values; empty array = All (when supported) or unset. */
+	values: Record<string, string[]>;
+	/** Source of the current selection, used for debugging only. */
+	source: "url" | "default" | "localStorage";
+}
+
+/** URL prefix used for variable values when persisted to query string. */
+export const DASHBOARD_VARIABLE_URL_PREFIX = "dashboard_var_";
+
+/**
+ * Translate a single dashboard variable's selected values into a normalized
+ * filter. Returns `null` when no filter should be added (All selection or
+ * no values).
+ *
+ * Always parameter-safe: values flow through `NormalizedFilter.value` and
+ * are passed to adapters as typed inputs. Adapters translate them into the
+ * vendor's native query language without string interpolation.
+ *
+ * The optional `opts.scopeOverride` lets a widget re-bind the variable to a
+ * different attribute scope (e.g. span -> resource) at query time without
+ * mutating the board spec. The override is only honored after it is validated
+ * against the variable's signal via `isDashboardVariableBindingValid`; an
+ * invalid override fails closed by dropping the filter. When the override is
+ * valid but no selection is present, the function still returns `null`
+ * (the All sentinel). When the override is absent, the spec's declared
+ * scope is used unchanged.
+ */
+const VALID_SCOPES_BY_SIGNAL: Partial<
+	Record<Signal, ReadonlySet<AttributeScope>>
+> = {
+	traces: new Set<AttributeScope>(["resource", "span"]),
+	logs: new Set<AttributeScope>(["resource", "log"]),
+	metrics: new Set<AttributeScope>(["resource", "metric"]),
+};
+const ATTRIBUTE_KEY_PATTERN = /^[A-Za-z][A-Za-z0-9_.*-]{0,127}$/;
+
+export function isDashboardVariableBindingValid(
+	signal: Signal,
+	scope: AttributeScope,
+): boolean {
+	return VALID_SCOPES_BY_SIGNAL[signal]?.has(scope) ?? false;
+}
+
+/**
+ * List every AttributeScope a signal accepts. Used by the widget opt-in
+ * editor to expose a per-widget scope override only when more than one
+ * scope is valid for the variable's signal.
+ */
+export function scopesForSignal(signal: Signal): AttributeScope[] {
+	return Array.from(VALID_SCOPES_BY_SIGNAL[signal] ?? new Set<AttributeScope>());
+}
+
+/**
+ * Resolve the effective AttributeScope for a variable, honoring an optional
+ * per-widget override. The override must be a scope the signal accepts;
+ * anything else returns `null` so the caller fails closed.
+ *
+ * The spec is never mutated: this is a pure read.
+ */
+export function resolveVariableScope(
+	spec: DashboardVariableSpec,
+	scopeOverride: AttributeScope | undefined,
+): AttributeScope | null {
+	if (!isDashboardVariableBindingValid(spec.signal, spec.scope)) {
+		return null;
+	}
+	if (scopeOverride === undefined) {
+		return spec.scope;
+	}
+	if (!isDashboardVariableBindingValid(spec.signal, scopeOverride)) {
+		// Invalid override: fail closed. The caller drops the filter so a
+		// hand-edited board cannot widen a resource-only variable to a span
+		// key by injecting a bogus scope.
+		return null;
+	}
+	return scopeOverride;
+}
+
+export function variableToFilter(
+	spec: DashboardVariableSpec,
+	selection: string[] | undefined,
+	opts: { scopeOverride?: AttributeScope } = {},
+): NormalizedFilter | null {
+	if (
+		!isDashboardVariableBindingValid(spec.signal, spec.scope) ||
+		!ATTRIBUTE_KEY_PATTERN.test(spec.key)
+	) {
+		return null;
+	}
+	if (!Array.isArray(selection) || selection.length === 0) {
+		// All (empty) or unset: do not push a predicate.
+		return null;
+	}
+	const effectiveScope = resolveVariableScope(spec, opts.scopeOverride);
+	if (effectiveScope === null) {
+		// Invalid override or invalid spec scope: drop the filter rather
+		// than silently binding it to the wrong attribute map.
+		return null;
+	}
+	if (spec.multi && selection.length > 1) {
+		return {
+			target: "attribute",
+			scope: effectiveScope,
+			key: spec.key,
+			op: "in",
+			value: selection.slice(),
+		};
+	}
+	return {
+		target: "attribute",
+		scope: effectiveScope,
+		key: spec.key,
