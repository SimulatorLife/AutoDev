+import { OPENLIT_BOARD_TABLE_NAME } from "@/lib/platform/manage-dashboard/table-details";
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "add-board-variables-column";
+
+/**
+ * Adds a `variables` column to the `openlit_board` table. The column holds a
+ * JSON-encoded array of `DashboardVariableSpec` records declared on the board;
+ * the dashboard editor writes the column on layout save, and the board layout
+ * reader decodes it back into the typed `Board.variables` field. The column is
+ * safe to add on stacks where the board table already exists because of the
+ * `IF NOT EXISTS` modifier and the `DEFAULT '[]'` so older rows survive.
+ */
+export default async function AddBoardVariablesColumnMigration(
+	databaseConfigId?: string
+) {
+	const queries = [
+		`ALTER TABLE ${OPENLIT_BOARD_TABLE_NAME} ADD COLUMN IF NOT EXISTS variables String DEFAULT '[]';`,
+	];
+
+	return migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+}
