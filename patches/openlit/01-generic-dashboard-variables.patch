+"use client";
+
+import { useCallback } from "react";
+import type {
+	AttributeScope,
+	DashboardVariableOptIn,
+	DashboardVariableSpec,
+} from "@/lib/platform/dashboard-variables";
+import {
+	isDashboardVariableBindingValid,
+	scopesForSignal,
+} from "@/lib/platform/dashboard-variables";
+
+/**
+ * Per-widget variable opt-in editor. Lists the variables declared on the
+ * board and lets the user toggle which ones this widget follows. When the
+ * widget declares no opt-in list, it follows every variable on its signal
+ * (the stock behaviour). When the list is present, declared variables
+ * receive their translated filters when their selection is non-empty;
+ * undeclared variables are dropped.
+ *
+ * When the variable's signal allows more than one AttributeScope (e.g.
+ * traces: { resource, span }) the editor exposes a per-variable scope
+ * override selector for opted-in variables. The override is a pure read at
+ * query time — the board spec is never mutated — and the binding layer
+ * validates the override against the signal's allowed scopes, failing
+ * closed on invalid input.
+ *
+ * Persistence is the parent's responsibility: `onChangeOptIn` receives the
+ * new opt-in list and `onChangeScopeOverrides` receives the new override
+ * map; the dashboard editor writes them back to the widget's
+ * `properties.optInVariables` and `properties.variableScopeOverrides`
+ * fields on save.
+ */
+export interface WidgetOptInEditorProps {
+	specs: DashboardVariableSpec[];
+	optIn: DashboardVariableOptIn | undefined;
+	/**
+	 * Per-widget scope override map. When a variable is opted in and the
+	 * signal allows multiple scopes, the editor exposes a small selector to
+	 * set the override. The map is the typed `Record<variableId,
+	 * AttributeScope>` shape stored on the widget; omitted variables use the
+	 * spec's declared scope unchanged.
+	 */
+	scopeOverrides: Record<string, AttributeScope> | undefined;
+	onChangeOptIn: (next: DashboardVariableOptIn | undefined) => void;
+	onChangeScopeOverrides: (
+		next: Record<string, AttributeScope> | undefined,
+	) => void;
+	widgetSignal: string;
+}
+
+const SCOPE_LABEL: Record<AttributeScope, string> = {
+	resource: "resource",
+	span: "span",
+	log: "log",
+	metric: "metric",
+};
+
+export function WidgetOptInEditor({
+	specs,
+	optIn,
+	scopeOverrides,
+	onChangeOptIn,
+	onChangeScopeOverrides,
+	widgetSignal,
+}: WidgetOptInEditorProps) {
+	const compatible = specs.filter((spec) => spec.signal === widgetSignal);
+	const allowedScopes = scopesForSignal(widgetSignal as DashboardVariableSpec["signal"]);
+	const showScopeOverride = allowedScopes.length > 1;
+
+	const isAll = optIn === undefined;
+	const isChecked = useCallback(
+		(id: string) => {
+			if (optIn === undefined) return true;
+			return optIn.includes(id);
+		},
+		[optIn],
+	);
+
+	const toggle = useCallback(
+		(id: string) => {
+			if (optIn === undefined) {
+				// Switching from "all" to "explicit": seed with everything
+				// except the toggled id so the user-visible behaviour matches
+				// the checkbox state.
+				onChangeOptIn(compatible.map((s) => s.id).filter((sid) => sid !== id));
+				return;
+			}
+			if (optIn.includes(id)) {
+				onChangeOptIn(optIn.filter((sid) => sid !== id));
+			} else {
+				onChangeOptIn([...optIn, id]);
+			}
+		},
+		[compatible, optIn, onChangeOptIn],
+	);
+
+	const setAll = useCallback(
+		(next: boolean) => {
+			if (next) onChangeOptIn(undefined);
+			else onChangeOptIn([]);
+		},
+		[onChangeOptIn],
+	);
+
+	const setScopeOverride = useCallback(
+		(id: string, scope: AttributeScope | "") => {
+			const next = { ...(scopeOverrides ?? {}) };
+			if (scope === "") {
+				delete next[id];
+			} else {
+				next[id] = scope;
+			}
+			const cleaned: Record<string, AttributeScope> = {};
+			for (const [k, v] of Object.entries(next)) {
+				if (typeof v === "string" && isDashboardVariableBindingValid(
+					compatible.find((s) => s.id === k)?.signal ?? (widgetSignal as DashboardVariableSpec["signal"]),
+					v as AttributeScope,
+				)) {
+					cleaned[k] = v as AttributeScope;
+				}
+			}
+			onChangeScopeOverrides(
+				Object.keys(cleaned).length === 0 ? undefined : cleaned,
+			);
+		},
+		[compatible, onChangeScopeOverrides, scopeOverrides, widgetSignal],
+	);
+
+	if (compatible.length === 0) {
+		return (
+			<p className="text-xs text-stone-500">
+				No variables declared for this signal on the board.
+			</p>
+		);
+	}
+
+	return (
+		<div className="space-y-2" data-dashboard-widget-opt-in="1">
+			<div className="flex items-center justify-between">
+				<p className="text-xs font-semibold uppercase tracking-wide text-stone-500">
+					Widget variable opt-in
+				</p>
+				<label className="text-xs flex items-center gap-1">
+					<input
+						type="checkbox"
+						checked={isAll}
+						onChange={(e) => setAll(e.target.checked)}
+					/>
+					follow all variables on signal
+				</label>
+			</div>
+			<ul className="space-y-1 text-xs">
+				{compatible.map((spec) => {
+					const isOptedIn = isChecked(spec.id);
+					const currentOverride = scopeOverrides?.[spec.id];
+					return (
+						<li
+							key={spec.id}
+							className="flex items-center justify-between rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-2 py-1"
+						>
+							<span>
+								<code className="font-mono text-stone-500">{spec.id}</code>
+								<span className="ml-2 text-stone-500">{spec.label}</span>
+								<span className="ml-2 text-[10px] text-stone-400">
+									(default scope: {SCOPE_LABEL[spec.scope]})
+								</span>
+							</span>
+							<div className="flex items-center gap-2">
+								{showScopeOverride && isOptedIn ? (
+									<select
+										data-dashboard-widget-scope-override={spec.id}
+										className="h-6 rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-1 text-[10px]"
+										value={currentOverride ?? ""}
+										onChange={(e) =>
+											setScopeOverride(
+												spec.id,
+												e.target.value as AttributeScope | "",
+											)
+										}
+										title={`Bind ${spec.id} to a different attribute scope for this widget`}
+									>
+										<option value="">default ({SCOPE_LABEL[spec.scope]})</option>
+										{allowedScopes.map((scope) => (
+											<option key={scope} value={scope}>
+												override: {scope}
+											</option>
+										))}
+									</select>
+								) : null}
+								<label className="flex items-center gap-1">
+									<input
+										type="checkbox"
+										checked={isOptedIn}
+										onChange={() => toggle(spec.id)}
+									/>
+									{isOptedIn ? "follows" : "ignored"}
+								</label>
+							</div>
+						</li>
+					);
+				})}
+			</ul>
+			{showScopeOverride ? (
+				<p className="text-[10px] text-stone-500">
+					Scope overrides re-bind an opted-in variable to a different
+					attribute scope for this widget only; the board spec is not
+					mutated. Invalid overrides fail closed.
+				</p>
+			) : null}
+		</div>
+	);
+}
