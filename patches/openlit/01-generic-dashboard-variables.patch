+					Dashboard variables
+				</h3>
+				<div className="flex gap-2">
+					<Button
+						type="button"
+						variant="outline"
+						size="sm"
+						className="h-7"
+						onClick={append}
+					>
+						<Plus className="h-3 w-3 mr-1" /> Add variable
+					</Button>
+					<Button
+						type="button"
+						size="sm"
+						className="h-7"
+						onClick={commit}
+						disabled={draft.some((s) => validate(s) !== null) || dupes.length > 0}
+					>
+						Save variables
+					</Button>
+				</div>
+			</div>
+			{dupes.length > 0 ? (
+				<p className="text-xs text-amber-700 dark:text-amber-300">
+					duplicate ids: {dupes.join(", ")}
+				</p>
+			) : null}
+			{draft.length === 0 ? (
+				<p className="text-xs text-stone-500">
+					No non-time variables declared. The stock time-range control
+					remains authoritative; widgets that opt in to a variable
+					ignore its selection.
+				</p>
+			) : (
+				<ul className="space-y-3">
+					{draft.map((spec, index) => {
+						const err = validate(spec);
+						return (
+							<li
+								key={`${spec.id}-${index}`}
+								className="rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-3"
+							>
+								<div className="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
+									<label className="space-y-1">
+										<span className="text-stone-500">id</span>
+										<Input
+											value={spec.id}
+											className="h-7"
+											onChange={(e) =>
+												updateAt(index, { id: e.target.value })
+											}
+										/>
+									</label>
+									<label className="space-y-1">
+										<span className="text-stone-500">label</span>
+										<Input
+											value={spec.label}
+											className="h-7"
+											onChange={(e) =>
+												updateAt(index, { label: e.target.value })
+											}
+										/>
+									</label>
+									<label className="space-y-1">
+										<span className="text-stone-500">signal</span>
+										<Select
+											value={spec.signal}
+											onValueChange={(v) =>
+												updateAt(index, { signal: v as Signal })
+											}
+										>
