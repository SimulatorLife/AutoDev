+										<label className="flex items-center gap-1">
+											<input
+												type="checkbox"
+												checked={spec.multi}
+												onChange={(e) =>
+													updateAt(index, { multi: e.target.checked })
+												}
+											/>
+											multi-select
+										</label>
+										<label className="flex items-center gap-1">
+											<input
+												type="checkbox"
+												checked={spec.supportsAll}
+												onChange={(e) =>
+													updateAt(index, {
+														supportsAll: e.target.checked,
+													})
+												}
+											/>
+											supports All
+										</label>
+										<Button
+											type="button"
+											variant="ghost"
+											size="sm"
+											className="ml-auto h-7 px-2 text-amber-700"
+											onClick={() => removeAt(index)}
+										>
+											<Trash2 className="h-3 w-3 mr-1" /> remove
+										</Button>
+									</div>
+								</div>
+								{err ? (
+									<p className="mt-2 text-xs text-amber-700 dark:text-amber-300">
+										{err}
+									</p>
+								) : null}
+							</li>
+						);
+					})}
+				</ul>
+			)}
+			<Label className="text-xs text-stone-500">
+				Variable bindings never interpolate values into SQL. The widget
+				query layer applies the typed NormalizedFilter via
+				OpenLITQuery.filters.
+			</Label>
+		</div>
+	);
+}
