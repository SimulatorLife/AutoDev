diff --git a/src/client/src/__tests__/lib/platform/dashboard-variables/distinct-values.test.ts b/src/client/src/__tests__/lib/platform/dashboard-variables/distinct-values.test.ts
new file mode 100644
index 00000000..5fcbdc90
--- /dev/null
+++ b/src/client/src/__tests__/lib/platform/dashboard-variables/distinct-values.test.ts
@@ -0,0 +1,146 @@
+/**
+ * Generic typed source binding tests for dashboard variable
+ * `distinctValues` lookup. The dashboard editor calls
+ * `fetchVariableAllowedValues` to populate the dropdown for variables
+ * that do NOT carry a hand-curated `allowedValues` array; the binding
+ * layer is the typed `distinctValues(scopedKey, query)` adapter method.
+ *
+ * This test ensures the binding:
+ *
+ *   - Returns `{ supported: false }` when the bound adapter does not
+ *     advertise the capability (and never throws UnsupportedCapabilityError
+ *     to the caller).
+ *   - Returns the adapter's distinct values when the capability is on.
+ *   - Never composes a SQL string with user-controlled values.
+ *   - Clamps the result to the requested limit.
+ */
+
+import {
+	distinctValueLookupKey,
+	fetchVariableAllowedValues,
+} from "@/lib/platform/dashboard-variables";
+import { UnsupportedCapabilityError } from "@/lib/platform/connectors/datasource/types";
+import type { DataSourceAdapter } from "@/lib/platform/connectors/datasource/types";
+
+function fakeAdapter(
+	overrides: Partial<DataSourceAdapter> = {},
+): DataSourceAdapter {
+	return {
+		type: "fake",
+		capabilities: () => ({
+			signals: ["traces"],
+			traceTree: false,
+			spanEvents: false,
+			serverAggregation: false,
+			spanMutation: false,
+			distinctValues: true,
+			crossTraceSession: false,
+			rawQuery: false,
+		}),
+		distinctValues: async () => ["alpha", "beta", "gamma"],
+		...overrides,
+	} as unknown as DataSourceAdapter;
+}
+
+describe("distinctValueLookupKey", () => {
+	it("qualifies trace attributes by scope and rejects mismatched signal scopes", () => {
+		expect(distinctValueLookupKey("traces", "resource", "service.name")).toBe(
+			"resource:service.name",
+		);
+		expect(distinctValueLookupKey("traces", "span", "gen_ai.system")).toBe(
+			"span:gen_ai.system",
+		);
+		expect(distinctValueLookupKey("logs", "span", "service.name")).toBeNull();
+	});
+});
+
+describe("fetchVariableAllowedValues", () => {
+	it("returns { supported: true } and the adapter values when supported", async () => {
+		const queriedKeys: string[] = [];
+		const result = await fetchVariableAllowedValues({
+			adapter: fakeAdapter({
+				distinctValues: async (key) => {
+					queriedKeys.push(key);
+					return ["alpha", "beta", "gamma"];
+				},
+			}),
+			signal: "traces",
+			scope: "resource",
+			key: "service.name",
+			timeRange: {
+				start: new Date("2026-01-01T00:00:00Z"),
+				end: new Date("2026-01-02T00:00:00Z"),
+			},
+		});
+		expect(result.supported).toBe(true);
+		expect(result.values).toEqual(["alpha", "beta", "gamma"]);
+		expect(queriedKeys).toEqual(["resource:service.name"]);
+	});
+
+	it("returns { supported: false } when adapter has no distinctValues capability", async () => {
+		const result = await fetchVariableAllowedValues({
+			adapter: fakeAdapter({
+				capabilities: () => ({
+					signals: ["traces"],
+					traceTree: false,
+					spanEvents: false,
+					serverAggregation: false,
+					spanMutation: false,
+					distinctValues: false,
+					crossTraceSession: false,
+					rawQuery: false,
+				}) as never,
+			}),
+			signal: "traces",
+			scope: "resource",
+			key: "service.name",
+			timeRange: {
+				start: new Date("2026-01-01T00:00:00Z"),
+				end: new Date("2026-01-02T00:00:00Z"),
+			},
+		});
+		expect(result.supported).toBe(false);
+		expect(result.values).toEqual([]);
+	});
+
+	it("returns { supported: false } when adapter throws UnsupportedCapabilityError", async () => {
+		const result = await fetchVariableAllowedValues({
+			adapter: fakeAdapter({
+				distinctValues: async () => {
+					throw new UnsupportedCapabilityError(
+						"fake",
+						"distinctValues",
+						"not supported",
+					);
+				},
+			}),
+			signal: "traces",
+			scope: "resource",
+			key: "service.name",
+			timeRange: {
+				start: new Date("2026-01-01T00:00:00Z"),
+				end: new Date("2026-01-02T00:00:00Z"),
+			},
+		});
+		expect(result.supported).toBe(false);
+		expect(result.values).toEqual([]);
+	});
+
+	it("clamps the result to the requested limit", async () => {
+		const big = Array.from({ length: 100 }, (_, i) => `value-${i}`);
+		const result = await fetchVariableAllowedValues({
+			adapter: fakeAdapter({
+				distinctValues: async () => big,
+			}),
+			signal: "traces",
+			scope: "resource",
+			key: "service.name",
+			timeRange: {
+				start: new Date("2026-01-01T00:00:00Z"),
+				end: new Date("2026-01-02T00:00:00Z"),
+			},
+			limit: 5,
+		});
+		expect(result.values.length).toBe(5);
+	});
+});
diff --git a/src/client/src/__tests__/lib/platform/dashboard-variables/translate.test.ts b/src/client/src/__tests__/lib/platform/dashboard-variables/translate.test.ts
new file mode 100644
index 0000000..9c7b390
--- /dev/null
+++ b/src/client/src/__tests__/lib/platform/dashboard-variables/translate.test.ts
@@ -0,0 +1,408 @@
+import {
+	applyDashboardVariables,
+	isDashboardVariableBindingValid,
+	parseVariableSelection,
+	readVariablesFromSearchParams,
+	resolveVariableScope,
+	scopesForSignal,
+	serializeVariableSelection,
+	variableToFilter,
+	variablesToSearchParams,
+	DASHBOARD_VARIABLE_URL_PREFIX,
+} from "@/lib/platform/dashboard-variables/translate";
+import type {
+	DashboardVariableSpec,
+	NormalizedQueryLike,
+} from "@/lib/platform/dashboard-variables/translate";
+import type { OpenLITQuery } from "@/lib/platform/connectors/datasource/types";
+
+const SPECS: DashboardVariableSpec[] = [
+	{
+		id: "workspace",
+		label: "Workspace",
+		signal: "traces",
+		scope: "resource",
+		key: "workspace.id",
+		multi: false,
+		supportsAll: true,
+		defaultValues: ["default"],
+	},
+	{
+		id: "provider",
+		label: "Provider",
+		signal: "traces",
+		scope: "span",
+		key: "gen_ai.system",
+		multi: true,
+		supportsAll: true,
+		defaultValues: [],
+	},
+	{
+		id: "metric-name",
+		label: "Metric",
+		signal: "metrics",
+		scope: "metric",
+		key: "metric.name",
+		multi: false,
+		supportsAll: false,
+	},
+	{
+		// Span-scoped workspace variable. The override path lets one widget
+		// re-bind it to `resource` while another keeps the declared scope.
+		id: "workspace-span",
+		label: "Workspace (span)",
+		signal: "traces",
+		scope: "span",
+		key: "workspace.id",
+		multi: false,
+		supportsAll: true,
+		defaultValues: [],
+	},
+];
+
+// `OpenLITQuery` is structurally a `NormalizedQueryLike`, but the upstream
+// type doesn't declare an index signature. Cast once at the test boundary.
+function asNormalized(q: OpenLITQuery): NormalizedQueryLike {
+	return q as unknown as NormalizedQueryLike;
+}
+
+describe("variableToFilter", () => {
+	it("accepts only scopes supported by the variable signal", () => {
+		expect(isDashboardVariableBindingValid("traces", "resource")).toBe(true);
+		expect(isDashboardVariableBindingValid("traces", "span")).toBe(true);
+		expect(isDashboardVariableBindingValid("logs", "log")).toBe(true);
+		expect(isDashboardVariableBindingValid("metrics", "metric")).toBe(true);
+		expect(isDashboardVariableBindingValid("logs", "span")).toBe(false);
+	});
+
+	it("returns null for empty / All selection", () => {
+		expect(variableToFilter(SPECS[0], undefined)).toBeNull();
+		expect(variableToFilter(SPECS[0], [])).toBeNull();
+	});
+
+	it("emits eq for a single non-All value", () => {
+		expect(variableToFilter(SPECS[0], ["alpha"])).toEqual({
+			target: "attribute",
+			scope: "resource",
+			key: "workspace.id",
+			op: "eq",
+			value: "alpha",
+		});
+	});
+
+	it("emits in for multi-select with more than one value", () => {
+		expect(variableToFilter(SPECS[1], ["openai", "anthropic"])).toEqual({
+			target: "attribute",
+			scope: "span",
+			key: "gen_ai.system",
+			op: "in",
+			value: ["openai", "anthropic"],
+		});
+	});
+});
+
+describe("applyDashboardVariables", () => {
+	const baseQuery: OpenLITQuery = {
+		signal: "traces",
+		timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+		filters: [
+			{
+				target: "attribute",
+				scope: "span",
+				key: "gen_ai.operation.name",
+				op: "eq",
+				value: "chat",
+			},
+		],
+	};
+
+	it("prepends variable filters and preserves existing filters", () => {
+		const out = applyDashboardVariables(asNormalized(baseQuery), SPECS, {
+			values: {
+				workspace: ["alpha"],
+				provider: ["openai", "anthropic"],
+				"metric-name": [], // signal mismatch => ignored
+			},
+		});
+		expect(out.signal).toBe("traces");
+		expect(out.filters).toHaveLength(3);
+		// Variable filters come first so they short-circuit irrelevant rows
+		// before the existing attribute filter runs.
+		expect(out.filters?.[0]).toMatchObject({
+			key: "workspace.id",
+			op: "eq",
+			value: "alpha",
+		});
+		expect(out.filters?.[1]).toMatchObject({
+			key: "gen_ai.system",
+			op: "in",
+			value: ["openai", "anthropic"],
+		});
+		// Existing filter is preserved verbatim.
+		expect(out.filters?.[2]).toEqual(baseQuery.filters?.[0]);
+	});
+
+	it("ignores variables whose selection is empty / All", () => {
+		const out = applyDashboardVariables(asNormalized(baseQuery), SPECS, {
+			values: {
+				workspace: [],
+				provider: [],
+			},
+		});
+		expect(out.filters).toEqual(baseQuery.filters);
+	});
+
+	it("skips variables whose signal does not match the query", () => {
+		const out = applyDashboardVariables(asNormalized(baseQuery), SPECS, {
+			values: { "metric-name": ["request_total"] },
+		});
+		expect(out.filters).toEqual(baseQuery.filters);
+	});
+
+	it("honors widget opt-in: undeclared variables are dropped", () => {
+		const out = applyDashboardVariables(
+			asNormalized(baseQuery),
+			SPECS,
+			{
+				values: {
+					workspace: ["alpha"],
+					provider: ["openai"],
+				},
+			},
+			{ widgetOptIn: ["provider"] },
+		);
+		expect(out.filters).toHaveLength(2);
+		expect(out.filters?.[0]).toMatchObject({ key: "gen_ai.system" });
+		expect(out.filters?.[1]).toEqual(baseQuery.filters?.[0]);
+	});
+
+	it("never interpolates user-controlled values into SQL strings", () => {
+		const out = applyDashboardVariables(asNormalized(baseQuery), SPECS, {
+			values: { workspace: ["'; DROP TABLE otel_traces; --"] },
+		});
+		// The value flows through the typed filter pipeline, never a SQL
+		// string; this assertion exists so a future regression that
+		// reintroduces string concatenation is caught at the type level.
+		expect(out.filters?.[0]).toMatchObject({
+			op: "eq",
+			value: "'; DROP TABLE otel_traces; --",
+		});
+	});
+});
+
+describe("widget-level scope overrides", () => {
+	const SPAN_WORKSPACE: DashboardVariableSpec = {
+		id: "workspace-span",
+		label: "Workspace (span)",
+		signal: "traces",
+		scope: "span",
+		key: "workspace.id",
+		multi: false,
+		supportsAll: true,
+	};
+
+	it("lists the scopes a signal accepts", () => {
+		expect(scopesForSignal("traces").sort()).toEqual(["resource", "span"]);
+		expect(scopesForSignal("logs").sort()).toEqual(["log", "resource"]);
+		expect(scopesForSignal("metrics").sort()).toEqual(["metric", "resource"]);
+	});
+
+	it("resolveVariableScope honors a valid override", () => {
+		expect(resolveVariableScope(SPAN_WORKSPACE, "resource")).toBe("resource");
+		expect(resolveVariableScope(SPAN_WORKSPACE, "span")).toBe("span");
+	});
+
+	it("resolveVariableScope returns the spec scope when no override is given", () => {
+		expect(resolveVariableScope(SPAN_WORKSPACE, undefined)).toBe("span");
+	});
+
+	it("resolveVariableScope fails closed on an invalid override", () => {
+		// `log` is not valid for `traces`; the override must be rejected.
+		expect(
+			resolveVariableScope(SPAN_WORKSPACE, "log" as unknown as "resource"),
+		).toBeNull();
+		// `metric` is also not valid for `traces`.
+		expect(
+			resolveVariableScope(SPAN_WORKSPACE, "metric" as unknown as "resource"),
+		).toBeNull();
+	});
+
+	it("variableToFilter reuses the spec scope when no override is supplied", () => {
+		expect(variableToFilter(SPAN_WORKSPACE, ["alpha"])).toEqual({
+			target: "attribute",
+			scope: "span",
+			key: "workspace.id",
+			op: "eq",
+			value: "alpha",
+		});
+	});
+
+	it("variableToFilter honors a valid override", () => {
+		expect(
+			variableToFilter(SPAN_WORKSPACE, ["alpha"], { scopeOverride: "resource" }),
+		).toEqual({
+			target: "attribute",
+			scope: "resource",
+			key: "workspace.id",
+			op: "eq",
+			value: "alpha",
+		});
+	});
+
+	it("variableToFilter returns null on an invalid override (fail closed)", () => {
+		expect(
+			variableToFilter(SPAN_WORKSPACE, ["alpha"], {
+				scopeOverride: "metric" as unknown as "resource",
+			}),
+		).toBeNull();
+	});
+
+	it("variableToFilter keeps the All sentinel: an empty selection never adds a filter", () => {
+		expect(
+			variableToFilter(SPAN_WORKSPACE, [], { scopeOverride: "resource" }),
+		).toBeNull();
+		expect(
+			variableToFilter(SPAN_WORKSPACE, undefined, { scopeOverride: "resource" }),
+		).toBeNull();
+	});
+
+	it("applyDashboardVariables uses the spec scope when no override is given", () => {
+		const out = applyDashboardVariables(
+			asNormalized({
+				signal: "traces",
+				timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+			}),
+			SPECS,
+			{ values: { "workspace-span": ["alpha"] } },
+		);
+		expect(out.filters?.[0]).toMatchObject({
+			key: "workspace.id",
+			scope: "span",
+			value: "alpha",
+		});
+	});
+
+	it("applyDashboardVariables binds one widget to resource while another stays span", () => {
+		const base = asNormalized({
+			signal: "traces",
+			timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+		});
+
+		// Widget A re-binds the span-scoped workspace variable to `resource`.
+		const outA = applyDashboardVariables(
+			base,
+			SPECS,
+			{ values: { "workspace-span": ["alpha"] } },
+			{ scopeOverrides: { "workspace-span": "resource" } },
+		);
+		expect(outA.filters).toHaveLength(1);
+		expect(outA.filters?.[0]).toMatchObject({
+			key: "workspace.id",
+			scope: "resource",
+			value: "alpha",
+		});
+
+		// Widget B keeps the spec's declared scope (`span`). The base query
+		// must be returned unchanged for the no-override caller, mirroring
+		// the existing behavior when overrides are absent.
+		const outB = applyDashboardVariables(
+			base,
+			SPECS,
+			{ values: { "workspace-span": ["alpha"] } },
+		);
+		expect(outB.filters).toHaveLength(1);
+		expect(outB.filters?.[0]).toMatchObject({
+			key: "workspace.id",
+			scope: "span",
+			value: "alpha",
+		});
+	});
+
+	it("applyDashboardVariables drops the filter on an invalid override", () => {
+		const base = asNormalized({
+			signal: "traces",
+			timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+		});
+		const out = applyDashboardVariables(
+			base,
+			SPECS,
+			{ values: { "workspace-span": ["alpha"] } },
+			{ scopeOverrides: { "workspace-span": "log" as unknown as "resource" } },
+		);
+		expect(out.filters).toBeUndefined();
+	});
+
+	it("applyDashboardVariables drops the filter on an All selection regardless of override", () => {
+		const base = asNormalized({
+			signal: "traces",
+			timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+		});
+		const out = applyDashboardVariables(
+			base,
+			SPECS,
+			{ values: { "workspace-span": [] } },
+			{ scopeOverrides: { "workspace-span": "resource" } },
+		);
+		expect(out.filters).toBeUndefined();
+	});
+
+	it("applyDashboardVariables ignores overrides for variables the widget does not opt into", () => {
+		const base = asNormalized({
+			signal: "traces",
+			timeRange: { start: new Date("2026-01-01"), end: new Date("2026-01-02") },
+		});
+		const out = applyDashboardVariables(
+			base,
+			SPECS,
+			{ values: { "workspace-span": ["alpha"], provider: ["openai"] } },
+			{ widgetOptIn: ["workspace-span"], scopeOverrides: { provider: "resource" } },
+		);
+		expect(out.filters).toHaveLength(1);
+		expect(out.filters?.[0]).toMatchObject({
+			key: "workspace.id",
+			scope: "span",
+			value: "alpha",
+		});
+	});
+});
+
+describe("URL persistence", () => {
+	it("round-trips an All selection through serialize/parse", () => {
+		expect(serializeVariableSelection([])).toBe("*");
+		expect(parseVariableSelection("*")).toEqual([]);
+		expect(parseVariableSelection(null)).toEqual([]);
+		expect(parseVariableSelection("")).toEqual([]);
+	});
+
+	it("round-trips a single value", () => {
+		expect(serializeVariableSelection(["alpha"])).toBe("alpha");
+		expect(parseVariableSelection("alpha")).toEqual(["alpha"]);
+	});
+
+	it("round-trips a multi-value selection with URL encoding", () => {
+		const original = ["openai", "anthropic", "value with space"];
+		const token = serializeVariableSelection(original);
+		expect(token).toBe("openai,anthropic,value%20with%20space");
+		expect(parseVariableSelection(token)).toEqual(original);
+	});
+
+	it("variablesToSearchParams emits the dashboard_var_ prefix", () => {
+		const params = variablesToSearchParams({
+			values: { workspace: ["alpha"], provider: [] },
+		});
+		expect(params.get(`${DASHBOARD_VARIABLE_URL_PREFIX}workspace`)).toBe("alpha");
+		// All / empty selection serializes to "*" so the URL is stable.
+		expect(params.get(`${DASHBOARD_VARIABLE_URL_PREFIX}provider`)).toBe("*");
+	});
+
+	it("readVariablesFromSearchParams ignores unrelated keys", () => {
+		const params = new URLSearchParams();
+		params.set("tr", "24H");
+		params.set(`${DASHBOARD_VARIABLE_URL_PREFIX}workspace`, "alpha");
+		params.set(`${DASHBOARD_VARIABLE_URL_PREFIX}provider`, "openai,anthropic");
+		expect(readVariablesFromSearchParams(params)).toEqual({
+			workspace: ["alpha"],
+			provider: ["openai", "anthropic"],
+		});
+	});
+});
