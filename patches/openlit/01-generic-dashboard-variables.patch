+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import type {
+	DashboardVariableSpec,
+	Signal,
+} from "@/lib/platform/dashboard-variables";
+import { isDashboardVariableBindingValid } from "@/lib/platform/dashboard-variables";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import {
+	Select,
+	SelectContent,
+	SelectItem,
+	SelectTrigger,
+	SelectValue,
+} from "@/components/ui/select";
+import { Trash2, Plus } from "lucide-react";
+
+/**
+ * Variable-definition editor. Lets the user declare, edit, and remove
+ * non-time dashboard variables persisted on the board. The editor is
+ * deliberately generic: it does NOT hard-wire application-specific field
+ * names; producers attach standard or custom attributes at the source, and
+ * the editor records the typed `(signal, scope, key)` triple plus selection
+ * semantics.
+ *
+ * `allowedValues` may be omitted. When omitted, the editor resolves the
+ * typed candidate list at render time by calling
+ * `/api/manage-dashboard/variables/distinct-values` — the typed
+ * `distinctValues(scopedKey, query)` source binding — and pre-populating the
+ * select. The route is parameterized so the editor never composes a SQL
+ * string with user-controlled values.
+ */
+const SIGNAL_OPTIONS: { value: Signal; label: string }[] = [
+	{ value: "traces", label: "Traces" },
+	{ value: "logs", label: "Logs" },
+	{ value: "metrics", label: "Metrics" },
+];
+
+const SCOPE_OPTIONS = [
+	{ value: "resource", label: "Resource attribute" },
+	{ value: "span", label: "Span attribute" },
+	{ value: "log", label: "Log attribute" },
+	{ value: "metric", label: "Metric attribute" },
+] as const;
+
+const VARIABLE_ID_PATTERN = /^[A-Za-z][A-Za-z0-9_-]{0,63}$/;
+const ATTRIBUTE_KEY_PATTERN = /^[A-Za-z][A-Za-z0-9_.*-]{0,127}$/;
+
+export interface DashboardVariableEditorProps {
+	specs: DashboardVariableSpec[];
+	onChange: (next: DashboardVariableSpec[]) => void;
+}
+
+function emptySpec(): DashboardVariableSpec {
+	return {
+		id: `var-${Math.random().toString(36).slice(2, 8)}`,
+		label: "New variable",
+		signal: "traces",
+		scope: "span",
+		key: "",
+		multi: false,
+		supportsAll: true,
+		defaultValues: [],
+		allowedValues: [],
+	};
+}
+
+function validate(spec: DashboardVariableSpec): string | null {
+	if (!VARIABLE_ID_PATTERN.test(spec.id)) {
+		return "id must be 1-64 chars, start with a letter, [A-Za-z0-9_-]";
+	}
+	if (spec.label.length === 0) return "label is required";
+	if (!isDashboardVariableBindingValid(spec.signal, spec.scope)) {
+		return "scope must match the selected telemetry signal";
+	}
+	if (!ATTRIBUTE_KEY_PATTERN.test(spec.key)) {
+		return "key must be a valid OTel attribute identifier";
+	}
+	return null;
+}
+
+export function DashboardVariableEditor({
+	specs,
+	onChange,
+}: DashboardVariableEditorProps) {
+	const [draft, setDraft] = useState<DashboardVariableSpec[]>(specs);
+
+	useEffect(() => {
+		setDraft(specs);
+	}, [specs]);
+
+	const updateAt = useCallback(
+		(index: number, patch: Partial<DashboardVariableSpec>) => {
+			setDraft((prev) => {
+				const next = prev.slice();
+				next[index] = { ...next[index], ...patch };
+				return next;
+			});
+		},
+		[],
+	);
+
+	const removeAt = useCallback((index: number) => {
+		setDraft((prev) => prev.filter((_, i) => i !== index));
+	}, []);
+
+	const append = useCallback(() => {
+		setDraft((prev) => [...prev, emptySpec()]);
+	}, []);
+
+	const commit = useCallback(() => {
+		onChange(draft);
+	}, [draft, onChange]);
+
+	const ids = new Set<string>();
+	const dupes: string[] = [];
+	for (const s of draft) {
+		if (ids.has(s.id)) dupes.push(s.id);
+		ids.add(s.id);
