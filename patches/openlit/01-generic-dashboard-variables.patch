index 00000000..4fde1846
--- /dev/null
+++ b/src/client/src/lib/platform/connectors/datasource/clickhouse/parameterized-query.ts
@@ -0,0 +1,164 @@
+import { agentLoopWhereSql } from "@/lib/platform/agent-loop/sql";
+import { generationHealthWhereSql } from "@/lib/platform/generation-health/sql";
+import { aiSelectorToClickHouse } from "../ai-selector";
+import type {
+	FilterOp,
+	NormalizedFilter,
+	OpenLITQuery
+} from "../types";
+
+const ATTRIBUTE_KEY_PATTERN = /^[A-Za-z][A-Za-z0-9_.*-]{0,127}$/;
+const ALLOWED_COLUMNS = new Set([
+	"SpanId",
+	"TraceId",
+	"ParentSpanId",
+	"SpanName",
+	"ServiceName",
+	"Duration",
+	"Timestamp",
+	"StatusCode",
+	"StatusMessage",
+	"SpanKind",
+	"TraceState",
+	"ScopeName",
+	"ScopeVersion"
+]);
+
+/**
+ * Builds ClickHouse structured-trace predicates with query_params. Dynamic
+ * map keys, values, and time bounds are never inserted into the SQL text.
+ */
+export class ParameterizedTraceQuery {
+	readonly queryParams: Record<string, unknown> = {};
+	private nextParamIndex = 0;
+
+	bind(value: unknown, type: string): string {
+		const name = `autodev_filter_${this.nextParamIndex++}`;
+		this.queryParams[name] = value;
+		return `{${name}:${type}}`;
+	}
+
+	fieldExpression(field: string): string {
+		const scoped = field.match(/^(span|resource):(.+)$/u);
+		if (scoped) {
+			const [, scope, key] = scoped;
+			return this.attributeExpression(scope === "resource" ? "resource" : "span", key);
+		}
+		if (field === "duration") return "Duration / 1000000000";
+		if (field === "service.name") return "ServiceName";
+		if (field === "deployment.environment") {
+			return this.attributeExpression("resource", field);
+		}
+		if (field === "gen_ai.provider.name" || field === "gen_ai.system") {
+			return "nullIf(coalesce(nullIf(SpanAttributes['gen_ai.provider.name'], ''), nullIf(SpanAttributes['gen_ai.system'], '')), '')";
+		}
+		if (ALLOWED_COLUMNS.has(field)) return field;
+		if (field.includes(".")) return this.attributeExpression("span", field);
+		throw new Error(`Unsupported ClickHouse field: ${field}`);
+	}
+
+	where(query: OpenLITQuery, tracesTable: string): string {
+		const clauses: string[] = [];
+		const start = this.bind(query.timeRange.start.toISOString(), "String");
+		const end = this.bind(query.timeRange.end.toISOString(), "String");
+		clauses.push(
+			`Timestamp >= parseDateTimeBestEffort(${start}) AND Timestamp <= parseDateTimeBestEffort(${end})`
+		);
+
+		for (const filter of query.filters || []) {
+			const clause = this.filterExpression(filter);
+			if (clause) clauses.push(clause);
+		}
+
+		if (query.aiSelector !== false) clauses.push(aiSelectorToClickHouse());
+
+		const generationHealth = generationHealthWhereSql(query.generationHealth);
+		if (generationHealth) clauses.push(generationHealth);
+
+		if (query.agentLoop) {
+			clauses.push(agentLoopWhereSql(tracesTable, clauses.join(" AND ")));
+		}
+
+		return clauses.join(" AND ");
+	}
+
+	private attributeExpression(scope: string, key: string): string {
+		if (!ATTRIBUTE_KEY_PATTERN.test(key)) {
+			throw new Error("Invalid ClickHouse attribute key");
+		}
+		if (scope !== "resource" && scope !== "span") {
+			throw new Error("Unsupported ClickHouse trace attribute scope");
+		}
+		if (scope === "resource" && key === "service.name") return "ServiceName";
+		const column = scope === "resource" ? "ResourceAttributes" : "SpanAttributes";
+		return `${column}[${this.bind(key, "String")}]`;
+	}
+
+	private filterExpression(filter: NormalizedFilter): string {
+		let expression: string;
+		switch (filter.target) {
+			case "attribute": {
+				if (!filter.key) return "";
+				expression = this.attributeExpression(filter.scope || "span", filter.key);
+				break;
+			}
+			case "spanName":
+				expression = "SpanName";
+				break;
+			case "status":
+				expression = "StatusCode";
+				break;
+			case "duration":
+				expression = "Duration / 1000000000";
+				break;
+			default:
+				return "";
+		}
+		return this.comparison(expression, filter.op, filter.value);
+	}
+
+	private comparison(
+		expression: string,
+		op: FilterOp,
+		rawValue: NormalizedFilter["value"]
+	): string {
+		if (op === "exists") return `notEmpty(toString(${expression}))`;
+		if (op === "notExists") return `empty(toString(${expression}))`;
+		if (rawValue === undefined) return "";
+
+		const values = Array.isArray(rawValue) ? rawValue : [rawValue];
+		if (!values.length) return op === "notIn" ? "1" : "0";
+		const numeric = values.every((value) => typeof value === "number");
+		const valueType = numeric ? "Float64" : "String";
+		const normalize = (value: string | number) =>
+			numeric ? Number(value) : String(value);
+		const scalar = () => this.bind(normalize(values[0]!), valueType);
+		const array = () =>
+			this.bind(values.map(normalize), `Array(${valueType})`);
+
+		switch (op) {
+			case "eq":
+				return `${expression} = ${scalar()}`;
+			case "neq":
+				return `${expression} != ${scalar()}`;
+			case "in":
+				return `${expression} IN ${array()}`;
+			case "notIn":
+				return `${expression} NOT IN ${array()}`;
+			case "gt":
+				return `${expression} > ${scalar()}`;
+			case "gte":
+				return `${expression} >= ${scalar()}`;
+			case "lt":
+				return `${expression} < ${scalar()}`;
+			case "lte":
+				return `${expression} <= ${scalar()}`;
+			case "contains": {
+				const value = this.bind(String(values[0]!), "String");
+				return `positionCaseInsensitive(toString(${expression}), ${value}) > 0`;
+			}
+			default:
+				return "";
+		}
+	}
+}
