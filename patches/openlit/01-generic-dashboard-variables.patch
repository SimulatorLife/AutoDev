diff --git a/src/client/src/lib/platform/dashboard-variables/distinct-values.ts b/src/client/src/lib/platform/dashboard-variables/distinct-values.ts
new file mode 100644
index 00000000..6af01c98
--- /dev/null
+++ b/src/client/src/lib/platform/dashboard-variables/distinct-values.ts
@@ -0,0 +1,86 @@
+import type {
+	AttributeScope,
+	DataSourceAdapter,
+	OpenLITQuery,
+	Signal,
+} from "@/lib/platform/connectors/datasource/types";
+import { UnsupportedCapabilityError } from "@/lib/platform/connectors/datasource/types";
+import { clampQueryToSource } from "@/lib/platform/connectors/datasource/http/limits";
+import { isDashboardVariableBindingValid } from "./translate";
+
+/**
+ * Generic, type-safe source binding for fetching the allowed values of a
+ * dashboard variable. The dashboard editor calls this when the variable does
+ * NOT have a hand-curated `allowedValues` array — the binding layer is the
+ * typed adapter's `distinctValues(scopedKey, query)` method, which adapters
+ * translate into the vendor's native query language without SQL string
+ * interpolation.
+ *
+ * Never concatenate user-controlled values into SQL. The attribute key
+ * flows from the typed `DashboardVariableSpec.key` (already validated at
+ * the dashboard layer), and the query is built from the dashboard filter
+ * (time range + project + environment) by the query planner.
+ */
+
+export interface VariableAllowedValuesRequest {
+	adapter: DataSourceAdapter;
+	signal: Signal;
+	scope: AttributeScope;
+	/** Bound attribute key for the variable (e.g. "service.name"). */
+	key: string;
+	/** Time range used as the probe window. */
+	timeRange: { start: Date; end: Date };
+	/** Maximum number of values to return. Defaults to 256. */
+	limit?: number;
+}
+
+export interface VariableAllowedValuesResult {
+	values: string[];
+	/**
+	 * When `false`, the bound source does not support distinct attribute
+	 * values. The dashboard editor falls back to a free-text input in that
+	 * case rather than showing a broken dropdown.
+	 */
+	supported: boolean;
+}
+
+export function distinctValueLookupKey(
+	signal: Signal,
+	scope: AttributeScope,
+	key: string,
+): string | null {
+	if (!isDashboardVariableBindingValid(signal, scope)) return null;
+	if (signal === "traces") return `${scope}:${key}`;
+	return key;
+}
+
+export async function fetchVariableAllowedValues(
+	req: VariableAllowedValuesRequest,
+): Promise<VariableAllowedValuesResult> {
+	const lookupKey = distinctValueLookupKey(req.signal, req.scope, req.key);
+	if (!lookupKey) return { values: [], supported: false };
+	const capabilities = req.adapter.capabilities?.();
+	if (!capabilities?.distinctValues) {
+		return { values: [], supported: false };
+	}
+	const query: OpenLITQuery = clampQueryToSource(req.adapter, {
+		signal: req.signal,
+		timeRange: req.timeRange,
+		limit: req.limit ?? 256,
+	}).query;
+	try {
+		const values = await req.adapter.distinctValues(
+			lookupKey,
+			query,
+		);
+		return {
+			values: values.slice(0, req.limit ?? 256),
+			supported: true,
+		};
+	} catch (err) {
+		if (err instanceof UnsupportedCapabilityError) {
+			return { values: [], supported: false };
+		}
+		throw err;
+	}
+}
