+"use client";
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import type {
+	DashboardVariableSpec,
+	DashboardVariableState,
+} from "@/lib/platform/dashboard-variables";
+import { serializeVariableSelection } from "@/lib/platform/dashboard-variables/translate";
+import {
+	Select,
+	SelectContent,
+	SelectItem,
+	SelectTrigger,
+	SelectValue,
+} from "@/components/ui/select";
+import { Label } from "@/components/ui/label";
+
+/**
+ * Dashboard-wide top-bar selector for non-time variables.
+ *
+ * Renders one All/single/multi-select control per declared variable. The
+ * UI is generic — it binds a `DashboardVariableSpec` to a typed value
+ * selection and persists the choice through the `setSelection` callback
+ * (which writes to URL via `variablesToSearchParams`). The widget query
+ * layer reads the same selection through `applyDashboardVariables`, so
+ * any change here re-binds every opted-in widget consistently.
+ *
+ * The selector NEVER reads `allowedValues` from a SQL string or
+ * interpolates user input into a query: when the spec omits
+ * `allowedValues`, the caller is expected to pre-load `candidates[id]`
+ * from the typed `distinctValues` source binding (see
+ * `lib/platform/dashboard-variables/distinct-values.ts`). When the
+ * binding reports `{ supported: false }`, the editor renders a free-text
+ * input as a fallback.
+ */
+export interface DashboardVariableSelectorProps {
+	specs: DashboardVariableSpec[];
+	state: DashboardVariableState;
+	onChange: (id: string, values: string[]) => void;
+	/**
+	 * Optional per-id candidate lists pre-resolved through the typed
+	 * `distinctValues(key, query)` source binding. When a spec carries a
+	 * hand-curated `allowedValues`, that wins. When neither is provided,
+	 * the selector degrades to a free-text input.
+	 */
+	candidates?: Record<string, string[]>;
+}
+
+interface FreeTextProps {
+	id: string;
+	values: string[];
+	placeholder: string;
+	onCommit: (values: string[]) => void;
+}
+
+function FreeTextInput({ id, values, placeholder, onCommit }: FreeTextProps) {
+	const [draft, setDraft] = useState(values.join(", "));
+	useEffect(() => {
+		setDraft(values.join(", "));
+	}, [id, values.join("|")]);
+	return (
+		<input
+			type="text"
+			className="h-8 w-44 rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-2 text-xs"
+			value={draft}
+			placeholder={placeholder}
+			onChange={(e) => setDraft(e.target.value)}
+			onBlur={() => {
+				const tokens = draft
+					.split(",")
+					.map((v) => v.trim())
+					.filter((v) => v.length > 0);
+				onCommit(tokens);
+			}}
+		/>
+	);
+}
+
+export function DashboardVariableSelector({
+	specs,
+	state,
+	onChange,
+	candidates,
+}: DashboardVariableSelectorProps) {
+	const orderedSpecs = useMemo(() => specs, [specs]);
+	const [dynamicCandidates, setDynamicCandidates] = useState<Record<string, string[]>>({});
+
+	useEffect(() => {
+		const abortCtrl = new AbortController();
+		for (const spec of orderedSpecs) {
+			if (
+				(spec.allowedValues?.length ?? 0) > 0 ||
+				candidates?.[spec.id] ||
+				dynamicCandidates[spec.id]
+			) {
+				continue;
+			}
+			const now = new Date();
+			const start = new Date(now.getTime() - 24 * 3600 * 1000);
+			const params = new URLSearchParams({
+				signal: spec.signal || "traces",
+				scope: spec.scope,
+				key: spec.key,
+				start: start.toISOString(),
+				end: now.toISOString(),
+			});
+			if (spec.sourceId) {
+				params.set("sourceId", spec.sourceId);
+			}
+			fetch(`/api/manage-dashboard/variables/distinct-values?${params.toString()}`, {
+				signal: abortCtrl.signal,
+			})
+				.then((res) => (res.ok ? res.json() : null))
+				.then((data) => {
+					if (data?.values && Array.isArray(data.values)) {
+						setDynamicCandidates((prev) => ({
+							...prev,
+							[spec.id]: data.values,
+						}));
+					}
+				})
+				.catch(() => {});
+		}
+		return () => abortCtrl.abort();
+	}, [orderedSpecs, candidates]);
+
+	if (orderedSpecs.length === 0) return null;
+
+	return (
+		<div
+			className="flex flex-wrap items-center gap-3"
+			data-dashboard-variables="1"
+		>
+			{orderedSpecs.map((spec) => {
+				const values = state.values[spec.id] ?? [];
+				const staticValues = spec.allowedValues;
+				const dynamicValues =
+					candidates?.[spec.id] ?? dynamicCandidates[spec.id];
+				const options =
+					staticValues && staticValues.length > 0
+						? staticValues
+						: dynamicValues && dynamicValues.length > 0
+							? dynamicValues
+							: null;
+				return (
+					<div
+						key={spec.id}
+						className="flex items-center gap-2"
+						data-dashboard-variable={spec.id}
+					>
+						<Label className="text-xs text-stone-500">
+							{spec.label}
+						</Label>
+						{options === null ? (
+							<FreeTextInput
+								id={spec.id}
+								values={values}
+								placeholder={
+									spec.supportsAll
+										? "type or paste values"
+										: "type a value"
+								}
+								onCommit={(next) => onChange(spec.id, next)}
+							/>
+						) : spec.multi ? (
+							<MultiValueSelect
+								spec={spec}
+								options={options}
+								values={values}
+								onChange={(next) => onChange(spec.id, next)}
+							/>
+						) : (
+							<SingleValueSelect
+								spec={spec}
+								options={options}
+								value={values[0] ?? ""}
+								onChange={(next) =>
+									onChange(spec.id, next ? [next] : [])
+								}
+							/>
+						)}
+						{values.length > 0 ? (
+							<span
+								className="text-[10px] font-mono text-stone-400"
+								title="serialized URL token"
+							>
+								{serializeVariableSelection(values)}
+							</span>
+						) : spec.supportsAll ? (
+							<span className="text-[10px] font-mono text-stone-400">
+								all
+							</span>
+						) : null}
+					</div>
+				);
+			})}
+		</div>
+	);
+}
+
+interface SingleValueSelectProps {
+	spec: DashboardVariableSpec;
+	options: string[];
+	value: string;
+	onChange: (next: string | null) => void;
+}
+
+function SingleValueSelect({
+	spec,
+	options,
+	value,
+	onChange,
+}: SingleValueSelectProps) {
+	return (
+		<Select
+			value={value || "__all__"}
+			onValueChange={(next) => {
+				if (next === "__all__") {
+					onChange(null);
+					return;
+				}
+				onChange(next);
+			}}
+		>
+			<SelectTrigger className="h-8 min-w-[10rem] text-xs">
+				<SelectValue placeholder={spec.supportsAll ? "All" : "Select"} />
+			</SelectTrigger>
+			<SelectContent>
+				{spec.supportsAll ? (
+					<SelectItem value="__all__">All</SelectItem>
+				) : null}
+				{options.map((option) => (
+					<SelectItem key={option} value={option}>
+						{option}
+					</SelectItem>
+				))}
+			</SelectContent>
+		</Select>
+	);
+}
+
+interface MultiValueSelectProps {
+	spec: DashboardVariableSpec;
+	options: string[];
+	values: string[];
+	onChange: (next: string[]) => void;
+}
+
+function MultiValueSelect({
+	spec,
+	options,
+	values,
+	onChange,
+}: MultiValueSelectProps) {
+	const handleToggle = useCallback(
+		(option: string) => {
+			const set = new Set(values);
+			if (set.has(option)) {
+				set.delete(option);
+			} else {
+				set.add(option);
+			}
+			onChange(Array.from(set));
+		},
+		[values, onChange],
+	);
+	return (
+		<div className="flex flex-wrap items-center gap-1 rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-2 py-1 max-w-[24rem]">
+			{spec.supportsAll ? (
+				<button
+					type="button"
+					onClick={() => onChange([])}
+					className={`text-[10px] rounded px-2 py-0.5 ${
+						values.length === 0
+							? "bg-stone-200 dark:bg-stone-800"
+							: "hover:bg-stone-100 dark:hover:bg-stone-800"
+					}`}
+					title="clear selection = All"
+				>
+					All
+				</button>
+			) : null}
+			{options.map((option) => {
+				const active = values.includes(option);
+				return (
+					<button
+						key={option}
+						type="button"
+						className={`text-[10px] rounded px-2 py-0.5 ${
+							active
+								? "bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900"
+								: "hover:bg-stone-100 dark:hover:bg-stone-800"
+						}`}
+						onClick={() => handleToggle(option)}
+					>
+						{option}
+					</button>
+				);
+			})}
+		</div>
+	);
+}
