--- /dev/null
+++ b/src/client/src/__tests__/lib/platform/datasource/parameterized-trace-query.test.ts
@@ -0,0 +1,71 @@
+import type { OpenLITQuery } from "@/lib/platform/connectors/datasource/types";
+import { ParameterizedTraceQuery } from "@/lib/platform/connectors/datasource/clickhouse/parameterized-query";
+
+const base: OpenLITQuery = {
+	signal: "traces",
+	aiSelector: false,
+	timeRange: {
+		start: new Date("2026-01-01T00:00:00.000Z"),
+		end: new Date("2026-01-02T00:00:00.000Z"),
+	},
+};
+
+describe("ParameterizedTraceQuery", () => {
+	it("binds filter keys, values, and time bounds outside SQL text", () => {
+		const key = "autodev.workspace";
+		const value = "'; DROP TABLE otel_traces; --";
+		const bindings = new ParameterizedTraceQuery();
+		const where = bindings.where(
+			{
+				...base,
+				filters: [{ target: "attribute", scope: "span", key, op: "eq", value }],
+			},
+			"`openlit`.`otel_traces`",
+		);
+
+		expect(where).not.toContain(key);
+		expect(where).not.toContain(value);
+		expect(where).toContain(
+			"SpanAttributes[{autodev_filter_2:String}] = {autodev_filter_3:String}",
+		);
+		expect(bindings.queryParams).toMatchObject({
+			autodev_filter_0: base.timeRange.start.toISOString(),
+			autodev_filter_1: base.timeRange.end.toISOString(),
+			autodev_filter_2: key,
+			autodev_filter_3: value,
+		});
+	});
+
+	it("binds multi-select values as a typed array and uses the service projection", () => {
+		const values = ["autodev-router", "nonexistent"];
+		const bindings = new ParameterizedTraceQuery();
+		const where = bindings.where(
+			{
+				...base,
+				filters: [
+					{ target: "attribute", scope: "resource", key: "service.name", op: "in", value: values },
+				],
+			},
+			"`openlit`.`otel_traces`",
+		);
+
+		expect(where).toContain("ServiceName IN {autodev_filter_2:Array(String)}");
+		expect(where).not.toContain(values[0]);
+		expect(bindings.queryParams.autodev_filter_2).toEqual(values);
+	});
+
+	it("rejects unsafe attribute keys before producing query text", () => {
+		const bindings = new ParameterizedTraceQuery();
+		expect(() =>
+			bindings.where(
+				{
+					...base,
+					filters: [
+						{ target: "attribute", scope: "span", key: "x'] OR 1=1 --", op: "eq", value: "x" },
+					],
+				},
+				"`openlit`.`otel_traces`",
+			),
+		).toThrow("Invalid ClickHouse attribute key");
+	});
+});
