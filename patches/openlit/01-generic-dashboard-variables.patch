@@ -0,0 +1,159 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import {
+	DASHBOARD_VARIABLE_URL_PREFIX,
+	parseVariableSelection,
+	readVariablesFromSearchParams,
+	serializeVariableSelection,
+	variablesToSearchParams,
+} from "@/lib/platform/dashboard-variables/translate";
+import type {
+	DashboardVariableSpec,
+	DashboardVariableState,
+} from "@/lib/platform/dashboard-variables";
+
+/**
+ * Bind a board's declared variables to URL state, default values, and a
+ * typed `DashboardVariableState` object the widget query layer consumes.
+ *
+ * URL persistence is the source of truth for sharing; `defaultValues` on the
+ * spec fill in when the URL is empty; `localStorage` keeps the user's last
+ * selection across visits on the same browser without polluting the URL.
+ *
+ * The hook is generic — it does not hard-wire application-specific field
+ * names. It binds user selections to the typed attribute keys in the spec.
+ */
+export interface UseDashboardVariablesResult {
+	specs: DashboardVariableSpec[];
+	state: DashboardVariableState;
+	setSelection: (id: string, values: string[]) => void;
+	setSpecs: (specs: DashboardVariableSpec[]) => void;
+	serializeVariables: () => string;
+}
+
+const DEFAULT_SOURCE: DashboardVariableState["source"] = "default";
+
+export function useDashboardVariables(
+	boardVariables: DashboardVariableSpec[] | undefined,
+	options: {
+		persistTo?: "url" | "localStorage" | "none";
+	} = { persistTo: "url" },
+): UseDashboardVariablesResult {
+	const specs = useMemo(
+		() => boardVariables ?? [],
+		[boardVariables],
+	);
+
+	// Read URL state once on mount; URL is the authoritative source for
+	// sharable links. When no URL params are present, fall back to the
+	// variable's declared `defaultValues`.
+	const [state, setState] = useState<DashboardVariableState>(() => {
+		const params =
+			typeof window !== "undefined"
+				? new URLSearchParams(window.location.search)
+				: new URLSearchParams();
+		const urlValues = readVariablesFromSearchParams(params);
+		const values: Record<string, string[]> = {};
+		for (const spec of specs) {
+			if (urlValues[spec.id] && urlValues[spec.id].length > 0) {
+				values[spec.id] = urlValues[spec.id];
+			} else if (spec.defaultValues && spec.defaultValues.length > 0) {
+				values[spec.id] = spec.defaultValues.slice();
+			} else {
+				values[spec.id] = [];
+			}
+		}
+		return { values, source: Object.keys(urlValues).length > 0 ? "url" : DEFAULT_SOURCE };
+	});
+
+	// Avoid the SSR / first-client-render mismatch: only mirror selection
+	// into the URL after hydration so server-rendered widget shells do not
+	// disagree with the post-mount variable state.
+	const hydrated = useRef(false);
+	useEffect(() => {
+		hydrated.current = true;
+	}, []);
+
+	// Persist selection to URL when it changes. Read the URL fresh each time
+	// so the function is stable under arbitrary refolds.
+	const persist = useCallback(
+		(next: DashboardVariableState) => {
+			if (!hydrated.current) return;
+			if (typeof window === "undefined") return;
+			const url = new URL(window.location.href);
+			const params = new URLSearchParams(url.search);
+			// Drop existing variable params so a removed spec is cleaned up.
+			for (const key of Array.from(params.keys())) {
+				if (key.startsWith(DASHBOARD_VARIABLE_URL_PREFIX)) {
+					params.delete(key);
+				}
+			}
+			const fresh = variablesToSearchParams(next);
+			fresh.forEach((v, k) => params.set(k, v));
+			url.search = params.toString();
+			window.history.replaceState(null, "", url.toString());
+			if (options.persistTo === "localStorage") {
+				try {
+					window.localStorage.setItem(
+						"openlit.dashboard.variables.v1",
+						JSON.stringify(next.values),
+					);
+				} catch {
+					// localStorage may be disabled (private mode, quota); fall
+					// back silently — the URL still carries the selection.
+				}
+			}
+		},
+		[options.persistTo],
+	);
+
+	const setSelection = useCallback(
+		(id: string, values: string[]) => {
+			setState((prev) => {
+				const nextValues = { ...prev.values, [id]: values };
+				const next: DashboardVariableState = {
+					values: nextValues,
+					source: "localStorage",
+				};
+				persist(next);
+				return next;
+			});
+		},
+		[persist],
+	);
+
+	const setSpecs = useCallback((next: DashboardVariableSpec[]) => {
+		setState((prev) => {
+			// Drop selection for removed specs so a stale URL fragment does
+			// not re-introduce a deleted variable on the next read.
+			const validIds = new Set(next.map((s) => s.id));
+			const nextValues: Record<string, string[]> = {};
+			for (const id of Object.keys(prev.values)) {
+				if (validIds.has(id)) nextValues[id] = prev.values[id];
+			}
+			for (const spec of next) {
+				if (!(spec.id in nextValues)) {
+					nextValues[spec.id] = spec.defaultValues ?? [];
+				}
+			}
+			return { values: nextValues, source: prev.source };
+		});
+	}, []);
+
+	const serializeVariables = useCallback(
+		() =>
+			Object.entries(state.values)
+				.map(([id, values]) =>
+					`${DASHBOARD_VARIABLE_URL_PREFIX}${id}=${serializeVariableSelection(values)}`,
+				)
+				.join("&"),
+		[state.values],
+	);
+
+	return { specs, state, setSelection, setSpecs, serializeVariables };
+}
+
+// Re-export parseVariableSelection for callers that need to parse a single
+// value token from a URL fragment.
+export { parseVariableSelection };
