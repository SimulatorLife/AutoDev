+/**
+ * Validate and normalize the dashboard variable payload from the client.
+ *
+ * The variable spec and selection live entirely on the dashboard: the server
+ * only forwards typed structures, never raw SQL or attribute names chosen by
+ * the client at request time. Anything that fails validation is dropped
+ * silently — the dashboard falls back to the stock time/filter path.
+ */
+function normalizeDashboardVariables(raw: unknown): {
+	specs: DashboardVariableSpec[];
+	state: Pick<DashboardVariableState, "values">;
+} | undefined {
+	if (!raw || typeof raw !== "object") return undefined;
+	const { specs, state } = raw as {
+		specs?: unknown;
+		state?: unknown;
+	};
+	if (!Array.isArray(specs) || !state || typeof state !== "object") {
+		return undefined;
+	}
+	const validSpecs: DashboardVariableSpec[] = [];
+	for (const spec of specs) {
+		if (!spec || typeof spec !== "object") continue;
+		const s = spec as Partial<DashboardVariableSpec>;
+		if (
+			typeof s.id !== "string" ||
+			typeof s.label !== "string" ||
+			!s.signal ||
+			!s.scope ||
+			typeof s.key !== "string" ||
+			typeof s.multi !== "boolean" ||
+			typeof s.supportsAll !== "boolean"
+		) {
+			continue;
+		}
+		if (s.defaultValues && !Array.isArray(s.defaultValues)) continue;
+		validSpecs.push({
+			id: s.id,
+			label: s.label,
+			signal: s.signal,
+			scope: s.scope,
+			key: s.key,
+			multi: s.multi,
+			supportsAll: s.supportsAll,
+			defaultValues: s.defaultValues as string[] | undefined,
+			sourceId: (s.sourceId ?? null) as string | null | undefined,
+			allowedValues: Array.isArray(s.allowedValues)
+				? (s.allowedValues as string[])
+				: undefined,
+		});
+	}
+	const values = (state as { values?: unknown }).values;
+	if (!values || typeof values !== "object") return undefined;
+	const safeValues: Record<string, string[]> = {};
+	for (const [id, raw] of Object.entries(values as Record<string, unknown>)) {
+		if (!Array.isArray(raw)) continue;
+		safeValues[id] = raw.filter((v): v is string => typeof v === "string");
+	}
+	return { specs: validSpecs, state: { values: safeValues } };
+}
