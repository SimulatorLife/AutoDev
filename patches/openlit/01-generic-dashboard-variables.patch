+											<SelectContent>
+												{SIGNAL_OPTIONS.map((o) => (
+													<SelectItem key={o.value} value={o.value}>
+														{o.label}
+													</SelectItem>
+												))}
+											</SelectContent>
+										</Select>
+									</label>
+									<label className="space-y-1">
+										<span className="text-stone-500">scope</span>
+										<Select
+											value={spec.scope}
+											onValueChange={(v) =>
+												updateAt(index, {
+													scope: v as DashboardVariableSpec["scope"],
+												})
+											}
+										>
+											<SelectTrigger className="h-7">
+												<SelectValue />
+											</SelectTrigger>
+											<SelectContent>
+												{SCOPE_OPTIONS.map((o) => (
+													<SelectItem key={o.value} value={o.value}>
+														{o.label}
+													</SelectItem>
+												))}
+											</SelectContent>
+										</Select>
+									</label>
+									<label className="space-y-1 sm:col-span-2">
+										<span className="text-stone-500">
+											attribute key (OTel identifier)
+										</span>
+										<Input
+											value={spec.key}
+											placeholder="e.g. service.name, gen_ai.system, workspace.id"
+											className="h-7"
+											onChange={(e) =>
+												updateAt(index, { key: e.target.value })
+											}
+										/>
+									</label>
+									<label className="space-y-1 sm:col-span-2">
+										<span className="text-stone-500">
+											allowedValues (comma-separated, optional)
+										</span>
+										<Input
+											value={(spec.allowedValues ?? []).join(", ")}
+											placeholder="leave empty to fetch via typed distinctValues()"
+											className="h-7"
+											onChange={(e) => {
+												const tokens = e.target.value
+													.split(",")
+													.map((v) => v.trim())
+													.filter((v) => v.length > 0);
+												updateAt(index, { allowedValues: tokens });
+											}}
+										/>
+									</label>
+									<label className="space-y-1 sm:col-span-2">
+										<span className="text-stone-500">
+											defaultValues (comma-separated, optional)
+										</span>
+										<Input
+											value={(spec.defaultValues ?? []).join(", ")}
+											placeholder="leave empty for All (when supportsAll)"
+											className="h-7"
+											onChange={(e) => {
+												const tokens = e.target.value
+													.split(",")
+													.map((v) => v.trim())
+													.filter((v) => v.length > 0);
+												updateAt(index, { defaultValues: tokens });
+											}}
+										/>
