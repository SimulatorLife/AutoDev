diff --git a/src/client/src/helpers/client/chart-axis.ts b/src/client/src/helpers/client/chart-axis.ts
new file mode 100644
index 00000000..00ea6fb2
--- /dev/null
+++ b/src/client/src/helpers/client/chart-axis.ts
@@ -0,0 +1,46 @@
+import { format } from "date-fns";
+
+/**
+ * Axis ticks for the time-series charts.
+ *
+ * The telemetry reads return `request_time` as the full stored value —
+ * "2026-10-05 20:18:07.020" — and the XAxis drew it verbatim. Six of those
+ * across a card's width collide into an unreadable run of text
+ * ("20:18:07.0202026-10-05 23:18:07.020"). The full value still belongs in the
+ * tooltip, where there is room for it and the reader can hover to read it, so
+ * the tick drops to the clock and the tick gap lets Recharts thin the set.
+ */
+export function formatTimeTick(value: unknown): string {
+	const date = toDate(value);
+	if (!date) return typeof value === "string" ? value : "";
+	// A range spanning days needs the day too, or every tick reads "00:00".
+	return format(date, "MMM d HH:mm");
+}
+
+/**
+ * The stored value is a ClickHouse datetime string ("2026-10-05 20:18:07.020")
+ * or, on some reads, a unix timestamp in seconds. `new Date` accepts neither
+ * form reliably on its own, so both are normalised here rather than letting an
+ * axis silently render "Invalid Date".
+ */
+function toDate(value: unknown): Date | null {
+	if (value instanceof Date)
+		return Number.isNaN(value.getTime()) ? null : value;
+	if (typeof value === "number" && Number.isFinite(value)) {
+		// Anything below this is a seconds timestamp, not milliseconds: 1e12 ms
+		// is 2001, and 1e12 s is the year 33658.
+		const ms = value < 1e12 ? value * 1000 : value;
+		const date = new Date(ms);
+		return Number.isNaN(date.getTime()) ? null : date;
+	}
+	if (typeof value === "string") {
+		const trimmed = value.trim();
+		if (!trimmed) return null;
+		const normalised = /^\d{4}-\d{2}-\d{2} /u.test(trimmed)
+			? trimmed.replace(" ", "T")
+			: trimmed;
+		const date = new Date(normalised);
+		return Number.isNaN(date.getTime()) ? null : date;
+	}
+	return null;
+}
