+import { describe, expect, it } from "@jest/globals";
+import { formatTimeTick } from '@/helpers/client/chart-axis';
+
+// The axis drew the raw stored value ("2026-10-05 20:18:07.020") and six of
+// those collided across a card's width. These pin the compacted form and, more
+// importantly, pin that an unparseable value is echoed rather than becoming
+// "Invalid Date" on a chart.
+describe("formatTimeTick", () => {
+	it("drops the seconds and milliseconds from a stored ClickHouse datetime", () => {
+		expect(formatTimeTick("2026-10-05 20:18:07.020")).toBe("Oct 5 20:18");
+	});
+
+	it("accepts an ISO string with a T separator", () => {
+		expect(formatTimeTick("2026-10-05T20:18:07.020Z")).toMatch(/^Oct/iu);
+	});
+
+	it("keeps the day, because a multi-day range would otherwise read 00:00", () => {
+		const tick = formatTimeTick("2026-10-05 20:18:07.020");
+		expect(tick).not.toMatch(/^\d{2}:\d{2}/u);
+	});
+
+	it("reads a unix timestamp in seconds and in milliseconds as one instant", () => {
+		// 1e9 seconds and 1e12 milliseconds are the same moment. If the seconds
+		// branch were dropped, the seconds form would land in 1970 instead.
+		expect(formatTimeTick(1_000_000_000)).toBe(formatTimeTick(1_000_000_000_000));
+		expect(formatTimeTick(1_000_000_000)).toMatch(/^Sep/iu);
+	});
+
+	it("echoes a value it cannot parse rather than rendering Invalid Date", () => {
+		expect(formatTimeTick("not a date")).toBe("not a date");
+		expect(formatTimeTick("")).toBe("");
+		expect(formatTimeTick(null)).toBe("");
+		expect(formatTimeTick(undefined)).toBe("");
+		expect(formatTimeTick(Number.NaN)).toBe("");
+	});
+
+	it("is short enough that several ticks fit across a card", () => {
+		expect(formatTimeTick("2026-10-05 20:18:07.020").length).toBeLessThanOrEqual(12);
+	});
+});
