-function topRepeatedEntries(map: Map<string, string[]>, limit = 5) {
-	return Array.from(map.entries())
-		.filter(([, spanIds]) => spanIds.length > 1)
-		.sort((a, b) => b[1].length - a[1].length)
-		.slice(0, limit)
-		.map(([key, spanIds]) => ({ key, count: spanIds.length, spanIds }));
-}
