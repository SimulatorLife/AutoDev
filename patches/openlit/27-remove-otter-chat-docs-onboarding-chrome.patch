-function eventAttributes(span: TraceHeirarchySpan) {
-	return (span.Events || [])
-		.map((event) => ({
-			name: event.Name,
-			attributes: (event.Attributes || {}) as Record<string, string | number>,
-		}))
-		.filter((event) => event.name || Object.keys(event.attributes).length > 0);
