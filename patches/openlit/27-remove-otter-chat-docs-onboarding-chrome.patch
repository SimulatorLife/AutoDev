-				severity: "minor",
-				summary: `${DIMENSION_LABELS[dimension]} analysis could not be parsed`,
-				detail: "The model response for this dimension was not valid JSON, so OpenLIT could not build findings for it.",
-				span_refs: [root.SpanId],
