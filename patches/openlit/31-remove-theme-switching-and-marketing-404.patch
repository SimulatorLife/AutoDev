@@ -0,0 +1,30 @@
+import { renderToStaticMarkup } from "react-dom/server";
+
+// `next/font/local` resolves to a build-time asset loader; stub it so the
+// layout can be rendered outside a Next build.
+jest.mock("next/font/local", () => ({
+	__esModule: true,
+	default: () => ({ className: "font-inter", variable: "--font-inter" }),
+}));
+
+import RootLayout from "@/app/layout";
+
+describe("root layout theme", () => {
+	it("renders the product in dark unconditionally", () => {
+		const markup = renderToStaticMarkup(
+			RootLayout({ children: null }) as React.ReactElement
+		);
+
+		expect(markup).toContain('<html lang="en" class="scroll-smooth dark"');
+	});
+
+	it("does not read or depend on a persisted theme preference", () => {
+		const markup = renderToStaticMarkup(
+			RootLayout({ children: null }) as React.ReactElement
+		);
+
+		// Tailwind is configured with `darkMode: ["class"]`, so the absence of a
+		// theme-driven class would silently render the light palette.
+		expect(markup).not.toMatch(/<html(?![^>]*\bdark\b)[^>]*>/);
+	});
+});
