+/**
+ * The metadata of the most recent successful run of a cron.
+ *
+ * A cron that resumes where it left off needs to know how far the previous
+ * run got, which is its own bookkeeping rather than the clock: the time a
+ * run started is not the point it reached. A run that examined a span it
+ * could not price still examined it, and the next run has to start after it.
+ */
+export async function getLastRunCronLogMetaByCronId(
+	cronId: string,
+	databaseConfigId?: string
+): Promise<Record<string, any> | null> {
+	const query = `
+		SELECT meta
+		FROM ${OPENLIT_CRON_LOG_TABLE_NAME}
+		WHERE cron_id = '${cronId}' AND run_status = '${CronRunStatus.SUCCESS}'
+		ORDER BY started_at DESC
+		LIMIT 1
+	`;
+
+	const { data, err } = await dataCollector(
+		{ query },
+		"query",
+		databaseConfigId
+	);
+
+	if (err || !Array.isArray(data)) {
+		return null;
+	}
+
+	const [lastRun] = data as CronLogData[];
+	const meta = lastRun?.meta;
+	return meta && typeof meta === "object" ? meta : null;
+}
