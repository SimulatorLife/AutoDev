diff --git a/src/client/src/clickhouse/migrations/drop-rule-engine-migration.ts b/src/client/src/clickhouse/migrations/drop-rule-engine-migration.ts
new file mode 100644
index 00000000..8e8346c9
--- /dev/null
+++ b/src/client/src/clickhouse/migrations/drop-rule-engine-migration.ts
@@ -0,0 +1,31 @@
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "drop-rule-engine-tables";
+
+/**
+ * Drops the Rule Engine tables that earlier deployments created via the
+ * now-removed `create-rule-engine-migration`. The product is gone, so a fresh
+ * install must not recreate them and an existing install should not keep them.
+ *
+ * `openlit_contexts` is deliberately absent: it was created by the same
+ * migration but belongs to the surviving Context product, which now creates it
+ * itself via `create-context-migration`.
+ *
+ * `DROP TABLE IF EXISTS` keeps an install that never had them a no-op.
+ */
+export default async function DropRuleEngineMigration(databaseConfigId?: string) {
+	const queries = [
+		`DROP TABLE IF EXISTS openlit_rules`,
+		`DROP TABLE IF EXISTS openlit_rule_condition_groups`,
+		`DROP TABLE IF EXISTS openlit_rule_conditions`,
+		`DROP TABLE IF EXISTS openlit_rule_entities`,
+	];
+
+	const { migrationExist, queriesRun } = await migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+
+	return { migrationExist, queriesRun };
+}
