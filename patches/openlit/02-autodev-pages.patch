+import Link from "next/link";
+import React from "react";
+
+/**
+ * Isolated AutoDev control chrome.
+ *
+ * Per docs/observability-target-state.md §3, these pages live under `/autodev`
+ * and show authoritative configuration, exposure/availability, and control
+ * state. They link to OpenLIT's stock observability views for historical
+ * activity; they do not rebuild charts.
+ *
+ * The layout deliberately does NOT render the OpenLIT sidebar or analytics
+ * chrome — it is a focused control surface. Session identity comes from the
+ * stock NextAuth session; no browser-held service secrets are ever exposed.
+ */
+const NAV: Array<{ href: string; label: string }> = [
+	{ href: "/autodev", label: "Overview" },
+	{ href: "/autodev/providers", label: "Providers" },
+	{ href: "/autodev/mcps", label: "MCPs" },
+	{ href: "/autodev/skills", label: "Skills" },
+	{ href: "/autodev/runtime", label: "Runtime" },
+];
+
+export default function AutodevLayout({
+	children,
+}: {
+	children: React.ReactNode;
+}) {
+	return (
+		<div
+			data-autodev-layout="1"
+			className="min-h-screen w-full bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100"
+		>
+			<header className="border-b border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
+				<div className="mx-auto max-w-6xl px-6 py-4 flex items-center gap-6">
+					<Link
+						href="/autodev"
+						className="font-semibold text-base tracking-tight"
+					>
+						AutoDev Control
+					</Link>
+					<nav className="flex flex-wrap gap-4 text-sm text-stone-600 dark:text-stone-300">
+						{NAV.map((item) => (
+							<Link
+								key={item.href}
+								href={item.href}
+								className="hover:text-stone-900 dark:hover:text-stone-100"
+							>
+								{item.label}
+							</Link>
+						))}
+					</nav>
+				</div>
+			</header>
+			<main className="mx-auto max-w-6xl px-6 py-8">{children}</main>
+		</div>
+	);
+}
