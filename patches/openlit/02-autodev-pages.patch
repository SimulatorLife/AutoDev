+import { withControlApiProxy } from "@/lib/autodev/control-api";
+import { NextRequest } from "next/server";
+
+/** /autodev/api/mcps — proxy GET to AutoDev Control API. */
+export async function GET(request: NextRequest): Promise<Response> {
