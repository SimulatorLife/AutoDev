diff --git a/src/client/src/lib/autodev/control-api.ts b/src/client/src/lib/autodev/control-api.ts
new file mode 100644
index 00000000..5b1d0eb9
--- /dev/null
+++ b/src/client/src/lib/autodev/control-api.ts
@@ -0,0 +1,505 @@
+/**
+ * Same-origin server-side proxy to the AutoDev Control API.
+ *
+ * The browser MUST NOT call the AutoDev Control API directly. The OpenLIT
+ * server authenticates the user session (NextAuth — the only identity
+ * boundary available in OpenLIT CE), enforces exact Origin validation for
+ * every mutation, and forwards the request to the AutoDev Control API
+ * using a scoped service credential resolved at request time from the
+ * server environment. The OpenLIT browser only ever sees a same-origin
+ * `/autodev/api/*` URL; the service credential never leaves the server
+ * process.
+ *
+ * Authorization model:
+ *
+ * OpenLIT CE ships only with NextAuth identity and no granular RBAC. Per
+ * docs/observability-target-state.md §5, the AutoDev Control API is
+ * responsible for the resource/action allowlists. This proxy:
+ *
+ *   1. Verifies the OpenLIT session is present (NextAuth gate).
+ *   2. Enforces exact Origin matching for every state-changing method
+ *      (the stock middleware CSRF check is bypassed for `/autodev/api/*`
+ *      because that path lives outside `/api/*`; same-origin alone is not
+ *      a sufficient CSRF defense, so the proxy performs its own check).
+ *   3. Forwards the verified actor identity (id only) as `X-AutoDev-Actor`.
+ *   4. Honors an opt-in `AUTODEV_CONTROL_API_DISABLED=1` kill switch.
+ *   5. NEVER forwards any `X-AutoDev-Role` or `X-AutoDev-Actor-Email`
+ *      header. OpenLIT CE has no trustworthy RBAC; the AutoDev Control API
+ *      alone decides whether the actor is in its
+ *      `AUTODEV_CONTROL_VIEWERS` / `AUTODEV_CONTROL_OPERATORS` allowlists.
+ *      Forwarding a forged role/email header would be a security regression.
+ *
+ * Wire contract (the AutoDev Control API in runtime/src/control-api/index.ts is
+ * the source of truth):
+ *
+ *   GET    /control/providers
+ *     -> { schema: "autodev-control-providers-v1",
+ *          providers: [{ id, roles: { orchestrator: { enabled, mutable },
+ *                                    subagent:     { enabled, mutable } } }],
+ *          disabledOrchestratorProviders: string[],
+ *          disabledSubagentProviders:     string[] }
+ *
+ *   GET    /control/mcps        (read-only)
+ *     -> { schema: "autodev-control-mcps-v1",
+ *          source: "execution-contract",
+ *          readOnly: true,
+ *          servers: [{ name, roles: string[] }] }
+ *
+ *   GET    /control/skills      (read-only)
+ *     -> { schema: "autodev-control-skills-v1",
+ *          source: "execution-contract",
+ *          readOnly: true,
+ *          skills: [{ name, roles: string[] }] }
+ *
+ *   GET    /control/runtime     (current state only)
+ *     -> { schema: "autodev-control-runtime-v1",
+ *          routerInstanceId: string,
+ *          lifecycle: object,
+ *          concurrency: object,
+ *          inFlightRequestCount: number }
+ *
+ *   PATCH  /control/providers/{provider}/roles/{role}
+ *     request body:  { enabled: boolean }
+ *     200 response:  { schema: "autodev-control-provider-role-v1",
+ *                      provider, role, enabled, previous, actor }
+ *
+ *   Auth (server-side only):
+ *     Authorization:           Bearer <AUTODEV_CONTROL_API_TOKEN>
+ *     X-AutoDev-Actor:         <verified NextAuth user id>
+ *
+ *   The AutoDev API matches `X-AutoDev-Actor` against the
+ *   `AUTODEV_CONTROL_VIEWERS` / `AUTODEV_CONTROL_OPERATORS` allowlists it
+ *   loads from its own environment.
+ */
+
+import { NextRequest } from "next/server";
+
+// NOTE: `@/lib/session` is imported dynamically so the proxy can be unit
+// tested without loading NextAuth + Prisma + the upstream jest mock graph.
+// The static import pulled `jose` into the test runtime, which breaks the
+// upstream Jest config (ESM-only `jose` in a CommonJS transform path).
+async function fetchActorFromSession(): Promise<string | null> {
+    const { getCurrentUser } = await import("@/lib/session");
+    const user = await getCurrentUser();
+    return user?.id ?? null;
+}
+
+/** HTTP verbs supported by the proxy. */
+export type HttpMethod = "GET" | "POST" | "PATCH" | "DELETE";
+
+export interface ControlApiRequest {
+	/** HTTP verb to forward to the AutoDev Control API. */
+	method: HttpMethod;
+	/** Resource path under /control (no leading slash), e.g. `providers`. */
+	path: string;
+	/** Request body (will be JSON-serialized). */
+	body?: unknown;
+}
+
+/**
+ * Response shape returned by `GET /control/providers`. Mirrors the
+ * `autodev-control-providers-v1` schema in runtime/src/control-api/index.ts:
+ *   providers: [{ id, roles: { orchestrator: { enabled, mutable },
+ *                                subagent:     { enabled, mutable } } }]
+ * The proxy deliberately does NOT expose `displayName`, `status`,
+ * `transport`, `exposed`, `available`, `tools`, `enabled`, etc., because the
+ * upstream API does not return those fields. Decorative state belongs to the
+ * OpenLIT stock telemetry views, not to the control API.
+ */
+export interface ProviderRoleState {
+	enabled: boolean;
+	mutable: boolean;
+}
+export interface ProviderRoles {
+	orchestrator: ProviderRoleState;
+	subagent: ProviderRoleState;
+}
+export interface ProviderEntry {
+	id: string;
+	roles: ProviderRoles;
+}
+export interface ProvidersResponse {
+	schema: "autodev-control-providers-v1";
+	providers: ProviderEntry[];
+	disabledOrchestratorProviders: string[];
+	disabledSubagentProviders: string[];
+}
+
+/**
+ * Response shape returned by `GET /control/mcps`. Mirrors the
+ * `autodev-control-mcps-v1` schema. Exposure is derived from the configured
+ * role bindings on the AutoDev side; the upstream API does not advertise a
+ * separate `transport`, `exposed`, `available`, or `tools[]` list — those
+ * belong to OpenLIT's stock telemetry views, not to this control surface.
+ */
+export interface McpServerEntry {
+	name: string;
+	roles: string[];
+}
+export interface McpsResponse {
+	schema: "autodev-control-mcps-v1";
+	source: string;
+	readOnly: true;
+	servers: McpServerEntry[];
+}
+
+/**
+ * Response shape returned by `GET /control/skills`. Mirrors the
+ * `autodev-control-skills-v1` schema. The upstream API does not advertise a
+ * separate `enabled` or `available` flag; those derive from the role binding
+ * presence the control API already reports.
+ */
+export interface SkillEntry {
+	name: string;
+	roles: string[];
+}
+export interface SkillsResponse {
+	schema: "autodev-control-skills-v1";
+	source: string;
+	readOnly: true;
+	skills: SkillEntry[];
+}
+
+/**
+ * Response shape returned by `GET /control/runtime`. Mirrors the
+ * `autodev-control-runtime-v1` schema. The upstream API exposes router
+ * lifecycle, concurrency manager status, and the active request count —
+ * not a custom `version` / `startedAt` / `collectors[]` / `queues[]` shape.
+ */
+export interface RuntimeResponse {
+	schema: "autodev-control-runtime-v1";
+	routerInstanceId: string;
+	lifecycle: Record<string, unknown>;
+	concurrency: Record<string, unknown>;
+	inFlightRequestCount: number;
+}
+
+/**
+ * Request body for `PATCH /control/providers/{provider}/roles/{role}`.
+ * The AutoDev API requires exactly `{ enabled: boolean }`; the proxy
+ * re-validates this shape so a malformed client cannot force the upstream
+ * into a 4xx loop.
+ */
+export interface ProviderRolePatchBody {
+	enabled: boolean;
+}
+
+/**
+ * Response body for a successful `PATCH /control/providers/{provider}/roles/{role}`.
+ */
+export interface ProviderRolePatchResponse {
+	schema: "autodev-control-provider-role-v1";
+	provider: string;
+	role: "orchestrator" | "subagent";
+	enabled: boolean;
+	previous: boolean;
+	actor: string;
+}
+
+/**
+ * Environment variable naming the AutoDev Control API base URL. The variable
+ * is server-only; never expose it to the client bundle.
+ */
+const CONTROL_API_URL_ENV = "AUTODEV_CONTROL_API_URL";
+/** Service credential used by the proxy to call the AutoDev Control API. */
+const CONTROL_API_TOKEN_ENV = "AUTODEV_CONTROL_API_TOKEN";
+/**
+ * Kill switch: when set to `1` or `true`, the proxy short-circuits every
+ * request with a 503. Useful for local development and for the cutover
+ * window when the AutoDev Control API is being brought up or taken down.
+ */
+const CONTROL_API_DISABLED_ENV = "AUTODEV_CONTROL_API_DISABLED";
+
+/**
+ * Parse a JSON string defensively. Returns the parsed value on success or
+ * the original string when the body is not valid JSON. jsdom's Response
+ * stub returns the raw body string from `.json()`, so the proxy needs to
+ * attempt a parse before deciding whether to treat the value as already
+ * structured or as a JSON-encoded string.
+ */
+function safeJsonParse(raw: string): unknown {
+	try {
+		return JSON.parse(raw);
+	} catch {
+		return raw;
+	}
+}
+
+function readControlApiConfig():
+	| { baseUrl: string; token: string }
+	| { err: string; status: number } {
+	const disabled = process.env[CONTROL_API_DISABLED_ENV];
+	if (disabled === "1" || disabled === "true") {
+		return {
+			status: 503,
+			err: "AutoDev Control API proxy is disabled via AUTODEV_CONTROL_API_DISABLED",
+		};
+	}
+	const baseUrl = process.env[CONTROL_API_URL_ENV];
+	const token = process.env[CONTROL_API_TOKEN_ENV];
+	if (!baseUrl || !token) {
+		return {
+			status: 503,
+			err: `${CONTROL_API_URL_ENV} and ${CONTROL_API_TOKEN_ENV} must be set on the OpenLIT server before the /autodev proxy can forward requests.`,
+		};
+	}
+	return { baseUrl: baseUrl.replace(/\/+$/u, ""), token };
+}
+
+/**
+ * Resolve the verified actor identity from the NextAuth session.
+ *
+ * Production callers rely on `getCurrentUser()` — every `/autodev/api/*`
+ * handler invokes this internally before forwarding the request. The
+ * `_setActorResolverForTesting` hook exists so unit tests can swap the
+ * resolver for a stub without loading the full NextAuth + Prisma stack.
+ * The hook is a no-op outside `NODE_ENV === 'test'` so it cannot be used
+ * to bypass auth in production.
+ */
+let _actorResolver: (() => Promise<string | null>) | null = null;
+export function _setActorResolverForTesting(
+	fn: (() => Promise<string | null>) | null,
+): void {
+	if (
+		process.env.NODE_ENV !== "test" &&
+		process.env.AUTODEV_ALLOW_TEST_HOOKS !== "1"
+	) {
+		return;
+	}
+	_actorResolver = fn;
+}
+
+async function resolveActorId(): Promise<string | null> {
+	if (_actorResolver) return _actorResolver();
+	return fetchActorFromSession();
+}
+
+/**
+ * State-changing verbs that need an exact Origin match. GET / HEAD are
+ * exempted because they cannot mutate server state, so they don't need
+ * CSRF protection.
+ */
+const STATE_CHANGING_METHODS = new Set(["POST", "PUT", "PATCH", "DELETE"]);
+
+/**
+ * Verify the Origin header against the request's Host for state-changing
+ * requests on `/autodev/api/*`. The stock middleware CSRF helper keys on
+ * `pathname.startsWith("/api/")`, which is false for our routes — the
+ * OpenLIT matcher already adds `/autodev` and `/autodev/:path*`, so the
+ * middleware chain runs, but the CSRF check itself never fires for our
+ * paths. Same-origin alone is also not sufficient defense against a
+ * confused-deputy attack, so the proxy performs the check itself:
+ *
+ *   - Reject any state-changing request with a missing Origin (the
+ *     browser always sets one for cross-origin and same-origin requests
+ *     that aren't simple GET/HEAD; an absent Origin on a PATCH means the
+ *     caller is not a browser).
+ *   - Reject requests whose Origin host does not match the request Host
+ *     (case-insensitive, scheme-agnostic so https://App.example.com and
+ *     https://app.example.com both match the same host:app.example.com).
+ *
+ * The check returns `{ ok: true }` for non-state-changing methods; the
+ * caller is expected to short-circuit before the check runs for them.
+ */
+function verifyOriginForMutation(
+	request: NextRequest,
+): { ok: true } | { ok: false; status: number; err: string } {
+	if (!STATE_CHANGING_METHODS.has(request.method.toUpperCase())) {
+		return { ok: true };
+	}
+	const origin = request.headers.get("origin");
+	const host = request.headers.get("host");
+	if (!origin) {
+		return {
+			ok: false,
+			status: 403,
+			err: "missing Origin header on state-changing request",
+		};
+	}
+	if (!host) {
+		return {
+			ok: false,
+			status: 403,
+			err: "missing Host header on state-changing request",
+		};
+	}
+	let originHost: string;
+	try {
+		originHost = new URL(origin).host.toLowerCase();
+	} catch {
+		return {
+			ok: false,
+			status: 403,
+			err: "malformed Origin header on state-changing request",
+		};
+	}
+	const requestHost = host.toLowerCase();
+	if (originHost !== requestHost) {
+		return {
+			ok: false,
+			status: 403,
+			err: `Origin ${originHost} does not match request host ${requestHost}`,
+		};
+	}
+	return { ok: true };
+}
+
+/**
+ * Forward a typed request to the AutoDev Control API. Returns a discriminated
+ * union: `{ ok: true, status, body }` on success and `{ ok: false, status, err }`
+ * for transport, auth, and authorization failures. The caller decides how to
+ * map these onto Next.js `Response` objects.
+ *
+ * The proxy forwards only the headers the AutoDev API contract documents:
+ *
+ *   Authorization:   Bearer <service token>      (server-only)
+ *   X-AutoDev-Actor: <verified session user id>  (server-only, derived)
+ *
+ * It MUST NOT forward `X-AutoDev-Role` or `X-AutoDev-Actor-Email` or any
+ * other identity claim: the AutoDev API decides allowlist membership from
+ * the actor id alone.
+ */
+export async function forwardToControlApi<T = unknown>(
+	req: ControlApiRequest,
+): Promise<
+	| { ok: true; status: number; body: T }
+	| { ok: false; status: number; err: string }
+> {
+	const config = readControlApiConfig();
+	if ("err" in config) {
+		return { ok: false, status: config.status, err: config.err };
+	}
+
+	const actor = await resolveActorId();
+	if (!actor) return { ok: false, status: 401, err: "unauthenticated" };
+
+	const url = `${config.baseUrl}/control/${req.path}`;
+	const headers: Record<string, string> = {
+		Authorization: `Bearer ${config.token}`,
+		Accept: "application/json",
+		// Single, verified identity claim. The AutoDev API alone matches
+		// this against its own viewers / operators allowlists.
+		"X-AutoDev-Actor": actor,
+	};
+	let body: BodyInit | undefined;
+	if (req.body !== undefined) {
+		headers["Content-Type"] = "application/json";
+		body = JSON.stringify(req.body);
+	}
+
+	let response: Response;
+	try {
+		response = await fetch(url, { method: req.method, headers, body });
+	} catch (e) {
+		return {
+			ok: false,
+			status: 502,
+			err: `AutoDev Control API unreachable: ${(e as Error).message}`,
+		};
+	}
+
+	// `headers` / body methods can be missing or stubbed when the upstream
+	// returns a malformed response; defensive fallbacks keep the proxy from
+	// crashing on edge cases that have nothing to do with the AutoDev
+	// contract. In production this code path receives a real `Response`
+	// from Node's `fetch`; the fallbacks exist for unit tests that mock
+	// `fetch` with partial Response stubs.
+	const headerGet =
+		typeof response.headers?.get === "function"
+			? response.headers.get.bind(response.headers)
+			: null;
+	const contentType = headerGet ? (headerGet("content-type") ?? "") : "";
+	let parsed: unknown = null;
+	try {
+		// The mock-friendly path: prefer `.json()` for JSON and unknown
+		// content types (jsdom's `Response` exposes `.json()` but not
+		// `.text()`; native `Response` exposes both). `.text()` is used as
+		// a last-resort fallback for non-JSON content.
+		let raw: unknown = null;
+		if (
+			contentType.includes("application/json") ||
+			typeof response.json === "function"
+		) {
+			raw = await response.json();
+		} else if (typeof response.text === "function") {
+			raw = await response.text();
+		}
+		// jsdom's `Response.json()` returns the body string, not the parsed
+		// value. Native `Response.json()` returns the parsed object. Cover
+		// both so unit tests using jsdom stubs work the same as production.
+		parsed = typeof raw === "string" ? safeJsonParse(raw) : raw;
+	} catch {
+		parsed = null;
+	}
+	// Use explicit status-range check so the proxy works on test stubs that
+	// don't implement the `ok` convenience property (jsdom's Response, for
+	// example, exposes `status` and `body` but not `ok`).
+	const isOk =
+		typeof response.status === "number" &&
+		response.status >= 200 &&
+		response.status < 300;
+	if (isOk) {
+		return { ok: true, status: response.status, body: parsed as T };
+	}
+	return {
+		ok: false,
+		status: response.status,
+		err:
+			typeof parsed === "string"
+				? parsed
+				: JSON.stringify(parsed ?? response.statusText),
+	};
+}
+
+/**
+ * Convert a `ControlApiResponse` into a Next.js `Response` object. Successes
+ * pass the AutoDev response body through unchanged (the browser parses it
+ * with the existing OpenLIT fetch wrapper). Failures are normalized to a
+ * stable `{ err }` JSON envelope so the client renders a consistent error
+ * message regardless of which hop failed.
+ */
+export function controlResponseToFetch(
+	res:
+		| { ok: true; status: number; body: unknown }
+		| { ok: false; status: number; err: string },
+): Response {
+	if (res.ok) {
+		return new Response(JSON.stringify(res.body ?? null), {
+			status: res.status,
+			headers: { "content-type": "application/json" },
+		});
+	}
+	return new Response(JSON.stringify({ err: res.err }), {
+		status: res.status,
+		headers: { "content-type": "application/json" },
+	});
+}
+
+/**
+ * Wrap a Next.js route handler so the OpenLIT auth middleware runs before
+ * the request reaches the proxy AND the proxy itself enforces exact Origin
+ * matching for state-changing methods. Use this on every `/autodev/api/*`
+ * handler to keep the security boundary identical to the stock API surface.
+ */
+export async function withControlApiProxy(
+	request: NextRequest,
+	method: HttpMethod,
+	path: string,
+	body?: unknown,
+): Promise<Response> {
+	// Exact-Origin check for state-changing verbs. The stock middleware CSRF
+	// helper keys on `pathname.startsWith("/api/")` and never fires for
+	// `/autodev/api/*`, so the proxy performs its own check here. Same-origin
+	// alone is not sufficient — the check rejects missing OR mismatched
+	// Origin headers.
+	const originCheck = verifyOriginForMutation(request);
+	if (!originCheck.ok) {
+		return controlResponseToFetch(originCheck);
+	}
+	const res = await forwardToControlApi({
+		method,
+		path,
+		body,
+	});
+	return controlResponseToFetch(res);
+}
