@@ -0,0 +1,141 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+/**
+ * /autodev/runtime
+ *
+ * Renders the live router state from the
+ * `autodev-control-runtime-v1` schema (defined in
+ * runtime/src/control-api/index.ts). The AutoDev API exposes the router
+ * instance id, lifecycle status, concurrency-manager status, and the
+ * active request count — it does NOT advertise a custom `version`,
+ * `startedAt`, `collectors[]`, or `queues[]` shape, so this page shows
+ * only the fields the upstream returns.
+ *
+ * The page is read-only: mutations stay gated on the AutoDev Control API
+ * allowlists, and the OpenLIT CE has no granular RBAC to enforce an
+ * OpenLIT-side role.
+ */
+
+interface RuntimeResponse {
+	schema: "autodev-control-runtime-v1";
+	routerInstanceId: string;
+	lifecycle: Record<string, unknown>;
+	concurrency: Record<string, unknown>;
+	inFlightRequestCount: number;
+}
+
+function formatLifecycle(value: unknown): string {
+	if (value === null || value === undefined) return "unknown";
+	if (typeof value === "string") return value;
+	try {
+		return JSON.stringify(value, null, 2);
+	} catch {
+		return String(value);
+	}
+}
+
+export default function AutodevRuntimePage() {
+	const [data, setData] = useState<RuntimeResponse | null>(null);
+	const [err, setErr] = useState<string | null>(null);
+
+	useEffect(() => {
+		let cancelled = false;
+		fetch("/autodev/api/runtime", { credentials: "same-origin" })
+			.then(async (r) => {
+				if (!r.ok) {
+					const body = (await r.json().catch(() => ({}))) as { err?: string };
+					throw new Error(body.err ?? `HTTP ${r.status}`);
+				}
+				return r.json();
+			})
+			.then((body: RuntimeResponse) => {
+				if (!cancelled) setData(body);
+			})
+			.catch((e: Error) => {
+				if (!cancelled) setErr(e.message);
+			});
+		return () => {
+			cancelled = true;
+		};
+	}, []);
+
+	if (err) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">Runtime controls</h1>
+				<p
+					className="mt-3 rounded border border-amber-300 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-800 p-3 text-sm"
+					role="status"
+				>
+					Unable to load runtime state: {err}
+				</p>
+			</section>
+		);
+	}
+
+	if (!data) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">Runtime controls</h1>
+				<p className="mt-3 text-sm text-stone-500">Loading runtime state…</p>
+			</section>
+		);
+	}
+
+	return (
+		<section className="space-y-6">
+			<div>
+				<h1 className="text-xl font-semibold">Runtime controls</h1>
+				<p className="mt-2 text-sm text-stone-600 dark:text-stone-300 max-w-3xl">
+					Live router state. The proxy forwards the verified actor identity
+					to the AutoDev Control API; the API alone decides whether a
+					mutation is allowed for the current actor against its resource
+					allowlists. OpenLIT CE has no granular RBAC, so all authorization
+					lives on the AutoDev side.
+				</p>
+			</div>
+			<dl className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
+				<div className="rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4">
+					<dt className="text-xs uppercase text-stone-500">Schema</dt>
+					<dd className="mt-1 font-mono">{data.schema}</dd>
+				</div>
+				<div className="rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4">
+					<dt className="text-xs uppercase text-stone-500">
+						Router instance id
+					</dt>
+					<dd className="mt-1 font-mono break-all">
+						{data.routerInstanceId}
+					</dd>
+				</div>
+				<div className="rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4">
+					<dt className="text-xs uppercase text-stone-500">
+						In-flight requests
+					</dt>
+					<dd className="mt-1 font-mono">
+						{typeof data.inFlightRequestCount === "number"
+							? data.inFlightRequestCount
+							: "unknown"}
+					</dd>
+				</div>
+			</dl>
+			<div>
+				<h2 className="text-sm font-semibold uppercase text-stone-500">
+					Lifecycle
+				</h2>
+				<pre className="mt-2 overflow-x-auto rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-3 text-xs font-mono">
+					{formatLifecycle(data.lifecycle)}
+				</pre>
+			</div>
+			<div>
+				<h2 className="text-sm font-semibold uppercase text-stone-500">
+					Concurrency
+				</h2>
+				<pre className="mt-2 overflow-x-auto rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-3 text-xs font-mono">
+					{formatLifecycle(data.concurrency)}
+				</pre>
+			</div>
+		</section>
+	);
+}
