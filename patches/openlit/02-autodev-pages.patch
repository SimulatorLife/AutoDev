@@ -0,0 +1,270 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+
+/**
+ * /autodev/providers
+ *
+ * Renders the authoritative provider configuration read from the same-origin
+ * AutoDev Control API proxy at /autodev/api/providers. The page never holds
+ * the AutoDev Control API token; the proxy resolves the service credential
+ * server-side and forwards the request.
+ *
+ * Per the canonical AutoDev Control API contract
+ * (`autodev-control-providers-v1`, defined in runtime/src/control-api/index.ts):
+ *
+ *   - `providers[]` entries carry `id` plus a `roles` map with
+ *     `orchestrator.{enabled,mutable}` and `subagent.{enabled,mutable}`.
+ *   - The top-level `disabledOrchestratorProviders` and
+ *     `disabledSubagentProviders` arrays are the runtime's authoritative
+ *     view of the currently disabled set (a mutation takes effect here, not
+ *     inside an individual provider row).
+ *   - The API does NOT advertise `displayName`, `status`, or a separate
+ *     `ProviderRoleBinding[]` list. Those fields are stock UI decorations;
+ *     they belong to the OpenLIT telemetry surface, not to this control
+ *     surface, and the proxy must not invent them.
+ *
+ * Authorization is enforced by the AutoDev Control API; the proxy forwards
+ * the verified actor identity via `X-AutoDev-Actor` and the AutoDev API
+ * applies its own `AUTODEV_CONTROL_OPERATORS` allowlist. A 403 means the
+ * actor is not an operator; the page surfaces the upstream error verbatim
+ * so the operator sees why the action was rejected.
+ */
+
+interface ProviderRoleState {
+	enabled: boolean;
+	mutable: boolean;
+}
+
+interface ProviderRoles {
+	orchestrator: ProviderRoleState;
+	subagent: ProviderRoleState;
+}
+
+interface ProviderEntry {
+	id: string;
+	roles: ProviderRoles;
+}
+
+interface ProvidersResponse {
+	schema: "autodev-control-providers-v1";
+	providers: ProviderEntry[];
+	disabledOrchestratorProviders: string[];
+	disabledSubagentProviders: string[];
+}
+
+interface ProviderRolePatchResponse {
+	schema: "autodev-control-provider-role-v1";
+	provider: string;
+	role: "orchestrator" | "subagent";
+	enabled: boolean;
+	previous: boolean;
+	actor: string;
+}
+
+interface MutationResult {
+	provider: string;
+	role: "orchestrator" | "subagent";
+	enabled: boolean;
+	err?: string;
+}
+
+type RoleKey = "orchestrator" | "subagent";
+const ROLES: RoleKey[] = ["orchestrator", "subagent"];
+
+export default function AutodevProvidersPage() {
+	const [data, setData] = useState<ProvidersResponse | null>(null);
+	const [err, setErr] = useState<string | null>(null);
+	const [pending, setPending] = useState<Record<string, boolean>>({});
+	const [results, setResults] = useState<Record<string, MutationResult>>({});
+
+	const refresh = useCallback(async () => {
+		try {
+			const r = await fetch("/autodev/api/providers", {
+				credentials: "same-origin",
+			});
+			if (!r.ok) {
+				const body = (await r.json().catch(() => ({}))) as { err?: string };
+				throw new Error(body.err ?? `HTTP ${r.status}`);
+			}
+			setData((await r.json()) as ProvidersResponse);
+		} catch (e) {
+			setErr((e as Error).message);
+		}
+	}, []);
+
+	useEffect(() => {
+		void refresh();
+	}, [refresh]);
+
+	const toggleRole = useCallback(
+		async (providerId: string, role: RoleKey, next: boolean) => {
+			const key = `${providerId}/${role}`;
+			setPending((prev) => ({ ...prev, [key]: true }));
+			setResults((prev) => ({
+				...prev,
+				[key]: { provider: providerId, role, enabled: next },
+			}));
+			try {
+				const r = await fetch(
+					`/autodev/api/providers/${encodeURIComponent(providerId)}/roles/${encodeURIComponent(role)}`,
+					{
+						method: "PATCH",
+						credentials: "same-origin",
+						headers: { "Content-Type": "application/json" },
+						body: JSON.stringify({ enabled: next }),
+					},
+				);
+				const body = (await r.json().catch(() => ({}))) as
+					| (ProviderRolePatchResponse & { err?: string })
+					| { err?: string };
+				if (!r.ok) {
+					const message =
+						"err" in body && body.err
+							? body.err
+							: `HTTP ${r.status}`;
+					setResults((prev) => ({
+						...prev,
+						[key]: {
+							provider: providerId,
+							role,
+							enabled: !next,
+							err: message,
+						},
+					}));
+					return;
+				}
+				setResults((prev) => ({
+					...prev,
+					[key]: {
+						provider: providerId,
+						role,
+						enabled: next,
+					},
+				}));
+				// Re-read so the table reflects the upstream-authoritative state.
+				await refresh();
+			} finally {
+				setPending((prev) => ({ ...prev, [key]: false }));
+			}
+		},
+		[refresh],
+	);
+
+	if (err) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">Providers</h1>
+				<p
+					className="mt-3 rounded border border-amber-300 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-800 p-3 text-sm"
+					role="status"
+				>
+					Unable to load providers: {err}
+				</p>
+			</section>
+		);
+	}
+
+	if (!data) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">Providers</h1>
+				<p className="mt-3 text-sm text-stone-500">Loading providers…</p>
+			</section>
+		);
+	}
+
+	const disabledOrchestrator = new Set(
+		data.disabledOrchestratorProviders ?? [],
+	);
+	const disabledSubagent = new Set(data.disabledSubagentProviders ?? []);
+
+	return (
+		<section>
+			<h1 className="text-xl font-semibold">Providers</h1>
+			<p className="mt-2 text-sm text-stone-600 dark:text-stone-300 max-w-3xl">
+				Authoritative provider configuration and current availability.
+				Mutations are forwarded to{" "}
+				<code>PATCH /control/providers/&#123;provider&#125;/roles/&#123;role&#125;</code>{" "}
+				and enforced by the AutoDev Control API against its operator
+				allowlist. Historical activity (token usage, latency, errors) is
+				rendered by the stock OpenLIT{" "}
+				<a className="underline" href="/telemetry">traces</a> and{" "}
+				<a className="underline" href="/dashboards">dashboards</a> views.
+			</p>
+			<table className="mt-6 w-full text-sm border-collapse">
+				<thead>
+					<tr className="text-left border-b border-stone-200 dark:border-stone-800">
+						<th className="py-2">Provider</th>
+						{ROLES.map((role) => (
+							<th key={role} className="py-2 capitalize">
+								{role}
+							</th>
+						))}
+					</tr>
+				</thead>
+				<tbody>
+					{data.providers.map((p) => (
+						<tr
+							key={p.id}
+							className="border-b border-stone-100 dark:border-stone-900 align-top"
+						>
+							<td className="py-2 font-medium">{p.id}</td>
+							{ROLES.map((role) => {
+								const key = `${p.id}/${role}`;
+								const state = p.roles[role];
+								const isPending = pending[key];
+								const result = results[key];
+								const runtimeDisabled =
+									role === "orchestrator"
+										? disabledOrchestrator.has(p.id)
+										: disabledSubagent.has(p.id);
+								return (
+									<td key={role} className="py-2">
+										<span
+											className={`inline-block mr-2 px-2 py-0.5 rounded text-xs ${
+												state.enabled
+													? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-100"
+													: "bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-300"
+											}`}
+										>
+											{state.enabled ? "enabled" : "disabled"}
+										</span>
+										{runtimeDisabled ? (
+											<span
+												className="inline-block mr-2 px-2 py-0.5 rounded text-xs bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100"
+												title="runtime-disabled"
+											>
+												runtime off
+											</span>
+										) : null}
+										<button
+											type="button"
+											className="text-xs underline disabled:opacity-50"
+											disabled={isPending || !state.mutable}
+											onClick={() => toggleRole(p.id, role, !state.enabled)}
+										>
+											{isPending
+												? "saving…"
+												: state.enabled
+													? "disable"
+													: "enable"}
+										</button>
+										{result?.err ? (
+											<p
+												className="mt-1 text-xs text-amber-700 dark:text-amber-300"
+												role="status"
+											>
+												rejected: {result.err}
+											</p>
+										) : null}
+									</td>
+								);
+							})}
+						</tr>
+					))}
+				</tbody>
+			</table>
+		</section>
+	);
+}
