+"use client";
+
+import { useEffect, useState } from "react";
+
+/**
+ * /autodev/mcps
+ *
+ * Renders the read-only MCP server exposure list sourced from the
+ * `autodev-control-mcps-v1` schema (defined in runtime/src/control-api/index.ts).
+ * The AutoDev API derives exposure from the configured role bindings on
+ * each server; it does NOT advertise a separate `transport`, `exposed`,
+ * `available`, or `tools[]` list — those belong to OpenLIT's stock
+ * telemetry views, not to this control surface.
+ *
+ * Historical MCP operations are explored through OpenLIT's stock trace view
+ * filtered by `mcp.method` / `mcp.server` attributes; the page links there
+ * rather than rebuilding charts.
+ */
+
+interface McpServerEntry {
+	name: string;
+	roles: string[];
+}
+
+interface McpsResponse {
+	schema: "autodev-control-mcps-v1";
+	source: string;
+	readOnly: true;
+	servers: McpServerEntry[];
+}
+
+export default function AutodevMcpsPage() {
+	const [data, setData] = useState<McpsResponse | null>(null);
+	const [err, setErr] = useState<string | null>(null);
+
+	useEffect(() => {
+		let cancelled = false;
+		fetch("/autodev/api/mcps", { credentials: "same-origin" })
+			.then(async (r) => {
+				if (!r.ok) {
+					const body = (await r.json().catch(() => ({}))) as { err?: string };
+					throw new Error(body.err ?? `HTTP ${r.status}`);
+				}
+				return r.json();
+			})
+			.then((body: McpsResponse) => {
+				if (!cancelled) setData(body);
+			})
+			.catch((e: Error) => {
+				if (!cancelled) setErr(e.message);
+			});
+		return () => {
+			cancelled = true;
+		};
+	}, []);
+
+	if (err) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">MCPs</h1>
+				<p
+					className="mt-3 rounded border border-amber-300 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-800 p-3 text-sm"
+					role="status"
+				>
+					Unable to load MCPs: {err}
+				</p>
+			</section>
+		);
+	}
+
+	if (!data) {
+		return (
+			<section>
+				<h1 className="text-xl font-semibold">MCPs</h1>
+				<p className="mt-3 text-sm text-stone-500">Loading MCP servers…</p>
+			</section>
+		);
+	}
+
+	return (
+		<section>
+			<h1 className="text-xl font-semibold">MCP servers</h1>
+			<p className="mt-2 text-sm text-stone-600 dark:text-stone-300 max-w-3xl">
+				Configured MCP servers and the roles that currently expose them.
+				This control surface is read-only: mutations require an authoritative
+				writable configuration that does not yet exist on the AutoDev side.
+				Historical MCP operations are explored through the stock OpenLIT{" "}
+				<a className="underline" href="/telemetry">traces</a> view filtered
+				by <code>mcp.method</code> / <code>mcp.server</code> attributes.
+			</p>
+			<p className="mt-2 text-xs text-stone-500">
+				schema: <code>{data.schema}</code> · source:{" "}
+				<code>{data.source}</code> · read-only:{" "}
+				<code>{String(data.readOnly)}</code>
+			</p>
+			<ul className="mt-6 space-y-3">
+				{(data.servers ?? []).map((m) => (
+					<li
+						key={m.name}
+						className="rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4"
+					>
+						<div className="flex items-center justify-between">
+							<span className="font-medium">{m.name}</span>
+						</div>
+						<div className="mt-2 text-sm">
+							<span className="text-xs uppercase text-stone-500 mr-2">
+								exposed to roles:
+							</span>
+							{(m.roles ?? []).map((r) => (
+								<span
+									key={r}
+									className="inline-block mr-2 px-2 py-0.5 rounded text-xs bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300"
+								>
+									{r}
+								</span>
+							))}
+						</div>
+					</li>
+				))}
+			</ul>
+		</section>
+	);
+}
