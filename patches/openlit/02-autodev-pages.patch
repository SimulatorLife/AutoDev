+import Link from "next/link";
+
+/**
+ * /autodev index page.
+ *
+ * Top-level entry point that links to the four stock control surfaces
+ * (Providers, MCPs, Skills, Runtime) and to OpenLIT's stock observability
+ * views for historical activity. The page is reachable from the OpenLIT
+ * left nav (see the "Configuration" section in src/constants/sidebar.tsx)
+ * — a nested `/autodev` layout without a top-level entry would not be
+ * discoverable.
+ *
+ * No charts are rendered here; the AutoDev target is to use stock OpenLIT
+ * dashboards for history. All mutations are evaluated by the AutoDev
+ * Control API against its own resource/action allowlists.
+ */
+const SECTIONS: Array<{
+	href: string;
+	label: string;
+	description: string;
+	readOnly: boolean;
+}> = [
+	{
+		href: "/autodev/providers",
+		label: "Providers",
+		description:
+			"Authoritative provider configuration and per-role enablement. Mutations are PATCH /control/providers/{provider}/roles/{role}.",
+		readOnly: false,
+	},
+	{
+		href: "/autodev/mcps",
+		label: "MCPs",
+		description:
+			"Configured MCP servers and the roles that currently expose them. Read-only on this control surface.",
+		readOnly: true,
+	},
+	{
+		href: "/autodev/skills",
+		label: "Skills",
+		description:
+			"Configured skills and the roles that currently expose them. Read-only on this control surface.",
+		readOnly: true,
+	},
+	{
+		href: "/autodev/runtime",
+		label: "Runtime controls",
+		description:
+			"Live router state: lifecycle, concurrency manager, active request count. Mutations stay gated on the AutoDev Control API allowlists.",
+		readOnly: true,
+	},
+];
+
+const HISTORY: Array<{ href: string; label: string; description: string }> = [
+	{
+		href: "/dashboards",
+		label: "OpenLIT dashboards",
+		description:
+			"Stock token usage, latency, tool calls, and agent run dashboards.",
+	},
+	{
+		href: "/telemetry",
+		label: "OpenLIT traces",
+		description:
+			"Trace and log exploration; historical provider/MCP/skill activity.",
+	},
+];
+
+export default function AutodevIndexPage() {
+	return (
+		<div className="space-y-10">
+			<section>
+				<h1 className="text-2xl font-semibold tracking-tight">
+					AutoDev Control
+				</h1>
+				<p className="mt-2 text-sm text-stone-600 dark:text-stone-300 max-w-3xl">
+					Isolated AutoDev control surface. Authoritative configuration and
+					current state live here; historical activity is rendered by stock
+					OpenLIT dashboards. All mutations are evaluated by the AutoDev
+					Control API against its own resource/action allowlists. OpenLIT CE
+					has no granular RBAC, so the AutoDev API alone matches the verified
+					actor identity against its viewers / operators allowlists.
+				</p>
+			</section>
+			<section>
+				<h2 className="text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">
+					Control surfaces
+				</h2>
+				<ul className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
+					{SECTIONS.map((s) => (
+						<li key={s.href}>
+							<Link
+								href={s.href}
+								className="block rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4 hover:border-stone-400 dark:hover:border-stone-600"
+							>
+								<div className="flex items-center justify-between">
+									<span className="text-base font-medium">{s.label}</span>
+									{s.readOnly ? (
+										<span className="text-[10px] font-mono text-stone-400">
+											read-only
+										</span>
+									) : null}
+								</div>
+								<p className="mt-1 text-sm text-stone-600 dark:text-stone-300">
+									{s.description}
+								</p>
+							</Link>
+						</li>
+					))}
+				</ul>
+			</section>
+			<section>
+				<h2 className="text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">
+					Historical activity
+				</h2>
+				<ul className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
+					{HISTORY.map((h) => (
+						<li key={h.href}>
+							<Link
+								href={h.href}
+								className="block rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-4 hover:border-stone-400 dark:hover:border-stone-600"
+							>
+								<div className="text-base font-medium">{h.label}</div>
+								<p className="mt-1 text-sm text-stone-600 dark:text-stone-300">
+									{h.description}
+								</p>
+							</Link>
+						</li>
+					))}
+				</ul>
+			</section>
+		</div>
+	);
+}
