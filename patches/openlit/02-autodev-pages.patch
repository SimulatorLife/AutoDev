+
+	it("maps upstream 502 / connection failure to a normalized error envelope", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: "http://127.0.0.1:4100",
+			AUTODEV_CONTROL_API_TOKEN: "service-secret",
