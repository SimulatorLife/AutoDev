+/**
+ * Proxy contract tests for the AutoDev Control API gateway.
+ *
+ * These tests focus on the security boundary the patch documents:
+ *
+ *   1. The service credential must never appear in any value the proxy
+ *      returns to the browser (URL, headers, body).
+ *   2. The proxy must reject requests when the OpenLIT session is missing
+ *      with a deterministic 401 envelope.
+ *   3. The proxy must reject state-changing requests whose Origin header
+ *      is missing or mismatched against the request Host (the stock
+ *      middleware CSRF helper keys on `pathname.startsWith("/api/")` and
+ *      never fires for `/autodev/api/*`, so the proxy performs its own
+ *      exact-Origin check).
+ *   4. The kill switch (`AUTODEV_CONTROL_API_DISABLED=1`) must short-circuit
+ *      every request with a deterministic 503 envelope.
+ *   5. The proxy must forward ONLY the documented headers:
+ *        Authorization:           Bearer <service token>
+ *        X-AutoDev-Actor:         <verified NextAuth user id>
+ *      It MUST NOT forward X-AutoDev-Role, X-AutoDev-Actor-Email, or any
+ *      other identity claim. OpenLIT CE has no granular RBAC, so the
+ *      AutoDev Control API is the sole authority for viewer/operator
+ *      allowlists.
+ *   6. The PATCH endpoint forwards typed `{ enabled: boolean }` bodies to
+ *      the canonical PATCH /control/providers/{provider}/roles/{role} path.
+ *   7. Upstream 401/403/502 errors propagate through the proxy with the
+ *      upstream status preserved and a normalized `{ err }` body.
+ *
+ * The test uses the `_setActorResolverForTesting` hook to inject a stub
+ * session resolver. The proxy imports `@/lib/session` lazily (so the
+ * static import chain does not pull in NextAuth + Prisma + ESM-only
+ * `jose`); the hook short-circuits the dynamic import at call time.
+ */
+
+import {
+	_setActorResolverForTesting,
+	controlResponseToFetch,
+	forwardToControlApi,
+	withControlApiProxy,
+} from "@/lib/autodev/control-api";
+import type { NextRequest } from "next/server";
+
+// The test resolver hook is gated on NODE_ENV !== 'test'. Force it on
+// via `Object.defineProperty` because TypeScript types `process.env` as
+// readonly. The proxy reads `process.env.NODE_ENV` at function-call time
+// (not at module-load time), so the mutation is picked up by the resolver.
+Object.defineProperty(process.env, "NODE_ENV", {
+	value: "test",
+	writable: true,
+	configurable: true,
+});
+
+const envSnapshot = { ...process.env };
+
+function setEnv(patch: Record<string, string | undefined>) {
+	for (const [k, v] of Object.entries(patch)) {
+		if (v === undefined) delete process.env[k];
+		else process.env[k] = v;
+	}
+}
+
+function restoreEnv() {
+	for (const k of Object.keys(process.env)) {
+		if (!(k in envSnapshot)) delete process.env[k];
+	}
+	for (const [k, v] of Object.entries(envSnapshot)) {
+		process.env[k] = v;
+	}
+}
+
+const originalFetch = globalThis.fetch;
+function mockFetch(impl: typeof fetch) {
+	globalThis.fetch = impl as typeof fetch;
+}
+function unmockFetch() {
+	globalThis.fetch = originalFetch;
+}
+
+function setActor(fn: () => Promise<string | null> | string | null) {
+	_setActorResolverForTesting(async () => (await fn()) ?? null);
+}
+
+/**
+ * Build a minimal NextRequest stub. The proxy only reads `method`,
+ * `headers` (Origin / Host), and `nextUrl`. Tests below only mutate the
+ * subset they need; everything else is irrelevant.
+ */
+function fakeRequest(
+	init: {
+		method?: string;
+		origin?: string | null;
+		host?: string | null;
+	} = {},
+): NextRequest {
+	const headers = new Headers();
+	if (init.origin !== null && init.origin !== undefined) {
+		headers.set("origin", init.origin);
+	}
+	if (init.host !== null && init.host !== undefined) {
+		headers.set("host", init.host);
+	}
+	const url = `http://${init.host ?? "app.example.com"}/autodev/api/providers`;
+	return {
+		method: init.method ?? "GET",
+		headers,
+		nextUrl: new URL(url),
+	} as unknown as NextRequest;
+}
+
+beforeEach(() => {
+	setActor(() => null);
+});
+
+afterAll(() => {
+	restoreEnv();
+	unmockFetch();
+	_setActorResolverForTesting(null);
+});
+
+describe("forwardToControlApi", () => {
+	it("returns 401 when the OpenLIT session is missing", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: "http://127.0.0.1:4100",
+			AUTODEV_CONTROL_API_TOKEN: "service-secret",
+			AUTODEV_CONTROL_API_DISABLED: undefined,
+		});
+		setActor(() => null);
+		const res = await forwardToControlApi({ method: "GET", path: "providers" });
+		expect(res.ok).toBe(false);
+		if (!res.ok) {
+			expect(res.status).toBe(401);
+			expect(res.err).toBe("unauthenticated");
+		}
+	});
+
+	it("returns 503 when the kill switch is set", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: "http://127.0.0.1:4100",
+			AUTODEV_CONTROL_API_TOKEN: "service-secret",
+			AUTODEV_CONTROL_API_DISABLED: "1",
+		});
+		setActor(() => "u1");
+		const res = await forwardToControlApi({ method: "GET", path: "providers" });
+		expect(res.ok).toBe(false);
+		if (!res.ok) {
+			expect(res.status).toBe(503);
+			expect(res.err).toMatch(/AUTODEV_CONTROL_API_DISABLED/);
+		}
+	});
+
+	it("returns 503 when required env is missing", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: undefined,
+			AUTODEV_CONTROL_API_TOKEN: undefined,
+			AUTODEV_CONTROL_API_DISABLED: undefined,
+		});
+		setActor(() => "u1");
+		const res = await forwardToControlApi({ method: "GET", path: "providers" });
+		expect(res.ok).toBe(false);
+		if (!res.ok) {
+			expect(res.status).toBe(503);
+			expect(res.err).toMatch(/AUTODEV_CONTROL_API_URL/);
+		}
+	});
+
+	it("forwards only Authorization + X-AutoDev-Actor, never a role claim", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: "http://127.0.0.1:4100",
+			AUTODEV_CONTROL_API_TOKEN: "service-secret-do-not-leak",
+			AUTODEV_CONTROL_API_DISABLED: undefined,
+		});
+		const observed: Array<{ url: string; init: RequestInit }> = [];
+		mockFetch(async (input, init) => {
+			observed.push({
+				url: typeof input === "string" ? input : (input as URL).toString(),
+				init: init ?? {},
+			});
+			return new Response(
+				JSON.stringify({
+					schema: "autodev-control-providers-v1",
+					providers: [
+						{
+							id: "openai",
+							roles: {
+								orchestrator: { enabled: true, mutable: true },
+								subagent: { enabled: true, mutable: true },
+							},
+						},
+					],
+					disabledOrchestratorProviders: [],
+					disabledSubagentProviders: [],
+				}),
+				{
+					status: 200,
+					headers: { "content-type": "application/json" },
+				},
+			);
+		});
+		setActor(() => "u1");
+		const res = await forwardToControlApi<{
+			schema: string;
+			providers: Array<{
+				id: string;
+				roles: {
+					orchestrator: { enabled: boolean; mutable: boolean };
+					subagent: { enabled: boolean; mutable: boolean };
+				};
+			}>;
+		}>({ method: "GET", path: "providers" });
+		expect(res.ok).toBe(true);
+		if (res.ok) {
+			expect(res.status).toBe(200);
+			expect(res.body.schema).toBe("autodev-control-providers-v1");
+			expect(res.body.providers).toHaveLength(1);
+			expect(res.body.providers[0]?.id).toBe("openai");
+			expect(res.body.providers[0]?.roles.orchestrator.enabled).toBe(true);
+		}
+		expect(observed).toHaveLength(1);
+		const call = observed[0];
+		expect(call.url).toBe("http://127.0.0.1:4100/control/providers");
+		const headers = call.init.headers as Record<string, string>;
+
+		// Documented contract: only Authorization + X-AutoDev-Actor.
+		expect(headers.Authorization).toBe("Bearer service-secret-do-not-leak");
+		expect(headers["X-AutoDev-Actor"]).toBe("u1");
+
+		// Strictly forbidden: any role / email claim at the proxy layer.
+		// OpenLIT CE has no RBAC; AutoDev API alone applies allowlists.
+		expect(headers["X-AutoDev-Role"]).toBeUndefined();
+		expect(headers["X-AutoDev-Actor-Email"]).toBeUndefined();
+
+		// The bearer token must NEVER appear in the Next.js response the
+		// browser sees — only the typed AutoDev payload.
+		const fetchRes = controlResponseToFetch(res);
+		const raw = await fetchRes.json();
+		const body =
+			typeof raw === "string" ? JSON.parse(raw) : raw;
+		expect(JSON.stringify(body)).not.toMatch(/service-secret-do-not-leak/);
+		expect(body.schema).toBe("autodev-control-providers-v1");
+	});
+
+	it("PATCH forwards role-enablement bodies with the typed envelope", async () => {
+		setEnv({
+			AUTODEV_CONTROL_API_URL: "http://127.0.0.1:4100",
+			AUTODEV_CONTROL_API_TOKEN: "service-secret",
+			AUTODEV_CONTROL_API_DISABLED: undefined,
+		});
+		const observed: Array<{ url: string; init: RequestInit }> = [];
+		mockFetch(async (input, init) => {
+			observed.push({
+				url: typeof input === "string" ? input : (input as URL).toString(),
+				init: init ?? {},
+			});
+			return new Response(
+				JSON.stringify({
+					schema: "autodev-control-provider-role-v1",
+					provider: "openai",
+					role: "subagent",
+					enabled: true,
+					previous: false,
+					actor: "u1",
+				}),
+				{
+					status: 200,
+					headers: { "content-type": "application/json" },
+				},
+			);
+		});
+		setActor(() => "u1");
+		const res = await forwardToControlApi<{ enabled: boolean }>({
+			method: "PATCH",
+			path: "providers/openai/roles/subagent",
+			body: { enabled: true },
+		});
+		expect(res.ok).toBe(true);
+		if (res.ok) {
+			expect(res.status).toBe(200);
+			expect(res.body.enabled).toBe(true);
+		}
+		expect(observed).toHaveLength(1);
+		const call = observed[0];
+		expect(call.url).toBe(
+			"http://127.0.0.1:4100/control/providers/openai/roles/subagent",
+		);
+		const headers = call.init.headers as Record<string, string>;
+		expect(headers.Authorization).toBe("Bearer service-secret");
+		expect(headers["X-AutoDev-Actor"]).toBe("u1");
+		expect(headers["X-AutoDev-Role"]).toBeUndefined();
+		expect(headers["Content-Type"]).toBe("application/json");
+		expect(call.init.body).toBe(JSON.stringify({ enabled: true }));
