+import { fireEvent, render, screen } from "@testing-library/react";
+import MemoryActionDialog from "@/components/(playground)/memory/memory-action-dialog";
+import type { MemoryActionDescriptor } from "@/lib/platform/connectors/memory/types";
+
+const action: MemoryActionDescriptor = {
+	id: "invalidate",
+	label: "Invalidate memory",
+	description: "Add current evidence.",
+	payloadTemplate: { evidence: [] },
+};
+
+test("capability action dialog parses a JSON payload before dispatch", () => {
+	const onSubmit = jest.fn();
+	render(
+		<MemoryActionDialog
+			open
+			action={action}
+			saving={false}
+			onOpenChange={jest.fn()}
+			onSubmit={onSubmit}
+		/>,
+	);
+
+	fireEvent.change(screen.getByRole("textbox", { name: /lifecycle action json/i }), {
+		target: {
+			value: JSON.stringify({ evidence: [{ kind: "commit", uri: "git://repo/commit/abc" }] }),
+		},
+	});
+	fireEvent.click(screen.getByRole("button", { name: "Invalidate memory" }));
+
+	expect(onSubmit).toHaveBeenCalledWith({
+		evidence: [{ kind: "commit", uri: "git://repo/commit/abc" }],
+	});
+});
+
+test("capability action dialog rejects malformed payload JSON", () => {
+	const onSubmit = jest.fn();
+	render(
+		<MemoryActionDialog
+			open
+			action={action}
+			saving={false}
+			onOpenChange={jest.fn()}
+			onSubmit={onSubmit}
+		/>,
+	);
+
+	fireEvent.change(screen.getByRole("textbox", { name: /lifecycle action json/i }), {
+		target: { value: "not-json" },
+	});
+	fireEvent.click(screen.getByRole("button", { name: "Invalidate memory" }));
+
+	expect(onSubmit).not.toHaveBeenCalled();
+	expect(screen.getByText("Request body must be valid JSON.")).toBeTruthy();
+});
