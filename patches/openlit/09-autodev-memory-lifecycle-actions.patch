+export async function executeProjectMemoryAction(input: {
+	id: string;
+	connectorId?: string;
+	action: string;
+	payload: Record<string, unknown>;
+}): Promise<MemoryActionResult> {
+	const id = trim(input.id);
+	const action = trim(input.action);
+	if (!id || !action) throw new Error(MEMORY_DETAIL_NOT_FOUND);
+	const { connector, adapter, capabilities } = await resolveProjectMemoryAdapter(
+		input.connectorId
+	);
+	if (!adapter.actionsFor || !adapter.executeAction) {
+		throw new UnsupportedMemoryCapabilityError(adapter.type, "actions");
+	}
+	const current = await adapter.get(id);
+	if (!current) throw new Error(MEMORY_DETAIL_NOT_FOUND);
+	if (!adapter.actionsFor(current).some((candidate) => candidate.id === action)) {
+		throw new UnsupportedMemoryCapabilityError(
+			adapter.type,
+			"actions",
+			`Action "${action}" is not available for this memory record.`
+		);
+	}
+	const updated = await adapter.executeAction(id, action, input.payload);
+	return {
+		connector,
+		capabilities: {
+			...capabilities,
+			actions: adapter.actionsFor(updated)
+		},
+		memory: asMemoryListItem(updated)
+	};
+}
