@@ -0,0 +1,105 @@
+import { NextRequest } from "next/server";
+import { getCurrentUser } from "@/lib/session";
+import { errorResponse } from "@/utils/api-response";
+import asaw from "@/utils/asaw";
+import { withMemoryAccess, withMemoryAudit } from "@/lib/access/memory-route";
+import { isMemoryConnectorId, memoryConnectorId } from "@/lib/platform/connectors/memory/crud";
+import { executeProjectMemoryAction } from "@/lib/platform/connectors/memory/write";
+import { UnsupportedMemoryCapabilityError } from "@/lib/platform/connectors/memory/types";
+import {
+	MEMORY_CONNECTOR_NOT_FOUND,
+	MEMORY_DETAIL_NOT_FOUND,
+	MEMORY_EDIT_FAILED,
+	MEMORY_INVALID_FILTER,
+	MEMORY_INVALID_JSON,
+} from "@/constants/messages/en";
+
+const ID_MAX = 200;
+const ACTION_MAX = 64;
+const PAYLOAD_MAX = 4_000;
+
+function parseId(value: string): string {
+	const id = String(value || "").trim();
+	if (!id || id.length > ID_MAX || /[\u0000-\u001f]/.test(id)) {
+		throw new Error(MEMORY_INVALID_FILTER);
+	}
+	return id;
+}
+
+function parseConnectorId(value: unknown): string | undefined {
+	if (value == null) return undefined;
+	if (typeof value !== "string") throw new Error(MEMORY_INVALID_FILTER);
+	const trimmed = value.trim();
+	if (!trimmed) return undefined;
+	if (trimmed.length > 120 || /[\u0000-\u001f]/.test(trimmed)) {
+		throw new Error(MEMORY_INVALID_FILTER);
+	}
+	const id = memoryConnectorId(trimmed);
+	if (!isMemoryConnectorId(id)) throw new Error(MEMORY_CONNECTOR_NOT_FOUND);
+	return id;
+}
+
+function parseBody(value: unknown): {
+	action: string;
+	connectorId?: string;
+	payload: Record<string, unknown>;
+} {
+	if (!value || typeof value !== "object" || Array.isArray(value)) {
+		throw new Error(MEMORY_INVALID_JSON);
+	}
+	const body = value as Record<string, unknown>;
+	if (Object.keys(body).some((key) => !["action", "connectorId", "payload"].includes(key))) {
+		throw new Error(MEMORY_INVALID_FILTER);
+	}
+	if (
+		typeof body.action !== "string" ||
+		!body.action.trim() ||
+		body.action.trim().length > ACTION_MAX ||
+		/[\u0000-\u001f]/.test(body.action)
+	) {
+		throw new Error(MEMORY_INVALID_FILTER);
+	}
+	if (!body.payload || typeof body.payload !== "object" || Array.isArray(body.payload)) {
+		throw new Error(MEMORY_INVALID_JSON);
+	}
+	if (JSON.stringify(body.payload).length > PAYLOAD_MAX) {
+		throw new Error(MEMORY_INVALID_JSON);
+	}
+	return {
+		action: body.action.trim(),
+		connectorId: parseConnectorId(body.connectorId),
+		payload: body.payload as Record<string, unknown>,
+	};
+}
+
+function statusFor(error: unknown): number {
+	if (error instanceof UnsupportedMemoryCapabilityError) return 400;
+	if (error instanceof Error && error.message === MEMORY_DETAIL_NOT_FOUND) return 404;
+	if (error && typeof error === "object" && "status" in error) {
+		const status = Number((error as { status?: unknown }).status);
+		if ([400, 401, 403, 404, 409, 503].includes(status)) return status;
+	}
+	return 503;
+}
+
+async function POSTHandler(request: NextRequest, { params }: { params: { id: string } }) {
+	const user = await getCurrentUser();
+	if (!user) return Response.json("Unauthorized", { status: 401 });
+
+	let id: string;
+	let input: ReturnType<typeof parseBody>;
+	try {
+		id = parseId(params.id);
+		input = parseBody(await request.json());
+	} catch (error) {
+		return errorResponse(error, MEMORY_INVALID_JSON, 400);
+	}
+
+	const [error, result] = await asaw(executeProjectMemoryAction({ id, ...input }));
+	if (error) {
+		return errorResponse(error, MEMORY_EDIT_FAILED, statusFor(error));
+	}
+	return Response.json(result);
+}
+
+export const POST = withMemoryAudit(withMemoryAccess("update", POSTHandler));
