+jest.mock("@/lib/session", () => ({ getCurrentUser: jest.fn() }));
+jest.mock("@/lib/platform/connectors/memory/write", () => ({
+	executeProjectMemoryAction: jest.fn(),
+}));
+jest.mock("@/utils/asaw", () =>
+	jest.fn(async (promise: Promise<unknown>) => {
+		try {
+			return [null, await promise];
+		} catch (error) {
+			return [error, null];
+		}
+	}),
+);
+
+import { POST } from "@/app/api/memory/[id]/actions/route";
+import { getCurrentUser } from "@/lib/session";
+import { executeProjectMemoryAction } from "@/lib/platform/connectors/memory/write";
+import { MEMORY_INVALID_FILTER, MEMORY_INVALID_JSON } from "@/constants/messages/en";
+
+(globalThis as unknown as { Response: { json: unknown } }).Response = {
+	json: (body: unknown, init?: ResponseInit) => ({
+		status: init?.status ?? 200,
+		json: async () => body,
+	}),
+};
+
+function makeRequest(body: unknown) {
+	const url = "http://localhost/api/memory/memory-a/actions";
+	return {
+		url,
+		nextUrl: { searchParams: new URL(url).searchParams },
+		json: async () => {
+			if (body === "__invalid__") throw new SyntaxError("bad JSON");
+			return body;
+		},
+	} as any;
+}
+
+describe("POST /api/memory/[id]/actions", () => {
+	beforeEach(() => {
+		jest.clearAllMocks();
+		(getCurrentUser as jest.Mock).mockResolvedValue({ id: "operator-a" });
+	});
+
+	it("requires authentication", async () => {
+		(getCurrentUser as jest.Mock).mockResolvedValue(null);
+		const response = await POST(makeRequest({ action: "invalidate", payload: {} }), {
+			params: { id: "memory-a" },
+		});
+		expect(response.status).toBe(401);
+		expect(executeProjectMemoryAction).not.toHaveBeenCalled();
+	});
+
+	it("rejects malformed or extra action fields", async () => {
+		const malformed = await POST(makeRequest("__invalid__"), {
+			params: { id: "memory-a" },
+		});
+		expect(malformed.status).toBe(400);
+		await expect(malformed.json()).resolves.toBe(MEMORY_INVALID_JSON);
+
+		const extra = await POST(
+			makeRequest({ action: "invalidate", payload: {}, actor: "forged" }),
+			{ params: { id: "memory-a" } },
+		);
+		expect(extra.status).toBe(400);
+		await expect(extra.json()).resolves.toBe(MEMORY_INVALID_FILTER);
+		expect(executeProjectMemoryAction).not.toHaveBeenCalled();
+	});
+
+	it("dispatches a capability action through the connector service", async () => {
+		(executeProjectMemoryAction as jest.Mock).mockResolvedValue({
+			connector: { id: "memory:autodev" },
+			capabilities: { actions: [] },
+			memory: { id: "memory-a", lifecycleState: "invalidated" },
+		});
+		const payload = {
+			evidence: [{ kind: "commit", uri: "git://owner/repo/commit/abc" }],
+		};
+		const response = await POST(
+			makeRequest({
+				action: "invalidate",
+				connectorId: "memory:autodev",
+				payload,
+			}),
+			{ params: { id: "memory-a" } },
+		);
+		expect(response.status).toBe(200);
+		expect(executeProjectMemoryAction).toHaveBeenCalledWith({
+			id: "memory-a",
+			connectorId: "memory:autodev",
+			action: "invalidate",
+			payload,
+		});
+	});
+
+	it("preserves the Control API conflict status", async () => {
+		(executeProjectMemoryAction as jest.Mock).mockRejectedValue(
+			Object.assign(new Error("conflict"), { status: 409 }),
+		);
+		const response = await POST(
+			makeRequest({ action: "invalidate", payload: { evidence: [] } }),
+			{ params: { id: "memory-a" } },
+		);
+		expect(response.status).toBe(409);
+	});
+});
