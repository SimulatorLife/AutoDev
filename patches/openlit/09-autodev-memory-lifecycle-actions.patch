+"use client";
+
+import { useEffect, useState } from "react";
+import {
+	AlertDialog,
+	AlertDialogAction,
+	AlertDialogCancel,
+	AlertDialogContent,
+	AlertDialogDescription,
+	AlertDialogFooter,
+	AlertDialogHeader,
+	AlertDialogTitle,
+} from "@/components/ui/alert-dialog";
+import { Textarea } from "@/components/ui/textarea";
+import getMessage from "@/constants/messages";
+import type { MemoryActionDescriptor } from "@/lib/platform/connectors/memory/types";
+
+export default function MemoryActionDialog({
+	open,
+	action,
+	saving,
+	onOpenChange,
+	onSubmit,
+}: {
+	open: boolean;
+	action: MemoryActionDescriptor | null;
+	saving: boolean;
+	onOpenChange: (open: boolean) => void;
+	onSubmit: (payload: Record<string, unknown>) => void;
+}) {
+	const messages = getMessage();
+	const [payloadText, setPayloadText] = useState("");
+	const [error, setError] = useState<string | null>(null);
+
+	useEffect(() => {
+		setPayloadText(action ? JSON.stringify(action.payloadTemplate, null, 2) : "");
+		setError(null);
+	}, [action]);
+
+	function submit() {
+		if (!action || saving) return;
+		try {
+			const parsed: unknown = JSON.parse(payloadText);
+			if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+				throw new Error(messages.MEMORY_INVALID_JSON);
+			}
+			setError(null);
+			onSubmit(parsed as Record<string, unknown>);
+		} catch {
+			setError(messages.MEMORY_INVALID_JSON);
+		}
+	}
+
+	return (
+		<AlertDialog open={open} onOpenChange={onOpenChange}>
+			<AlertDialogContent>
+				<AlertDialogHeader>
+					<AlertDialogTitle>{action?.label}</AlertDialogTitle>
+					<AlertDialogDescription>{action?.description}</AlertDialogDescription>
+				</AlertDialogHeader>
+				<label className="text-xs font-medium text-stone-700 dark:text-stone-300">
+					Lifecycle action JSON
+					<Textarea
+						value={payloadText}
+						onChange={(event) => setPayloadText(event.target.value)}
+						className="mt-1 min-h-40 font-mono text-xs"
+						maxLength={4_000}
+						disabled={saving}
+					/>
+				</label>
+				{error ? <p className="text-xs text-error">{error}</p> : null}
+				<AlertDialogFooter>
+					<AlertDialogCancel disabled={saving} size="sm">
+						{messages.MEMORY_CANCEL}
+					</AlertDialogCancel>
+					<AlertDialogAction
+						disabled={saving || !action}
+						size="sm"
+						onClick={(event) => {
+							event.preventDefault();
+							submit();
+						}}
+					>
+						{action?.label}
+					</AlertDialogAction>
+				</AlertDialogFooter>
+			</AlertDialogContent>
+		</AlertDialog>
+	);
+}
