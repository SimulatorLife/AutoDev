+++ b/src/client/src/constants/environment.ts
@@ -0,0 +1,14 @@
+/**
+ * The one environment the console resolves datasources through.
+ *
+ * Environments were an OpenLIT product dimension: a selector in the header, a
+ * per-project list in Settings, an `x-openlit-environment` header on every
+ * request, and a storage column that keyed database configs and signal
+ * bindings. None of that is a product concept in AutoDev, and none of it is
+ * selectable any more, so the value is a constant rather than state.
+ *
+ * It is still passed to the server because `environment` is what selects which
+ * ClickHouse the telemetry adapters talk to — that is a datasource routing
+ * concern, not a tenancy one.
+ */
+export const DEFAULT_ENVIRONMENT = "production";
