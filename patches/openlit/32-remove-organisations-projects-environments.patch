diff --git a/src/client/src/lib/scope.ts b/src/client/src/lib/scope.ts
new file mode 100644
index 00000000..3b82b515
--- /dev/null
+++ b/src/client/src/lib/scope.ts
@@ -0,0 +1,96 @@
+import prisma from "./prisma";
+import { getCurrentUser } from "./session";
+import { throwIfError } from "@/utils/error";
+import getMessage from "@/constants/messages";
+
+/**
+ * The singleton ownership scope.
+ *
+ * AutoDev is single-user and has no tenancy. Organisations, memberships,
+ * invitations and projects used to be a real product layer — switchable in
+ * the header, editable in Settings, and the filter dimension behind nearly
+ * every stored row — and all of that is removed. What survives here is the
+ * minimum the retained storage schema still requires: `DatabaseConfig`,
+ * `TelemetrySource` and `ConnectorInstance` all carry a non-null
+ * `organisationId`/`projectId`, so exactly one organisation and one project
+ * must exist for those rows to reference.
+ *
+ * Those rows are a hidden implementation detail of the retained schema, not a
+ * product concept. Nothing selects them, nothing switches between them, and
+ * nothing is scoped by them. This module is therefore the only thing that
+ * resolves them, and it never returns more than one.
+ */
+
+export type SingletonScope = {
+	organisationId: string;
+	projectId: string;
+};
+
+/**
+ * Resolve the singleton organisation/project pair for the current user,
+ * creating either on first use.
+ *
+ * Returns `null` only when there is no signed-in user, which is the one
+ * condition under which stored rows cannot be attributed. Callers that are
+ * already behind an authenticated route treat that as an error rather than
+ * silently matching everything.
+ */
+export async function getSingletonScope(): Promise<SingletonScope | null> {
+	const user = await getCurrentUser();
+	if (!user) return null;
+
+	// An organisation created by any earlier install is reused rather than
+	// duplicated, so existing DatabaseConfig/TelemetrySource rows keep
+	// resolving to the same scope across the upgrade.
+	const organisation =
+		(await prisma.organisation.findFirst({
+			orderBy: { createdAt: "asc" },
+			select: { id: true },
+		})) ??
+		(await prisma.organisation.create({
+			data: {
+				name: "AutoDev",
+				slug: "default",
+				createdByUserId: user.id,
+			},
+			select: { id: true },
+		}));
+
+	const project =
+		(await prisma.project.findFirst({
+			where: { organisationId: organisation.id },
+			orderBy: [{ isDefault: "desc" }, { createdAt: "asc" }],
+			select: { id: true },
+		})) ??
+		(await prisma.project.create({
+			data: {
+				organisationId: organisation.id,
+				name: "Default",
+				slug: "default",
+				isDefault: true,
+			},
+			select: { id: true },
+		}));
+
+	// Membership is retained only because ConnectorInstance and the remaining
+	// organisation-scoped rows still join through it.
+	await prisma.organisationUser.upsert({
+		where: {
+			organisationId_userId: { organisationId: organisation.id, userId: user.id },
+		},
+		update: {},
+		create: { organisationId: organisation.id, userId: user.id, role: "owner" },
+	});
+
+	return { organisationId: organisation.id, projectId: project.id };
+}
+
+/**
+ * Same as {@link getSingletonScope}, for callers that already require an
+ * authenticated request and have no meaningful work to do without a scope.
+ */
+export async function requireSingletonScope(): Promise<SingletonScope> {
+	const scope = await getSingletonScope();
+	throwIfError(!scope, getMessage().UNAUTHORIZED_USER);
+	return scope!;
+}
