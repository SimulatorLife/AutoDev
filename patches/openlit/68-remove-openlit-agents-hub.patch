diff --git a/src/client/src/clickhouse/migrations/drop-agents-migration.ts b/src/client/src/clickhouse/migrations/drop-agents-migration.ts
new file mode 100644
index 00000000..a803d32c
--- /dev/null
+++ b/src/client/src/clickhouse/migrations/drop-agents-migration.ts
@@ -0,0 +1,34 @@
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "drop-agents-tables";
+
+/**
+ * Drops the tables that the Agents Hub owned.
+ *
+ * The Agents Hub's API, its materializer and its pages are gone, so nothing
+ * reads or writes these tables any more. A fresh install must not create
+ * them, and an existing install should not keep them: the tables were the
+ * product's storage, and storage with no owner is a place a stale row can
+ * still be read from by something that believes it is looking at agents.
+ *
+ * The table names are spelled out here rather than imported, because the
+ * module that named them was part of the removed product. The drop migration
+ * is the one place that still has to say what the tables were called, and it
+ * has to survive the removal that took the names with it.
+ *
+ * `DROP TABLE IF EXISTS` keeps an install that never had them a no-op.
+ */
+export default async function DropAgentsMigration(databaseConfigId?: string) {
+	const queries = [
+		`DROP TABLE IF EXISTS openlit_agent_versions`,
+		`DROP TABLE IF EXISTS openlit_agents_summary`,
+	];
+
+	const { migrationExist, queriesRun } = await migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+
+	return { migrationExist, queriesRun };
+}
