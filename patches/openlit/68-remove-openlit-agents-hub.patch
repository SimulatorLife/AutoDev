-		id: n.name,
-		spanName: n.name,
-		spanCount: n.count,
-		p50Ms: n.p50DurationMs,
-		errorRate: n.count ? n.errorCount / n.count : 0,
-		depth: 0,
-		kind: "span",
-	}));
