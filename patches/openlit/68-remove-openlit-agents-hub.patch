-				"scripts/agents/materialize.js"
-			),
-			cronLogPath: path.join(process.cwd(), "logs/agents/materialize.log"),
-		});
-		console.log("Installed agents materialize cron");
-	} catch (e) {
-		console.error("Failed to install agents materialize cron:", e);
-	}
-}
