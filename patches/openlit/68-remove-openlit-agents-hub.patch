-
-/**
- * Patch 18: the agents list endpoint now serves coding-agent rows
- * exclusively. The previous `controller` / `sdk` / `both` / coding-source
- * mix relied on the Controller poll pipeline + rollup, both of which were
- * removed in the same patch. The `sdk`-only AutoDev Control API agent
- * surface ships separately from `runtime/src/control-api/` and renders
- * inside the consolidated AutoDev Console.
- */
-const ALLOWED_SOURCES = new Set<string>(["coding", "sdk"]);
-const APPLICATION_SOURCES = ["sdk"];
-
-function parseCsv(value: string | null): string[] {
-	if (!value) return [];
-	return value
-		.split(",")
-		.map((v) => v.trim())
-		.filter((v) => v.length > 0);
-}
-
-async function GETHandler(request: Request) {
-	const url = new URL(request.url);
-	const sp = url.searchParams;
-
-	const limitRaw = sp.get("limit");
-	const limit = limitRaw ? Number(limitRaw) : 50;
-	if (!Number.isFinite(limit) || limit <= 0) {
-		return Response.json({ error: "Invalid limit" }, { status: 400 });
-	}
-
-	const sourceFilter = parseCsv(sp.get("source")).filter((v) =>
-		ALLOWED_SOURCES.has(v)
-	);
-	const sources = sourceFilter.length > 0 ? sourceFilter : APPLICATION_SOURCES;
-
-	const sourceList = sources.map((s) => `'${escapeClickHouseString(s)}'`).join(", ");
-
-	const startTime = sp.get("start") || "";
-	const endTime = sp.get("end") || "";
-	const timePredicate =
-		startTime && endTime
-			? `AND last_seen BETWEEN '${escapeClickHouseString(startTime)}' AND '${escapeClickHouseString(endTime)}'`
-			: "";
-
-	const query = `
-		SELECT *
-		FROM ${AGENTS_SUMMARY_TABLE} FINAL
-		WHERE source IN (${sourceList})
-		${timePredicate}
-		ORDER BY last_seen DESC
-		LIMIT ${limit}
-	`;
-
-	const result = (await intelligenceDataCollector(
-		{ query },
-		"query"
-	)) as { err?: unknown; data?: UnifiedAgent[] };
-
-	if (result.err) {
-		return Response.json(
-			{ error: "Failed to load agents" },
-			{ status: 500 }
-		);
-	}
-
-	return withCacheHeaders(
-		{ data: result.data ?? [], nextCursor: null },
-		"list"
-	);
-}
-
-export const GET = withRouteAccess("observability.read", GETHandler, { requireDbConfig: true });
