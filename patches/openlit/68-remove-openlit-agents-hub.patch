-				) AS chat_lines_accepted,
-				greatest(
-					toInt64OrZero(any(SpanAttributes['coding_agent.session.lines.rejected'])),
-					toInt64(sumIf(
-						toInt64OrZero(SpanAttributes['coding_agent.edit.lines.added']),
-						SpanName = 'coding_agent.edit.decision'
