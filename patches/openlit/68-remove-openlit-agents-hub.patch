-				greatest(
-					toInt64OrZero(any(SpanAttributes['coding_agent.session.lines.removed'])),
-					toInt64(sumIf(
-						toInt64OrZero(SpanAttributes['coding_agent.edit.lines.removed']),
-						SpanName = 'coding_agent.edit.decision'
