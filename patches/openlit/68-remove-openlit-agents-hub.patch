-import migrationHelper from "./migration-helper";
-
-const MIGRATION_ID = "add-agents-summary-skip-indexes-2026-05-12";
-const AGENTS_SUMMARY_TABLE = "openlit_agents_summary";
-
-/**
- * Adds a skip index to `openlit_agents_summary` to speed up the
- * "List recent agents" read pattern observed in production. The base
- * query filters by `last_seen >= now() - INTERVAL N DAY`; without an
- * index on `last_seen`, ClickHouse must scan every part. A `minmax`
- * index lets it skip whole granules that fall outside the window.
- *
- * Patch 18 drops the controller-only `instrumentation_status` index
- * (`discovered`/`instrumented`) since that column was removed from the
- * agents summary in the same patch.
- *
- * Why NOT change `ORDER BY`: the table uses `ReplacingMergeTree(updated_at)`
- * with `ORDER BY (agent_key)`. Dedup happens on the ORDER BY tuple, so
- * moving `last_seen` into the leading position would mean two snapshots of
- * the same agent on different days would no longer be merged into a single
- * row. The skip-index approach gives us the query-time win without the
- * dedup regression.
- *
- * The index is added with `IF NOT EXISTS` so the migration is safe to
- * run repeatedly.
- */
-export default async function AddAgentsSummarySkipIndexesMigration(
-	databaseConfigId?: string
-) {
-	const queries = [
-		`ALTER TABLE ${AGENTS_SUMMARY_TABLE}
-			ADD INDEX IF NOT EXISTS idx_last_seen last_seen TYPE minmax GRANULARITY 1`,
-		`ALTER TABLE ${AGENTS_SUMMARY_TABLE} MATERIALIZE INDEX idx_last_seen`,
-	];
-
-	return migrationHelper({
-		clickhouseMigrationId: MIGRATION_ID,
-		databaseConfigId,
-		queries,
-	});
-}
