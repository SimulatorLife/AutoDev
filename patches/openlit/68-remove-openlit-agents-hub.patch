-	const env = normalizeDeploymentEnvironment(environment);
-	if (env === "default") {
-		return `(ResourceAttributes['deployment.environment'] IN ('default', 'local', 'default_environment', ''))`;
-	}
-	return `ResourceAttributes['deployment.environment'] = '${escape(env)}'`;
-}
