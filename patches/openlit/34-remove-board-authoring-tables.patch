 /** @jest-environment node */
 
 import { NextRequest } from "next/server";
+import usageDashboard from "@/clickhouse/seed-data/openlit-dashboard-AutoDev-Usage-layout.json";
 
 const mockFetchVariableAllowedValues = jest.fn();
 const mockResolveTelemetrySourceDescriptor = jest.fn();
@@ -67,4 +68,28 @@ describe("AutoDev Usage endpoint filter lookup", () => {
       expect(requestOptions.aiSelector).toBe(false);
     }
   });
+
+  it("hands runWidgetQuery the seeded widget definitions, not stored widget ids", async () => {
+    // The widget catalog was owned by the removed board-authoring product, so
+    // there is no ClickHouse row to look a widget up by any more. Passing an id
+    // instead of the definition silently fails every panel at run time, so pin
+    // the seed as the runner's input.
+    const request = new NextRequest("http://localhost/api/autodev/usage", {
+      method: "POST",
+      headers: {
+        authorization: "Bearer server-only-usage-test-token",
+        "content-type": "application/json"
+      },
+      body: JSON.stringify({ selection: { range: "24H", values: {} } })
+    });
+
+    const response = await POST(request);
+
+    expect(response.status).toBe(200);
+    const seedWidgets = Object.values(usageDashboard.widgets);
+    expect(mockRunWidgetQuery).toHaveBeenCalledTimes(seedWidgets.length);
+    for (const [widget] of mockRunWidgetQuery.mock.calls) {
+      expect(seedWidgets).toContain(widget);
+    }
+  });
 });
