-		return tags
-			.map((tag) => String(tag ?? "").trim())
-			.filter((tag) => tag.length > 0);
-	}
-	if (typeof tags === "string") {
-		const trimmed = tags.trim();
-		if (!trimmed) return [];
-		const parsed = jsonParse(trimmed);
-		if (Array.isArray(parsed)) {
-			return normalizeDashboardTags(parsed);
