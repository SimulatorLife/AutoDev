-}
-
-const VALUE_PATH_SEGMENT = /^(?:[A-Za-z][A-Za-z0-9_-]*|0|[1-9][0-9]*)$/;
-
-function readValuePath(data: unknown, path: string): unknown {
-	const parts = path.split(".");
-	if (!parts.length || parts.some((part) => !VALUE_PATH_SEGMENT.test(part))) {
-		return undefined;
-	}
-	return parts.reduce<unknown>((value, part) => {
-		if (Array.isArray(value) && /^(?:0|[1-9][0-9]*)$/.test(part)) {
-			return value[Number(part)];
-		}
-		if (!value || typeof value !== "object" || !Object.hasOwn(value, part)) {
-			return undefined;
-		}
-		return (value as Record<string, unknown>)[part];
-	}, data);
-}
-
-/** Calculate a display-only ratio from already-aggregated query results. */
-export function resolveRatioDisplay(
-	data: unknown,
-	ratio: RatioDisplay,
-): number | null {
-	const numerator = Number(readValuePath(data, ratio.numerator));
-	const denominator = Number(readValuePath(data, ratio.denominator));
-	const multiplier = ratio.multiplier ?? 1;
-	if (
-		!Number.isFinite(numerator) ||
-		!Number.isFinite(denominator) ||
-		denominator <= 0 ||
-		!Number.isFinite(multiplier)
-	) {
-		return null;
-	}
