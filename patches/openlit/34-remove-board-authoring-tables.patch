-/**
- * Validate and normalize a single generic non-time dashboard variable spec.
- * Variables are schema-driven: the typed attribute key is recorded on the
- * board and the binding layer applies it as a NormalizedFilter against
- * telemetry queries. The variable system is generic — application-specific
- * field names are not hardwired here.
- */
-const VALID_SIGNALS = new Set(["traces", "logs", "metrics", "intelligence"]);
-const VALID_SCOPES = new Set(["span", "resource", "log", "metric"]);
-const VARIABLE_ID_PATTERN = /^[A-Za-z][A-Za-z0-9_-]{0,63}$/;
-const ATTRIBUTE_KEY_PATTERN = /^[A-Za-z][A-Za-z0-9_.*-]{0,127}$/;
-
-export function normalizeDashboardVariable(
-	raw: unknown
-): DashboardVariableSpec | null {
-	if (!raw || typeof raw !== "object") return null;
-	const r = raw as Record<string, unknown>;
-	if (
-		typeof r.id !== "string" ||
-		!VARIABLE_ID_PATTERN.test(r.id) ||
-		typeof r.label !== "string" ||
-		r.label.length === 0 ||
-		typeof r.signal !== "string" ||
-		!VALID_SIGNALS.has(r.signal) ||
-		typeof r.scope !== "string" ||
-		!VALID_SCOPES.has(r.scope) ||
-		typeof r.key !== "string" ||
-		!ATTRIBUTE_KEY_PATTERN.test(r.key) ||
-		typeof r.multi !== "boolean" ||
-		typeof r.supportsAll !== "boolean"
-	) {
-		return null;
-	}
-	const out: DashboardVariableSpec = {
-		id: r.id,
-		label: r.label,
-		signal: r.signal as DashboardVariableSpec["signal"],
-		scope: r.scope as DashboardVariableSpec["scope"],
-		key: r.key,
-		multi: r.multi,
-		supportsAll: r.supportsAll,
-	};
-	if (Array.isArray(r.defaultValues)) {
-		const defaults = r.defaultValues
-			.filter((v): v is string => typeof v === "string")
-			.filter((v) => v.length > 0 && v.length <= 256);
-		if (defaults.length > 0) out.defaultValues = defaults;
-	}
-	if (typeof r.sourceId === "string" || r.sourceId === null) {
-		out.sourceId = r.sourceId as string | null;
-	}
-	if (Array.isArray(r.allowedValues)) {
-		const allowed = r.allowedValues
-			.filter((v): v is string => typeof v === "string")
-			.filter((v) => v.length > 0 && v.length <= 256);
-		if (allowed.length > 0) out.allowedValues = allowed;
-	}
-	return out;
-}
