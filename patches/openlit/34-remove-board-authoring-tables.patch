diff --git a/src/client/src/clickhouse/migrations/drop-dashboard-authoring-migration.ts b/src/client/src/clickhouse/migrations/drop-dashboard-authoring-migration.ts
new file mode 100644
index 00000000..a3e9299d
--- /dev/null
+++ b/src/client/src/clickhouse/migrations/drop-dashboard-authoring-migration.ts
@@ -0,0 +1,34 @@
+import migrationHelper from "./migration-helper";
+
+const MIGRATION_ID = "drop-dashboard-authoring-tables";
+
+/**
+ * Drops the board-authoring tables that earlier deployments created via the
+ * now-removed `create-custom-dashboards-migration`. The generic board/folder/
+ * widget authoring product is gone, so a fresh install must not recreate them
+ * and an existing install should not keep them.
+ *
+ * The AutoDev Usage board does **not** live here: `/api/autodev/usage` reads its
+ * widget definitions straight from
+ * `seed-data/openlit-dashboard-AutoDev-Usage-layout.json` and hands them to
+ * `runWidgetQuery`, which never touches ClickHouse for widget rows. These four
+ * tables only ever held user-authored boards and their widgets.
+ *
+ * `DROP TABLE IF EXISTS` keeps an install that never had them a no-op.
+ */
+export default async function DropDashboardAuthoringMigration(databaseConfigId?: string) {
+	const queries = [
+		`DROP TABLE IF EXISTS openlit_board_widget`,
+		`DROP TABLE IF EXISTS openlit_widget`,
+		`DROP TABLE IF EXISTS openlit_folder`,
+		`DROP TABLE IF EXISTS openlit_board`,
+	];
+
+	const { migrationExist, queriesRun } = await migrationHelper({
+		clickhouseMigrationId: MIGRATION_ID,
+		databaseConfigId,
+		queries,
+	});
+
+	return { migrationExist, queriesRun };
+}
