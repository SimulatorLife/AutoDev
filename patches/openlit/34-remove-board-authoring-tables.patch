-/**
- * Normalize the optional `variables` array carried on a dashboard. Silently
- * drops malformed entries and deduplicates by id so a corrupt export cannot
- * crash the editor or the widget renderer.
- */
-export function normalizeDashboardVariables(
-	raw: unknown
-): DashboardVariableSpec[] {
-	if (!Array.isArray(raw)) return [];
-	const out: DashboardVariableSpec[] = [];
-	const seen = new Set<string>();
-	for (const entry of raw) {
-		const spec = normalizeDashboardVariable(entry);
-		if (!spec) continue;
-		if (seen.has(spec.id)) continue;
-		seen.add(spec.id);
-		out.push(spec);
-	}
-	return out;
-}
-
-function normalizeLayouts(
-	layouts: unknown,
-	widgetIds: string[]
-): { lg: DashboardLayoutItem[] } {
-	const record = asRecord(layouts);
-	const rawLg = Array.isArray(record?.lg) ? record!.lg : [];
-	const lg: DashboardLayoutItem[] = [];
-	rawLg.forEach((item, index) => {
-		const normalized = normalizeLayoutItem(
-			item,
-			widgetIds[index] || `widget-${index}`
-		);
-		if (normalized) lg.push(normalized);
-	});
-
-	// When layouts are missing (corrupt export), place widgets in a simple grid.
-	if (lg.length === 0 && widgetIds.length > 0) {
-		widgetIds.forEach((id, index) => {
-			lg.push({
-				i: id,
-				x: (index % 4) * 3,
-				y: Math.floor(index / 4) * 2,
-				w: 3,
-				h: 2,
-			});
-		});
-	}
-
-	return { lg };
-}
