+				expect.objectContaining({
+					key: "gen_ai.request.model",
+					op: "in",
+					value: ["claude-sonnet-4-5"],
+				}),
+				expect.objectContaining({
+					key: "autodev.agent.role",
+					op: "in",
+					value: ["worker"],
+				}),
+			]),
+		);
+	});
+
+	it("aggregates root/child stages, rejection reasons, failed-before-start providers, and roles", async () => {
+		adapterWith([
