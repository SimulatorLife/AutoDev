+			}),
+			point("child", "started", 2, {
+				"autodev.agent.role": "worker",
+				"gen_ai.provider.name": "minimax",
+			}),
+			point("child", "cancelled", 1, {
+				"autodev.agent.role": "worker",
+				"gen_ai.provider.name": "minimax",
+			}),
+		]);
+
+		const widgets = await readAgentLaunchUsageWidgets(
+			{ range: "7D", values: {} },
+			range,
+			runImmediately,
+		);
+		const widget = (key: string) =>
+			widgets.find((candidate) => candidate.key === key);
+
+		expect(widgets).toHaveLength(6);
+		expect(widget("agent-launches-root-stages")).toMatchObject({
+			querySucceeded: true,
+			observed: true,
+			rows: expect.arrayContaining([
+				{ name: "attempted", count: 6 },
+				{ name: "admitted", count: 5 },
+				{ name: "rejected", count: 1 },
+				{ name: "started", count: 4 },
+				{ name: "failed_before_start", count: 1 },
+				{ name: "succeeded", count: 3 },
+			]),
+		});
+		expect(widget("agent-launches-child-stages")).toMatchObject({
+			querySucceeded: true,
+			observed: true,
+			rows: expect.arrayContaining([
+				{ name: "attempted", count: 4 },
+				{ name: "rejected", count: 2 },
+				{ name: "admitted", count: 2 },
+				{ name: "started", count: 2 },
+				{ name: "cancelled", count: 1 },
+			]),
+		});
+		expect(widget("agent-launches-root-rejections")?.rows).toEqual([
+			{ name: "dispatch_refused", count: 1 },
+		]);
+		expect(widget("agent-launches-child-rejections")?.rows).toEqual([
+			{ name: "concurrency_limit", count: 2 },
+		]);
+		expect(
+			widget("agent-launches-failed-before-start-by-provider")?.rows,
+		).toEqual([{ name: "codex", count: 1 }]);
+		expect(widget("agent-launches-by-role")?.rows).toEqual([
+			{ name: "orchestrator", count: 6 },
+			{ name: "worker", count: 4 },
+		]);
+	});
+
+	it("fails closed on skill filter, unsupported adapters, and malformed points", async () => {
+		let widgets = await readAgentLaunchUsageWidgets(
+			{ range: "7D", values: { skill: ["dry"] } },
+			range,
+			runImmediately,
+		);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(true);
+		expect(mockResolveTelemetrySourceDescriptor).not.toHaveBeenCalled();
+
+		adapterWith([
+			point("root", "attempted", 1),
+			{
+				metricName: "autodev.agent.launches",
+				serviceName: "autodev-router",
+				timestamp: "2026-11-27T00:00:00.000Z",
+				value: 1,
+				attributes: {
+					"autodev.launch.kind": "unknown-kind",
+					"autodev.launch.stage": "attempted",
+				},
+				resourceAttributes: {},
+			} as ReturnType<typeof point>,
+		]);
+		widgets = await readAgentLaunchUsageWidgets(
+			{ range: "7D", values: {} },
+			range,
+			runImmediately,
+		);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(true);
+	});
+});
