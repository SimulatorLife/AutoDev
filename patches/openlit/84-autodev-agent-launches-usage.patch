diff --git a/src/client/src/lib/autodev/usage-agent-launches.ts b/src/client/src/lib/autodev/usage-agent-launches.ts
new file mode 100644
index 0000000..e8f6725
--- /dev/null
+++ b/src/client/src/lib/autodev/usage-agent-launches.ts
@@ -0,0 +1,305 @@
+import {
+	getTelemetryAdapter,
+	resolveTelemetrySourceDescriptor,
+} from "@/lib/telemetry-source";
+import type {
+	NormalizedFilter,
+	NormalizedMetricPoint,
+	OpenLITQuery,
+} from "@/lib/platform/connectors/datasource/types";
+import type { UsageSelection } from "@/lib/autodev/usage-api";
+import type { runUsageQuery } from "@/lib/autodev/usage-query-scheduler";
+
+const METRIC_NAME = "autodev.agent.launches";
+const LAUNCH_KIND_KEY = "autodev.launch.kind";
+const LAUNCH_STAGE_KEY = "autodev.launch.stage";
+const LAUNCH_REASON_KEY = "autodev.launch.reason";
+const SERVICE_NAME = "autodev-router";
+const BREAKDOWN_LIMIT = 20;
+
+const VALID_LAUNCH_KINDS = new Set(["root", "child"]);
+const VALID_LAUNCH_STAGES = new Set([
+	"attempted",
+	"admitted",
+	"rejected",
+	"started",
+	"failed_before_start",
+	"succeeded",
+	"failed",
+	"cancelled",
+]);
+
+const WIDGET_KEYS = [
+	"agent-launches-root-stages",
+	"agent-launches-child-stages",
+	"agent-launches-root-rejections",
+	"agent-launches-child-rejections",
+	"agent-launches-failed-before-start-by-provider",
+	"agent-launches-by-role",
+] as const;
+
+export type AgentLaunchWidgetKey = (typeof WIDGET_KEYS)[number];
+
+export interface AgentLaunchUsageWidget {
+	readonly key: AgentLaunchWidgetKey;
+	readonly querySucceeded: boolean;
+	readonly observed: boolean;
+	readonly partial: boolean;
+	readonly rows: readonly Record<string, string | number>[];
+	readonly xAxis: "name";
+	readonly yAxis: "count";
+	readonly resultLimit: number;
+}
+
+interface LaunchObservation {
+	readonly kind: "root" | "child";
+	readonly stage: string;
+	readonly reason: string | null;
+	readonly value: number;
+	readonly attributes: Readonly<Record<string, string>>;
+}
+
+/** Create the fixed, typed OpenLIT metrics query for `autodev.agent.launches`. */
+export function buildAgentLaunchMetricQuery(
+	selection: UsageSelection,
+	range: { readonly start: Date; readonly end: Date },
+): OpenLITQuery {
+	const filters: NormalizedFilter[] = [
+		{ target: "spanName", op: "in", value: [METRIC_NAME] },
+		{
+			target: "attribute",
+			scope: "resource",
+			key: "service.name",
+			op: "eq",
+			value: SERVICE_NAME,
+		},
+	];
+	for (const [id, key] of [
+		["workspace", "autodev.workspace"],
+		["provider", "gen_ai.provider.name"],
+		["model", "gen_ai.request.model"],
+		["agent", "autodev.agent.role"],
+	] as const) {
+		const values = selection.values[id];
+		if (values?.length) {
+			filters.push({
+				target: "attribute",
+				scope: "metric",
+				key,
+				op: "in",
+				value: [...values],
+			});
+		}
+	}
+	return {
+		signal: "metrics",
+		timeRange: { start: range.start, end: range.end },
+		filters,
+		aiSelector: false,
+	};
+}
+
+/** Read stage-level agent launch counters and translate them into fixed Usage widgets. */
+export async function readAgentLaunchUsageWidgets(
+	selection: UsageSelection,
+	range: { readonly start: Date; readonly end: Date },
+	query: typeof runUsageQuery,
+): Promise<readonly AgentLaunchUsageWidget[]> {
+	const unavailable = unavailableWidgets();
+	if ((selection.values.skill?.length ?? 0) > 0) {
+		return unavailable;
+	}
+
+	try {
+		const descriptor = await resolveTelemetrySourceDescriptor({
+			signal: "metrics",
+		});
+		if (descriptor.type !== "clickhouse") return unavailable;
+		const adapter = await getTelemetryAdapter({
+			signal: "metrics",
+			sourceId: descriptor.id,
+		});
+		if (
+			adapter.capabilities().cumulativeCounterDeltas !== true ||
+			typeof adapter.metricCounterDeltas !== "function"
+		) {
+			return unavailable;
+		}
+		const frame = await query(() =>
+			adapter.metricCounterDeltas!(
+				buildAgentLaunchMetricQuery(selection, range),
+			),
+		);
+		if (frame.meta?.truncated) return unavailable;
+		const observations = parseLaunchObservations(frame.rows);
+		if (!observations) return unavailable;
+		return widgetsFromObservations(observations);
+	} catch {
+		return unavailable;
+	}
+}
+
+function parseLaunchObservations(
+	rows: readonly NormalizedMetricPoint[],
+): LaunchObservation[] | null {
+	const observations: LaunchObservation[] = [];
+	for (const row of rows) {
+		if (
+			row.metricName !== METRIC_NAME ||
+			row.serviceName !== SERVICE_NAME ||
+			!isRecord(row.attributes)
+		) {
+			return null;
+		}
+		const value = finiteCounter(row.value);
+		if (value === null) return null;
+		const attributes: Record<string, string> = {};
+		for (const [key, candidate] of Object.entries(row.attributes)) {
+			if (typeof candidate !== "string") return null;
+			attributes[key] = candidate;
+		}
+		const kind = attributes[LAUNCH_KIND_KEY];
+		const stage = attributes[LAUNCH_STAGE_KEY];
+		if (
+			!kind ||
+			!VALID_LAUNCH_KINDS.has(kind) ||
+			!stage ||
+			!VALID_LAUNCH_STAGES.has(stage)
+		) {
+			return null;
+		}
+		const reason = safeLabel(attributes[LAUNCH_REASON_KEY]);
+		observations.push({
+			kind: kind as "root" | "child",
+			stage,
+			reason,
+			value,
+			attributes,
+		});
+	}
+	return observations;
+}
+
+function widgetsFromObservations(
+	observations: readonly LaunchObservation[],
+): readonly AgentLaunchUsageWidget[] {
+	const root = observations.filter((row) => row.kind === "root");
+	const child = observations.filter((row) => row.kind === "child");
+	const rootRejections = root.filter((row) => row.stage === "rejected");
+	const childRejections = child.filter((row) => row.stage === "rejected");
+	const failedBeforeStart = observations.filter(
+		(row) => row.stage === "failed_before_start",
+	);
+	const attempted = observations.filter((row) => row.stage === "attempted");
+
+	return [
+		groupedWidget(
+			"agent-launches-root-stages",
+			root,
+			(row) => row.stage,
+			root.length > 0,
+		),
+		groupedWidget(
+			"agent-launches-child-stages",
+			child,
+			(row) => row.stage,
+			child.length > 0,
+		),
+		groupedWidget(
+			"agent-launches-root-rejections",
+			rootRejections,
+			(row) => row.reason,
+			root.length > 0,
+		),
+		groupedWidget(
+			"agent-launches-child-rejections",
+			childRejections,
+			(row) => row.reason,
+			child.length > 0,
+		),
+		groupedWidget(
+			"agent-launches-failed-before-start-by-provider",
+			failedBeforeStart,
+			(row) => safeLabel(row.attributes["gen_ai.provider.name"]),
+			observations.length > 0,
+		),
+		groupedWidget(
+			"agent-launches-by-role",
