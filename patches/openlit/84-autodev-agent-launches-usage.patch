+			point("root", "admitted", 5, {
+				"autodev.agent.role": "orchestrator",
+				"gen_ai.provider.name": "claude",
+			}),
+			point("root", "rejected", 1, {
+				"autodev.agent.role": "orchestrator",
+				"autodev.launch.reason": "dispatch_refused",
+			}),
+			point("root", "started", 4, {
+				"autodev.agent.role": "orchestrator",
+				"gen_ai.provider.name": "claude",
+			}),
+			point("root", "failed_before_start", 1, {
+				"autodev.agent.role": "orchestrator",
+				"gen_ai.provider.name": "codex",
+			}),
+			point("root", "succeeded", 3, {
+				"autodev.agent.role": "orchestrator",
+				"gen_ai.provider.name": "claude",
+			}),
+			point("child", "attempted", 4, { "autodev.agent.role": "worker" }),
+			point("child", "rejected", 2, {
+				"autodev.agent.role": "worker",
+				"autodev.launch.reason": "concurrency_limit",
+			}),
+			point("child", "admitted", 2, {
