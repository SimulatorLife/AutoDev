+]);
+const OUTCOME_KINDS = new Set(["success", "partial", "failure", "cancelled", "unknown"]);
+const REPORT_KINDS = new Set(["task", "pull_request", "issue", "other"]);
+const CONTROL_CHARACTER_PATTERN = /[\u0000-\u001f\u007f]/u;
+const MAX_BODY_BYTES = 64 * 1024;
+const MAX_EVIDENCE_REFERENCES = 64;
+
+interface ParsedReportBody {
+	readonly connectorId?: string;
+	readonly outcomeKind: string;
+	readonly reportKind: string;
+	readonly evidence: AutoDevSessionOutcomeReportInput["evidence"];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+function requiredId(value: unknown): string {
+	if (
+		typeof value !== "string" ||
+		!ID_PATTERN.test(value) ||
+		CONTROL_CHARACTER_PATTERN.test(value)
+	) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	return value;
+}
+
+function parseConnectorId(value: unknown): string | undefined {
+	if (value === undefined || value === null) return undefined;
+	if (typeof value !== "string" || value.length > 120 || CONTROL_CHARACTER_PATTERN.test(value)) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	const normalized = memoryConnectorId(value.trim());
+	if (!isMemoryConnectorId(normalized)) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	return normalized;
+}
+
+function parseEvidence(value: unknown): AutoDevSessionOutcomeReportInput["evidence"] {
+	if (!Array.isArray(value) || value.length > MAX_EVIDENCE_REFERENCES) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	return value.map((entry) => {
+		if (!isRecord(entry)) throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+		if (
+			Object.keys(entry).some((key) => !["kind", "uri", "revision", "observedAt"].includes(key)) ||
+			typeof entry.kind !== "string" ||
+			!EVIDENCE_KINDS.has(entry.kind) ||
+			typeof entry.uri !== "string" ||
+			!entry.uri.trim() ||
+			entry.uri.length > 2048 ||
+			CONTROL_CHARACTER_PATTERN.test(entry.uri) ||
+			(entry.revision !== undefined &&
