+		// and Control API report id remain server-side.
+		return Response.json(
+			{
+				schema: "autodev-memory-outcome-report-ui-v1",
+				appended: result.appended,
+				outcome: result.outcome
+			},
+			{ headers: { "cache-control": "no-store" } }
+		);
+	} catch (error) {
+		return errorResponse(error, MEMORY_DETAIL_OUTCOME_REPORT_FAILED, statusFor(error));
+	}
+}
