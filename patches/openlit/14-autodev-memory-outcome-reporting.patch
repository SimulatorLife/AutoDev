+		) {
+			throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+		}
+		return {
+			kind: entry.kind,
+			uri: entry.uri.trim(),
+			...(typeof entry.revision === "string" ? { revision: entry.revision } : {}),
+			...(typeof entry.observedAt === "string" ? { observedAt: entry.observedAt } : {})
+		};
+	});
+}
+
+// Session-level reports carry no task/run/agent, reporter, authority, or
+// correlation-token fields. Identity is derived server-side from the visible
+// experience and the authenticated operator; the only accepted body keys are
+// the outcome category, report kind, and evidence.
+function parseBody(value: unknown): ParsedReportBody {
+	if (!isRecord(value)) throw new TypeError(MEMORY_INVALID_JSON);
