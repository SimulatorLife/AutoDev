+"use client";
+
+import { useState, type FormEvent } from "react";
+import { Button } from "@/components/ui/button";
+import {
+	Select,
+	SelectContent,
+	SelectItem,
+	SelectTrigger,
+	SelectValue,
+} from "@/components/ui/select";
+import getMessage from "@/constants/messages";
+import { getRequestHeaders } from "@/utils/api";
+
+const OUTCOME_KINDS = ["unknown", "success", "partial", "failure", "cancelled"];
+const REPORT_KINDS = ["task", "pull_request", "issue", "other"];
+const EVIDENCE_KINDS = [
+	"trajectory", "trace", "file", "commit", "pull_request", "issue",
+	"rule", "skill", "document", "other"
+];
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+export interface MemoryOutcomeReportSummary {
+	outcomeKind: string;
+	reportKind: string;
+	reportedAt: string;
+	evidence: { kind: string; uri: string }[];
+}
+
+export default function MemoryOutcomeReportForm({
+	connectorId,
+	experienceId,
+	injectionEventId,
+	onReported
+}: {
+	connectorId: string;
+	experienceId: string;
+	injectionEventId: string;
+	onReported: (outcome: MemoryOutcomeReportSummary) => void;
+}) {
+	const messages = getMessage();
+	const [outcomeKind, setOutcomeKind] = useState("unknown");
+	const [reportKind, setReportKind] = useState("task");
+	const [evidenceKind, setEvidenceKind] = useState("other");
+	const [evidenceUri, setEvidenceUri] = useState("");
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+
+	async function submit(event: FormEvent<HTMLFormElement>) {
+		event.preventDefault();
+		if (saving) return;
+		const uri = evidenceUri.trim();
+		if (outcomeKind !== "unknown" && !uri) {
+			setError(messages.MEMORY_DETAIL_OUTCOME_REPORT_EVIDENCE_REQUIRED);
+			return;
+		}
+		setSaving(true);
+		setError(null);
+		const evidence = uri ? [{ kind: evidenceKind, uri }] : [];
