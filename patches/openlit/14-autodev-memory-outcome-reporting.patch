+		typeof value.outcomeKind !== "string" ||
+		!OUTCOME_KINDS.has(value.outcomeKind) ||
+		typeof value.reportKind !== "string" ||
+		!REPORT_KINDS.has(value.reportKind)
+	) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	const input: ParsedReportBody = {
+		connectorId: parseConnectorId(value.connectorId),
+		outcomeKind: value.outcomeKind,
+		reportKind: value.reportKind,
+		evidence: parseEvidence(value.evidence)
+	};
+	if (input.outcomeKind !== "unknown" && input.evidence.length === 0) {
+		throw new TypeError(MEMORY_SESSION_OUTCOME_REPORT_INVALID);
+	}
+	return input;
+}
+
+function statusFor(error: unknown): number {
+	if (error && typeof error === "object" && "status" in error) {
+		const status = Number((error as { status?: unknown }).status);
+		if ([400, 401, 403, 404, 409, 503].includes(status)) return status;
+	}
+	return 503;
+}
+
+async function POSTHandler(
+	request: NextRequest,
+	{ params }: { readonly params: { readonly id: string } }
+) {
+	const user = await getCurrentUser();
+	if (!user) return Response.json("Unauthorized", { status: 401 });
+
+	let experienceId: string;
+	let rawBody: unknown;
+	let input: ParsedReportBody;
+	try {
+		experienceId = requiredId(params.id);
+	} catch (error) {
+		return errorResponse(error, MEMORY_SESSION_OUTCOME_REPORT_INVALID, 400);
+	}
+	try {
+		rawBody = await request.json();
+	} catch {
+		return errorResponse(MEMORY_INVALID_JSON, MEMORY_INVALID_JSON, 400);
+	}
+	try {
+		input = parseBody(rawBody);
+	} catch (error) {
+		return errorResponse(error, MEMORY_SESSION_OUTCOME_REPORT_INVALID, 400);
+	}
+
+	try {
+		const connectors = await listMemoryConnectors();
+		const connector = input.connectorId
+			? connectors.find((item) => item.id === input.connectorId)
+			: connectors.find((item) => item.type === "autodev");
+		if (!connector) {
+			return errorResponse(MEMORY_COHORTS_UNSUPPORTED_CONNECTOR, MEMORY_COHORTS_UNSUPPORTED_CONNECTOR, 404);
+		}
+		const runtime = await getMemoryRuntime(connector.id);
+		if (!isAutoDevMemoryAdapter(runtime.adapter)) {
+			return errorResponse(MEMORY_COHORTS_UNSUPPORTED_CONNECTOR, MEMORY_COHORTS_UNSUPPORTED_CONNECTOR, 400);
+		}
+		const result = await runtime.adapter.reportSessionOutcome({
+			experienceId,
+			outcomeKind: input.outcomeKind,
+			reportKind: input.reportKind,
+			evidence: input.evidence
+		});
+		// The adapter returns only the reporter-visible report; the Control
+		// API report id and reporter identity remain server-side.
+		return Response.json(
+			{
+				schema: "autodev-memory-session-outcome-report-ui-v1",
+				appended: result.appended,
+				report: result.report
+			},
+			{ headers: { "cache-control": "no-store" } }
+		);
+	} catch (error) {
+		return errorResponse(error, MEMORY_SESSION_OUTCOME_REPORT_FAILED, statusFor(error));
+	}
+}
