+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import MemoryOutcomeReportForm from "@/components/(playground)/memory/memory-outcome-report-form";
+
+jest.mock("@/utils/api", () => ({
+	getRequestHeaders: (headers?: Record<string, string>) => headers || {},
+}));
+
+function response(body: unknown, status = 200) {
+	return {
+		ok: status >= 200 && status < 300,
+		status,
+		json: async () => body,
+	} as Response;
+}
+
+describe("MemoryOutcomeReportForm", () => {
+	beforeEach(() => jest.clearAllMocks());
+
+	it("requires evidence for non-unknown outcomes without sending a request", async () => {
+		const fetchSpy = jest.fn();
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		render(
+			<MemoryOutcomeReportForm
+				connectorId="memory:autodev-a"
+				experienceId="experience-a"
+				injectionEventId="injection-event-a"
+				onReported={jest.fn()}
+			/>
+		);
+		fireEvent.click(screen.getByText("Report outcome"));
+		fireEvent.change(screen.getByLabelText("Outcome category"), { target: { value: "success" } });
+		fireEvent.click(screen.getByRole("button", { name: "Append outcome" }));
+		expect(await screen.findByText(/Add at least one evidence reference/i)).toBeInTheDocument();
+		expect(fetchSpy).not.toHaveBeenCalled();
+	});
+
+	it("posts only the event id and reporter fields, then displays the sanitized outcome", async () => {
+		const fetchSpy = jest.fn().mockResolvedValue(response({
+			schema: "autodev-memory-outcome-report-ui-v1",
+			appended: true,
+			outcome: {
+				outcomeKind: "success",
+				reportKind: "pull_request",
+				reportedAt: "2026-10-01T00:05:00.000Z",
+				evidence: [{ kind: "pull_request", uri: "https://github.com/owner/repo/pull/1" }]
+			}
+		}));
+		global.fetch = fetchSpy as unknown as typeof fetch;
+		const onReported = jest.fn();
+		render(
+			<MemoryOutcomeReportForm
+				connectorId="memory:autodev-a"
+				experienceId="experience-a"
+				injectionEventId="injection-event-a"
+				onReported={onReported}
+			/>
+		);
+		fireEvent.click(screen.getByText("Report outcome"));
+		fireEvent.change(screen.getByLabelText("Outcome category"), { target: { value: "success" } });
+		fireEvent.change(screen.getByLabelText("Report kind"), { target: { value: "pull_request" } });
+		fireEvent.change(screen.getByLabelText("Evidence kind"), { target: { value: "pull_request" } });
+		fireEvent.change(screen.getByLabelText("Evidence reference"), { target: { value: "https://github.com/owner/repo/pull/1" } });
+		fireEvent.click(screen.getByRole("button", { name: "Append outcome" }));
+
+		await waitFor(() => expect(onReported).toHaveBeenCalledTimes(1));
+		const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
+		expect(url).toContain("/api/memory/experiences/experience-a/outcomes");
+		const body = JSON.parse(String(init.body)) as Record<string, unknown>;
+		expect(body).toMatchObject({
+			connectorId: "memory:autodev-a",
+			injectionEventId: "injection-event-a",
+			outcomeKind: "success",
+			reportKind: "pull_request",
+			evidence: [{ kind: "pull_request", uri: "https://github.com/owner/repo/pull/1" }]
+		});
+		expect(body).not.toHaveProperty("correlationToken");
+		expect(body).not.toHaveProperty("reporterId");
+		expect(onReported).toHaveBeenCalledWith({
+			outcomeKind: "success",
+			reportKind: "pull_request",
+			reportedAt: "2026-10-01T00:05:00.000Z",
+			evidence: [{ kind: "pull_request", uri: "https://github.com/owner/repo/pull/1" }]
+		});
+	});
+});
