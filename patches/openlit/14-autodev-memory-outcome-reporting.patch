+import { NextRequest } from "next/server";
+import { getCurrentUser } from "@/lib/session";
+import { errorResponse } from "@/utils/api-response";
+import { withMemoryAccess, withMemoryAudit } from "@/lib/access/memory-route";
+import {
+	getMemoryRuntime,
+	isMemoryConnectorId,
+	listMemoryConnectors,
+	memoryConnectorId
+} from "@/lib/platform/connectors/memory/crud";
+import {
+	isAutoDevMemoryAdapter,
+	type AutoDevOutcomeReportInput
+} from "@/lib/platform/connectors/memory/autodev/adapter";
+import {
+	MEMORY_COHORTS_UNSUPPORTED_CONNECTOR,
+	MEMORY_DETAIL_OUTCOME_REPORT_FAILED,
+	MEMORY_DETAIL_OUTCOME_REPORT_INVALID,
+	MEMORY_INVALID_JSON
+} from "@/constants/messages/en";
+
+const ID_PATTERN = /^[A-Za-z0-9._:-]{1,128}$/u;
+const EVIDENCE_KINDS = new Set([
+	"trajectory", "trace", "file", "commit", "pull_request", "issue",
+	"rule", "skill", "document", "other"
+]);
+const OUTCOME_KINDS = new Set(["success", "partial", "failure", "cancelled", "unknown"]);
+const REPORT_KINDS = new Set(["task", "pull_request", "issue", "other"]);
+const CONTROL_CHARACTER_PATTERN = /[\u0000-\u001f\u007f]/u;
+const MAX_BODY_BYTES = 64 * 1024;
+const MAX_EVIDENCE_REFERENCES = 64;
+
+interface ParsedReportBody {
+	readonly connectorId?: string;
+	readonly injectionEventId: string;
+	readonly outcomeKind: string;
+	readonly reportKind: string;
+	readonly evidence: AutoDevOutcomeReportInput["evidence"];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+function requiredId(value: unknown): string {
+	if (
+		typeof value !== "string" ||
+		!ID_PATTERN.test(value) ||
+		CONTROL_CHARACTER_PATTERN.test(value)
+	) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	return value;
+}
+
+function parseConnectorId(value: unknown): string | undefined {
+	if (value === undefined || value === null) return undefined;
+	if (typeof value !== "string" || value.length > 120 || CONTROL_CHARACTER_PATTERN.test(value)) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	const normalized = memoryConnectorId(value.trim());
+	if (!isMemoryConnectorId(normalized)) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	return normalized;
+}
+
+function parseEvidence(value: unknown): AutoDevOutcomeReportInput["evidence"] {
+	if (!Array.isArray(value) || value.length > MAX_EVIDENCE_REFERENCES) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	return value.map((entry) => {
+		if (!isRecord(entry)) throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+		if (
+			Object.keys(entry).some((key) => !["kind", "uri", "revision", "observedAt"].includes(key)) ||
+			typeof entry.kind !== "string" ||
+			!EVIDENCE_KINDS.has(entry.kind) ||
+			typeof entry.uri !== "string" ||
+			!entry.uri.trim() ||
+			entry.uri.length > 2048 ||
+			CONTROL_CHARACTER_PATTERN.test(entry.uri) ||
+			(entry.revision !== undefined &&
+				(typeof entry.revision !== "string" || entry.revision.length > 256 || CONTROL_CHARACTER_PATTERN.test(entry.revision))) ||
+			(entry.observedAt !== undefined &&
+				(typeof entry.observedAt !== "string" || !Number.isFinite(Date.parse(entry.observedAt))))
+		) {
+			throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+		}
+		return {
+			kind: entry.kind,
+			uri: entry.uri.trim(),
+			...(typeof entry.revision === "string" ? { revision: entry.revision } : {}),
+			...(typeof entry.observedAt === "string" ? { observedAt: entry.observedAt } : {})
+		};
+	});
+}
+
+function parseBody(value: unknown): ParsedReportBody {
+	if (!isRecord(value)) throw new TypeError(MEMORY_INVALID_JSON);
+	if (
+		Object.keys(value).some((key) => !["connectorId", "injectionEventId", "outcomeKind", "reportKind", "evidence"].includes(key)) ||
+		Buffer.byteLength(JSON.stringify(value), "utf8") > MAX_BODY_BYTES ||
+		typeof value.outcomeKind !== "string" ||
+		!OUTCOME_KINDS.has(value.outcomeKind) ||
+		typeof value.reportKind !== "string" ||
+		!REPORT_KINDS.has(value.reportKind)
+	) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	const input: ParsedReportBody = {
+		connectorId: parseConnectorId(value.connectorId),
+		injectionEventId: requiredId(value.injectionEventId),
+		outcomeKind: value.outcomeKind,
+		reportKind: value.reportKind,
+		evidence: parseEvidence(value.evidence)
+	};
+	if (input.outcomeKind !== "unknown" && input.evidence.length === 0) {
+		throw new TypeError(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+	}
+	return input;
+}
+
+function statusFor(error: unknown): number {
+	if (error && typeof error === "object" && "status" in error) {
+		const status = Number((error as { status?: unknown }).status);
+		if ([400, 401, 403, 404, 409, 503].includes(status)) return status;
+	}
+	return 503;
+}
+
+async function POSTHandler(
+	request: NextRequest,
+	{ params }: { readonly params: { readonly id: string } }
+) {
+	const user = await getCurrentUser();
+	if (!user) return Response.json("Unauthorized", { status: 401 });
+
+	let experienceId: string;
+	let rawBody: unknown;
+	let input: ParsedReportBody;
+	try {
+		experienceId = requiredId(params.id);
+	} catch (error) {
