+							className="h-8 rounded-md border border-stone-200 bg-white px-2 dark:border-stone-800 dark:bg-stone-950"
+						>
+							{OUTCOME_KINDS.map((kind) => <option key={kind} value={kind}>{kind}</option>)}
+						</select>
+					</label>
+					<label className="flex flex-col gap-1 text-xs text-stone-500 dark:text-stone-400">
+						{messages.MEMORY_DETAIL_OUTCOME_REPORT_KIND}
+						<select
+							aria-label={messages.MEMORY_DETAIL_OUTCOME_REPORT_KIND}
+							value={reportKind}
+							onChange={(event) => setReportKind(event.target.value)}
+							className="h-8 rounded-md border border-stone-200 bg-white px-2 dark:border-stone-800 dark:bg-stone-950"
+						>
+							{REPORT_KINDS.map((kind) => <option key={kind} value={kind}>{kind.replaceAll("_", " ")}</option>)}
+						</select>
+					</label>
+				</div>
+				<label className="flex flex-col gap-1 text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_DETAIL_OUTCOME_REPORT_EVIDENCE_KIND}
+					<select
+						aria-label={messages.MEMORY_DETAIL_OUTCOME_REPORT_EVIDENCE_KIND}
+						value={evidenceKind}
+						onChange={(event) => setEvidenceKind(event.target.value)}
+						className="h-8 rounded-md border border-stone-200 bg-white px-2 dark:border-stone-800 dark:bg-stone-950"
+					>
+						{EVIDENCE_KINDS.map((kind) => <option key={kind} value={kind}>{kind.replaceAll("_", " ")}</option>)}
+					</select>
+				</label>
+				<label className="flex flex-col gap-1 text-xs text-stone-500 dark:text-stone-400">
+					{messages.MEMORY_DETAIL_OUTCOME_REPORT_EVIDENCE_URI}
+					<input
+						type="text"
+						maxLength={2048}
+						value={evidenceUri}
+						onChange={(event) => setEvidenceUri(event.target.value)}
+						className="h-8 rounded-md border border-stone-200 bg-white px-2 text-xs dark:border-stone-800 dark:bg-stone-950"
+					/>
+				</label>
+				{error ? <p role="alert" className="text-xs text-red-700 dark:text-red-300">{error}</p> : null}
+				<Button type="submit" size="sm" disabled={saving}>
+					{saving ? messages.MEMORY_DETAIL_OUTCOME_REPORT_SAVING : messages.MEMORY_DETAIL_OUTCOME_REPORT_SUBMIT}
+				</Button>
+			</form>
+		</details>
+	);
+}
