+jest.mock("@/lib/session", () => ({ getCurrentUser: jest.fn() }));
+jest.mock("@/lib/platform/connectors/memory/crud", () => ({
+	isMemoryConnectorId: (id: unknown) => typeof id === "string" && id.startsWith("memory:"),
+	listMemoryConnectors: jest.fn(),
+	getMemoryRuntime: jest.fn(),
+	memoryConnectorId: (id: string) => (id.startsWith("memory:") ? id : `memory:${id}`)
+}));
+jest.mock("@/lib/platform/connectors/memory/autodev/adapter", () => ({
+	isAutoDevMemoryAdapter: (adapter: unknown) => !!adapter && typeof adapter === "object" && (adapter as { __autodev?: boolean }).__autodev === true
+}));
+
+import { POST } from "@/app/api/memory/experiences/[id]/outcomes/route";
+import { getCurrentUser } from "@/lib/session";
+import { getMemoryRuntime, listMemoryConnectors } from "@/lib/platform/connectors/memory/crud";
+import { MEMORY_DETAIL_OUTCOME_REPORT_INVALID } from "@/constants/messages/en";
+
+(globalThis as unknown as { Response: { json: unknown } }).Response = {
+	json: (body: unknown, init?: ResponseInit) => ({
+		status: init?.status ?? 200,
+		json: async () => body,
+	})
+};
+
+function makeRequest(body: unknown) {
+	return { json: async () => body } as any;
+}
+
+const connector = { id: "memory:autodev-a", type: "autodev", name: "AutoDev Memory" };
+
+beforeEach(() => {
+	jest.clearAllMocks();
+	(getCurrentUser as jest.Mock).mockResolvedValue({ id: "operator-a" });
+	(listMemoryConnectors as jest.Mock).mockResolvedValue([connector]);
+});
+
+test("outcome POST sends only the event id and reporter fields and returns no opaque token", async () => {
+	const reportOutcome = jest.fn().mockResolvedValue({
+		appended: true,
+		outcome: {
+			outcomeKind: "success",
+			reportKind: "pull_request",
+			reportedAt: "2026-10-01T00:05:00.000Z",
+			evidence: [{ kind: "pull_request", uri: "https://github.com/owner/repo/pull/1" }]
+		}
+	});
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({ connector, adapter: { __autodev: true, reportOutcome } });
+	const reportBody = {
+		connectorId: connector.id,
+		injectionEventId: "injection-event-a",
+		outcomeKind: "success",
+		reportKind: "pull_request",
+		evidence: [{ kind: "pull_request", uri: "https://github.com/owner/repo/pull/1" }]
+	};
+	const response = await POST(makeRequest(reportBody), { params: { id: "experience-a" } });
+	const body = await response.json();
+
+	expect(response.status).toBe(200);
+	expect(reportOutcome).toHaveBeenCalledWith({
+		experienceId: "experience-a",
+		injectionEventId: "injection-event-a",
+		outcomeKind: "success",
+		reportKind: "pull_request",
+		evidence: reportBody.evidence
+	});
+	expect(body.appended).toBe(true);
+	expect(body.outcome.reportKind).toBe("pull_request");
+	expect(JSON.stringify(body)).not.toMatch(/correlationToken|opaque-token|reportId|reporterId/iu);
+	expect(JSON.stringify(reportBody)).not.toMatch(/correlationToken|reporterId|reportId/iu);
+});
+
+test("outcome POST requires an authenticated session and evidence for non-unknown reports", async () => {
+	(getCurrentUser as jest.Mock).mockResolvedValue(null);
+	const unauthenticated = await POST(makeRequest({}), { params: { id: "experience-a" } });
+	expect(unauthenticated.status).toBe(401);
+	expect(listMemoryConnectors).not.toHaveBeenCalled();
+
+	(getCurrentUser as jest.Mock).mockResolvedValue({ id: "operator-a" });
+	const reportOutcome = jest.fn().mockResolvedValue({
+		appended: true,
+		outcome: {
+			outcomeKind: "unknown",
+			reportKind: "task",
+			reportedAt: "2026-10-01T00:05:00.000Z",
+			evidence: []
+		}
+	});
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({ connector, adapter: { __autodev: true, reportOutcome } });
+	const missingEvidence = await POST(
+		makeRequest({
+			connectorId: connector.id,
+			injectionEventId: "injection-event-a",
+			outcomeKind: "success",
+			reportKind: "task",
+			evidence: []
+		}),
+		{ params: { id: "experience-a" } }
+	);
+	expect(missingEvidence.status).toBe(400);
+	expect(reportOutcome).not.toHaveBeenCalled();
+	const unknownWithoutEvidence = await POST(
+		makeRequest({
+			connectorId: connector.id,
+			injectionEventId: "injection-event-a",
+			outcomeKind: "unknown",
+			reportKind: "task",
+			evidence: []
+		}),
+		{ params: { id: "experience-a" } }
+	);
+	expect(unknownWithoutEvidence.status).toBe(200);
+});
+
+test("outcome POST rejects caller-supplied correlation tokens and unknown fields", async () => {
+	const response = await POST(
+		makeRequest({
+			connectorId: connector.id,
+			injectionEventId: "injection-event-a",
+			correlationToken: "caller-token",
+			outcomeKind: "unknown",
+			reportKind: "task",
+			evidence: []
+		}),
+		{ params: { id: "experience-a" } }
+	);
+	expect(response.status).toBe(400);
+	const body = await response.json();
+	expect(body).toBe(MEMORY_DETAIL_OUTCOME_REPORT_INVALID);
+});
+
+test("outcome POST rejects non-AutoDev connectors and preserves append-only conflict status", async () => {
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({ connector, adapter: { __autodev: false } });
+	const nonAutoDev = await POST(
+		makeRequest({ connectorId: connector.id, injectionEventId: "event-a", outcomeKind: "unknown", reportKind: "task", evidence: [] }),
+		{ params: { id: "experience-a" } }
+	);
+	expect(nonAutoDev.status).toBe(400);
+
+	(getMemoryRuntime as jest.Mock).mockResolvedValue({
+		connector,
+		adapter: { __autodev: true, reportOutcome: jest.fn().mockRejectedValue(Object.assign(new Error("conflict"), { status: 409 })) }
+	});
+	const conflict = await POST(
+		makeRequest({ connectorId: connector.id, injectionEventId: "event-a", outcomeKind: "failure", reportKind: "task", evidence: [{ kind: "commit", uri: "git://repo/commit/abc" }] }),
+		{ params: { id: "experience-a" } }
+	);
+	expect(conflict.status).toBe(409);
+});
