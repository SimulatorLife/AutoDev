index 00000000..912729eb
--- /dev/null
+++ b/src/client/src/__tests__/lib/autodev/usage-git-metrics.test.ts
@@ -0,0 +1,219 @@
+const mockResolveTelemetrySourceDescriptor = jest.fn();
+const mockGetTelemetryAdapter = jest.fn();
+const mockMetricCounterDeltas = jest.fn();
+
+jest.mock("@/lib/telemetry-source", () => ({
+	resolveTelemetrySourceDescriptor: (...args: unknown[]) =>
+		mockResolveTelemetrySourceDescriptor(...args),
+	getTelemetryAdapter: (...args: unknown[]) =>
+		mockGetTelemetryAdapter(...args),
+}));
+
+import {
+	buildGitMetricQuery,
+	readGitUsageWidgets,
+} from "@/lib/autodev/usage-git-metrics";
+import type { UsageSelection } from "@/lib/autodev/usage-api";
+
+const selection: UsageSelection = {
+	range: "7D",
+	values: { workspace: ["repo-a"], provider: ["codex"], agent: ["worker"] },
+};
+const range = {
+	start: new Date("2026-10-01T00:00:00.000Z"),
+	end: new Date("2026-10-08T00:00:00.000Z"),
+};
+const commonAttributes = {
+	"autodev.git.attribution": "commit_identity",
+	"autodev.workspace": "repo-a",
+	"gen_ai.provider.name": "codex",
+	"autodev.agent.role": "worker",
+};
+
+function point(
+	metricName: string,
+	value: number,
+	extra: Record<string, string> = {},
+) {
+	return {
+		metricName,
+		serviceName: "autodev-router",
+		timestamp: "2026-10-06T00:00:00.000Z",
+		value,
+		attributes: { ...commonAttributes, ...extra },
+		resourceAttributes: {},
+	};
+}
+
+function adapterWith(rows: readonly ReturnType<typeof point>[]) {
+	mockGetTelemetryAdapter.mockResolvedValue({
+		capabilities: () => ({ cumulativeCounterDeltas: true }),
+		metricCounterDeltas: mockMetricCounterDeltas,
+	});
+	mockMetricCounterDeltas.mockResolvedValue({ rows, meta: {} });
+}
+
+describe("Usage Git metric query", () => {
+	beforeEach(() => {
+		mockResolveTelemetrySourceDescriptor.mockReset();
+		mockResolveTelemetrySourceDescriptor.mockResolvedValue({
+			type: "clickhouse",
+			id: "builtin:default-db",
+		});
+		mockGetTelemetryAdapter.mockReset();
+		mockMetricCounterDeltas.mockReset();
+	});
+
+	it("uses only bounded, typed metric filters for source-confirmed commits", () => {
+		const untrusted = "repo-a' OR 1=1 --";
+		const query = buildGitMetricQuery(
+			{
+				...selection,
+				values: { ...selection.values, workspace: [untrusted] },
+			},
+			range,
+		);
+
+		expect(query.signal).toBe("metrics");
+		expect(query.timeRange).toEqual(range);
+		expect(query.aiSelector).toBe(false);
+		expect(query.filters).toEqual(
+			expect.arrayContaining([
+				expect.objectContaining({
+					target: "spanName",
+					op: "in",
+					value: expect.arrayContaining(["autodev.git.commits"]),
+				}),
+				expect.objectContaining({
+					key: "autodev.git.attribution",
+					op: "eq",
+					value: "commit_identity",
+				}),
+				expect.objectContaining({
+					key: "autodev.workspace",
+					op: "in",
+					value: [untrusted],
+				}),
+			]),
+		);
+		expect(JSON.stringify(query)).toContain(untrusted);
+	});
+
+	it("aggregates typed cumulative-counter deltas into the ten fixed Git widgets", async () => {
+		adapterWith([
+			point("autodev.git.commits", 12),
+			point("autodev.git.commits", 2, { "autodev.git.partial": "true" }),
+			point("autodev.git.files_changed", 24),
+			point("autodev.git.files_added", 6),
+			point("autodev.git.files_deleted", 3),
+			point("autodev.git.lines_added", 50),
+			point("autodev.git.lines_removed", 40),
+		]);
+
+		const widgets = await readGitUsageWidgets(selection, range);
+		const widget = (key: string) =>
+			widgets.find((candidate) => candidate.key === key);
+		expect(widgets).toHaveLength(10);
+		expect(widget("git-commits")).toMatchObject({
+			querySucceeded: true,
+			observed: true,
+			rows: [{ commits: 14 }],
+		});
+		expect(widget("git-partial-commits")).toMatchObject({
+			observed: true,
+			rows: [{ value: 2 }],
+		});
+		expect(widget("git-files-changed")?.rows).toEqual([{ value: 24 }]);
+		expect(widget("git-files-added")?.rows).toEqual([{ value: 6 }]);
+		expect(widget("git-files-deleted")?.rows).toEqual([{ value: 3 }]);
+		expect(widget("git-lines-added")?.rows).toEqual([{ value: 50 }]);
+		expect(widget("git-lines-removed")?.rows).toEqual([{ value: 40 }]);
+		expect(widget("git-commits-by-workspace")?.rows).toEqual([
+			{ name: "repo-a", count: 14 },
+		]);
+		expect(widget("git-commits-by-provider")?.rows).toEqual([
+			{ name: "codex", count: 14 },
+		]);
+		expect(widget("git-commits-by-agent")?.rows).toEqual([
+			{ name: "worker", count: 14 },
+		]);
+		expect(mockResolveTelemetrySourceDescriptor).toHaveBeenCalledWith({
+			signal: "metrics",
+		});
+		expect(mockGetTelemetryAdapter).toHaveBeenCalledWith({
+			signal: "metrics",
+			sourceId: "builtin:default-db",
+		});
+		expect(mockMetricCounterDeltas).toHaveBeenCalledWith(
+			queryFor(selection),
+		);
+	});
+
+	it("omits unknown attribution from breakdowns and marks a bounded truncation", async () => {
+		const rows = Array.from({ length: 21 }, (_, index) =>
+			point("autodev.git.commits", 1, {
+				"autodev.workspace": `workspace-${index}`,
+			}),
+		);
+		rows.push(
+			point("autodev.git.commits", 100, {
+				"autodev.workspace": "",
+				"gen_ai.provider.name": "",
+				"autodev.agent.role": "",
+			}),
+		);
+		adapterWith(rows);
+		const widgets = await readGitUsageWidgets(selection, range);
+		const workspace = widgets.find(
+			(candidate) => candidate.key === "git-commits-by-workspace",
+		);
+		const provider = widgets.find(
+			(candidate) => candidate.key === "git-commits-by-provider",
+		);
+		expect(workspace?.rows).toHaveLength(20);
+		expect(workspace?.partial).toBe(true);
+		expect(provider?.rows).toEqual([{ name: "codex", count: 21 }]);
+	});
+
+	it("fails closed for unsupported sources, adapters, metric filters and query bounds", async () => {
+		mockResolveTelemetrySourceDescriptor.mockResolvedValue({
+			type: "prometheus",
+		});
+		let widgets = await readGitUsageWidgets(selection, range);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(
+			true,
+		);
+		expect(mockGetTelemetryAdapter).not.toHaveBeenCalled();
+
+		mockResolveTelemetrySourceDescriptor.mockResolvedValue({
+			type: "clickhouse",
+			id: "source",
+		});
+		mockGetTelemetryAdapter.mockResolvedValue({ capabilities: () => ({}) });
+		widgets = await readGitUsageWidgets(selection, range);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(
+			true,
+		);
+
+		adapterWith([point("autodev.git.commits", 1)]);
+		mockMetricCounterDeltas.mockRejectedValueOnce(new Error("no baseline"));
+		widgets = await readGitUsageWidgets(selection, range);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(
+			true,
+		);
+
+		adapterWith([point("autodev.git.commits", 1)]);
+		mockMetricCounterDeltas.mockResolvedValueOnce({
+			rows: [],
+			meta: { truncated: true },
+		});
+		widgets = await readGitUsageWidgets(selection, range);
+		expect(widgets.every((candidate) => !candidate.querySucceeded)).toBe(
+			true,
+		);
+	});
+});
+
+function queryFor(selection: UsageSelection) {
+	return buildGitMetricQuery(selection, range);
+}
diff --git a/src/client/src/__tests__/lib/platform/datasource/clickhouse-counter-deltas.test.ts b/src/client/src/__tests__/lib/platform/datasource/clickhouse-counter-deltas.test.ts
