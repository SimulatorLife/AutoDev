diff --git a/src/client/src/lib/platform/connectors/datasource/clickhouse/counter-deltas.ts b/src/client/src/lib/platform/connectors/datasource/clickhouse/counter-deltas.ts
new file mode 100644
index 00000000..a7deb120
--- /dev/null
+++ b/src/client/src/lib/platform/connectors/datasource/clickhouse/counter-deltas.ts
@@ -0,0 +1,316 @@
+import { OTEL_METRICS_SUM_TABLE_NAME } from "@/lib/platform/common";
+import { queryConnectorMetrics } from "./direct-read";
+import type {
+	DataFrame,
+	NormalizedMetricPoint,
+	NormalizedFilter,
+	OpenLITQuery,
+} from "../types";
+
+const GIT_METRIC_NAMES = [
+	"autodev.git.commits",
+	"autodev.git.files_changed",
+	"autodev.git.files_added",
+	"autodev.git.files_deleted",
+	"autodev.git.lines_added",
+	"autodev.git.lines_removed",
+] as const;
+const ATTRIBUTE_FILTERS = new Set([
+	"autodev.workspace",
+	"gen_ai.provider.name",
+	"autodev.agent.role",
+]);
+const MAX_COUNTER_SERIES = 10_000;
+const MAX_COUNTER_WINDOW_MS = 90 * 24 * 60 * 60 * 1_000;
+const SERVICE_NAME = "autodev-router";
+const ATTRIBUTION_KEY = "autodev.git.attribution";
+const ATTRIBUTION_VALUE = "commit_identity";
+
+interface CounterDeltaQuery {
+	readonly sql: string;
+	readonly params: Readonly<Record<string, unknown>>;
+}
+
+interface CounterDeltaRow {
+	readonly MetricName?: unknown;
+	readonly Attributes?: unknown;
+	readonly currentValue?: unknown;
+	readonly baselineValue?: unknown;
+	readonly baselinePoints?: unknown;
+	readonly startedInWindow?: unknown;
+	readonly timestampMs?: unknown;
+}
+
+/** Read one exact window of cumulative monotonic counters through the metrics adapter. */
+export async function readCounterDeltaSeries(
+	query: OpenLITQuery,
+	dbConfigId?: string,
+): Promise<DataFrame<NormalizedMetricPoint>> {
+	const prepared = buildCounterDeltaQuery(query);
+	const startedAt = Date.now();
+	const result = await queryConnectorMetrics(prepared.sql, dbConfigId, {
+		...prepared.params,
+	});
+	if (result.err || !Array.isArray(result.data)) {
+		throw result.err instanceof Error
+			? result.err
+			: new Error("ClickHouse metric-counter query failed");
+	}
+	if (result.data.length > MAX_COUNTER_SERIES) {
+		throw new Error("ClickHouse metric-counter result exceeded its bound");
+	}
+	const rows = (result.data as CounterDeltaRow[]).map(toCounterDeltaPoint);
+	if (rows.some((row) => row === null)) {
+		throw new Error(
+			"Cumulative metric window has an incomplete or invalid baseline",
+		);
+	}
+	return {
+		fields: [],
+		rows: rows as NormalizedMetricPoint[],
+		meta: { latencyMs: Date.now() - startedAt, rowsScanned: rows.length },
+	};
+}
+
+export function buildCounterDeltaQuery(query: OpenLITQuery): CounterDeltaQuery {
+	const filters = validateCounterQuery(query);
+	const params: Record<string, unknown> = {
+		metric_names: [...GIT_METRIC_NAMES],
+		service_name: SERVICE_NAME,
+		attribution_key: ATTRIBUTION_KEY,
+		attribution_value: ATTRIBUTION_VALUE,
+		start: query.timeRange.start.toISOString(),
+		end: query.timeRange.end.toISOString(),
+	};
+	const dimensionFilters = filters.flatMap((filter, index) => {
+		const key = filter.key!;
+		const values = filter.value as string[];
+		params[`dimension_${index}_key`] = key;
+		params[`dimension_${index}_values`] = values;
+		return [
+			`AND Attributes[{dimension_${index}_key:String}] IN {dimension_${index}_values:Array(String)}`,
+		];
+	});
+	const selectionWhere = dimensionFilters.join("\n\t\t");
+	const start = "parseDateTime64BestEffort({start:String}, 9, 'UTC')";
+	const end = "parseDateTime64BestEffort({end:String}, 9, 'UTC')";
+	const where = `MetricName IN {metric_names:Array(String)}
+		AND ServiceName = {service_name:String}
+		AND IsMonotonic = 1
+		AND AggregationTemporality = 2
+		AND Attributes[{attribution_key:String}] = {attribution_value:String}
+		${selectionWhere}
+		AND TimeUnix <= ${end}`;
+	const sql = `
+WITH matching_points AS (
+	SELECT
+		MetricName,
+		ServiceName,
+		Attributes,
+		ResourceAttributes,
+		ScopeName,
+		ScopeVersion,
+		ScopeAttributes,
+		StartTimeUnix,
+		TimeUnix,
+		Value,
+		toJSONString(Attributes) AS attributes_key,
+		toJSONString(ResourceAttributes) AS resource_attributes_key,
+		toJSONString(ScopeAttributes) AS scope_attributes_key
+	FROM ${OTEL_METRICS_SUM_TABLE_NAME}
+	WHERE ${where}
+), window_latest AS (
+	SELECT
+		MetricName,
+		ServiceName,
+		attributes_key,
+		resource_attributes_key,
+		ScopeName,
+		ScopeVersion,
+		scope_attributes_key,
+		StartTimeUnix,
+		any(Attributes) AS Attributes,
+		argMax(Value, TimeUnix) AS currentValue,
+		toUInt8(StartTimeUnix >= ${start}) AS startedInWindow,
+		max(TimeUnix) AS timestamp
+	FROM matching_points
+	WHERE TimeUnix >= ${start}
+	GROUP BY MetricName, ServiceName, attributes_key, resource_attributes_key,
+		ScopeName, ScopeVersion, scope_attributes_key, StartTimeUnix
+), baseline_latest AS (
+	SELECT
+		MetricName,
+		ServiceName,
+		attributes_key,
+		resource_attributes_key,
+		ScopeName,
+		ScopeVersion,
+		scope_attributes_key,
+		StartTimeUnix,
+		argMax(Value, TimeUnix) AS baselineValue,
+		count() AS baselinePoints
+	FROM matching_points
+	WHERE TimeUnix < ${start}
+	GROUP BY MetricName, ServiceName, attributes_key, resource_attributes_key,
+		ScopeName, ScopeVersion, scope_attributes_key, StartTimeUnix
+)
+SELECT
+	window_latest.MetricName AS MetricName,
+	window_latest.Attributes AS Attributes,
+	window_latest.currentValue AS currentValue,
+	ifNull(baseline_latest.baselineValue, 0) AS baselineValue,
+	ifNull(baseline_latest.baselinePoints, 0) AS baselinePoints,
+	window_latest.startedInWindow AS startedInWindow,
+	toUnixTimestamp64Milli(window_latest.timestamp) AS timestampMs
+FROM window_latest
+LEFT JOIN baseline_latest ON
+	window_latest.MetricName = baseline_latest.MetricName
+	AND window_latest.ServiceName = baseline_latest.ServiceName
+	AND window_latest.attributes_key = baseline_latest.attributes_key
+	AND window_latest.resource_attributes_key = baseline_latest.resource_attributes_key
+	AND window_latest.ScopeName = baseline_latest.ScopeName
+	AND window_latest.ScopeVersion = baseline_latest.ScopeVersion
+	AND window_latest.scope_attributes_key = baseline_latest.scope_attributes_key
+	AND window_latest.StartTimeUnix = baseline_latest.StartTimeUnix
+ORDER BY window_latest.MetricName, window_latest.attributes_key, window_latest.StartTimeUnix
+LIMIT ${MAX_COUNTER_SERIES + 1}`;
+	return { sql, params };
+}
+
+function validateCounterQuery(query: OpenLITQuery): NormalizedFilter[] {
+	if (
+		query.signal !== "metrics" ||
+		query.aiSelector !== false ||
+		!Number.isFinite(query.timeRange.start.getTime()) ||
+		!Number.isFinite(query.timeRange.end.getTime()) ||
+		query.timeRange.start >= query.timeRange.end
+	) {
+		throw new Error("Invalid cumulative metric window");
+	}
+	const allFilters = query.filters ?? [];
+	const metricFilters = allFilters.filter(
+		(filter) => filter.target === "spanName",
+	);
+	const metricNames = metricFilters.flatMap((filter) =>
+		Array.isArray(filter.value) ? filter.value : [filter.value],
+	);
+	if (
+		metricFilters.length !== 1 ||
+		metricNames.length !== GIT_METRIC_NAMES.length ||
+		GIT_METRIC_NAMES.some((name) => !metricNames.includes(name))
+	) {
+		throw new Error(
+			"Unsupported metric names for cumulative counter query",
+		);
+	}
+	const serviceFilters = allFilters.filter(
+		(filter) =>
+			filter.target === "attribute" && filter.key === "service.name",
+	);
+	const attributionFilters = allFilters.filter(
+		(filter) =>
+			filter.target === "attribute" && filter.key === ATTRIBUTION_KEY,
+	);
+	if (
+		serviceFilters.length !== 1 ||
+		serviceFilters[0]?.scope !== "resource" ||
+		serviceFilters[0]?.op !== "eq" ||
+		serviceFilters[0]?.value !== SERVICE_NAME ||
+		attributionFilters.length !== 1 ||
+		attributionFilters[0]?.scope !== "metric" ||
+		attributionFilters[0]?.op !== "eq" ||
+		attributionFilters[0]?.value !== ATTRIBUTION_VALUE
+	) {
+		throw new Error(
+			"Cumulative counters require the AutoDev router and commit identity",
+		);
+	}
+	const dimensions = allFilters.filter(
+		(filter) =>
+			filter.target === "attribute" &&
+			filter.key !== "service.name" &&
+			filter.key !== ATTRIBUTION_KEY,
+	);
+	const invalidDimension = dimensions.some((filter) => {
+		if (
+			filter.target !== "attribute" ||
+			filter.scope !== "metric" ||
+			!filter.key ||
+			!ATTRIBUTE_FILTERS.has(filter.key) ||
+			filter.op !== "in" ||
+			!Array.isArray(filter.value) ||
+			filter.value.length === 0 ||
+			filter.value.length > 32
+		) {
+			return true;
+		}
+		return !filter.value.every(
+			(value) =>
+				typeof value === "string" &&
+				value.length <= 256 &&
+				value.trim() === value,
+		);
+	});
+	if (allFilters.length !== 3 + dimensions.length || invalidDimension) {
+		throw new Error("Unsupported metric dimension filter");
+	}
+	return dimensions;
+}
+
+function toCounterDeltaPoint(
+	row: CounterDeltaRow,
+): NormalizedMetricPoint | null {
+	if (
+		typeof row.MetricName !== "string" ||
+		!GIT_METRIC_NAMES.includes(
+			row.MetricName as (typeof GIT_METRIC_NAMES)[number],
+		) ||
+		!isRecord(row.Attributes)
+	) {
+		return null;
+	}
+	const currentValue = finiteCounter(row.currentValue);
+	const baselineValue = finiteCounter(row.baselineValue);
+	const baselinePoints = finiteCounter(row.baselinePoints);
+	const startedInWindow =
+		row.startedInWindow === 1 || row.startedInWindow === "1";
+	if (
+		currentValue === null ||
+		baselineValue === null ||
+		baselinePoints === null ||
+		(baselinePoints === 0 && !startedInWindow) ||
+		(baselinePoints > 0 && currentValue < baselineValue)
+	) {
+		return null;
+	}
+	const attributes: Record<string, string> = {};
+	for (const [key, value] of Object.entries(row.Attributes)) {
+		if (typeof value !== "string") return null;
+		attributes[key] = value;
+	}
+	if (attributes[ATTRIBUTION_KEY] !== ATTRIBUTION_VALUE) return null;
+	const timestampMillis = Number(row.timestampMs);
+	const timestamp = new Date(timestampMillis);
+	if (
+		!Number.isSafeInteger(timestampMillis) ||
+		!Number.isFinite(timestamp.getTime())
+	)
+		return null;
+	return {
+		metricName: row.MetricName,
+		serviceName: SERVICE_NAME,
+		timestamp: timestamp.toISOString(),
+		value: baselinePoints > 0 ? currentValue - baselineValue : currentValue,
+		attributes,
+		resourceAttributes: {},
+	};
+}
+
+function finiteCounter(value: unknown): number | null {
+	const parsed = typeof value === "number" ? value : Number(value);
+	return Number.isSafeInteger(parsed) && parsed >= 0 ? parsed : null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
