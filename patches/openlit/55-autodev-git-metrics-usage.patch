index 00000000..63b327ad
--- /dev/null
+++ b/src/client/src/__tests__/lib/platform/datasource/clickhouse-counter-deltas.test.ts
@@ -0,0 +1,175 @@
+const mockQueryConnectorMetrics = jest.fn();
+
+jest.mock("@/lib/platform/common", () => ({
+	OTEL_METRICS_SUM_TABLE_NAME: "otel_metrics_sum",
+}));
+
+jest.mock(
+	"@/lib/platform/connectors/datasource/clickhouse/direct-read",
+	() => ({
+		queryConnectorMetrics: (...args: unknown[]) =>
+			mockQueryConnectorMetrics(...args),
+	}),
+);
+
+import {
+	buildCounterDeltaQuery,
+	readCounterDeltaSeries,
+} from "@/lib/platform/connectors/datasource/clickhouse/counter-deltas";
+import type { OpenLITQuery } from "@/lib/platform/connectors/datasource/types";
+
+const query: OpenLITQuery = {
+	signal: "metrics",
+	timeRange: {
+		start: new Date("2026-10-01T00:00:00.000Z"),
+		end: new Date("2026-10-08T00:00:00.000Z"),
+	},
+	aiSelector: false,
+	filters: [
+		{
+			target: "spanName",
+			op: "in",
+			value: [
+				"autodev.git.commits",
+				"autodev.git.files_changed",
+				"autodev.git.files_added",
+				"autodev.git.files_deleted",
+				"autodev.git.lines_added",
+				"autodev.git.lines_removed",
+			],
+		},
+		{
+			target: "attribute",
+			scope: "resource",
+			key: "service.name",
+			op: "eq",
+			value: "autodev-router",
+		},
+		{
+			target: "attribute",
+			scope: "metric",
+			key: "autodev.git.attribution",
+			op: "eq",
+			value: "commit_identity",
+		},
+		{
+			target: "attribute",
+			scope: "metric",
+			key: "autodev.workspace",
+			op: "in",
+			value: ["repo-a' OR 1=1 --"],
+		},
+	],
+};
+
+function row(overrides: Record<string, unknown> = {}) {
+	return {
+		MetricName: "autodev.git.commits",
+		Attributes: {
+			"autodev.git.attribution": "commit_identity",
+			"autodev.workspace": "repo-a",
+			"gen_ai.provider.name": "codex",
+			"autodev.agent.role": "worker",
+		},
+		currentValue: 22,
+		baselineValue: 10,
+		baselinePoints: 1,
+		startedInWindow: 0,
+		timestampMs: new Date("2026-10-07T00:00:00.000Z").getTime(),
+		...overrides,
+	};
+}
+
+describe("ClickHouse cumulative metric windows", () => {
+	beforeEach(() => mockQueryConnectorMetrics.mockReset());
+
+	it("uses a fixed parameterized sum query and never averages cumulative samples", () => {
+		const prepared = buildCounterDeltaQuery(query);
+		expect(prepared.sql).toContain("otel_metrics_sum");
+		expect(prepared.sql).toContain("AggregationTemporality = 2");
+		expect(prepared.sql).toContain("IsMonotonic = 1");
+		expect(prepared.sql).toContain("argMax(Value, TimeUnix)");
+		expect(prepared.sql).toContain("baseline_latest");
+		expect(prepared.sql).toContain("{dimension_0_values:Array(String)}");
+		expect(prepared.sql).not.toMatch(/avg\s*\(/iu);
+		expect(prepared.sql).not.toContain("repo-a' OR 1=1 --");
+		expect(prepared.params.dimension_0_values).toEqual([
+			"repo-a' OR 1=1 --",
+		]);
+		expect(prepared.params.start).toBe("2026-10-01T00:00:00.000Z");
+		expect(prepared.params.end).toBe("2026-10-08T00:00:00.000Z");
+	});
+
+	it("subtracts the prior cumulative reading and accepts a series that starts inside the window", async () => {
+		mockQueryConnectorMetrics.mockResolvedValue({ data: [row()] });
+		const delta = await readCounterDeltaSeries(query, "db-1");
+		expect(delta.rows).toEqual([
+			expect.objectContaining({
+				metricName: "autodev.git.commits",
+				value: 12,
+				serviceName: "autodev-router",
+			}),
+		]);
+		expect(mockQueryConnectorMetrics).toHaveBeenCalledWith(
+			expect.stringContaining("LEFT JOIN baseline_latest"),
+			"db-1",
+			expect.objectContaining({ attribution_value: "commit_identity" }),
+		);
+
+		mockQueryConnectorMetrics.mockResolvedValueOnce({
+			data: [
+				row({
+					currentValue: 3,
+					baselineValue: 0,
+					baselinePoints: 0,
+					startedInWindow: 1,
+				}),
+			],
+		});
+		const newSeries = await readCounterDeltaSeries(query, "db-1");
+		expect(newSeries.rows[0]?.value).toBe(3);
+	});
+
+	it("rejects missing baselines, counter resets, and non-integral counters instead of undercounting", async () => {
+		for (const invalid of [
+			row({ baselinePoints: 0, startedInWindow: 0 }),
+			row({ currentValue: 3, baselineValue: 10 }),
+			row({ currentValue: 3.5 }),
+		]) {
+			mockQueryConnectorMetrics.mockResolvedValueOnce({
+				data: [invalid],
+			});
+			await expect(readCounterDeltaSeries(query)).rejects.toThrow(
+				/baseline|window/u,
+			);
+		}
+	});
+
+	it("rejects any query outside the fixed AutoDev metric/filter contract", () => {
+		const missingAttribution = {
+			...query,
+			filters: query.filters?.filter(
+				(filter) => filter.key !== "autodev.git.attribution",
+			),
+		};
+		const injected = {
+			...query,
+			filters: [
+				...(query.filters ?? []),
+				{
+					target: "attribute" as const,
+					scope: "metric" as const,
+					key: "arbitrary",
+					op: "eq" as const,
+					value: "x",
+				},
+			],
+		};
+		expect(() => buildCounterDeltaQuery(missingAttribution)).toThrow(
+			/identity/u,
+		);
+		expect(() => buildCounterDeltaQuery(injected)).toThrow(
+			/dimension filter/u,
+		);
+	});
+});
