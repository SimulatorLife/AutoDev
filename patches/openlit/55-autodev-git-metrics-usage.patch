diff --git a/src/client/src/lib/autodev/usage-git-metrics.ts b/src/client/src/lib/autodev/usage-git-metrics.ts
new file mode 100644
index 00000000..5ba220ff
--- /dev/null
+++ b/src/client/src/lib/autodev/usage-git-metrics.ts
@@ -0,0 +1,317 @@
+import {
+	getTelemetryAdapter,
+	resolveTelemetrySourceDescriptor,
+} from "@/lib/telemetry-source";
+import type {
+	NormalizedFilter,
+	NormalizedMetricPoint,
+	OpenLITQuery,
+} from "@/lib/platform/connectors/datasource/types";
+import type { UsageSelection } from "@/lib/autodev/usage-api";
+
+const METRIC_NAMES = [
+	"autodev.git.commits",
+	"autodev.git.files_changed",
+	"autodev.git.files_added",
+	"autodev.git.files_deleted",
+	"autodev.git.lines_added",
+	"autodev.git.lines_removed",
+] as const;
+const METRIC_WIDGET_KEYS = [
+	"git-commits",
+	"git-files-changed",
+	"git-files-added",
+	"git-files-deleted",
+	"git-lines-added",
+	"git-lines-removed",
+	"git-partial-commits",
+	"git-commits-by-workspace",
+	"git-commits-by-provider",
+	"git-commits-by-agent",
+] as const;
+const BREAKDOWN_LIMIT = 20;
+const SERVICE_NAME = "autodev-router";
+const ATTRIBUTION_KEY = "autodev.git.attribution";
+const ATTRIBUTION_VALUE = "commit_identity";
+const PARTIAL_KEY = "autodev.git.partial";
+
+export interface GitUsageWidget {
+	readonly key: (typeof METRIC_WIDGET_KEYS)[number];
+	readonly querySucceeded: boolean;
+	readonly observed: boolean;
+	readonly partial: boolean;
+	readonly rows: readonly Record<string, string | number>[];
+	readonly valuePath?: string;
+	readonly xAxis?: string;
+	readonly yAxis?: string;
+	readonly resultLimit?: number;
+}
+
+interface CounterObservation {
+	readonly metric: (typeof METRIC_NAMES)[number];
+	readonly value: number;
+	readonly attributes: Readonly<Record<string, string>>;
+}
+
+/** Create the fixed, typed OpenLIT metrics query for source-confirmed Git changes. */
+export function buildGitMetricQuery(
+	selection: UsageSelection,
+	range: { readonly start: Date; readonly end: Date },
+): OpenLITQuery {
+	const filters: NormalizedFilter[] = [
+		{ target: "spanName", op: "in", value: [...METRIC_NAMES] },
+		{
+			target: "attribute",
+			scope: "resource",
+			key: "service.name",
+			op: "eq",
+			value: SERVICE_NAME,
+		},
+		{
+			target: "attribute",
+			scope: "metric",
+			key: ATTRIBUTION_KEY,
+			op: "eq",
+			value: ATTRIBUTION_VALUE,
+		},
+	];
+	for (const [id, key] of [
+		["workspace", "autodev.workspace"],
+		["provider", "gen_ai.provider.name"],
+		["agent", "autodev.agent.role"],
+	] as const) {
+		const values = selection.values[id];
+		if (values?.length) {
+			filters.push({
+				target: "attribute",
+				scope: "metric",
+				key,
+				op: "in",
+				value: [...values],
+			});
+		}
+	}
+	return {
+		signal: "metrics",
+		timeRange: { start: range.start, end: range.end },
+		filters,
+		aiSelector: false,
+	};
+}
+
+/** Read source-confirmed agent commit counters and translate them into fixed Usage widgets. */
+export async function readGitUsageWidgets(
+	selection: UsageSelection,
+	range: { readonly start: Date; readonly end: Date },
+): Promise<readonly GitUsageWidget[]> {
+	const unavailable = unavailableWidgets();
+	if (
+		(selection.values.model?.length ?? 0) > 0 ||
+		(selection.values.skill?.length ?? 0) > 0
+	) {
+		return unavailable;
+	}
+
+	try {
+		const descriptor = await resolveTelemetrySourceDescriptor({
+			signal: "metrics",
+		});
+		if (descriptor.type !== "clickhouse") return unavailable;
+		const adapter = await getTelemetryAdapter({
+			signal: "metrics",
+			sourceId: descriptor.id,
+		});
+		if (
+			adapter.capabilities().cumulativeCounterDeltas !== true ||
+			typeof adapter.metricCounterDeltas !== "function"
+		) {
+			return unavailable;
+		}
+		const frame = await adapter.metricCounterDeltas(
+			buildGitMetricQuery(selection, range),
+		);
+		if (frame.meta?.truncated) return unavailable;
+		const observations = parseCounterObservations(frame.rows);
+		if (!observations) return unavailable;
+		return widgetsFromObservations(observations);
+	} catch {
+		return unavailable;
+	}
+}
+
+function parseCounterObservations(
+	rows: readonly NormalizedMetricPoint[],
+): CounterObservation[] | null {
+	const observations: CounterObservation[] = [];
+	for (const row of rows) {
+		if (
+			!METRIC_NAMES.includes(
+				row.metricName as (typeof METRIC_NAMES)[number],
+			) ||
+			row.serviceName !== SERVICE_NAME ||
+			!isRecord(row.attributes)
+		) {
+			return null;
+		}
+		const value = finiteCounter(row.value);
+		if (value === null) return null;
+		const attributes: Record<string, string> = {};
+		for (const [key, candidate] of Object.entries(row.attributes)) {
+			if (typeof candidate !== "string") return null;
+			attributes[key] = candidate;
+		}
+		if (attributes[ATTRIBUTION_KEY] !== ATTRIBUTION_VALUE) return null;
+		observations.push({
+			metric: row.metricName as (typeof METRIC_NAMES)[number],
+			value,
+			attributes,
+		});
+	}
+	return observations;
+}
+
+function widgetsFromObservations(
+	observations: readonly CounterObservation[],
+): readonly GitUsageWidget[] {
+	const metricValues = new Map<string, number>();
+	for (const observation of observations) {
+		metricValues.set(
+			observation.metric,
+			(metricValues.get(observation.metric) ?? 0) + observation.value,
+		);
+	}
+	const commits = observations.filter(
+		(row) => row.metric === "autodev.git.commits",
+	);
+	const observedCommitCount = commits.length > 0;
+	const partialCommits = commits
+		.filter((row) => row.attributes[PARTIAL_KEY] === "true")
+		.reduce((total, row) => total + row.value, 0);
+	const numericWidget = (
+		key: (typeof METRIC_WIDGET_KEYS)[number],
+		metric: (typeof METRIC_NAMES)[number],
+		field: string,
+	): GitUsageWidget => {
+		const found = metricValues.has(metric);
+		return {
+			key,
+			querySucceeded: true,
+			observed: found,
+			partial: false,
+			rows: found ? [{ [field]: metricValues.get(metric)! }] : [],
+			valuePath: `0.${field}`,
+		};
+	};
+	const partialWidget: GitUsageWidget = {
+		key: "git-partial-commits",
+		querySucceeded: true,
+		observed: observedCommitCount,
+		partial: false,
+		rows: observedCommitCount ? [{ value: partialCommits }] : [],
+		valuePath: "0.value",
+	};
+	return [
+		numericWidget("git-commits", "autodev.git.commits", "commits"),
+		numericWidget(
+			"git-files-changed",
+			"autodev.git.files_changed",
+			"value",
+		),
+		numericWidget("git-files-added", "autodev.git.files_added", "value"),
+		numericWidget(
+			"git-files-deleted",
+			"autodev.git.files_deleted",
+			"value",
+		),
+		numericWidget("git-lines-added", "autodev.git.lines_added", "value"),
+		numericWidget(
+			"git-lines-removed",
+			"autodev.git.lines_removed",
+			"value",
+		),
+		partialWidget,
+		breakdownWidget(
+			"git-commits-by-workspace",
+			commits,
+			"autodev.workspace",
+		),
+		breakdownWidget(
+			"git-commits-by-provider",
+			commits,
+			"gen_ai.provider.name",
+		),
+		breakdownWidget("git-commits-by-agent", commits, "autodev.agent.role"),
+	];
+}
+
+function breakdownWidget(
+	key:
+		| "git-commits-by-workspace"
+		| "git-commits-by-provider"
+		| "git-commits-by-agent",
+	commits: readonly CounterObservation[],
+	attribute: string,
+): GitUsageWidget {
+	const counts = new Map<string, number>();
+	for (const commit of commits) {
+		const name = safeLabel(commit.attributes[attribute]);
+		if (name) counts.set(name, (counts.get(name) ?? 0) + commit.value);
+	}
+	const rows = Array.from(counts.entries())
+		.sort(
+			([leftName, leftCount], [rightName, rightCount]) =>
+				rightCount - leftCount || leftName.localeCompare(rightName),
+		)
+		.slice(0, BREAKDOWN_LIMIT)
+		.map(([name, count]) => ({ name, count }));
+	return {
+		key,
+		querySucceeded: true,
+		observed: commits.length > 0,
+		partial: counts.size > BREAKDOWN_LIMIT,
+		rows,
+		xAxis: "name",
+		yAxis: "count",
+		resultLimit: BREAKDOWN_LIMIT,
+	};
+}
+
+function unavailableWidgets(): readonly GitUsageWidget[] {
+	return METRIC_WIDGET_KEYS.map((key) => ({
+		key,
+		querySucceeded: false,
+		observed: false,
+		partial: false,
+		rows: [],
+		...(key.startsWith("git-commits-by-")
+			? { xAxis: "name", yAxis: "count", resultLimit: BREAKDOWN_LIMIT }
+			: {}),
+		...(key === "git-commits" ? { valuePath: "0.commits" } : {}),
+		...(key === "git-partial-commits" ? { valuePath: "0.value" } : {}),
+		...(key.startsWith("git-files-") || key.startsWith("git-lines-")
+			? { valuePath: "0.value" }
+			: {}),
+	}));
+}
+
+function finiteCounter(value: unknown): number | null {
+	const parsed = typeof value === "number" ? value : Number(value);
+	return Number.isSafeInteger(parsed) && parsed >= 0 ? parsed : null;
+}
+
+function safeLabel(value: unknown): string | null {
+	if (
+		typeof value !== "string" ||
+		value.length === 0 ||
+		value.length > 128 ||
+		value.trim() !== value ||
+		/[\u0000-\u001f]/u.test(value)
+	) {
+		return null;
+	}
+	return value;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
