+/**
+ * The reply to a prompt that was typed into the composer rather than attached.
+ *
+ * The site renders a typed message's Markdown, so the bubble it shows is not
+ * the text that was sent, and a reply paired against the sent text is never
+ * found: the command waited out its timeout on a reply that had arrived. The
+ * message therefore opens with a marker line of plain words that rendering
+ * leaves alone. The bubble that starts with the marker is this turn's, and the
+ * reply is paired against that bubble's own text -- whatever the site made of
+ * the rest.
+ */
+export async function waitForChatGPTInlineReply(page, baselineMessages, marker, timeoutSeconds) {
+    const startTime = Date.now();
+    const markerKey = cleanPromptText(marker);
+    let shown = null;
+    while (shown === null && Date.now() - startTime < timeoutSeconds * 1000) {
+        await page.sleep(1);
+        const messages = await getVisibleMessages(page, { textOnly: true });
+        for (let index = messages.length - 1; index >= 0; index -= 1) {
+            const message = messages[index];
