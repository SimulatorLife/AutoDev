+// ── AutoDev: chat guards ───────────────────────────────────────────────
+// A caller that keeps one chat per agent must know a prompt goes into that
+// chat, and must not have it land in whatever chat the tab shows. These run
+// on the page that sends, immediately before the prompt is sent.
+const GEMINI_CHAT_ID_PATTERN = /\/app\/([\w-]+)/;
+export function geminiChatIdOf(url) {
+    const match = GEMINI_CHAT_ID_PATTERN.exec(String(url || ''));
+    return match ? match[1] : null;
+}
+function clickGeminiStopScript() {
+    return `(() => {
+      const node = Array.from(document.querySelectorAll('button, [role="button"]')).find((el) => {
+        const text = (el.textContent || '').trim().toLowerCase();
+        const aria = (el.getAttribute('aria-label') || '').trim().toLowerCase();
+        return text === 'stop response' || aria === 'stop response'
+          || text === 'detener respuesta' || aria === 'detener respuesta'
+          || text === '停止回答' || aria === '停止回答';
+      });
+      if (!node) return false;
+      node.click();
+      return true;
+    })()`;
+}
+/**
+ * Stop a reply still being written in this chat. A caller that was
+ * interrupted leaves the site answering a prompt nobody waits for, and a
+ * new prompt cannot be sent until that reply ends.
+ */
+export async function stopStaleGeminiReply(page, timeoutSeconds = 20) {
+    if (!(await isGeminiGenerating(page)))
+        return false;
+    await page.evaluate(clickGeminiStopScript());
+    for (let waited = 0; waited < timeoutSeconds; waited += 1) {
+        await page.wait({ time: 1 });
+        if (!(await isGeminiGenerating(page)))
+            return true;
+    }
+    throw new CommandExecutionError('Gemini is still answering an earlier prompt; prompt was not sent');
+}
+/**
+ * Google's unusual-traffic check. It replaces Gemini with a CAPTCHA page
+ * (www.google.com/sorry/...) until someone solves it in the browser, and
+ * until then no prompt can be sent. It is reported as the rate limit it is,
+ * not as a missing chat or a reply that never came.
+ */
+export async function requireGeminiNotBlocked(page) {
+    const blocked = await page.evaluate(`(() => {
+      const url = window.location.href;
+      return /^https:\\/\\/(?:www\\.)?google\\.[a-z.]+\\/sorry\\//.test(url)
+        || /unusual traffic from your computer network|detected unusual traffic/i.test(document.body ? document.body.innerText.slice(0, 2000) : '');
+    })()`).catch(() => false);
+    if (unwrapGeminiEvaluateResult(blocked, 'Gemini block probe') === true) {
+        throw new CommandExecutionError("Gemini is rate limited: Google is showing its unusual-traffic check (CAPTCHA) in opencli's Gemini tab; solve it in the browser");
+    }
+}
+/** Open a conversation by id on this page; refuse one that shows no turns. */
+export async function openGeminiConversation(page, id) {
+    await ensureGeminiPage(page);
+    await page.goto(`${GEMINI_APP_URL}/${id}`, { waitUntil: 'load', settleMs: 2500 });
+    await requireGeminiNotBlocked(page);
+    const turns = await getGeminiVisibleTurns(page);
+    if (!Array.isArray(turns) || turns.length === 0) {
+        throw new EmptyResultError('gemini ask', `No turns were visible in chat ${id}; prompt was not sent`);
+    }
+}
+/** `expected` is a chat id, or null for a new chat that has none yet. */
+export async function requireGeminiChat(page, expected) {
+    await requireGeminiNotBlocked(page);
+    const shown = geminiChatIdOf(await getCurrentGeminiUrl(page));
+    if (shown !== expected) {
+        throw new CommandExecutionError(`the Gemini tab shows chat ${shown ?? 'none'}, not ${expected ?? 'a new chat'}; prompt was not sent`);
+    }
