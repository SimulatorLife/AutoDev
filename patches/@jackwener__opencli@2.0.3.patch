+// ── AutoDev: chat guards ───────────────────────────────────────────────
+// See the Gemini adapter: checked on the sending page right before sending.
+function clickChatGPTStopScript() {
+    return `(() => {
+      const node = document.querySelector('[data-testid="stop-button"]')
+        || Array.from(document.querySelectorAll('button, [role="button"]')).find((el) => {
+          const aria = el.getAttribute('aria-label') || '';
+          return aria.includes('Stop generating') || aria.includes('Stop streaming') || aria.includes('停止生成');
+        });
+      if (!node) return false;
+      node.click();
+      return true;
+    })()`;
+}
+/** Stop a reply an interrupted caller left the site writing. */
+export async function stopStaleChatGPTReply(page, timeoutSeconds = 20) {
+    if (!(await isGenerating(page)))
+        return false;
+    await page.evaluate(clickChatGPTStopScript());
+    for (let waited = 0; waited < timeoutSeconds; waited += 1) {
+        await page.wait({ time: 1 });
+        if (!(await isGenerating(page)))
+            return true;
+    }
+    throw new CommandExecutionError('ChatGPT is still answering an earlier prompt; prompt was not sent');
+}
+/** `expected` is a conversation id, or null for a new chat that has none yet. */
+export async function requireChatGPTChat(page, expected) {
+    let shown = null;
+    try {
+        shown = parseChatGPTConversationId(await currentChatGPTUrl(page)) || null;
+    } catch {
+        // A page that is not a /c/<id> conversation, such as a new chat.
+    }
+    if (shown !== expected) {
+        throw new CommandExecutionError(`the ChatGPT tab shows chat ${shown ?? 'none'}, not ${expected ?? 'a new chat'}; prompt was not sent`);
+    }
+}
