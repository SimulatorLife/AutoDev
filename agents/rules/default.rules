# AutoDev's Codex command rules. The installer copies this file to
# "$CODEX_HOME/rules/default.rules" as a regular file: Codex loads a rules
# entry only when it resolves to a file directly inside that directory, and
# skips anything else -- a symlink into this checkout, for example --
# silently, which leaves every rule below inert.

# Code-search agents must use the configured CocoIndex MCP server. The CLI
# executable remains available to the MCP server itself, but model-issued shell
# commands cannot invoke it as a search/indexing fallback.
prefix_rule(
    pattern = ["ccc"],
    decision = "forbidden",
    justification = "Use the configured cocoindex-code MCP tools; direct ccc CLI execution is forbidden for agent shell commands.",
)

# Protect uncommitted work from destructive or history-rewriting Git commands.
# Codex evaluates these prefixes before dispatching the command.
prefix_rule(
    pattern = ["git", ["checkout", "reset", "stash"]],
    decision = "forbidden",
    justification = "These Git operations can discard, rewrite, or hide uncommitted work. Ask the user or use a non-destructive alternative such as git switch -c, git restore --staged, or git worktree.",
    match = [
        "git checkout main",
        "git reset --hard HEAD",
        "git stash push",
    ],
    not_match = [
        "git status",
        "git switch -c feature",
        "git restore --staged file",
    ],
)

# Also cover Git's dashed executable forms.
prefix_rule(
    pattern = ["git-checkout"],
    decision = "forbidden",
    justification = "Use a non-destructive alternative or ask the user to run this command.",
)
prefix_rule(
    pattern = ["git-reset"],
    decision = "forbidden",
    justification = "Use a non-destructive alternative or ask the user to run this command.",
)
prefix_rule(
    pattern = ["git-stash"],
    decision = "forbidden",
    justification = "Use a non-destructive alternative or ask the user to run this command.",
)

# Local service diagnostics are read-only probes. Network policy still governs
# whether the destination is reachable. Keep the URL list explicit so remote
# curl/download commands remain subject to the normal approval policy.
local_diagnostic_urls = [
    "http://127.0.0.1:4100/status",
    "http://127.0.0.1:4100/dashboard",
    "http://127.0.0.1:4100/health",
    "http://127.0.0.1:4100/health/liveliness",
    "http://127.0.0.1:4100/health/readiness",
    "http://127.0.0.1:4100/v1/models",
    "http://localhost:4100/status",
    "http://localhost:4100/dashboard",
    "http://localhost:4100/health",
    "http://localhost:4100/health/liveliness",
    "http://localhost:4100/health/readiness",
    "http://localhost:4100/v1/models",
    "http://127.0.0.1:4000/health",
    "http://127.0.0.1:4000/health/liveliness",
    "http://127.0.0.1:4000/v1/models",
    "http://127.0.0.1:4002/health",
    "http://127.0.0.1:4002/health/liveliness",
    "http://127.0.0.1:4003/health",
    "http://127.0.0.1:4003/health/liveliness",
    "http://127.0.0.1:18765/health",
    "http://localhost:4000/health",
    "http://localhost:4000/health/liveliness",
    "http://localhost:4000/v1/models",
    "http://localhost:4002/health",
    "http://localhost:4002/health/liveliness",
    "http://localhost:4003/health",
    "http://localhost:4003/health/liveliness",
    "http://localhost:18765/health",
]
local_curl_prefixes = [
    [],
    ["--silent"],
    ["--fail"],
    ["--silent", "--fail", "--max-time", "1"],
    ["-fsS", "--max-time", "3"],
]
for local_url in local_diagnostic_urls:
    for local_prefix in local_curl_prefixes:
        prefix_rule(
            pattern = ["curl"] + local_prefix + [local_url],
            decision = "allow",
            justification = "Allow read-only localhost diagnostics; remote curl commands still require approval.",
        )

# Protect uncommitted work from additional history/filesystem destructive Git
# operations. Prefer git switch, git diff, and git restore --staged instead.
prefix_rule(
    pattern = ["git", ["clean", "rebase"]],
    decision = "forbidden",
    justification = "These Git operations can delete untracked work or rewrite history. Ask the user or use a non-destructive alternative.",
)
prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "forbidden",
    justification = "Restoring the whole working tree can discard uncommitted changes. Restore a specific path only after user confirmation.",
)
prefix_rule(
    pattern = ["git", "branch", ["-D", "--delete-force"]],
    decision = "forbidden",
    justification = "Force-deleting a branch can discard commits. Ask the user before removing it.",
)
prefix_rule(
    pattern = ["git", "push", ["-f", "--force", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force pushing can overwrite remote history. Ask the user before force pushing.",
)

# Let agents record their own work. Codex's workspace-write sandbox keeps
# `<root>/.git` read-only, so `git add` and `git commit` fail with
# `.git/index.lock: Operation not permitted` inside it. An `allow` rule runs
# exactly these local, non-destructive index/history writes outside the sandbox;
# every other command still sees `.git` read-only, so it cannot plant hooks or
# rewrite `.git/config`. Prefixes are matched from the first token, so
# `git -c ... commit` and `env ... git commit` stay sandboxed. Push is not here:
# publishing stays subject to the normal approval policy. If the repository
# ever configures commit hooks that live in the worktree (core.hooksPath,
# husky), they run unsandboxed under this rule; review that before adding one.
prefix_rule(
    pattern = ["git", ["add", "commit", "mv", "rm"]],
    decision = "allow",
    justification = "Staging and committing the agent's own changes needs write access to .git, which workspace-write keeps read-only.",
    match = [
        "git add runtime/src/agents/spawn-tools.ts",
        "git commit -m message",
        "git mv old.ts new.ts",
        "git rm --cached file",
    ],
    not_match = [
        "git push",
        "git -c core.hooksPath=x commit",
    ],
)
# Codex judges a chained command as a whole: the most restrictive decision
# across the parts of the chain wins. One companion command that no rule
# matches therefore drops a staging command back into the workspace-write
# sandbox, where `.git` is read-only, and the staging fails with
# `.git/index.lock: Operation not permitted` -- even though the staging command
# on its own is allowed. These are the read-only Git commands an agent chains
# with staging to check the result, so allowing them keeps
# `git add ... && git status` working. They read the repository, and `git status`
# at most refreshes the index. `git log` and `git show` are not here: the root
# orchestrator's own policy refuses to read Git history at all.
prefix_rule(
    pattern = ["git", ["status", "diff", "rev-parse", "ls-files", "branch"]],
    decision = "allow",
    justification = "Read-only Git inspection commands are chained with the staging commands they verify, and a chain is allowed only when every part of it is.",
    match = [
        "git status --short",
        "git diff --cached",
        "git rev-parse --short HEAD",
        "git ls-files runtime/src",
        "git branch --show-current",
    ],
    not_match = [
        "git push",
        "git config core.hooksPath hooks",
    ],
)
prefix_rule(
    pattern = ["git", "restore", "--staged"],
    decision = "allow",
    justification = "Unstaging a path only edits the index and never touches the working tree.",
)
prefix_rule(
    pattern = ["git", "switch", ["-c", "--create"]],
    decision = "allow",
    justification = "Creating a branch from the current HEAD keeps every uncommitted change.",
)
prefix_rule(
    pattern = ["git", "worktree", "add"],
    decision = "allow",
    justification = "Adding a worktree writes only new Git metadata and a new checkout.",
)
# Amending rewrites a commit that may not be this agent's: other agents commit
# to the same branch concurrently. The most restrictive matching rule wins.
prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Amending can rewrite another agent's commit on a shared branch. Make a new commit instead.",
)

# Protect the host from raw-disk and superuser destruction. Targeted, tracked
# cleanup remains available through the installer and normal project tooling.
prefix_rule(
    pattern = [["sudo", "su", "doas", "dd", "mkfs", "fdisk"]],
    decision = "forbidden",
    justification = "Superuser, raw-disk, and filesystem-formatting commands can cause irreversible system-wide damage.",
)
prefix_rule(
    pattern = ["rm", ["-rf", "-fr"], ["/", "~", "*"]],
    decision = "forbidden",
    justification = "Recursive forced deletion of a root, home, or wildcard path can destroy the host or workspace.",
)
prefix_rule(
    pattern = ["rm", ["-rf", "-fr"], [".", "..", ".git"]],
    decision = "forbidden",
    justification = "Recursive forced deletion of the current directory, parent, or Git metadata can destroy the workspace.",
)
