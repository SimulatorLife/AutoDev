{
  "providerGroups": {
    "default": [
      [
        "claude",
        "antigravity",
        "minimax"
      ],
      [
        "copilot"
      ],
      [
        "codex"
      ]
    ],
    "browser-tester": [
      [
        "claude",
        "minimax",
        "antigravity"
      ],
      [
        "copilot"
      ],
      [
        "codex"
      ]
    ],
    "smart": [
      [
        "claude",
        "antigravity",
        "minimax"
      ],
      [
        "codex"
      ]
    ],
    "orchestrator": [
      [
        "codex"
      ],
      [
        "claude",
        "copilot",
        "antigravity"
      ]
    ]
  },
  "routes": {
    "claude": {
      "pattern": "^(sonnet|opus|haiku|claude-[a-z0-9-]*[a-z0-9])$",
      "baseUrl": "http://127.0.0.1:4000/v1",
      "healthUrl": "http://127.0.0.1:4000/health/liveliness",
      "envKey": "LITELLM_API_KEY"
    },
    "minimax": {
      "pattern": "^MiniMax-[A-Za-z0-9][A-Za-z0-9.-]*$",
      "baseUrl": "http://127.0.0.1:18765/v1",
      "healthUrl": "http://127.0.0.1:18765/health",
      "envKey": "MINIMAX_API_KEY"
    },
    "antigravity": {
      "pattern": "^gemini-[A-Za-z0-9][A-Za-z0-9.-]*$",
      "baseUrl": "http://127.0.0.1:4002/v1",
      "healthUrl": "http://127.0.0.1:4002/health/liveliness",
      "envKey": "LITELLM_API_KEY"
    },
    "codex": {
      "pattern": "^(gpt-[A-Za-z0-9][A-Za-z0-9.-]*|o[1-9][A-Za-z0-9.-]*|codex-[A-Za-z0-9][A-Za-z0-9.-]*)$",
      "baseUrl": "https://chatgpt.com/backend-api/codex",
      "envKey": null
    },
    "copilot": {
      "pattern": "^copilot$",
      "baseUrl": "http://127.0.0.1:4003/v1",
      "healthUrl": "http://127.0.0.1:4003/health/liveliness",
      "envKey": "CODEX_ROUTER_COPILOT_API_KEY"
    }
  },
  "providers": {
    "antigravity": {
      "models": {
        "smart": "gemini-3.8-flash-high",
        "orchestrator": "gemini-3.8-flash-high",
        "default": "gemini-3.8-flash-medium"
      },
      "links": {
        "usage": "https://gemini.google.com/u/1/usage?pli=1",
        "documentation": "https://ai.google.dev/gemini-api/docs"
      }
    },
    "claude": {
      "models": {
        "smart": "claude-opus-5-5",
        "orchestrator": "claude-opus-5-5",
        "default": "sonnet"
      },
      "links": {
        "usage": "https://claude.ai/new#settings/usage",
        "documentation": "https://docs.anthropic.com/en/docs/welcome"
      }
    },
    "minimax": {
      "models": {
        "smart": "MiniMax-M3.1-Flash-Preview",
        "default": "MiniMax-M3"
      },
      "links": {
        "usage": "https://platform.minimax.io/console/usage",
        "documentation": "https://platform.minimax.io/docs/guides/text-generation"
      }
    },
    "copilot": {
      "models": {
        "default": "copilot",
        "orchestrator": "copilot"
      },
      "links": {
        "usage": "https://github.com/settings/billing/ai_usage",
        "documentation": "https://docs.github.com/en/copilot"
      }
    },
    "codex": {
      "models": {
        "smart": "gpt-6-sol",
        "orchestrator": "gpt-6-luna",
        "default": "gpt-6-luna"
      },
      "links": {
        "usage": "https://chatgpt.com/settings/usage?tab=overview",
        "documentation": "https://developers.openai.com/codex"
      }
    }
  },
  "roles": {
    "default": {
      "tier": "default"
    },
    "docs-researcher": {
      "tier": "default"
    },
    "browser-tester": {
      "tier": "browser-tester"
    },
    "explorer": {
      "tier": "default"
    },
    "worker": {
      "tier": "default"
    },
    "validator": {
      "tier": "default"
    },
    "smart": {
      "tier": "smart"
    },
    "playtester": {
      "tier": "default"
    },
    "playtest-analyst": {
      "tier": "smart"
    }
  },
  "orchestrator": {
    "alias": "autodev/orchestrator",
    "tier": "orchestrator",
    "reasoningEffort": {
      "claude": "medium",
      "antigravity": "high"
    }
  }
}