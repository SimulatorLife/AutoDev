# OpenLIT 2.1.0 deployment defaults for AutoDev.
#
# This file is read by the local docker-compose fragment in
# config/openlit/docker-compose.yml. It deliberately documents ONLY the
# settings AutoDev relies on; the upstream env.example covers the full
# surface and is the source of truth for unused variables.
#
# Pinned values:
#   source release tag    openlit-2.1.0
#   image tag             2.1.0
#   commit                9938c66638666ca5d3bcb850350faa82e510924b
#   digest                sha256:94552ccd09379b5e2fec3c51c4fec1b41d88d6b56b0a5ccc895c116673884fa8
#
# This is a non-secret template. `scripts/openlit/up.sh` loads it together
# with `$CODEX_HOME/openlit-secrets.env`; generated secrets never enter this
# tracked file. The latter is mode 0600 and contains DB, Control API, OTLP
# receiver, and Console Usage service tokens.

# Upstream OpenLIT image. Pin by immutable digest; the tag is the
# human-readable alias recorded in docs/autodev-console-target-state.md.
# `scripts/openlit/up.sh` supplies the immutable local image ID from the lock.
OPENLIT_IMAGE=autodev-openlit:openlit-9938c6663866-patched
OPENLIT_UPSTREAM_IMAGE=ghcr.io/openlit/openlit@sha256:94552ccd09379b5e2fec3c51c4fec1b41d88d6b56b0a5ccc895c116673884fa8
OPENLIT_TAG=2.1.0

# HTTP port for the OpenLIT UI + API.
PORT=3000
DOCKER_PORT=3000

# ClickHouse persistence (OpenLIT's bundled receiver exports OTLP into
# ClickHouse; this is the persistence layer for telemetry history). Password
# comes only from the out-of-repository CODEX_HOME secret file.
OPENLIT_DB_NAME=openlit
OPENLIT_DB_USER=default

# Edition mode. The patches do not depend on any Enterprise feature.
OPENLIT_EDITION=oss

# ---- AutoDev Control API proxy settings ---------------------------
# Read by the patched Next.js server. The bearer token stays server side;
# the browser only sees same-origin /autodev/api/* URLs.
#
# Contract (see scripts/openlit/README.md):
#   - Bearer token is sent in Authorization: Bearer <token>
#   - Verified session user id is sent in X-AutoDev-Actor
#   - NO X-AutoDev-Role is forwarded (OpenLIT CE has no granular RBAC;
#     the AutoDev API applies its own viewers/operators allowlists).
AUTODEV_CONTROL_API_URL=http://host.docker.internal:4101
# Optional kill switch for cutover windows.
# AUTODEV_CONTROL_API_DISABLED=1

# `OPENLIT_OTLP_API_KEY` and `AUTODEV_OPENLIT_USAGE_TOKEN` are only in
# `$CODEX_HOME/openlit-secrets.env`.
# The patched first-party Collector validates `Authorization: Bearer ...`.
# See config/openlit/otlp-endpoints.md.
