<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.autodev-chatgpt-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TUNNEL_BINARY__</string>
    <string>run</string>
    <string>--profile-file</string>
    <string>__TUNNEL_PROFILE__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__TUNNEL_HOME__</string>
    <key>PATH</key>
    <string>__TUNNEL_SERVICE_PATH__</string>
    <key>MCP_FORWARD_TRACE_CONTEXT</key>
    <string>true</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__TUNNEL_WORKSPACE__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>__TUNNEL_LOG_DIRECTORY__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__TUNNEL_LOG_DIRECTORY__/stderr.log</string>
</dict>
</plist>
