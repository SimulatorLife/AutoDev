<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.model-router</string>

  <!-- Model-aware Codex Responses router on 127.0.0.1:4100. This is the
       parent transport for Codex Desktop (openai_base_url), so it must stay
       up across app restarts, crashes, and sleep. KeepAlive owns that.
       The launcher resolves the node binary itself (nvm/homebrew) so this
       plist does not pin a brittle version-specific PATH. The installer
       ensures $CODEX_HOME/run exists with mode 0700 so launchd can write
       to the separate stdout/stderr logs there. ExitTimeOut is sized so the
       router can finish its graceful drain (30s + buffer) without the
       desktop session tearing the launchd job away mid-shutdown. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CODEX_HOME__/hooks/run-codex-model-router.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- Bound the launchd-killed exit window: the router drains in-flight
       /v1/responses requests for CODEX_ROUTER_SHUTDOWN_DRAIN_MS (30s by
       default) and then closes the HTTP server. 45s gives the process a
       few extra seconds to persist state and exit cleanly. -->
  <key>ExitTimeOut</key>
  <integer>45</integer>

  <!-- The launcher (run-codex-model-router.sh) runs AUTODEV_NODE_BIN, the
       native Node the installer resolved, and falls back to PATH if that
       binary is gone. CODEX_HOME is set so the router reads the user-level
       config; HOME so launcher credential files are found. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- The installer's native Node: PATH alone finds /usr/local/bin/node
         first, an Intel build on many Apple Silicon Macs (run under Rosetta). -->
    <key>AUTODEV_NODE_BIN</key>
    <string>__AUTODEV_NODE_BIN__</string>
    <key>CODEX_HOME</key>
    <string>__CODEX_HOME__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <!-- Separate stdout/stderr so structured router events (autodev-router-event-v1
       on stderr) and incidental stdout output never interleave and are easy
       to correlate by timestamp when triaging. The installer's ensure hook
       tails the stderr log on startup failure; keep the .err.log suffix. -->
  <key>StandardOutPath</key>
  <string>__CODEX_HOME__/run/codex-model-router.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CODEX_HOME__/run/codex-model-router.launchd.err.log</string>

  <!-- Standard, not Background: every Codex request passes through the router,
       and Background puts it in the throttled darwinbg tier (lowest CPU
       priority, throttled disk I/O), so it stalls whenever the machine is busy.
       A LaunchAgent without a GUI never appears in the Dock either way. -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
