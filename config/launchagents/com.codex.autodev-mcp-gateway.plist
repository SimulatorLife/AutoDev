<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.autodev-mcp-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SERVICE_NODE__</string>
    <string>__SERVICE_RUNNER__</string>
    <string>run</string>
    <string>__SERVICE_REPOSITORY_ROOT__</string>
    <string>__SERVICE_HOME__</string>
    <string>__SERVICE_CODEX_HOME__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__SERVICE_HOME__</string>
    <key>PATH</key>
    <string>__SERVICE_PATH__</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__SERVICE_WORKING_DIRECTORY__</string>
  <!-- Interactive, not default/Background: the backend pool spawns sandboxed
       MCP child processes per session, which stall under launchd's throttled
       daemon/background QoS when omitted. LaunchAgents without a GUI never
       appear in the Dock. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>__SERVICE_LOG_DIRECTORY__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__SERVICE_LOG_DIRECTORY__/stderr.log</string>
</dict>
</plist>
