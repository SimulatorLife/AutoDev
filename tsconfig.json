{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    ".rulesync/**/*.ts",
    "core/src/**/*.ts",
    "core/tests/**/*.ts",
    "data/src/**/*.ts",
    "data/tests/**/*.ts",
    "runtime/src/**/*.ts",
    "runtime/tests/**/*.ts"
  ]
}
