# These files contain unified patches. Their leading diff-context marker may be
# followed by a source-code indentation tab, which the outer diff checker sees
# as a space-before-tab error even though it is required patch syntax.
patches/openlit/*.patch whitespace=-space-before-tab
# The pnpm dependency patch carries blank diff-context lines, which unified
# patch syntax writes as a single space; the outer checker reads that as
# trailing whitespace.
patches/@jackwener__opencli@*.patch whitespace=-trailing-space
