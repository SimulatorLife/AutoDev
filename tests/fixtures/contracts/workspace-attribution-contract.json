{
  "schema": "autodev-workspace-attribution-v3",
  "description": "Deterministic contract for workspace-scoped skill attribution on the router's live bridge-observation path. It freezes fail-closed unavailable-versus-empty behavior, exposure-versus-use separation, bridge evidence deduplication, and privacy normalization. MCP and tool evidence is the shared MCP gateway's, not the router's. Refreshing this fixture is the intentional signal that attribution ownership or wire shape changed.",
  "scenarios": {
    "empty_workspace_is_unavailable": {
      "operations": [
        {
          "op": "record",
          "requestId": "empty",
          "phase": "selected",
          "workspace": "SimulatorLife/Empty"
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Empty",
          "field": "bySkill",
          "expected": null
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Empty",
          "field": "skillsExposed",
          "expected": 0
        },
        {
          "op": "assertFieldAbsent",
          "workspace": "SimulatorLife/Empty",
          "field": "bridgeSkills"
        }
      ]
    },
    "skill_exposure_and_use_are_distinct": {
      "operations": [
        {
          "op": "bridgeRequest",
          "requestId": "skill-1",
          "workspace": "SimulatorLife/Skills",
          "provider": "claude",
          "model": "sonnet",
          "role": "default"
        },
        {
          "op": "bridgeEvents",
          "requestId": "skill-1",
          "events": [
            {
              "type": "skill_exposed",
              "skill": "ccc",
              "source": "role_contract",
              "pluginId": "plugin-ccc"
            },
            {
              "type": "skill_used",
              "skill": "ccc",
              "source": "skill_read",
              "eventId": "read-1"
            },
            {
              "type": "skill_used",
              "skill": "ccc",
              "source": "skill_read",
              "eventId": "read-1"
            }
          ]
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Skills",
          "field": "skillsExposed",
          "expected": 1
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Skills",
          "field": "skillUses",
          "expected": 1
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Skills",
          "field": "bySkill",
          "expected": [
            {
              "skill": "ccc",
              "total": 0,
              "uses": 1,
              "errors": 0,
              "byStatus": {},
              "byInvokeType": {},
              "byAgentKind": {},
              "byModel": {},
              "byPlugin": {}
            }
          ]
        },
        {
          "op": "assert",
          "workspace": "SimulatorLife/Skills",
          "field": "bridgeSkills",
          "expected": [
            {
              "skill": "ccc",
              "count": 1
            }
          ]
        }
      ]
    },
    "absolute_workspace_paths_are_hashed": {
      "operations": [
        {
          "op": "privacyHelper",
          "path": "/Users/operator/private-repo",
          "expected": "ws_40eee6443c21"
        }
      ]
    }
  }
}
