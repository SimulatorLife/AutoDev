          "field": "byStatus",
          "expected": {
            "started": 3
          }
        },
        {
          "op": "assert_recent_length",
          "expected": 1
        },
        {
          "op": "assert_recent_field",
          "index": 0,
          "field": "count",
          "expected": 3
        },
        {
          "op": "assert_recent_field",
          "index": 0,
          "field": "mechanism",
          "expected": "bridge_native"
        },
        {
          "op": "assert_recent_field",
          "index": 0,
          "field": "provider",
