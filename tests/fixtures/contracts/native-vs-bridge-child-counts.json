{
  "schema": "autodev-native-vs-bridge-child-counts-v1",
  "description": "Deterministic boundary for the router's native-vs-bridge child count contract. The fixture pins every observable shape `subagentStatus()` produces today: the canonical projection keys (`total`, `byMechanism` covering `router_alias` and `bridge_native`, `byProvider`, `byRole`, `byStatus`, `codexNativeSpawns`, `spawnCapableProviders`, `recent`), the newest-first ordering of `recent`, the 50-entry cap on `recent`, the per-child bridge batch counting rule (one batch event with N children contributes N to `total`/`byMechanism.bridge_native` and one row to `recent`), the `started -> success|failure` settlement that moves a child out of `byStatus.started` and updates the originating row's `settled` tally, the roleless bridge attribution to `byRole.unattributed-subagent`, the inherited-child-model collapse (`inherit`/`self`/`default`/`parent` resolve to the parent turn's model), the rejection of unknown spawn mechanisms by `recordSubagentSpawn`, the late-arriving bridge report (after the parent turn has finished) being opened and settled against the parent turn, the overflow failure path that closes the oldest tracked bridge child when `MAX_TRACKED_BRIDGE_SUBAGENTS` is exceeded, the non-additive `codexNativeSpawns` (Codex's OTLP `codex.multi_agent.spawn` counter is kept beside the router's count rather than merged into it), and the spawn-failure exclusion (a `subagent_tools_unavailable` event records a `spawn_tool_unavailable` failure but does not move any spawn counter). Refreshing the fixture is the documented, intentional signal that the projection shape, the canonical mechanism list, the row-settled semantics, the cap, or the spawn-failure boundary are meant to change.",
  "canonicalMechanisms": [
    "router_alias",
    "bridge_native"
  ],
  "unattributedSubagentRole": "unattributed-subagent",
  "inheritedChildModels": [
    "inherit",
    "self",
    "default",
    "parent"
  ],
  "recentCap": 50,
  "scenarios": {
    "empty_projection_has_exact_key_set_and_zero_tallies": {
      "operations": [
        {
          "op": "assert_keys",
          "expected": [
            "byMechanism",
            "byProvider",
            "byRole",
            "byStatus",
            "codexNativeSpawns",
            "recent",
            "spawnCapableProviders",
            "total"
          ]
        },
        {
          "op": "assert_field",
          "field": "total",
          "expected": 0
        },
        {
          "op": "assert_field",
          "field": "codexNativeSpawns",
          "expected": 0
        },
        {
          "op": "assert_deep_equal",
          "field": "byMechanism",
          "expected": {
            "bridge_native": 0,
            "router_alias": 0
          }
        },
        {
          "op": "assert_deep_equal",
          "field": "byStatus",
          "expected": {}
        },
        {
          "op": "assert_deep_equal",
          "field": "byProvider",
          "expected": {}
        },
        {
          "op": "assert_deep_equal",
          "field": "byRole",
          "expected": {}
        },
        {
          "op": "assert_deep_equal",
          "field": "recent",
          "expected": []
        }
      ]
    },
