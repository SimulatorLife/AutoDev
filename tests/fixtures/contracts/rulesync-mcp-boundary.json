{
  "schema": "autodev-rulesync-mcp-boundary-v1",
  "rulesyncVersion": "16.30.2",
  "description": "Deterministic Phase 2 shared-MCP boundary contract: Rulesync projections are generated in temporary roots, while the portable live config remains the sole owner of lsp, cocoindex-code, and playwright.",
  "targets": {
    "codexcli": {
      "file": ".codex/config.toml",
      "serversKey": "mcp_servers",
      "servers": {
        "lsp": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"
          ]
        },
        "cocoindex-code": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"
          ]
        },
        "playwright": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" playwright"
          ],
          "enabled": false
        }
      }
    },
    "claudecode": {
      "file": ".mcp.json",
      "serversKey": "mcpServers",
      "servers": {
        "lsp": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"
          ]
        },
        "cocoindex-code": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"
          ]
        },
        "openaiDeveloperDocs": {
          "url": "https://developers.openai.com/mcp"
        }
      }
    },
    "copilot": {
      "file": ".vscode/mcp.json",
      "serversKey": "servers",
      "servers": {
        "lsp": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"
          ]
        },
        "cocoindex-code": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"
          ]
        }
      }
    },
    "antigravity-cli": {
      "file": ".agents/mcp_config.json",
      "serversKey": "mcpServers",
      "servers": {
        "lsp": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"
          ]
        },
        "cocoindex-code": {
          "command": "bash",
          "args": [
            "-lc",
            "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"
          ]
        },
        "openaiDeveloperDocs": {
          "serverUrl": "https://developers.openai.com/mcp"
        }
      }
    }
  },
  "forbiddenServers": [
    "node_repl",
    "cua_repl",
    "autodev_spawn"
  ],
  "liveOwnership": {
    "file": "scripts/codex/config.autodev.toml",
    "servers": {
      "lsp": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"
        ],
        "enabled": true,
        "default_tools_approval_mode": "approve"
      },
      "cocoindex-code": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"
        ],
        "enabled": true,
        "default_tools_approval_mode": "approve"
      },
      "playwright": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" playwright"
        ],
        "enabled": false,
        "default_tools_approval_mode": "approve"
      }
    }
  }
}
