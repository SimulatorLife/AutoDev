{
  "schema": "autodev-antigravity-responses-contract-v1",
  "description": "Offline stream-json inputs and expected boundary invariants for the Antigravity Responses bridge.",
  "cases": {
    "normal_stream": {
      "request": {
        "stream": true
      },
      "cli": {
        "events": [
          {
            "event": "step_update",
            "step_update": {
              "step_index": 1,
              "step_type": "tool",
              "tool_name": "search_web",
              "state": "ACTIVE",
              "tool_info": {
                "args": {
                  "query": "contract query"
                }
              }
            }
          },
          {
            "event": "step_update",
            "step_update": {
              "step_index": 1,
              "step_type": "tool",
              "tool_name": "search_web",
              "state": "DONE",
              "duration_seconds": 0.01,
              "tool_info": {
                "output": "search result"
              }
            }
          },
          {
            "event": "step_update",
            "step_index": 2,
            "step_type": "agent_response",
            "state": "ACTIVE"
          },
          {
            "event": "step_update",
            "step_index": 2,
            "step_type": "agent_response",
            "state": "DONE",
            "text_delta": "contract answer"
          },
          {
            "event": "result",
            "result": {
              "status": "SUCCESS",
              "response": "contract answer"
            }
          }
        ],
        "exitCode": 0,
        "stderr": ""
      },
      "expected": {
        "status": 200,
        "eventTypes": [
          "response.created",
          "response.output_item.added",
          "response.reasoning_summary_part.added",
          "response.output_item.added",
          "response.content_part.added",
          "response.reasoning_summary_text.delta",
          "response.reasoning_summary_text.delta",
          "response.reasoning_summary_text.delta",
          "response.output_text.delta",
          "response.reasoning_summary_text.done",
          "response.reasoning_summary_part.done",
          "response.output_item.done",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]"
        ],
        "outputText": "contract answer",
        "completedStatus": "completed",
        "telemetryTypes": [
          "skill_exposed",
          "mcp_exposed",
          "tool_requested",
          "tool_executed",
          "activity"
        ],
        "tool": "search_web",
        "privacyToken": "contract task"
      }
    },
