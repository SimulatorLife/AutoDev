{
  "schema": "autodev-copilot-responses-contract-v1",
  "description": "Offline JSONL inputs and expected boundary invariants for the incumbent Copilot Responses bridge. The fixture also pins the request a bridge cannot serve: a turn that carries a frame is refused with the typed provider_request_unsupported error before the CLI is started, because a text prompt cannot show the model a picture.",
  "cases": {
    "normal_stream": {
      "request": {
        "stream": true
      },
      "cli": {
        "events": [
          {
            "type": "assistant.message_start",
            "data": {
              "messageId": "message-1",
              "phase": "final_answer"
            }
          },
          {
            "type": "assistant.message_delta",
            "data": {
              "messageId": "message-1",
              "phase": "final_answer",
              "deltaContent": "contract answer"
            }
          },
          {
            "type": "result",
            "data": {
              "exitCode": 0
            }
          }
        ],
        "exitCode": 0,
        "stderr": ""
      },
      "expected": {
        "status": 200,
        "eventTypes": [
          "response.created",
          "response.output_item.added",
          "response.reasoning_summary_part.added",
          "response.output_item.added",
          "response.content_part.added",
          "response.output_text.delta",
          "response.reasoning_summary_text.done",
          "response.reasoning_summary_part.done",
          "response.output_item.done",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]"
        ],
        "outputText": "contract answer",
        "completedStatus": "completed"
      }
    },
    "tool_and_skill_read": {
      "request": {
        "stream": true
      },
      "cli": {
        "events": [
          {
            "type": "tool.execution_start",
            "data": {
              "toolCallId": "tool-1",
              "toolName": "read_file",
              "arguments": {
                "file_path": "<REPO_ROOT>/.rulesync/skills/ccc/SKILL.md"
              }
            }
          },
          {
            "type": "tool.execution_complete",
            "data": {
              "toolCallId": "tool-1",
              "toolName": "read_file",
              "success": true,
              "output": "skill body"
            }
          },
          {
            "type": "assistant.message_start",
            "data": {
              "messageId": "message-2",
              "phase": "final_answer"
            }
          },
          {
            "type": "assistant.message_delta",
            "data": {
              "messageId": "message-2",
              "phase": "final_answer",
              "deltaContent": "skill inspected"
            }
          },
          {
            "type": "result",
            "data": {
              "exitCode": 0
            }
          }
        ],
        "exitCode": 0,
        "stderr": ""
      },
      "expected": {
        "status": 200,
        "outputText": "skill inspected",
        "completedStatus": "completed",
        "telemetryTypes": [
          "tool_requested",
          "tool_executed"
        ],
        "tool": "read_file",
        "skill": "ccc",
        "eventTypes": [
          "response.created",
          "response.output_item.added",
          "response.reasoning_summary_part.added",
          "response.output_item.added",
          "response.content_part.added",
          "response.reasoning_summary_text.delta",
          "response.output_text.delta",
          "response.reasoning_summary_text.done",
          "response.reasoning_summary_part.done",
          "response.output_item.done",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]"
        ],
        "directEventTypes": [
          "skill_used"
        ]
      }
    },
