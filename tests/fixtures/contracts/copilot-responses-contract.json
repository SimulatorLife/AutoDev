    "provider_limit_incomplete": {
      "request": {
        "stream": true
      },
      "cli": {
        "events": [
          {
            "type": "assistant.message_start",
            "data": {
              "messageId": "message-4",
              "phase": "final_answer"
            }
          },
          {
            "type": "assistant.message_delta",
            "data": {
              "messageId": "message-4",
              "phase": "final_answer",
              "deltaContent": "partial answer"
            }
          }
        ],
        "exitCode": 1,
        "stderr": "Copilot usage limit reached; reset at 2099-01-02T03:04:05Z"
      },
      "expected": {
        "status": 200,
        "eventTypes": [
          "response.created",
          "response.output_item.added",
          "response.reasoning_summary_part.added",
          "response.output_item.added",
          "response.content_part.added",
          "response.output_text.delta",
          "response.output_text.delta",
          "response.reasoning_summary_text.done",
          "response.reasoning_summary_part.done",
          "response.output_item.done",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]"
        ],
        "outputTextPrefix": "partial answer",
        "completedStatus": "incomplete",
        "incompleteReason": "provider_limit",
        "limit": {
          "class": "quota_exhausted",
          "type": "quota",
          "resets_at": "2099-01-02T03:04:05.000Z",
          "source": "inferred"
        }
      }
    },
    "image_content_refused": {
      "request": {
        "stream": false,
        "input": [
          {
            "type": "message",
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "contract task"
              },
              {
                "type": "input_image",
                "image_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
              }
            ]
          }
        ]
      },
      "cli": {
