      "expected": 0
    },
    "retry_skips_expired_entries_at_future_time": {
      "setup": [
        { "provider": "claude", "args": { "failureClass": "probe_unavailable" } },
        { "provider": "antigravity", "args": {} }
      ],
      "atDeltaMs": 6000,
      "providers": ["claude", "antigravity"],
      "expected": 24000
    },
    "summary_disabled_provider_reports_disabled_state": {
      "setup": [{ "disable": "antigravity" }],
      "providers": ["antigravity"],
      "expected": [
        {
          "provider": "antigravity",
          "state": "disabled",
          "failureClass": "provider_disabled",
          "resetsAt": null,
          "retryAfterMs": 0
        }
      ]
    },
    "summary_cooling_provider_reports_kind_failure_and_reset": {
      "setup": [
        { "provider": "claude", "args": { "failureClass": "quota_exhausted", "structured": true, "resetsAt": "2023-11-14T23:13:20.000Z" } }
      ],
      "providers": ["claude"],
      "atDeltaMs": 1,
      "expected": [
        {
          "provider": "claude",
          "state": "hard",
