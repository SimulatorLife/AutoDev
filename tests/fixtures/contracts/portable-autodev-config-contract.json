{
  "schema": "autodev-portable-autodev-config-v1",
  "description": "Deterministic portable-source contract for config/config.autodev.toml. Rulesync owns hook declarations and generated hook files; this fixture pins AutoDev's portable scalars, provider entries, required sections, explicit absence of hooks and mcp_servers, and the skills.config name set. runtime/src/config/compose-user-config.ts removes legacy hook event arrays while preserving machine-local hooks.state trusted hashes. The portable source suppresses Codex plugin families that are irrelevant noise for AutoDev (openai-primary-runtime and openai-curated-remote artifact/site/dev skills) via whole-plugin `[plugins.\"<plugin>@<marketplace>\"]` disables, and disables the openai-bundled family that ships native Codex tools, apart from the Codex App tools plugin it narrows to request_user_input, and disables the irrelevant Codex `.system/` skills (imagegen, plugin-creator, skill-creator, skill-installer) per-skill while keeping openai-docs. Codex 0.154.0 only honours `[[skills.config]]` against user-level skills; plugin-provided skills require whole-plugin disable. `[skills.bundled] enabled = false` would also suppress openai-docs, so it is not used at the user level.",
  "source": "config/config.autodev.toml",
  "portableScalars": [
    "background_terminal_max_timeout",
    "model",
    "model_catalog_json",
    "model_provider",
    "model_reasoning_effort",
    "model_verbosity",
    "openai_base_url",
    "personality",
    "service_tier",
    "suppress_unstable_features_warning"
  ],
  "scalars": {
    "model": "autodev/orchestrator",
    "model_provider": "local_model_router",
    "openai_base_url": "http://127.0.0.1:4100/v1",
    "model_verbosity": "low",
    "model_reasoning_effort": "xhigh",
    "personality": "pragmatic",
    "suppress_unstable_features_warning": true,
    "service_tier": "default",
    "model_catalog_json": "./codex-model-catalog.json",
    "background_terminal_max_timeout": 600000
  },
  "requiredSections": [
    "otel",
    "analytics",
    "features",
    "skills",
    "shell_environment_policy",
    "plugins"
  ],
  "sectionShapes": {
    "otel": {
      "environment": "autodev",
      "exporter": {
        "otlp-http": {
          "endpoint": "http://127.0.0.1:4318/v1/logs",
          "protocol": "json"
        }
      },
      "trace_exporter": {
        "otlp-http": {
          "endpoint": "http://127.0.0.1:4318/v1/traces",
          "protocol": "json"
        }
      },
      "metrics_exporter": {
        "otlp-http": {
          "endpoint": "http://127.0.0.1:4318/v1/metrics",
          "protocol": "json"
        }
      },
      "log_user_prompt": false
    },
    "analytics": {
      "enabled": true
    },
    "features": {
      "shell_snapshot": true,
      "unified_exec": true,
      "steer": true,
      "multi_agent": true,
      "multi_agent_v2": false,
      "js_repl": false,
      "memories": false,
      "apps": false,
      "respect_system_proxy": true,
      "chronicle": false,
      "goals": true,
      "hooks": true,
      "fast_mode": false,
      "prevent_idle_sleep": true,
      "personality": true,
      "image_generation": false
    },
    "skills": {
