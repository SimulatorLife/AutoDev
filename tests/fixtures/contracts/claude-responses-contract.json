{
  "schema": "autodev-claude-responses-contract-v1",
  "description": "Offline stream-json inputs and expected boundary invariants for the Claude Responses bridge. Each case feeds a fake Claude CLI subprocess whose stdout is the JSONL event sequence; the bridge is exercised through the real Python HTTP server and a local telemetry collector, so Anthropic is never contacted and no real OAuth credentials are required. Cases cover: normal streaming text deltas with reasoning and completion, direct file-tool skill reads, shell skill reads through bash, multi-call continuation with item-id continuity, permission-denied tool unavailability, rate-limit-event incomplete output with classified limit, missing-bearer 401 from the gateway auth check, and missing-Claude-OAuth 502 from the bridge subprocess guard. Expected IDs are normalized before assertion, and the prompt content used by every case is asserted absent from both the SSE body and the telemetry channel.",
  "cases": {
    "normal_stream": {
      "request": {
        "stream": true,
        "model": "claude-subscription"
      },
      "cli": {
        "events": [
          {
            "type": "system",
            "subtype": "init",
            "tools": [
              "Read",
              "Bash"
            ]
          },
          {
            "type": "stream_event",
            "event": {
              "type": "message_start"
            }
          },
          {
            "type": "stream_event",
            "event": {
              "type": "content_block_start",
              "index": 0,
              "content_block": {
                "type": "text",
                "text": ""
              }
            }
          },
          {
            "type": "stream_event",
            "event": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "text_delta",
                "text": "contract "
              }
            }
          },
          {
            "type": "stream_event",
            "event": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "text_delta",
                "text": "answer"
              }
            }
          },
          {
            "type": "stream_event",
            "event": {
              "type": "content_block_stop",
              "index": 0
            }
          },
          {
            "type": "result",
            "result": "contract answer",
            "is_error": false,
            "subtype": "success",
            "duration_ms": 120,
            "modelUsage": {
              "input_tokens": 7,
              "output_tokens": 5
            }
          }
        ],
        "exitCode": 0,
        "stderr": ""
      },
      "expected": {
        "status": 200,
        "outputText": "contract answer",
        "completedStatus": "completed",
        "eventTypes": [
          "response.created",
          "response.output_item.added",
          "response.reasoning_summary_part.added",
          "response.output_item.added",
          "response.content_part.added",
          "response.output_text.delta",
          "response.output_text.delta",
          "response.reasoning_summary_text.done",
          "response.reasoning_summary_part.done",
          "response.output_item.done",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]"
        ],
        "telemetryTypes": [
          "mcp_exposed",
          "activity"
        ]
      }
    },
