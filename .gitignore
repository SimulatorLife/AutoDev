.DS_Store
__pycache__/
*.py[cod]
node_modules/
tmp/
*.log
.env
.env.*
!.env.example
.playwright-mcp/
# CocoIndex Code (ccc)
/.cocoindex_code/
# Rulesync-generated repository skill surfaces. `.rulesync/skills/` is the only
# tracked skill source; the installer (and Copilot's setup steps) generate these.
# The installer keeps the generated `/.agents/skills/` out of git through
# `.git/info/exclude` instead, because Antigravity does not load skills from a
# `.agents/skills/` that .gitignore lists.
/.claude/skills/
/.github/skills/
# Rulesync-generated hook projections; `.rulesync/hooks.jsonc` is the only
# tracked declaration source.
/.codex/hooks.json
/.claude/settings.json
/.github/hooks/
/.agents/hooks.json
