.DS_Store
__pycache__/
.pytest_cache
*.py[cod]
node_modules/
tmp/
.tmp
.venv
*.log
.env
.env.*
!.env.example
.playwright-mcp/
# CocoIndex Code (ccc)
/.cocoindex_code/
# Rulesync-generated repository skill surfaces. `.rulesync/skills/` is the only
# tracked skill source; the installer (and Copilot's setup steps) generate these.
# The installer keeps the generated `/.agents/skills/` out of git through
# `.git/info/exclude` instead, because Antigravity does not load skills from a
# `.agents/skills/` that .gitignore lists.
/.claude/skills/
/.github/skills/
# Rulesync-generated hook projections; `.rulesync/hooks.jsonc` is the only
# tracked declaration source.
/.codex/hooks.json
/.claude/settings.json
/.github/hooks/
/.agents/hooks.json
.eslintcache
*.tmp.cjs
*.bak
*.lock

# Next.js output: production build (.next), dev server (.next-dev), and the
# next-env.d.ts that points at whichever of them generated it last
console/.next/
console/.next-dev/
console/next-env.d.ts

# Throwaway working files. A stub server or a captured page kept around to
# make one measurement reproducible must never reach the repository: a
# concurrent commit that stages the whole working tree will pick them up,
# and a stub that answers /control/* looks like a legitimate backend to
# anyone who finds it later.
.scratch-*
