{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "copilot",
    "claudecode",
    "codexcli",
    "antigravity-cli",
    "agentsmd"
  ],
  "features": [
    "skills",
    "commands",
    "hooks",
    "rules"
  ],
  "outputRoots": [
    "."
  ],
  "delete": true,
  "global": false,
  "sources": [
    {
      "source": "vercel-labs/agent-skills",
      "skills": [
        "react-best-practices"
      ]
    },
    {
      "source": "multica-ai/andrej-karpathy-skills",
      "skills": [
        "karpathy-guidelines"
      ]
    },
    {
      "source": "acpx",
      "transport": "npm",
      "ref": "0.22.0",
      "skills": [
        "acpx"
      ]
    },
    {
      "source": "quota-axi",
      "transport": "npm",
      "ref": "0.1.69",
      "skills": [
        "quota-axi"
      ]
    },
    {
      "source": "@jackwener/opencli",
      "transport": "npm",
      "ref": "2.0.3",
      "skills": [
        "opencli-autofix",
        "opencli-browser",
        "opencli-usage"
      ]
    },
    {
      "source": "@tanstack/react-table",
      "transport": "npm",
      "ref": "9.3.1",
      "skills": [
        "getting-started",
        "table-state"
      ]
    }
  ]
}
