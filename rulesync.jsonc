{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "copilot",
    "claudecode",
    "codexcli",
    "antigravity-cli",
    "agentsmd"
  ],
  "features": [
    "skills",
    "commands",
    "hooks",
    "rules"
  ],
  "outputRoots": [
    "."
  ],
  "delete": true,
  "global": false
}
