{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "copilot": [
      "skills",
      "commands",
      "hooks",
      "rules"
    ],
    "claudecode": [
      "skills",
      "commands",
      "hooks",
      "rules"
    ],
    "codexcli": [
      "skills",
      "rules"
    ],
    "antigravity-cli": [
      "commands",
      "hooks",
      "rules"
    ],
    "agentsmd": [
      "rules"
    ]
  },
  "outputRoots": [
    "."
  ],
  "delete": true,
  "global": false,
  "sources": [
    {
      "source": "vercel-labs/agent-skills",
      "skills": [
        "react-best-practices"
      ]
    },
    {
      "source": "multica-ai/andrej-karpathy-skills",
      "skills": [
        "karpathy-guidelines"
      ]
    },
    {
      "source": "acpx",
      "transport": "npm",
      "skills": [
        "acpx"
      ]
    },
    {
      "source": "quota-axi",
      "transport": "npm",
      "skills": [
        "quota-axi"
      ]
    },
    {
      "source": "@jackwener/opencli",
      "transport": "npm",
      "skills": [
        "opencli-autofix",
        "opencli-browser",
        "opencli-usage"
      ]
    },
    {
      "source": "@tanstack/react-table",
      "transport": "npm",
      "skills": [
        "getting-started",
        "table-state"
      ]
    }
  ]
}