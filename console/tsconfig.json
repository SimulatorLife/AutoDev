{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": [
    ".next-dev/types/**/*.ts",
    ".next-staging-e2e-70178-51944/types/**/*.ts",
    ".next-staging-e2e-71060-52271/types/**/*.ts",
    ".next-staging-e2e-71421-52479/types/**/*.ts",
    ".next-staging-e2e-72640-52874/types/**/*.ts",
    ".next-staging-e2e-73510-53135/types/**/*.ts",
    ".next-staging-e2e-74064-53425/types/**/*.ts",
    ".next-staging-e2e-74687-53629/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".next-staging-e2e-79907-54690/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-dev",
    "e2e/playtesting-usability.spec.ts",
    "e2e/playtesting-control-api-fixture.ts"
  ]
}
