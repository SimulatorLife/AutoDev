{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": [
    ".next-dev/types/**/*.ts",
    ".next-staging-e2e-72825-60257/types/**/*.ts",
    ".next-staging-e2e-75481-60887/types/**/*.ts",
    ".next-staging-e2e-77351-61238/types/**/*.ts",
    ".next-staging-e2e-77886-61359/types/**/*.ts",
    ".next-staging-e2e-78903-61560/types/**/*.ts",
    ".next-staging-e2e-79982-61739/types/**/*.ts",
    ".next-staging-e2e-80690-61967/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".next-staging-e2e-85973-62503/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-dev",
    "e2e/playtesting-usability.spec.ts",
    "e2e/playtesting-control-api-fixture.ts"
  ]
}
