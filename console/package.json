{
  "name": "@simulatorlife/autodev-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev:next": "next dev -p ${AUTODEV_CONSOLE_PORT:-3300}",
    "build": "node ../runtime/src/platform/console-build.ts",
    "start": "next start -p ${AUTODEV_CONSOLE_PORT:-3300}",
    "test": "node --test",
    "test:playtesting:browser": "playwright test --config=playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "0.4.43",
    "@simulatorlife/autodev-core": "workspace:*",
    "@simulatorlife/autodev-data": "workspace:*",
    "@tanstack/react-table": "9.3.1",
    "cockatiel": "4.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
