{
  "schemaVersion": 1,
  "adapter": {
    "transport": "stdio-jsonl",
    "command": [
      "/opt/autodev/playtest-adapter/main.js",
      "--integration-dir",
      ".autodev"
    ]
  },
  "modes": [
    "headless"
  ],
  "scenarios": [
    "tutorial"
  ],
  "scenarioFamilies": {
    "tutorial": "onboarding"
  },
  "policies": [
    "random"
  ],
  "budget": {
    "episodes": 1000,
    "maxStepsPerEpisode": 20,
    "workers": 1,
    "wallTimeMinutes": 1
  },
  "analysis": {
    "rubric": "playtest.rubric.json",
    "observationContract": "playtest.observation.json",
    "benchmark": "playtest.benchmark.json",
    "critic": "fixture-only-no-model",
    "maxReviewedSessions": 0,
    "reviewSelection": {
      "surveillanceSessions": 0,
      "discoverySessions": 0,
      "discoverySignal": null
    },
    "visualCapture": "off",
    "counterfactuals": "off",
    "understandingProbes": "off",
    "learningCohorts": "off",
    "humanCalibration": "off"
  },
  "reporting": {
    "githubIssues": "disabled"
  }
}
