        "invoke_subagent"
      ],
      "permissionMode": "configured"
    },
    "minimax": {
      "spawnTools": [],
      "permissionMode": "upstream"
    },
    "copilot": {
      "spawnTools": [],
      "permissionMode": "configured"
    },
    "codex": {
      "spawnTools": [],
      "permissionMode": "native"
    }
  }
}
