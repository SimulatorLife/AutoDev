{
  "version": 1,
  "roles": {
    "orchestrator": {
      "kind": "orchestrator",
      "readOnly": false,
      "mcp": [
        "lsp",
        "cocoindex-code",
        "playwright",
        "autodev_spawn"
      ]
    },
    "default": {
      "kind": "leaf",
      "readOnly": false,
      "mcp": [
        "lsp",
        "cocoindex-code"
      ]
    },
    "worker": {
      "kind": "leaf",
      "readOnly": false,
      "mcp": [
        "lsp",
        "cocoindex-code"
      ]
    },
    "explorer": {
      "kind": "leaf",
      "readOnly": true,
      "mcp": [
        "lsp",
        "cocoindex-code"
      ]
    },
    "validator": {
      "kind": "leaf",
      "readOnly": true,
      "mcp": [
        "lsp",
        "cocoindex-code"
      ]
    },
    "browser-tester": {
      "kind": "leaf",
      "readOnly": true,
      "mcp": [
        "playwright"
      ]
    },
    "docs-researcher": {
      "kind": "leaf",
      "readOnly": true,
      "mcp": [
        "openaiDeveloperDocs"
      ]
    },
    "smart": {
      "kind": "leaf",
      "readOnly": false,
