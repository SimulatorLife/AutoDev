<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.claude-bridge</string>

  <!-- Claude Code OAuth Responses bridge on 127.0.0.1:4000 (sonnet/opus/haiku
       child route). KeepAlive keeps it up across restarts, crashes, and sleep.
       Invokes the installed hook copy under ~/.codex (outside Desktop) so macOS
       privacy controls on the Desktop repo do not block launchd. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/henrykirk/.codex/hooks/run-codex-claude-bridge.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/henrykirk/.nvm/versions/node/v25.0.0/bin:/Users/henrykirk/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CODEX_HOME</key>
    <string>/Users/henrykirk/.codex</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/henrykirk/.codex/hooks/claude-bridge.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/henrykirk/.codex/hooks/claude-bridge.launchd.log</string>
</dict>
</plist>
