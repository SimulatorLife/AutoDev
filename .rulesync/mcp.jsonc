{
  "$schema": "https://raw.githubusercontent.com/dyoshikawa/rulesync/v16.30.2/schemas/mcp.json",
  "mcpServers": {
    "lsp": {
      "command": "bash",
      "args": ["-lc", "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"]
    },
    "cocoindex-code": {
      "command": "bash",
      "args": ["-lc", "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"]
    },
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    }
  },
  "codexcli": {
    "mcpServers": {
      "lsp": {
        "command": "bash",
        "args": ["-lc", "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" lsp"],
        "default_tools_approval_mode": "approve"
      },
      "cocoindex-code": {
        "command": "bash",
        "args": ["-lc", "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" cocoindex-code"],
        "default_tools_approval_mode": "approve"
      },
      "openaiDeveloperDocs": {
        "url": "https://developers.openai.com/mcp",
        "disabled": true
      },
      "playwright": {
        "command": "bash",
        "args": ["-lc", "exec \"${CODEX_HOME:-$HOME/.codex}/hooks/run-autodev-mcp.sh\" playwright"],
        "disabled": true,
        "default_tools_approval_mode": "approve"
      }
    }
  },
  "copilotcli": {
    "mcpServers": {
      "openaiDeveloperDocs": null
    }
  },
  "antigravity-cli": {
    "mcpServers": {
      "autodev_spawn": {
        "command": "bash",
        "args": ["-lc", "exec node \"${CODEX_HOME:-$HOME/.codex}/src/mcp/spawn-shim.ts\""]
      }
    }
  }
}
