{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "filesystem": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" filesystem"
      ]
    },
    "commands": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" commands"
      ]
    },
    "github": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" github"
      ]
    },
    "lsp": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" lsp"
      ]
    },
    "cocoindex-code": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" cocoindex-code"
      ]
    },
    "codegraphcontext": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" codegraphcontext"
      ]
    },
    "xacpx": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" xacpx"
      ]
    },
    "playwright": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" playwright"
      ]
    },
    "playtest": {
      "command": "bash",
      "args": [
        "-lc",
        "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" playtest"
      ]
    },
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "bearer_token_env_var": "CONTEXT7_API_KEY"
    },
    "googleDeveloperKnowledge": {
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY}"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    }
  },
  "codexcli": {
    "mcpServers": {
      "filesystem": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" filesystem"
        ],
        "default_tools_approval_mode": "approve"
      },
      "commands": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" commands"
        ],
        "default_tools_approval_mode": "approve"
      },
      "github": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" github"
        ],
        "disabled": true,
        "default_tools_approval_mode": "approve"
      },
      "lsp": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" lsp"
        ],
        "default_tools_approval_mode": "approve"
      },
      "cocoindex-code": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" cocoindex-code"
        ],
        "default_tools_approval_mode": "approve"
      },
      "codegraphcontext": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" codegraphcontext"
        ],
        "default_tools_approval_mode": "approve"
      },
      "xacpx": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" xacpx"
        ],
        "default_tools_approval_mode": "approve"
      },
      "openaiDeveloperDocs": {
        "url": "https://developers.openai.com/mcp",
        "disabled": true
      },
      "context7": {
        "url": "https://mcp.context7.com/mcp",
        "bearer_token_env_var": "CONTEXT7_API_KEY",
        "disabled": true
      },
      "googleDeveloperKnowledge": {
        "url": "https://developerknowledge.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "${GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY}"
        },
        "disabled": true
      },
      "exa": {
        "url": "https://mcp.exa.ai/mcp",
        "disabled": true
      },
      "playwright": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" playwright"
        ],
        "disabled": true,
        "default_tools_approval_mode": "approve"
      },
      "playtest": {
        "command": "bash",
        "args": [
          "-lc",
          "exec \"${AUTODEV_HOME:-$HOME/.autodev}/hooks/run-autodev-mcp.sh\" playtest"
        ],
        "disabled": true,
        "default_tools_approval_mode": "approve"
      },
      "codex_app": {
        "command": "bash",
        "args": [
          "-lc",
          "set -e; root=\"${CODEX_HOME:-$HOME/.codex}/plugins/cache/openai-bundled/codex-app-tools\"; plugin=$(printf '%s\\n' \"$root\"/* | sort | tail -n 1); test -d \"$plugin\"; cd \"$plugin\"; exec \"$plugin/scripts/launch_codex_app_tools_mcp\" ./server.mjs"
        ],
        "default_tools_approval_mode": "approve",
        "disabled": true,
        "enabled_tools": [
          "request_user_input"
        ]
      }
    }
  }
}