{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  // Canonical source for portable tool, command, and CLI permissions.
  //
  // Scope boundary:
  // - Applied to `codexcli` ($CODEX_HOME/config.toml permission/tool keys and
  //   $CODEX_HOME/rules/rulesync.rules) and `antigravity-cli`
  //   (~/.gemini/antigravity-cli/settings.json, merged with dynamic machine-local
  //   workspace read roots `AUTODEV_AGY_READ_ROOTS`).
  // - Per-role capability & read-only enforcement (MCP/tool allowlists,
  //   shell_tool = false, AUTODEV_MCP_READ_ONLY) remain in `agents/roles/*.toml`
  //   -> `config/execution-contract.json` and Runtime hooks/gateway boundaries
  //   (`role-sandbox.ts`, `block-ccc-cli.ts`, `file-surface.ts`, Supergateway)
  //   uniformly across every local and external provider, including ChatGPT.
  "permission": {
    "webfetch": {
      "*": "deny"
    },
    "bash": {
      // CLIs (should only be invoked via MCPs)
      "ccc *": "deny",
      "aws *": "deny",
      "cgc *": "deny",
      "gh *": "deny",
      // Destructive system commands
      "sudo *": "deny",
      "eval *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "rmdir *": "deny",
      // Prevent common recursive forced deletions
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r -f *": "deny",
      "rm -f -r *": "deny",
      // Destructive git commands
      "git checkout *": "deny",
      "git reset *": "deny",
      "git stash *": "deny",
      "git-checkout *": "deny",
      "git-reset *": "deny",
      "git-stash *": "deny",
      "git clean *": "deny",
      "git rebase *": "deny",
      "git restore *": "deny",
      "git remote set-url *": "deny",
      "git branch -D *": "deny",
      "git branch --delete-force *": "deny",
      "git remote add *": "deny",
      "git push -f *": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git commit --amend *": "deny",
      "git reflog expire *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git push --mirror *": "deny",
      "git push --delete *": "deny",
      "git remote remove *": "deny",
      "git worktree remove --force *": "deny",
      // External package publication
      "yarn npm publish *": "deny",
      "twine upload *": "deny",
      "cargo publish *": "deny",
      "docker push *": "deny",
      "npm publish *": "deny",
      "pnpm publish *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      // System sleep/hibernation
      "pmset *": "deny",
      "sleep *": "deny",
      // MacOS Keychain
      "security": "deny",
      "security *": "deny",
      "/usr/bin/security": "deny",
      "/usr/bin/security *": "deny",
      // Other credential-bearing cloud CLIs
      "gcloud *": "deny",
      "az *": "deny",
      "op *": "deny",
      "bw *": "deny",
      "vault *": "deny"
    },
    "read": {
      "~/.autodev/**": "allow",
      "~/.agents/**": "allow",
      "~/.codex/**": "allow",
      "~/.claude/**": "allow",
      "~/.gemini/**": "allow",
      "~/.minimax/**": "allow",
      "~/.mmx/**": "allow",
      "~/.opencli/**": "allow",
      "~/.copilot/**": "allow",
      "~/.docker/**": "allow",
      "~/.xacpx/**": "allow",
      "~/.cocoindex_code/**": "allow",
      "~/.codegraphcontext/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gh/**": "deny",
      "~/Library/Keychains/**": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny",
      "~/.codex/auth.json": "deny",
      "~/.codex/chatgpt-tunnel/**": "deny",
      "~/.codex/openlit-secrets.env": "deny"
    },
    "mcp__filesystem": {
      "*": "allow"
    },
    "mcp__cocoindex-code__search": {
      "*": "allow"
    },
    "mcp__codegraphcontext__list_indexed_repositories": {
      "*": "allow"
    },
    "mcp__codegraphcontext__find_code": {
      "*": "allow"
    },
    "mcp__codegraphcontext__analyze_code_relationships": {
      "*": "allow"
    },
    "mcp__codegraphcontext__get_repository_stats": {
      "*": "allow"
    },
    "mcp__lsp": {
      "*": "allow"
    },
    "mcp__xacpx": {
      "*": "allow"
    },
    "mcp__openaiDeveloperDocs": {
      "*": "allow"
    },
    "mcp__context7": {
      "*": "allow"
    },
    "mcp__googleDeveloperKnowledge": {
      "*": "allow"
    },
    "mcp__exa": {
      "*": "allow"
    },
    "mcp__playwright": {
      "*": "deny"
    },
    "mcp__playtest": {
      "*": "deny"
    }
  },
  "codexcli": {
    "base_permission_profile": ":danger-full-access",
    "approval_policy": "never",
    "approvals_reviewer": "user",
    "tools": {
      "web_search": false
    }
  },
  "antigravity-cli": {
    "agentMode": "accept-edits",
    "permission": {
      "unsandboxed": {
        "pwd *": "allow",
        "pnpm test *": "allow",
        "regex:python3 -m unittest discover -s tests -p test_.*\\.py": "allow",
        "ccc *": "deny"
      }
    }
  }
}