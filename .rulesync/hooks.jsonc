{
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "matcher": ".*",
        "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/session-start.ts"
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "matcher": ".*",
        "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/subagent-start.ts"
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "(?i)exec[_ -]?command|bash",
        "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/block-ccc-cli.ts",
        "statusMessage": "Enforcing command policy"
      },
      {
        "type": "command",
        "matcher": "(?i)read[_ -]?file|read|exec[_ -]?command|bash",
        "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/skill-read-telemetry.ts",
        "statusMessage": "Recording skill-read telemetry"
      }
    ]
  },
  "codexcli": {
    "hooks": {
      "beforeSubmitPrompt": [
        {
          "type": "command",
          "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/root-delegation.ts",
          "statusMessage": "Applying root delegation policy"
        }
      ],
      "sessionEnd": [
        {
          "type": "command",
          "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/memory-session-end.ts"
        }
      ]
    }
  },
  "copilot": {
    "hooks": {
      "beforeSubmitPrompt": [
        {
          "type": "command",
          "command": "~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/root-delegation.ts"
        }
      ]
    }
  },
  "claudecode": {
    "hooks": {
      "SessionEnd": [
        {
          "type": "command",
          "command": "AUTODEV_MEMORY_HOOK_PROVIDER=claude-code ~/.codex/hooks/run-autodev-hook.sh ~/.codex/src/hooks/memory-session-end.ts",
          "timeout": 60
        }
      ]
    }
  }
}
