{
  "name": "@simulatorlife/autodev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node runtime/src/cli/dev.ts",
    "clean": "rm -rf console/.next console/.next-dev console/.next-staging-* console/next-env.d.ts console/test-results playwright-report && find . -name .git -prune -o -name .cocoindex_code -prune -o -type d \\( -name tmp -o -name .tmp -o -name node_modules -o -name .venv -o -name .probe -o -name .playwright-mcp \\) -prune -exec node --input-type=module -e 'import { rmSync } from \"node:fs\"; for (const target of process.argv.slice(1)) rmSync(target, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });' '{}' + && find . -name .git -prune -o -name .cocoindex_code -prune -o -type f \\( -name '*.tsbuildinfo' -o -name .eslintcache \\) -exec rm -f '{}' + && pnpm store prune",
    "test:root": "node --import ./runtime/tests/support/isolate-autodev-state.ts --test tests/*.test.ts tests/**/*.test.ts",
    "test": "pnpm run test:root; root_status=$?; pnpm --recursive --workspace-concurrency=1 --if-present test; workspace_status=$?; test \"$root_status\" -eq 0 -a \"$workspace_status\" -eq 0",
    "typecheck:root": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:root; root_status=$?; pnpm --recursive --if-present typecheck; workspace_status=$?; test \"$root_status\" -eq 0 -a \"$workspace_status\" -eq 0",
    "validate:weights": "node tests/weights.test.ts",
    "bench:github-metrics": "node runtime/src/benchmarks/github-metrics.ts",
    "validate:actionlint": "actionlint",
    "validate:shell": "find scripts -type f -name '*.sh' -exec shellcheck --severity=warning {} +",
    "autodev": "node runtime/src/cli/autodev.ts",
    "opencli:version": "node runtime/src/cli/opencli-version.ts",
    "opencli:version:check": "node runtime/src/cli/opencli-version.ts --check",
    "install:autodev": "bash scripts/install.sh --enable-chatgpt-tunnel",
    "validate:inventory": "AUTODEV_ENFORCE_INVENTORY=1 node --test tests/inventory/repository-inventory.test.ts",
    "lint": "eslint . --cache --max-warnings=0 --report-unused-disable-directives",
    "lint:fix": "eslint . --cache --fix --max-warnings=0",
    "lint:ci": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "format": "prettier --cache --write --ignore-path .gitignore \"{tests,core,data,console,runtime}/**/*.{ts,tsx}\" \".rulesync/**/*.ts\" \"*.{js,ts}\"",
    "format:check": "prettier --check --ignore-path .gitignore \"{tests,core,data,console,runtime}/**/*.{ts,tsx}\" \".rulesync/**/*.ts\" \"*.{js,ts}\"",
    "knip": "knip",
    "knip:production": "knip --production",
    "duplicates": "jscpd",
    "duplicates:similar": "jscpd --similarity"
  },
  "packageManager": "pnpm@12.23.0",
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@simulatorlife/autodev-core": "workspace:*",
    "@simulatorlife/autodev-data": "workspace:*",
    "@simulatorlife/autodev-runtime": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.4.5",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.1",
    "rulesync": "43.16.0",
    "smol-toml": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}