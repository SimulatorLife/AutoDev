{
  "name": "@simulatorlife/autodev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test:root": "node --test tests/*.test.ts tests/**/*.test.ts",
    "test": "pnpm run test:root && pnpm --recursive --if-present test",
    "typecheck:root": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:root; root_status=$?; pnpm --recursive --if-present typecheck; workspace_status=$?; test \"$root_status\" -eq 0 -a \"$workspace_status\" -eq 0",
    "validate:weights": "node tests/weights.test.ts",
    "validate:actionlint": "actionlint",
    "validate:shell": "find scripts -type f -name '*.sh' -exec shellcheck --severity=warning {} +",
    "autodev": "node runtime/src/cli/autodev.ts",
    "install:codex": "bash scripts/install.sh",
    "validate:inventory": "AUTODEV_ENFORCE_INVENTORY=1 node --test tests/inventory/repository-inventory.test.ts",
    "lint": "eslint . --cache --max-warnings=0 --report-unused-disable-directives",
    "lint:fix": "eslint . --cache --fix --max-warnings=0",
    "lint:ci": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "format": "prettier --cache --write --ignore-path .gitignore \"{tests,core,data,console,runtime}/**/*.{ts,tsx}\" \".rulesync/**/*.ts\" \"*.{js,ts}\"",
    "format:check": "prettier --check --ignore-path .gitignore \"{tests,core,data,console,runtime}/**/*.{ts,tsx}\" \".rulesync/**/*.ts\" \"*.{js,ts}\""
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {},
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/mcp": "^0.0.80",
    "@simulatorlife/autodev-core": "workspace:*",
    "@simulatorlife/autodev-data": "workspace:*",
    "@simulatorlife/autodev-runtime": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.0.2",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "lsp-mcp-server": "^1.1.20",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rulesync": "16.30.2",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "typescript-language-server": "^5.3.0"
  }
}
